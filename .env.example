# 创建 GitHub 仓库并安装 Giscus 后填写；未配置时评论区显示暂未开放。
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=

# 生产站点与个人入口。联系方式已内置公开默认值，此处仅在需要覆盖时填写
# （如 QQ 加群链接失效换新、更换邮箱）；留空即用代码内置值。
PUBLIC_SITE_URL=https://aria-7.pages.dev
PUBLIC_GITHUB_URL=
PUBLIC_CONTACT_EMAIL=
PUBLIC_QQ_GROUP_URL=

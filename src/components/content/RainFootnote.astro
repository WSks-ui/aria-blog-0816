---
import { Droplet } from '@lucide/astro';

interface Props {
	index: number | string;
	title?: string;
}

const { index, title = '补充说明' } = Astro.props;
---

<aside class="rain-footnote" role="note">
	<details>
		<summary>
			<Droplet size={15} stroke-width={1.5} aria-hidden="true" />
			<span>{String(index).padStart(2, '0')} / {title}</span>
		</summary>
		<div class="rain-footnote__body">
			<slot />
		</div>
	</details>
</aside>

<style>
	.rain-footnote {
		margin-block: 28px;
		border-left: 1px solid var(--accent-strong);
		background: color-mix(in srgb, var(--accent-soft) 22%, transparent);
	}

	.rain-footnote details {
		padding: 0 20px;
	}

	.rain-footnote summary {
		display: flex;
		min-height: 44px;
		align-items: center;
		gap: 9px;
		font-family: var(--font-ui);
		font-size: 12px;
		color: var(--accent-strong);
		cursor: pointer;
	}

	.rain-footnote summary::marker {
		content: '';
	}

	.rain-footnote__body {
		padding: 4px 0 20px 24px;
		font-size: 0.92em;
		color: var(--ink-muted);
	}
</style>

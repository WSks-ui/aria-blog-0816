	}

	/* 列表行每次切入列表视图都会重放：display:none → block 会让动画重新开始。 */
	.article-graph[data-motion-state='drawn'][data-graph-view='list'] .article-graph__list li {
		animation: article-graph-row-in var(--duration-base) var(--ease-rain) backwards;
		animation-delay: calc(var(--row-order, 0) * 24ms);
	}

	/*
	 * 聚焦某个节点时：它的边实体化、相邻节点保留描边，其余节点与边退到纸面
	 * 之下。全部状态由脚本写 data 属性，这里只做呈现，不承担命中判定。
	 *
	 * 压暗规则整体包在 :where() 里，把前缀特异性归零——否则
	 * 「.article-graph [data-graph-svg][data-focus-key] … path」会压过下面的
	 * path[data-active='true']，连本该点亮的边也一起沉到 3.5% 透明度，
	 * 聚焦时就只剩节点变色、连线全消失。
	 */
	:where(.article-graph [data-graph-svg][data-focus-key]:not([data-focus-key=''])) .article-graph__edges path {
		stroke-opacity: 0.05;
	}

	.article-graph__edges path[data-active='true'] {
		stroke-opacity: 0.92;
		stroke-width: 1.7;
	}

	.article-graph__node {
		color: var(--ink);
		outline: none;
		transition:
			opacity var(--duration-base) ease,
			transform var(--duration-fast) var(--ease-rain);
	}

	/* 纸面浮起：与侧轨导航同一套悬停语言，位移只有 1px，不干扰点选。 */
	.article-graph__node:hover,
	.article-graph__node:focus-visible {
		transform: translate(-1px, -1px);
	}

	:where(.article-graph [data-graph-svg][data-focus-key]:not([data-focus-key=''])) .article-graph__node {
		opacity: 0.24;
	}

	:where(.article-graph [data-graph-svg][data-focus-key]:not([data-focus-key=''])) .article-graph__node[data-related='true'] {
		opacity: 1;
	}

	/* 孤点用虚线框声明「没有关联」，避免被读成渲染失败或尚未加载。 */
	.article-graph__node[data-isolated='true'] .article-graph__node-surface {
		fill: color-mix(in srgb, var(--paper-0) 86%, transparent);
		stroke: var(--line);
		stroke-dasharray: 3 3;
	}

	.article-graph__node[data-isolated='true'] .article-graph__node-accent {
		opacity: 0.45;
	}

	.article-graph__node[data-isolated='true']:hover .article-graph__node-surface,
	.article-graph__node[data-isolated='true'][data-active='true'] .article-graph__node-surface {
		stroke-dasharray: none;
	}

	.article-graph__node[data-related='true'] .article-graph__node-surface {
		stroke: var(--accent-strong);
	}

	.article-graph__node-surface {
		fill: color-mix(in srgb, var(--paper-0) 94%, transparent);
		stroke: var(--line-strong);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
		transition: fill var(--duration-fast) ease, stroke var(--duration-fast) ease;
	}

	.article-graph__focus-ring {
		fill: none;
		stroke: transparent;
		stroke-width: 2;
		vector-effect: non-scaling-stroke;
		transition: stroke var(--duration-fast) ease;
	}

	/* 悬停时先给一圈淡描边，点选或 Tab 到达后再走完整的焦点色。 */
	.article-graph__node:hover .article-graph__focus-ring {
		stroke: color-mix(in srgb, var(--accent-strong) 42%, transparent);
	}

	.article-graph__node:hover .article-graph__node-surface,
	.article-graph__node[data-active='true'] .article-graph__node-surface {
		fill: color-mix(in srgb, var(--accent-soft) 42%, var(--paper-0));
		stroke: var(--accent-strong);
	}

	.article-graph__node[data-active='true'] .article-graph__node-surface {
		stroke-width: 1.5;
	}

	.article-graph__node-accent {
		opacity: 0.82;
		transition: opacity var(--duration-fast) ease;
	}

	.article-graph__node:hover .article-graph__node-accent,
	.article-graph__node[data-related='true'] .article-graph__node-accent {
		opacity: 1;
	}

	.article-graph__node:focus-visible .article-graph__focus-ring {
		stroke: var(--color-focus);
	}

	.article-graph__node-label {
		fill: currentColor;
		font-family: var(--font-display);
		/* 舞台 1080 用户单位会缩到约 944px 显示，13px 落屏约 11.4px。 */
		font-size: 13px;
		pointer-events: none;
	}

	.article-graph__node-meta {
		fill: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: 8.5px;
		pointer-events: none;
	}

	.article-graph__node[data-active='true'] .article-graph__node-label {
		fill: var(--accent-strong);
	}

	.article-graph__fallback {
		display: none;
		max-height: min(68dvh, 44rem);
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-color: color-mix(in srgb, var(--accent-strong) 38%, transparent) transparent;
		scrollbar-gutter: stable;
		scrollbar-width: thin;
		background: var(--line);
		outline: none;
	}

	.article-graph[data-graph-view='list'] .article-graph__canvas { display: none; }
	.article-graph[data-graph-view='list'] .article-graph__fallback { display: block; }
	.article-graph [data-graph-panel]:not([hidden]) { animation: article-graph-panel-in var(--duration-base) var(--ease-rain) both; }
	.article-graph[data-graph-view-direction='to-list'] [data-graph-panel]:not([hidden]) {
		animation: article-graph-panel-in-right 430ms var(--ease-rain) both;
	}
	.article-graph[data-graph-view-direction='to-graph'] [data-graph-panel]:not([hidden]) {
		animation: article-graph-panel-in-left 430ms var(--ease-rain) both;
	}
	.article-graph[data-graph-view-direction='settled'] [data-graph-panel]:not([hidden]) {
		animation: none;
	}

	.article-graph__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		margin: 0;
		padding: 0;
		background: var(--line);
		list-style: none;
	}

	.article-graph__list li {
		position: relative;
		display: grid;
		grid-template-columns: 3.2rem minmax(0, 1fr);
		min-height: 7.75rem;
		background: color-mix(in srgb, var(--paper-0) 96%, transparent);
		transition: background-color var(--duration-fast) var(--ease-rain);
	}

	.article-graph__list li:hover,
	.article-graph__list li:has(.article-graph__list-title:focus-visible) {
		background: color-mix(in srgb, var(--accent-soft) 24%, var(--paper-0));
	}

	.article-graph__list-index {
		display: grid;
		place-items: start center;
		padding-top: 1.2rem;
		border-right: 1px solid color-mix(in srgb, var(--line) 76%, transparent);
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		transition: color var(--duration-fast) var(--ease-rain);
	}

	.article-graph__list li:hover .article-graph__list-index,
	.article-graph__list li:has(.article-graph__list-title:focus-visible) .article-graph__list-index {
		color: var(--accent-strong);
	}

	.article-graph__list-body {
		min-width: 0;
		padding: 1rem 1.15rem 1.1rem;
	}

	.article-graph__list-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: 0.5rem;
	}

	.article-graph__list-meta small {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font: inherit;
	}

	.article-graph__list-meta i {
		width: 0.4rem;
		height: 0.4rem;
		border: 1px solid var(--kind-color);
		background: color-mix(in srgb, var(--kind-color) 22%, transparent);
	}

	.article-graph__list-meta time {
		white-space: nowrap;
	}

	.article-graph__list-title {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.75rem;
		align-items: start;
		margin-top: 0.55rem;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.4;
		text-decoration: none;
		transition: color var(--duration-fast) var(--ease-rain);
	}

	.article-graph__list-title::after {
		position: absolute;
		inset: -2.1rem -1.15rem -2.7rem;
		content: '';
	}

	.article-graph__list-title span {
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.article-graph__list-title :global(svg) {
		margin-top: 0.15rem;
		color: var(--ink-muted);
		transition: color var(--duration-fast) var(--ease-rain), transform var(--duration-base) var(--ease-rain);
	}

	.article-graph__list li:hover .article-graph__list-title,
	.article-graph__list-title:focus-visible {
		color: var(--accent-strong);
	}

	.article-graph__list li:hover .article-graph__list-title :global(svg),
	.article-graph__list-title:focus-visible :global(svg) {
		color: var(--accent-strong);
		transform: translate(2px, -2px);
	}

	.article-graph__list p {
		margin: 0.5rem 0 0;
		color: var(--ink-muted);
		font-family: var(--font-ui);
		font-size: 0.625rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	/*
	 * 列表视图也要交代关系：窄屏默认停在列表，如果这里只有标签文本，
	 * 手机读者就完全接触不到这个页面独有的信息。
	 */
	.article-graph__list-relations {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.3rem 0.6rem;
		margin-top: 0.6rem;
		padding-top: 0.55rem;
		border-top: 1px dashed color-mix(in srgb, var(--line) 52%, transparent);
	}

	.article-graph__list-relations b {
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		font-weight: 500;
	}

	.article-graph__list-relations span {
		color: var(--ink-muted);
	}

	.article-graph__list-relations em {
		color: var(--line-strong);
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		font-style: normal;
	}

	.article-graph__list-relations.is-empty {
		border-top-style: dotted;
		color: var(--ink-muted);
	}

	.article-graph__empty {
		margin: 0;
		padding: 4rem 1.6rem;
		color: var(--ink-muted);
	}

	@keyframes article-graph-edge-draw {
		from { stroke-dashoffset: 1; }
		to { stroke-dashoffset: 0; }
	}

	@keyframes article-graph-node-in {
		from { opacity: 0; transform: translate(0, 10px); }
		to { opacity: 1; transform: none; }
	}

	@keyframes article-graph-heading-in {
		from { opacity: 0; transform: translateY(-0.45rem); }
		to { opacity: 1; transform: none; }
	}

	@keyframes article-graph-row-in {
		from { opacity: 0; transform: translateY(0.6rem); }
		to { opacity: 1; transform: none; }
	}

	@keyframes article-graph-panel-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes article-graph-panel-in-right {
		from { opacity: 0; transform: translateX(1.35rem) scale(0.992); }
		to { opacity: 1; transform: translateX(0) scale(1); }
	}

	@keyframes article-graph-panel-in-left {
		from { opacity: 0; transform: translateX(-1.35rem) scale(0.992); }
		to { opacity: 1; transform: translateX(0) scale(1); }
	}

	/* 轨道随视口收窄，把宽度让给画布；画布不够宽时靠横向平移，不改变结构。 */
	@media (max-width: 80rem) {
		.article-graph[data-graph-view='graph'] {
			grid-template-columns: minmax(0, 1fr) 13rem;
		}
	}

	@media (max-width: 60rem) {
		.article-graph[data-graph-view='graph'] {
			grid-template-columns: minmax(0, 1fr) 12rem;
		}
	}

	@media (max-width: 47.5rem) {
		/* 手机宽度真的放不下并排：轨道落到画布下方，改用视口比例上限。 */
		.article-graph[data-graph-view='graph'] {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'header'
				'canvas'
				'readout'
				'list';
		}

		.article-graph__readout {
			max-height: 42vh;
			border-top: 1px solid var(--line);
			border-left: 0;
		}

		.article-graph {
			box-shadow: none;
		}

		.article-graph__header {
			align-items: start;
			flex-direction: column;
			gap: 1.25rem;
			padding: 1.25rem;
		}

		.article-graph__meta {
			display: grid;
			grid-template-columns: 1fr;
			width: 100%;
			gap: 1rem;
		}

		.article-graph__stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			border-block: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
		}

		.article-graph__stats > div {
			padding: 0.7rem 0.85rem;
			border-left: 0;
		}

		.article-graph__stats > div + div {
			border-left: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
		}

		.article-graph__views {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		/* 无脚本时也让窄屏优先得到可读列表；脚本就绪后仍可切回完整图谱。 */
		.article-graph:not([data-interactive-ready='true']) .article-graph__canvas {
			display: none;
		}

		.article-graph:not([data-interactive-ready='true']) .article-graph__fallback {
			display: block;
		}

		.article-graph__list {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.article-graph__views::before {
			transition-duration: 1ms;
		}

		.article-graph [data-graph-panel]:not([hidden]) {
			animation: none;
		}

		/*
		 * motion.css 的全局兜底只压 duration 不清 delay，而入场动画用 backwards
		 * 在延迟期间持有起始帧；若这里不清零延迟，减少动态下会看到最长半秒的空图。
		 */
		.article-graph[data-motion-state='drawn'] .article-graph__edges path,
		.article-graph[data-motion-state='drawn'] .article-graph__node,
		.article-graph[data-motion-state='drawn'] .article-graph__band-rail span,
		.article-graph[data-motion-state='drawn'][data-graph-view='list'] .article-graph__list li {
			animation-delay: 0ms !important;
			animation-duration: 1ms !important;
		}

		.article-graph__node:hover,
		.article-graph__node:focus-visible {
			transform: none;
		}
	}
</style>

<style is:global>
	/*
	 * 图谱与列表面板共用一个命名快照，浏览器会在两种容器尺寸之间做几何插值；
	 * 标签选中态由组件内的滑块过渡完成。规则只在脚本写入局部标记时接管，
	 * 避免干扰 Astro 的跨页面转场。
	 */
	html[data-graph-view-transition] .article-graph [data-graph-panel]:not([hidden]) {
		animation: none;
	}

	html[data-graph-view-transition]::view-transition-group(aria7-graph-panel) {
		z-index: 20;
		animation-duration: 580ms;
		animation-timing-function: var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1));
	}

	html[data-graph-view-transition]::view-transition-image-pair(aria7-graph-panel) {
		isolation: isolate;
	}

	html[data-graph-view-transition]::view-transition-old(aria7-graph-panel),
	html[data-graph-view-transition]::view-transition-new(aria7-graph-panel) {
		mix-blend-mode: normal;
	}

	html[data-graph-view-transition='to-list']::view-transition-old(aria7-graph-panel) {
		animation: aria7-graph-panel-out-left 250ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) both;
	}

	html[data-graph-view-transition='to-list']::view-transition-new(aria7-graph-panel) {
		animation: aria7-graph-panel-in-right 430ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) 90ms both;
	}

	html[data-graph-view-transition='to-graph']::view-transition-old(aria7-graph-panel) {
		animation: aria7-graph-panel-out-right 250ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) both;
	}

	html[data-graph-view-transition='to-graph']::view-transition-new(aria7-graph-panel) {
		animation: aria7-graph-panel-in-left 430ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) 90ms both;
	}

	@keyframes aria7-graph-panel-out-left {
		from { opacity: 1; transform: translateX(0) scale(1); }
		to { opacity: 0; transform: translateX(-1.1rem) scale(0.992); }
	}

	@keyframes aria7-graph-panel-in-right {
		from { opacity: 0; transform: translateX(1.35rem) scale(0.992); }
		to { opacity: 1; transform: translateX(0) scale(1); }
	}

	@keyframes aria7-graph-panel-out-right {
		from { opacity: 1; transform: translateX(0) scale(1); }
		to { opacity: 0; transform: translateX(1.1rem) scale(0.992); }
	}

	@keyframes aria7-graph-panel-in-left {
		from { opacity: 0; transform: translateX(-1.35rem) scale(0.992); }
		to { opacity: 1; transform: translateX(0) scale(1); }
	}

	@media (prefers-reduced-motion: reduce) {
		html[data-graph-view-transition]::view-transition-group(aria7-graph-panel) {
			animation-duration: 1ms !important;
			animation-delay: 0ms !important;
		}
	}
</style>

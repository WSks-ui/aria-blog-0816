---
import { ArrowUpRight, ListTree, Network } from '@lucide/astro';
import { POST_KINDS, POST_KIND_LABELS, type PostKind } from '../../data/site';
import { getPostPath, sortPosts, type PostEntry } from '../../lib/content';

interface Props {
	posts: readonly PostEntry[];
	heading?: string;
}

interface GraphNode {
	post: PostEntry;
	kind: PostKind;
	bandIndex: number;
	line: number;
	absoluteLine: number;
	column: number;
	x: number;
	y: number;
	centerX: number;
	centerY: number;
	sequence: number;
	labelLines: string[];
}

interface GraphRelation {
	post: PostEntry;
	kind: PostKind;
	sharedTags: string[];
}

/** 一个内容类型占一条横带：标签在左侧竖栏，文章在带内从左往右排。 */
interface GraphBand {
	kind: PostKind;
	kindIndex: number;
	posts: readonly PostEntry[];
	startLine: number;
	lineCount: number;
}

interface GraphEdge {
	sourceId: string;
	targetId: string;
	path: string;
	sharedTags: string[];
}

const { posts, heading = '文章关系图' } = Astro.props;
const visiblePosts = sortPosts(posts.filter((post) => !post.data.draft));
const graphPosts = [...visiblePosts].sort((left, right) => left.id.localeCompare(right.id));

/*
 * 版面按行组织：每个内容类型是一条横带，类型标签落在左侧竖栏，文章在带内
 * 从左往右排，一行放满 cellsPerRow 张就换到本类型的下一行。
 *
 * 这样做的好处是宽度换高度——札记这类高产类型不再把整张图拉成一条竖带，
 * 画布无需纵向滚动，代价是画布可以横向平移。类型标签用 HTML 侧栏实现
 * （position: sticky; left: 0），横向平移时始终留在视野里。
 */
const cellWidth = 200;
const cellsPerRow = 5;
const nodeWidth = 184;
const nodeHeight = 68;
const rowHeight = 100;
const topPadding = 44;
const bottomPadding = 36;
/* 节点标题的可排宽度（用户单位）：节点宽减去左内边距和右侧留给 N/L 元信息的空间。 */
const labelUnits = 12;

const bands: GraphBand[] = [];
let lineCursor = 0;
for (const [kindIndex, kind] of POST_KINDS.entries()) {
	const posts = graphPosts.filter((post) => post.data.kind === kind);
	if (posts.length === 0) continue;
	const lineCount = Math.ceil(posts.length / cellsPerRow);
	bands.push({ kind, kindIndex, posts, startLine: lineCursor, lineCount });
	lineCursor += lineCount;
}

const totalLines = Math.max(1, lineCursor);
const columnCount = cellsPerRow;
const width = cellsPerRow * cellWidth;
const height = Math.max(280, topPadding + totalLines * rowHeight + bottomPadding);

/*
 * 标题断行：中日韩按 1 个字宽、拉丁与数字按 0.56 估算（接近 13px 字号下
 * Source Serif 与 Space Grotesk 的实际比例），贪心填满一行。断点落在拉丁单词
 * 内部时退到词首，避免把 Linux 拆成「Li / nux」；退让超过四成说明该词本身
 * 放不下，此时仍按字符断，不让短标题被无意义地截短。
 */
const isWideChar = (char: string) =>
	/[\u1100-\u115f\u2e80-\ua4cf\ua960-\ua97f\uac00-\ud7ff\uf900-\ufaff\ufe30-\ufe4f\uff00-\uff60\uffe0-\uffe6]/.test(char);
const isWordChar = (char: string) => /[A-Za-z0-9]/.test(char);
const charUnits = (char: string) => (isWideChar(char) ? 1 : isWordChar(char) ? 0.56 : 0.62);

const fitTitleLines = (title: string, maxUnits: number, maxLines = 2): string[] => {
	const characters = Array.from(title.trim());
	const lines: string[] = [];
	let index = 0;

	while (index < characters.length && lines.length < maxLines) {
		let used = 0;
		let end = index;
		while (end < characters.length && used + charUnits(characters[end]) <= maxUnits) {
			used += charUnits(characters[end]);
			end += 1;
		}

		if (end < characters.length && isWordChar(characters[end]) && isWordChar(characters[end - 1])) {
			let wordStart = end;
			while (wordStart > index && isWordChar(characters[wordStart - 1])) wordStart -= 1;
			if (wordStart > index && wordStart - index >= maxUnits * 0.55) end = wordStart;
		}

		if (end <= index) break;
		const rest = characters.slice(index, end).join('');
		const isLastLine = lines.length === maxLines - 1;
		lines.push(isLastLine && end < characters.length ? `${rest}…` : rest);
		index = end;
	}

	return lines.length > 0 ? lines : [''];
};

const nodes: GraphNode[] = bands.flatMap((band) =>
	band.posts.map((post, index) => {
		const line = Math.floor(index / cellsPerRow);
		const column = index % cellsPerRow;
		const x = column * cellWidth + (cellWidth - nodeWidth) / 2;
		const y = topPadding + (band.startLine + line) * rowHeight + (rowHeight - nodeHeight) / 2;
		return {
			post,
			kind: band.kind,
			bandIndex: band.kindIndex,
			line,
			absoluteLine: band.startLine + line,
			column,
			x,
			y,
			centerX: x + nodeWidth / 2,
			centerY: y + nodeHeight / 2,
			/* 序号在类型内连续，换行也接着数下去（N01…N10）。 */
			sequence: index + 1,
			labelLines: fitTitleLines(post.data.title, labelUnits),
		};
	}),
);

const normalizeTag = (tag: string) => tag.trim().toLocaleLowerCase();

/*
 * 先按标签建立倒排索引，再只组合确实共享标签的文章。文章持续增加时，这能避开
 * “每两篇文章都重建一次标签 Set”的全量比较。倒排阶段可对单篇文章的同义标签
 * 去重；边真正生成时仍按原算法从 source 文章取标签，保留其大小写、次序与重复项。
 */
const tagIndex = new Map<string, number[]>();
nodes.forEach((node, nodeIndex) => {
	const seenTags = new Set<string>();
	for (const label of node.post.data.tags) {
		const key = normalizeTag(label);
		if (!key || seenTags.has(key)) continue;
		seenTags.add(key);
		const indexedNodes = tagIndex.get(key);
		if (indexedNodes) indexedNodes.push(nodeIndex);
		else tagIndex.set(key, [nodeIndex]);
	}
});

const indexedEdges = new Map<string, {
	sourceIndex: number;
	targetIndex: number;
}>();

for (const nodeIndexes of tagIndex.values()) {
	for (let sourceOffset = 0; sourceOffset < nodeIndexes.length; sourceOffset += 1) {
		for (let targetOffset = sourceOffset + 1; targetOffset < nodeIndexes.length; targetOffset += 1) {
			const sourceIndex = nodeIndexes[sourceOffset];
			const targetIndex = nodeIndexes[targetOffset];
			const pairKey = `${sourceIndex}:${targetIndex}`;
			if (!indexedEdges.has(pairKey)) indexedEdges.set(pairKey, { sourceIndex, targetIndex });
		}
	}
}

/*
 * 同一条基线控制点上的边按出现次序上下散开：8 篇互相共享标签的文章会产生
 * 28 条同带边，若共用同一个控制点就会叠成一根实心横绳，读者只能看到「一束」，
 * 看不到「几根」。散开后这些边成为可分辨的伞骨，跨带扇出同理。
 */
const controlSpread = new Map<string, number>();

const edges: GraphEdge[] = [...indexedEdges.values()].map(({ sourceIndex, targetIndex }) => {
	const source = nodes[sourceIndex];
	const target = nodes[targetIndex];
	const targetTags = new Set(target.post.data.tags.map(normalizeTag));
	const sharedTags = [...new Set(source.post.data.tags.filter((tag) => targetTags.has(normalizeTag(tag))))];
	const sameBand = source.bandIndex === target.bandIndex;
	const baseControlY = sameBand
		? Math.max(source.centerY, target.centerY) + rowHeight * 0.46
		: (source.centerY + target.centerY) / 2;
	const groupKey = `${sameBand ? 'band' : 'cross'}:${Math.round(baseControlY)}`;
	const ordinal = controlSpread.get(groupKey) ?? 0;
	controlSpread.set(groupKey, ordinal + 1);
	const controlY = baseControlY + ((ordinal % 9) - 4) * rowHeight * 0.055;
	return {
		// 两个 id 分存两个属性，不靠分隔符拼串：id 本身含任何字符都不会解析错位。
		sourceId: source.post.id,
		targetId: target.post.id,
		path: [
			`M ${source.centerX.toFixed(2)} ${source.centerY.toFixed(2)}`,
			`C ${source.centerX.toFixed(2)} ${controlY.toFixed(2)},`,
			`${target.centerX.toFixed(2)} ${controlY.toFixed(2)},`,
			`${target.centerX.toFixed(2)} ${target.centerY.toFixed(2)}`,
		].join(' '),
		sharedTags,
	};
});

const connectionCounts = new Map<string, number>();
for (const edge of edges) {
	connectionCounts.set(edge.sourceId, (connectionCounts.get(edge.sourceId) ?? 0) + 1);
	connectionCounts.set(edge.targetId, (connectionCounts.get(edge.targetId) ?? 0) + 1);
}

/*
 * 每篇文章的关联清单（含共享标签）。图谱侧的「为什么相连」由运行时从边的
 * data-edge-tags 读出，列表侧无法悬停，因此在构建期就把同一份关系渲染成
 * 一句话摘要，两种视图表达的关系必须一致。
 */
const nodeByPostId = new Map(nodes.map((node) => [node.post.id, node]));
const sequenceByPostId = new Map(nodes.map((node) => [node.post.id, node.sequence]));
const relationsByPost = new Map<string, GraphRelation[]>();

const addRelation = (fromId: string, target: GraphNode, sharedTags: string[]) => {
	const relation: GraphRelation = { post: target.post, kind: target.kind, sharedTags };
	const list = relationsByPost.get(fromId);
	if (list) list.push(relation);
	else relationsByPost.set(fromId, [relation]);
};

for (const edge of edges) {
	const source = nodeByPostId.get(edge.sourceId);
	const target = nodeByPostId.get(edge.targetId);
	if (!source || !target) continue;
	addRelation(edge.sourceId, target, edge.sharedTags);
	addRelation(edge.targetId, source, edge.sharedTags);
}

/* 关联按共享标签数量排序，其次沿用全站时间顺序，保证每次构建结果一致。 */
relationsByPost.forEach((relations) => {
	relations.sort((left, right) => {
		const sharedDelta = right.sharedTags.length - left.sharedTags.length;
		if (sharedDelta !== 0) return sharedDelta;
		const publishedDelta = right.post.data.publishedAt.getTime() - left.post.data.publishedAt.getTime();
		return publishedDelta !== 0 ? publishedDelta : left.post.id.localeCompare(right.post.id);
	});
});

/** 一篇与其关联文章之间出现频次最高的共享标签，用于列表视图的一句话摘要。 */
const summarizeSharedTags = (relations: readonly GraphRelation[]) => {
	const counts = new Map<string, { label: string; count: number }>();
	for (const relation of relations) {
		for (const label of relation.sharedTags) {
			const key = normalizeTag(label);
			const current = counts.get(key);
			counts.set(key, { label: current?.label ?? label, count: (current?.count ?? 0) + 1 });
		}
	}
	return [...counts.values()]
		.sort((left, right) => right.count - left.count || left.label.localeCompare(right.label, 'zh-CN'))
		.slice(0, 3);
};

const isIsolatedPost = (postId: string) => (connectionCounts.get(postId) ?? 0) === 0;

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'UTC',
});
const formatDate = (date: Date) => dateFormatter.format(date).replaceAll('/', '.');

/* 超过这个规模时全图通常已经难以直接阅读，桌面首屏改用列表，但不移除图谱入口。 */
const defaultDesktopView = nodes.length > 50 || edges.length > 800 ? 'list' : 'graph';

const kindColors = {
	essay: '#1887aa',
	note: '#55757e',
	project: '#b87368',
	photo: '#668570',
	code: '#506784',
	tutorial: '#8a7650',
} as const satisfies Record<PostKind, string>;
---

<section
	class="article-graph"
	data-article-graph
	data-graph-view={defaultDesktopView}
	data-graph-default-view={defaultDesktopView}
	aria-labelledby="article-graph-title"
>
	<header class="article-graph__header">
		<div class="article-graph__intro">
			{heading
				? <h2 id="article-graph-title">{heading}</h2>
				: <h2 id="article-graph-title" class="sr-only">按共享标签形成的文章关系</h2>}
			{/*
			 * 图例是这张图能被读懂的前提：N##/L## 与曲线含义此前只存在于作者脑中，
			 * 读者只能看到一串无解释的代号。
			 */}
			<ul class="article-graph__legend">
				<li><i class="article-graph__legend-kind" aria-hidden="true"></i>行 = 内容类型，超过 5 篇换行</li>
				<li><i class="article-graph__legend-edge" aria-hidden="true"></i>曲线 = 共享标签，越粗共享越多</li>
				<li>
					<code>N05</code> 类型内序号
					<span aria-hidden="true">·</span>
					<code>L07</code> 关联篇数
				</li>
				<li><i class="article-graph__legend-dashed" aria-hidden="true"></i>虚线框 = 暂无关联</li>
			</ul>
		</div>
		<div class="article-graph__meta">
			<dl class="article-graph__stats" aria-label="关系图统计">
				<div>
					<dt>ARTICLES</dt>
					<dd data-count-to={visiblePosts.length}>{String(visiblePosts.length).padStart(2, '0')}</dd>
				</div>
				<div>
					<dt>LINKS</dt>
					<dd data-count-to={edges.length}>{String(edges.length).padStart(2, '0')}</dd>
				</div>
			</dl>
			{visiblePosts.length > 0 && <div class="article-graph__views" role="tablist" aria-label="关系图视图">
				<button
					id="article-graph-tab-graph"
					type="button"
					role="tab"
					aria-selected={defaultDesktopView === 'graph' ? 'true' : 'false'}
					aria-controls="article-graph-panel-graph"
					tabindex={defaultDesktopView === 'graph' ? '0' : '-1'}
					data-graph-view-button="graph"
				>
					<Network size={15} stroke-width={1.6} aria-hidden="true" />
					<span>图谱</span>
				</button>
				<button
					id="article-graph-tab-list"
					type="button"
					role="tab"
					aria-selected={defaultDesktopView === 'list' ? 'true' : 'false'}
					aria-controls="article-graph-panel-list"
					tabindex={defaultDesktopView === 'list' ? '0' : '-1'}
					data-graph-view-button="list"
				>
					<ListTree size={15} stroke-width={1.6} aria-hidden="true" />
					<span>列表</span>
				</button>
			</div>}
		</div>
	</header>
	<p id="article-graph-navigation-hint" class="sr-only">
		图谱可以横向和纵向滚动；聚焦任一节点会高亮它的连线，并在关系轨道里读出共享标签与关联文章。
	</p>

	{visiblePosts.length > 0 ? (
		<>
			<div
				id="article-graph-panel-graph"
				class="article-graph__canvas"
				data-graph-panel="graph"
				tabindex="0"
				role="tabpanel"
				aria-labelledby="article-graph-tab-graph"
				aria-describedby="article-graph-navigation-hint"
			>
				{/* 哨兵：滚出画布顶部即给类型栏加抬起阴影，不用裸挂 scroll 监听。 */}
				<div class="article-graph__scroll-sentinel" data-graph-sentinel aria-hidden="true"></div>
				{/*
				 * 左侧类型栏与画布是同一个 CSS grid 的两列（见 .article-graph__canvas）。
				 * grid-template-rows 直接映射 SVG 的 topPadding / rowHeight / bottomPadding
				 * 比例，因此标签与横带永远对齐；sticky left 让它在横向平移时留在视野里。
				 */}
				<div
					class="article-graph__band-rail"
					aria-hidden="true"
					style={`grid-template-rows: ${topPadding}fr repeat(${totalLines}, ${rowHeight}fr) ${bottomPadding}fr`}
				>
					{bands.map((band) => (
						<span
							style={`--kind-color: ${kindColors[band.kind]}; --band-order: ${band.kindIndex}; grid-row: ${band.startLine + 2} / span ${band.lineCount}`}
						>
							<i></i>
							<b>{POST_KIND_LABELS[band.kind]}</b>
							<small>{String(band.posts.length).padStart(2, '0')}</small>
						</span>
					))}
				</div>
				<div class="article-graph__stage">
					<svg
						viewBox={`0 0 ${width} ${height}`}
						data-graph-svg
						role="group"
						aria-label="文章关系图，连线表示两篇文章拥有相同标签"
					>
						<g class="article-graph__bands" aria-hidden="true">
							{bands.map((band) => (
								<rect
									/* 底色按类型奇偶交替：一条横带一个底色。 */
									class:list={[band.kindIndex % 2 === 1 && 'is-tinted']}
									x="0"
									y={topPadding + band.startLine * rowHeight}
									width={width}
									height={band.lineCount * rowHeight}
								/>
							))}
						</g>
						<g class="article-graph__guides" aria-hidden="true">
							{bands.map((band) => {
								const guideY = topPadding + (band.startLine + band.lineCount) * rowHeight;
								return <line x1="0" y1={guideY} x2={width} y2={guideY} />;
							})}
						</g>

						<g class="article-graph__edges" aria-hidden="true">
							{/*
							 * pathLength="1" 把每条曲线的总长归一化成 1，CSS 才能用同一个
							 * stroke-dashoffset 关键帧让所有连线自绘，不必逐条测量长度。
							 * --edge-order 决定自绘顺序，按生成次序依次铺开。
							 */}
							{edges.map((edge, edgeIndex) => (
								<path
									data-edge-source={edge.sourceId}
									data-edge-target={edge.targetId}
									data-edge-tags={JSON.stringify(edge.sharedTags)}
									d={edge.path}
									pathLength="1"
									style={`--edge-order: ${edgeIndex}`}
									stroke-width={0.7 + Math.min(3, edge.sharedTags.length) * 0.45}
								/>
							))}
						</g>

						<g class="article-graph__nodes">
							{nodes.map((node) => (
								<a
									class="article-graph__node"
									href={getPostPath(node.post)}
									data-article-transition-link
									data-node-key={node.post.id}
									data-node-title={node.post.data.title}
									data-node-kind={POST_KIND_LABELS[node.kind]}
									data-node-tags={JSON.stringify(node.post.data.tags)}
									data-node-index={`N${String(node.sequence).padStart(2, '0')}`}
									data-node-links={`L${String(connectionCounts.get(node.post.id) ?? 0).padStart(2, '0')}`}
									data-isolated={isIsolatedPost(node.post.id) ? 'true' : undefined}
									/* 入场按「先行后列」推进，读起来像伞骨自左向右张开。 */
									style={`--node-order: ${node.absoluteLine * 3 + node.column}`}
									tabindex="0"
									aria-label={`${node.post.data.title}，${POST_KIND_LABELS[node.kind]}${isIsolatedPost(node.post.id) ? '，暂无关联' : ''}`}
								>
									<title>{node.post.data.title}；标签：{node.post.data.tags.join('、')}</title>
									<rect
										class="article-graph__focus-ring"
										x={node.x - 4}
										y={node.y - 4}
										width={nodeWidth + 8}
										height={nodeHeight + 8}
										rx="6"
									/>
									<rect
										class="article-graph__node-surface"
										x={node.x}
										y={node.y}
										width={nodeWidth}
										height={nodeHeight}
										rx="4"
									/>
									<rect
										class="article-graph__node-accent"
										x={node.x}
										y={node.y}
										width="4"
										height={nodeHeight}
										fill={kindColors[node.kind]}
									/>
									<text class="article-graph__node-label" x={node.x + 16} y={node.y + 24}>
										{node.labelLines.map((line, lineIndex) => (
											<tspan x={node.x + 16} dy={lineIndex === 0 ? 0 : 17}>{line}</tspan>
										))}
									</text>
									<text
										class="article-graph__node-meta"
										x={node.x + nodeWidth - 11}
										y={node.y + nodeHeight - 9}
										text-anchor="end"
										aria-hidden="true"
									>
										N{String(node.sequence).padStart(2, '0')} · L{String(connectionCounts.get(node.post.id) ?? 0).padStart(2, '0')}
									</text>
								</a>
							))}
						</g>
					</svg>
				</div>
			</div>

			{/*
			 * 关系轨道：把「哪几篇、因为哪个标签相连」从连线里取出来变成文字。
			 * 放在画布右侧固定宽度的一列，内容再长也只在自己列内滚动，因此组件
			 * 高度只由画布决定——切换文章不会改变页面高度。aria-live 让键盘用户
			 * 聚焦节点时同样能拿到这份信息。
			 */}
			<aside class="article-graph__readout" data-graph-readout data-readout-state="idle" aria-live="polite">
				<p class="article-graph__readout-idle" data-readout-idle>
					悬停或聚焦任一节点，这根轨道会列出它的关联文章与共享标签；轨道里的条目可以直接点开。
				</p>
				<div class="article-graph__readout-body" data-readout-body>
					<div class="article-graph__readout-clip" data-readout-clip></div>
				</div>
			</aside>

			<section
				id="article-graph-panel-list"
				class="article-graph__fallback"
				data-graph-panel="list"
				role="tabpanel"
				aria-labelledby="article-graph-tab-list"
				tabindex="0"
			>
				<ul class="article-graph__list">
					{visiblePosts.map((post, rowIndex) => {
						const relations = relationsByPost.get(post.id) ?? [];
						const sharedTags = summarizeSharedTags(relations);
						return (
							/* 错峰上限 14 行：文章变多时总延时不会跟着无限增长。 */
							<li style={`--kind-color: ${kindColors[post.data.kind]}; --row-order: ${Math.min(rowIndex, 14)}`}>
								{/* 与图谱共用同一个类型内序号，切换视图时同一篇文章的编号不变。 */}
								<span class="article-graph__list-index" aria-hidden="true">
									{String(sequenceByPostId.get(post.id) ?? 0).padStart(2, '0')}
								</span>
								<div class="article-graph__list-body">
									<div class="article-graph__list-meta">
										<small><i aria-hidden="true"></i>{POST_KIND_LABELS[post.data.kind]}</small>
										<time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
									</div>
									<a class="article-graph__list-title" href={getPostPath(post)} data-article-transition-link>
										<span>{post.data.title}</span>
										<ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
									</a>
									<p class="article-graph__list-tags">{post.data.tags.map((tag) => `#${tag}`).join(' ')}</p>
									{relations.length > 0 ? (
										<p class="article-graph__list-relations">
											<b>关联 {relations.length} 篇</b>
											<span>
												{relations.slice(0, 2).map((relation) => relation.post.data.title).join('、')}
												{relations.length > 2 ? ' 等' : ''}
											</span>
											<em>共享 {sharedTags.map((tag) => `${tag.label} ×${tag.count}`).join('、')}</em>
										</p>
									) : (
										<p class="article-graph__list-relations is-empty">暂无共享标签的关联文章</p>
									)}
								</div>
							</li>
						);
					})}
				</ul>
			</section>
		</>
	) : (
		<p class="article-graph__empty">尚无已发布文章。</p>
	)}
</section>

<script>
  function initArticleGraphs() {
    document.querySelectorAll<HTMLElement>('[data-article-graph]').forEach((root) => {
      if (root.dataset.interactiveReady === 'true') return;
      root.dataset.interactiveReady = 'true';

      type GraphView = 'graph' | 'list';
      const isGraphView = (value: string | undefined): value is GraphView => value === 'graph' || value === 'list';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-graph-view-button]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-graph-panel]'));
      const svg = root.querySelector<SVGSVGElement>('[data-graph-svg]');
      const viewportQuery = window.matchMedia('(max-width: 47.5rem)');
      const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const viewportController = new AbortController();
      const motionController = new AbortController();
      let graphReady = false;
      let userSelectedView = false;
      let activeViewTransition: ViewTransition | null = null;

      const transitionNameRestore = new Map<HTMLElement, string>();
      const setTransitionName = (element: HTMLElement | null, name: string) => {
        if (!element) return;
        if (!transitionNameRestore.has(element)) {
          transitionNameRestore.set(element, element.style.viewTransitionName);
        }
        element.style.viewTransitionName = name;
      };

      const clearTransitionNames = () => {
        transitionNameRestore.forEach((name, element) => {
          if (name) element.style.viewTransitionName = name;
          else element.style.removeProperty('view-transition-name');
        });
        transitionNameRestore.clear();
        root.dataset.graphViewDirection = 'settled';
        delete document.documentElement.dataset.graphViewTransition;
        activeViewTransition = null;
      };

      const setupGraph = () => {
        if (graphReady || !svg) return;
        graphReady = true;

        const nodes = Array.from(svg.querySelectorAll<SVGAElement>('[data-node-key]'));
        const edges = Array.from(svg.querySelectorAll<SVGPathElement>('[data-edge-source][data-edge-target]'));
        if (nodes.length === 0) return;

        /*
         * 每个节点只保存自己的边；切换高亮时仅清理上一组并写入下一组，不再为
         * 一次 pointerover 扫描整张图。文章和边越多，这个差异越明显。
         */
        const nodeByKey = new Map(nodes.map((node) => [node.dataset.nodeKey ?? '', node]));
        const edgesByNode = new Map<string, SVGPathElement[]>();
        const linkEdge = (key: string, edge: SVGPathElement) => {
          const linkedEdges = edgesByNode.get(key);
          if (linkedEdges) linkedEdges.push(edge);
          else edgesByNode.set(key, [edge]);
        };
        edges.forEach((edge) => {
          const { edgeSource, edgeTarget } = edge.dataset;
          if (!edgeSource || !edgeTarget) return;
          linkEdge(edgeSource, edge);
          linkEdge(edgeTarget, edge);
        });

        let activeKey: string | null = null;
        let activeEdges: SVGPathElement[] = [];
        let relatedNodes: SVGAElement[] = [];
        let activeNode: SVGAElement | null = null;

        const readout = root.querySelector<HTMLElement>('[data-graph-readout]');
        const readoutClip = root.querySelector<HTMLElement>('[data-readout-clip]');

        const createEl = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) => {
          const element = document.createElement(tag);
          element.className = className;
          if (text !== undefined) element.textContent = text;
          return element;
        };

        /* 读数条动画的时长与缓动一次性从 tokens.css 读出来，避免每次切换都读样式。 */
        const readoutMotion = (() => {
          const styles = getComputedStyle(root);
          return {
            duration: Number.parseFloat(styles.getPropertyValue('--duration-base')) || 260,
            easing: styles.getPropertyValue('--ease-rain').trim() || 'cubic-bezier(0.22, 0.75, 0.28, 1)',
          };
        })();

        /*
         * 关系读数完全由已经渲染在 DOM 里的数据拼装：边的 data-edge-tags 是共享
         * 标签，节点的 data-node-* 是标题与类型。不再额外输出一份 JSON，同一事实
         * 只存一处，避免两份数据日后互相漂移。
         */
        /*
         * 读数条是常驻详情面板，不是悬停气泡：悬停/聚焦只切换它显示哪一篇。
         * 因此这里只处理「有目标」的情况，取消高亮不再清空内容。
         */
        const renderReadout = (key: string) => {
          if (!readout || !readoutClip) return;

          const node = nodeByKey.get(key);
          if (!node) return;

          const relations = (edgesByNode.get(key) ?? [])
            .map((edge) => {
              const otherKey = edge.dataset.edgeSource === key ? edge.dataset.edgeTarget : edge.dataset.edgeSource;
              const other = otherKey ? nodeByKey.get(otherKey) : undefined;
              let sharedTags: string[] = [];
              try {
                const parsed: unknown = JSON.parse(edge.dataset.edgeTags ?? '[]');
                if (Array.isArray(parsed)) sharedTags = parsed.filter((tag): tag is string => typeof tag === 'string');
              } catch {
                sharedTags = [];
              }
              return other ? { node: other, sharedTags } : null;
            })
            .filter((relation): relation is { node: SVGAElement; sharedTags: string[] } => relation !== null)
            .sort((left, right) =>
              right.sharedTags.length - left.sharedTags.length
              || (left.node.dataset.nodeTitle ?? '').localeCompare(right.node.dataset.nodeTitle ?? '', 'zh-CN'));

          const tagCounts = new Map<string, number>();
          relations.forEach((relation) => {
            relation.sharedTags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
          });
          const topTags = [...tagCounts.entries()]
            .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0], 'zh-CN'));

          /*
           * 逐条只标注「区别于整体」的标签：出现在过半关联里的标签属于这一簇的
           * 共同底色，已经在上面那行汇总里说过一次，每条再抄一遍「Linux · 学习笔记」
           * 只是噪声。阈值取严格过半，这样两篇各走不同标签时仍能看出一对一映射。
           */
          const dominantThreshold = Math.ceil((relations.length + 1) / 2);
          const isDominantTag = (tag: string) => (tagCounts.get(tag) ?? 0) >= dominantThreshold;

          /* 轨道头部：沿用节点卡片那套 HUD 编码（类型内序号 / 类型 / 关联篇数）。 */
          const head = createEl('div', 'article-graph__readout-head');
          const hud = createEl('p', 'article-graph__readout-hud');
          hud.append(
            createEl('b', 'article-graph__readout-hud-index', node.dataset.nodeIndex ?? ''),
            createEl('span', 'article-graph__readout-kind', node.dataset.nodeKind ?? ''),
            createEl('i', 'article-graph__readout-hud-links', node.dataset.nodeLinks ?? ''),
          );
          head.append(hud, createEl('strong', 'article-graph__readout-title', node.dataset.nodeTitle ?? ''));

          const body: HTMLElement[] = [head];
          if (relations.length === 0) {
            body.push(createEl('p', 'article-graph__readout-empty', '这篇文章的标签暂未出现在其他文章里，因此它没有连线。换一个更常见的标签即可与其他文章建立关联。'));
          } else {
            body.push(createEl(
              'p',
              'article-graph__readout-tags',
              `共享标签：${topTags.slice(0, 5).map(([tag, count]) => `${tag} ×${count}`).join('、')}`
                + (topTags.length > 5 ? ` 等 ${topTags.length} 个` : ''),
            ));
            const list = createEl('ul', 'article-graph__readout-list');
            relations.slice(0, 8).forEach((relation) => {
              const ownTags = relation.sharedTags.filter((tag) => !isDominantTag(tag));
              const item = document.createElement('li');
              // --rib-weight 决定伞骨短横的粗细：与画布上曲线线宽同一套编码。
              item.style.setProperty('--rib-weight', String(relation.sharedTags.length));
              /*
               * 条目直接可点：轨道在侧栏里是独立区域，不存在和整卡点击区嵌套的问题。
               * data-relation-key 让轨道反向联动——悬停条目时画布上对应的节点与连线
               * 一并高亮，读者不必回到图上再找一遍。
               */
              const link = createEl('a', 'article-graph__readout-link', relation.node.dataset.nodeTitle ?? '');
              link.href = relation.node.getAttribute('href') ?? '#';
              link.setAttribute('data-article-transition-link', '');
              item.dataset.relationKey = relation.node.dataset.nodeKey ?? '';
              item.append(link);
              // 没有区分度就只留标题，不再重复共同标签。
              if (ownTags.length > 0) {
                item.append(createEl('em', 'article-graph__readout-shared', ownTags.join(' · ')));
              }
              list.append(item);
            });
            body.push(list);
            if (relations.length > 8) {
              body.push(createEl('p', 'article-graph__readout-more', `另有 ${relations.length - 8} 篇关联文章未列出`));
            }
          }

          readoutClip.replaceChildren(...body);
          root.dataset.readoutState = 'filled';
          // 换成另一篇时轨道回到顶部，否则会停在上一条长列表的滚动位置。
          readout.scrollTop = 0;

          if (reduceMotionQuery.matches) return;

          /*
           * 内容淡入走 WAAPI，而不是「摘类 + 强制回流 + 挂类」：后者每次切换节点
           * 都同步触发布局，鼠标在节点间快速扫过时会掉帧。时长与缓动仍取自
           * tokens.css；减少动态时直接跳过——全局兜底只压 CSS 动画，管不到 WAAPI。
           */
          readoutClip.animate(
            [{ opacity: 0, transform: 'translateY(0.35rem)' }, { opacity: 1, transform: 'none' }],
            { duration: readoutMotion.duration, easing: readoutMotion.easing },
          );
        };

        const highlight = (key: string | null, syncReadout = true) => {
          if (key === activeKey) return;
          activeEdges.forEach((edge) => delete edge.dataset.active);
          relatedNodes.forEach((node) => delete node.dataset.related);
          if (activeNode) delete activeNode.dataset.active;
          activeEdges = [];
          relatedNodes = [];
          activeNode = null;
          activeKey = key;

          if (key === null) {
            delete svg.dataset.focusKey;
            return;
          }

          svg.dataset.focusKey = key;
          activeEdges = edgesByNode.get(key) ?? [];
          const relatedKeys = new Set([key]);
          activeEdges.forEach((edge) => {
            edge.dataset.active = 'true';
            if (edge.dataset.edgeSource) relatedKeys.add(edge.dataset.edgeSource);
            if (edge.dataset.edgeTarget) relatedKeys.add(edge.dataset.edgeTarget);
          });
          relatedNodes = [...relatedKeys]
            .map((relatedKey) => nodeByKey.get(relatedKey))
            .filter((node): node is SVGAElement => Boolean(node));
          relatedNodes.forEach((node) => { node.dataset.related = 'true'; });
          activeNode = nodeByKey.get(key) ?? null;
          if (activeNode) activeNode.dataset.active = 'true';
          /*
           * 轨道内部的悬停只联动画布，不换轨道内容：否则鼠标沿着列表往下扫时，
           * 列表会在指针底下被替换成另一篇的关系，条目根本点不到。
           */
          if (syncReadout) renderReadout(key);
        };

        /*
         * 指针事件挂在整块组件而不是 SVG 上：读数条就在画布下方，若沿用
         * svg 的 pointerleave，鼠标一离开文章块（哪怕只是移向读数条）就会
         * 收起，汇总行永远读不完。现在移出组件才取消高亮，读数条本身常驻。
         */
        root.addEventListener('pointerover', (event) => {
          const target = event.target as Element | null;
          const node = target?.closest?.('[data-node-key]');
          if (node) {
            highlight(node.getAttribute('data-node-key'));
            return;
          }
          // 轨道条目反向联动：指向关联文章时，画布上同步高亮那一个节点。
          const entry = target?.closest?.('[data-relation-key]');
          if (entry) highlight(entry.getAttribute('data-relation-key'), false);
        });
        root.addEventListener('pointerleave', () => highlight(null));
        // 键盘聚焦节点时给出同样的关系预览；聚焦轨道条目时只联动画布。
        root.addEventListener('focusin', (event) => {
          const target = event.target as Element | null;
          const node = target?.closest?.('[data-node-key]');
          if (node) {
            highlight(node.getAttribute('data-node-key'));
            return;
          }
          const entry = target?.closest?.('[data-relation-key]');
          if (entry) highlight(entry.getAttribute('data-relation-key'), false);
        });
        root.addEventListener('focusout', () => window.setTimeout(() => {
          if (!root.contains(document.activeElement)) highlight(null);
        }, 0));
      };

      /*
       * 入场编排统一由 root 上的 data-motion-state 驱动：连线自绘、节点错峰、
       * 列头起笔都是纯 CSS 动画，JS 只负责在整块关系图进入视口时打开开关。
       * 已经绘制过后不再重放，避免每次切换视图都重新演一遍。
       */
      const motionFrames: number[] = [];

      const runStatCountUp = () => {
        if (reduceMotionQuery.matches) return;
        root.querySelectorAll<HTMLElement>('[data-count-to]').forEach((element) => {
          const target = Number(element.dataset.countTo ?? '0');
          if (!Number.isFinite(target) || target <= 0) return;
          // HUD 计数刻意比 --duration-slow 更短促：它是读数，不是演出。
          const duration = 420;
          const startedAt = performance.now();
          element.textContent = '00';
          const step = (now: number) => {
            const progress = Math.min(1, (now - startedAt) / duration);
            const eased = 1 - (1 - progress) ** 3;
            element.textContent = String(Math.round(target * eased)).padStart(2, '0');
            if (progress < 1) motionFrames.push(window.requestAnimationFrame(step));
            else element.textContent = String(target).padStart(2, '0');
          };
          motionFrames.push(window.requestAnimationFrame(step));
        });
      };

      const setupMotion = () => {
        if (root.dataset.motionReady === 'true') return;
        root.dataset.motionReady = 'true';

        const canvas = root.querySelector<HTMLElement>('.article-graph__canvas');
        const sentinel = root.querySelector<HTMLElement>('[data-graph-sentinel]');

        if (typeof IntersectionObserver !== 'function') {
          root.dataset.motionState = 'drawn';
          runStatCountUp();
          return;
        }

        const revealObserver = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          root.dataset.motionState = 'drawn';
          runStatCountUp();
          revealObserver.disconnect();
        }, { threshold: 0.15 });
        revealObserver.observe(root);
        motionController.signal.addEventListener('abort', () => revealObserver.disconnect());

        // 画布内滚动时列头抬起：用哨兵替代裸 scroll 监听，零滚动回调。
        if (canvas && sentinel) {
          const scrollObserver = new IntersectionObserver((entries) => {
            const [entry] = entries;
            if (!entry) return;
            if (entry.isIntersecting) delete root.dataset.canvasScrolled;
            else root.dataset.canvasScrolled = 'true';
          }, { root: canvas, threshold: 0 });
          scrollObserver.observe(sentinel);
          motionController.signal.addEventListener('abort', () => scrollObserver.disconnect());
        }

        /*
         * 关系轨道的高度锁死在画布高度上：组件总高因此只由画布决定，切换文章
         * 时页面高度不变，也就不会冒出滚动条或触发滚动锚定——命中判定跟着稳定。
         * 只有手机宽度轨道才落到画布下方，那时交回 CSS 的视口比例上限。
         */
        const rail = root.querySelector<HTMLElement>('[data-graph-readout]');
        if (canvas && rail && typeof ResizeObserver === 'function') {
          const stackedQuery = window.matchMedia('(max-width: 47.5rem)');
          const syncRailHeight = () => {
            if (stackedQuery.matches) rail.style.removeProperty('max-height');
            else rail.style.maxHeight = `${Math.round(canvas.getBoundingClientRect().height)}px`;
          };
          const railObserver = new ResizeObserver(syncRailHeight);
          railObserver.observe(canvas);
          syncRailHeight();
          motionController.signal.addEventListener('abort', () => railObserver.disconnect());
        }
      };

      const setView = (view: GraphView, focusTab = false) => {
        root.dataset.graphView = view;
        tabs.forEach((tab) => {
          const selected = tab.dataset.graphViewButton === view;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          if (selected && focusTab) tab.focus();
        });
        panels.forEach((panel) => {
          const selected = panel.dataset.graphPanel === view;
          panel.hidden = !selected;
          panel.inert = !selected;
        });
        // 手机默认停在列表，不为不可见 SVG 建邻接索引；用户切到图谱时再初始化。
        if (view === 'graph') setupGraph();
      };

      const switchView = (view: GraphView, focusTab = false) => {
        const currentView: GraphView = root.dataset.graphView === 'list' ? 'list' : 'graph';
        if (currentView === view) {
          if (focusTab) tabs.find((tab) => tab.dataset.graphViewButton === view)?.focus();
          return;
        }

        if (activeViewTransition) {
          // 快速重复操作不叠加快照；焦点仍留在当前选中标签，保持 tablist 状态一致。
          tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')?.focus({ preventScroll: true });
          return;
        }
        if (reduceMotionQuery.matches) {
          root.dataset.graphViewDirection = 'settled';
          setView(view, focusTab);
          return;
        }
        if (typeof document.startViewTransition !== 'function') {
          // WebView 等无原生共享元素能力的环境，仍保留方向性面板与标签滑动反馈。
          root.dataset.graphViewDirection = view === 'list' ? 'to-list' : 'to-graph';
          setView(view, focusTab);
          return;
        }

        const sourcePanel = panels.find((panel) => panel.dataset.graphPanel === currentView) ?? null;
        const targetPanel = panels.find((panel) => panel.dataset.graphPanel === view) ?? null;
        if (!sourcePanel || !targetPanel) {
          setView(view, focusTab);
          return;
        }

        const pageMain = root.closest<HTMLElement>('[data-page-main]');
        root.dataset.graphViewDirection = view === 'list' ? 'to-list' : 'to-graph';
        document.documentElement.dataset.graphViewTransition = view === 'list' ? 'to-list' : 'to-graph';
        // 页面级 main 默认拥有 Astro 换页名称；局部切换时临时摘名，避免整页跟着位移。
        setTransitionName(pageMain, 'none');
        setTransitionName(sourcePanel, 'aria7-graph-panel');

        try {
          const transition = document.startViewTransition(() => {
            setView(view, focusTab);
            setTransitionName(targetPanel, 'aria7-graph-panel');
          });
          activeViewTransition = transition;
          transition.finished.catch(() => undefined).finally(() => {
            if (activeViewTransition === transition) clearTransitionNames();
          });
        } catch {
          clearTransitionNames();
          root.dataset.graphViewDirection = view === 'list' ? 'to-list' : 'to-graph';
          setView(view, focusTab);
        }
      };

      tabs.forEach((tab, tabIndex) => {
        tab.addEventListener('click', () => {
          const view = tab.dataset.graphViewButton;
          if (isGraphView(view)) {
            userSelectedView = true;
            switchView(view);
          }
        });
        tab.addEventListener('keydown', (event) => {
          let nextIndex = tabIndex;
          if (event.key === 'ArrowLeft') nextIndex = (tabIndex - 1 + tabs.length) % tabs.length;
          else if (event.key === 'ArrowRight') nextIndex = (tabIndex + 1) % tabs.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          const view = tabs[nextIndex]?.dataset.graphViewButton;
          if (isGraphView(view)) {
            userSelectedView = true;
            switchView(view, true);
          }
        });
      });

      if (tabs.length > 0 && panels.length > 0) {
        const desktopDefault = root.dataset.graphDefaultView === 'list' ? 'list' : 'graph';
        setView(viewportQuery.matches ? 'list' : desktopDefault);
        /*
         * 断点只在用户尚未主动选视图时接管：旋转设备会自动回到合适的初始布局，
         * 一旦用户选择图谱或列表，后续缩放就尊重该选择，不突然替换正在看的内容。
         */
        window.addEventListener('resize', () => {
          if (!userSelectedView) setView(viewportQuery.matches ? 'list' : desktopDefault);
        }, { passive: true, signal: viewportController.signal });
        document.addEventListener('astro:before-swap', () => {
          viewportController.abort();
          activeViewTransition?.skipTransition();
          clearTransitionNames();
        }, {
          once: true,

---
import { ChevronLeft, ChevronRight } from '@lucide/astro';

import { getPostPath, getPostTransitionName, sortPosts, type PostEntry } from '../../lib/content';

interface Props {
	posts: readonly PostEntry[];
	heading?: string;
}

interface CalendarCell {
	day: number | null;
	dateTime: string | null;
	posts: PostEntry[];
}

interface CalendarMonth {
	year: number;
	month: number;
	key: string;
	label: string;
	cells: CalendarCell[];
}

const { posts, heading = '文章日历' } = Astro.props;
const visiblePosts = sortPosts(posts.filter((post) => !post.data.draft));
const chronologicalPosts = [...visiblePosts].reverse();
const weekdayLabels = ['一', '二', '三', '四', '五', '六', '日'];
const pad = (value: number) => String(value).padStart(2, '0');

const toDateParts = (date: Date) => ({
	year: date.getUTCFullYear(),
	month: date.getUTCMonth(),
	day: date.getUTCDate(),
});

const months: CalendarMonth[] = [];

if (chronologicalPosts.length > 0) {
	const first = toDateParts(chronologicalPosts[0].data.publishedAt);
	const last = toDateParts(chronologicalPosts.at(-1)!.data.publishedAt);
	let year = first.year;
	let month = first.month;

	// 连续生成月份，空月份也保留，前后翻页时不会产生时间跳跃。
	while (year < last.year || (year === last.year && month <= last.month)) {
		const firstWeekday = (new Date(Date.UTC(year, month, 1)).getUTCDay() + 6) % 7;
		const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
		const postsByDay = new Map<number, PostEntry[]>();

		for (const post of chronologicalPosts) {
			const parts = toDateParts(post.data.publishedAt);
			if (parts.year !== year || parts.month !== month) continue;
			const entries = postsByDay.get(parts.day) ?? [];
			entries.push(post);
			postsByDay.set(parts.day, entries);
		}

		// 固定六周共 42 格，切换月份时日历高度保持稳定。
		const cells = Array.from({ length: 42 }, (_, cellIndex): CalendarCell => {
			const day = cellIndex - firstWeekday + 1;
			if (day < 1 || day > daysInMonth) return { day: null, dateTime: null, posts: [] };
			return {
				day,
				dateTime: `${year}-${pad(month + 1)}-${pad(day)}`,
				posts: postsByDay.get(day) ?? [],
			};
		});

		months.push({
			year,
			month,
			key: `${year}-${pad(month + 1)}`,
			label: `${year} / ${pad(month + 1)}`,
			cells,
		});

		month += 1;
		if (month === 12) {
			month = 0;
			year += 1;
		}
	}
}

const initialMonthIndex = Math.max(0, months.length - 1);

/*
 * 时间线按月分组、最新月份在上。与日历同源不同视图：桌面端两块同时可见，
 * 移动端只剩时间线。注意时间线的标题不持转场名——同一篇文章在可见月份的
 * 日历格里已有同名转场元素，重名会让 Chrome 跳过整场转场。
 */
const monthGroupsDesc = [...months].reverse().map((calendarMonth) => ({
	key: calendarMonth.key,
	label: calendarMonth.label,
	// 格子里的文章本来就只属于当月，直接展平即可。
	posts: calendarMonth.cells.flatMap((cell) => cell.posts),
}));

const spanLabel = months.length > 1
	? `${months[0].label.replace(' / ', '.')} — ${months.at(-1)!.label.replace(' / ', '.')}`
	: months[0]?.label.replace(' / ', '.') ?? '';

const listDateFormatter = (date: Date) => {
	const parts = toDateParts(date);
	// toDateParts 沿用日历的 UTC 取值，month 是 0 起索引，展示前必须 +1。
	return `${pad(parts.month + 1)}.${pad(parts.day)}`;
};
---

<section class="archive-calendar" data-archive-calendar data-initial-index={initialMonthIndex}>
	<header class="archive-calendar__header">
		<div>
			<p>ARCHIVE / CALENDAR</p>
			<h2>{heading}</h2>
		</div>
		{months.length > 0 && (
			<nav class="archive-calendar__navigation" aria-label="切换归档月份" data-calendar-navigation>
				<button
					type="button"
					aria-label="查看上一个月"
					title="上一个月"
					data-calendar-previous
					disabled={initialMonthIndex === 0}
				>
					<ChevronLeft size={20} stroke-width={1.5} aria-hidden="true" />
				</button>
				<span class="archive-calendar__month-label" aria-live="polite" data-calendar-label>
					{months[initialMonthIndex]?.label}
				</span>
				<button
					type="button"
					aria-label="查看下一个月"
					title="下一个月"
					data-calendar-next
					disabled={initialMonthIndex === months.length - 1}
				>
					<ChevronRight size={20} stroke-width={1.5} aria-hidden="true" />
				</button>
			</nav>
		)}
	</header>

	{months.length > 1 && (
		<div class="archive-calendar__chips" role="group" aria-label="按月份快速跳转" data-calendar-chips>
			{months.map((calendarMonth, index) => (
				<button
					type="button"
					data-calendar-chip
					data-chip-index={index}
					aria-pressed={index === initialMonthIndex ? 'true' : 'false'}
					aria-label={`跳转到 ${calendarMonth.label}`}
				>
					{calendarMonth.label.slice(-2)}
				</button>
			))}
		</div>
	)}

	{months.length > 0 ? (
		<div class="archive-calendar__months" data-calendar-months>
			{months.map((calendarMonth, monthIndex) => (
				<div
					class="archive-calendar__month"
					data-calendar-month={calendarMonth.key}
					data-calendar-month-label={calendarMonth.label}
					hidden={monthIndex !== initialMonthIndex}
				>
					<table>
						<caption class="sr-only">{calendarMonth.year} 年 {calendarMonth.month + 1} 月文章日历</caption>
						<thead>
							<tr>
								{weekdayLabels.map((weekday) => <th scope="col">{weekday}</th>)}
							</tr>
						</thead>
						<tbody>
							{Array.from({ length: 6 }, (_, weekIndex) => (
								<tr>
									{calendarMonth.cells.slice(weekIndex * 7, weekIndex * 7 + 7).map((cell) => (
										<td class:list={{ 'has-posts': cell.posts.length > 0, 'is-empty': cell.day === null }}>
											{cell.day !== null && (
												<>
													<time datetime={cell.dateTime ?? undefined}>{pad(cell.day)}</time>
													{cell.posts.length > 0 && (
														<ul>
															{cell.posts.map((post) => (
																/* 格内标题持转场名：从日历进入文章时标题飞入页头，
																	返回时飞回原格。不再整页重载。 */
																<li>
																	<a
																		href={getPostPath(post)}
																		data-article-transition-link
																		transition:name={getPostTransitionName(post)}
																	>{post.data.title}</a>
																</li>
															))}
														</ul>
													)}
												</>
											)}
										</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			))}
		</div>
	) : (
		<p class="archive-calendar__empty">尚无已发布文章。</p>
	)}

	<!--
		时间线：与日历同源的按月分组列表，桌面端铺满日历以下的空白半场，
		移动端（≤48rem）日历退场后它就是唯一视图。整行都是链接，命中区域
		不再只有标题那几个字。
	-->
	<section class="archive-timeline" aria-label="全部文章时间线">
		<header class="archive-timeline__header">
			<div>
				<p>TIMELINE / ALL RECORDS</p>
				<h3>全部记录</h3>
			</div>
			{months.length > 0 && (
				<span class="archive-timeline__meta">{spanLabel} · 共 {visiblePosts.length} 篇</span>
			)}
		</header>
		{monthGroupsDesc.map((group) => (
			<section class="archive-timeline__group" aria-label={`${group.label.replace(' / ', ' 年 ')} 月`}>
				<p class="archive-timeline__month-label">
					{group.label}
					<small>{String(group.posts.length).padStart(2, '0')} 篇</small>
				</p>
				<ol>
					{group.posts.map((post) => (
						<li>
							<a href={getPostPath(post)} data-article-transition-link>
								<time datetime={post.data.publishedAt.toISOString()}>{listDateFormatter(post.data.publishedAt)}</time>
								<span
									class:list={['archive-timeline__square', { 'is-filled': post.data.kind === 'project' || post.data.kind === 'tutorial' }]}
									aria-hidden="true"
								></span>
								<strong>{post.data.title}</strong>
								<span class="archive-timeline__kind">{post.data.kind.toUpperCase()}</span>
							</a>
						</li>
					))}
				</ol>
			</section>
		))}
	</section>
</section>

<script>
	function initArchiveCalendars() {
		document.querySelectorAll<HTMLElement>('[data-archive-calendar]').forEach((root) => {
			if (root.dataset.calendarReady === 'true') return;
			root.dataset.calendarReady = 'true';

			const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-calendar-month]'));
			const label = root.querySelector<HTMLElement>('[data-calendar-label]');
			const previous = root.querySelector<HTMLButtonElement>('[data-calendar-previous]');
			const next = root.querySelector<HTMLButtonElement>('[data-calendar-next]');
			const navigation = root.querySelector<HTMLElement>('[data-calendar-navigation]');
			const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-calendar-chip]'));
			if (panels.length === 0 || !label || !previous || !next || !navigation) return;

			const pad = (value: number) => String(value).padStart(2, '0');
			const monthStorageKey = 'aria7-archive-month';
			let activeIndex = Math.min(
				panels.length - 1,
				Math.max(0, Number(root.dataset.initialIndex) || 0),
			);

			// 从本页离开又返回时，回到离开前正在看的月份，而不是永远弹回最新月。
			try {
				const storedKey = sessionStorage.getItem(monthStorageKey);
				const storedIndex = panels.findIndex((panel) => panel.dataset.calendarMonth === storedKey);
				if (storedIndex >= 0) activeIndex = storedIndex;
			} catch {
				// 会话存储不可用时保持默认最新月。
			}

			let monthSwitched = false;

			const showMonth = (nextIndex: number) => {
				const previousIndex = activeIndex;
				activeIndex = Math.min(panels.length - 1, Math.max(0, nextIndex));
				// 方向只在用户切换后写入；首次渲染保持无动画直达当月。
				if (monthSwitched) {
					root.dataset.monthDirection = activeIndex >= previousIndex ? 'next' : 'prev';
				}
				monthSwitched = true;
				panels.forEach((panel, index) => {
					panel.hidden = index !== activeIndex;
				});
				label.textContent = panels[activeIndex]?.dataset.calendarMonthLabel ?? '';
				previous.disabled = activeIndex === 0;
				next.disabled = activeIndex === panels.length - 1;
				chips.forEach((chip) => {
					chip.setAttribute('aria-pressed', String(Number(chip.dataset.chipIndex) === activeIndex));
				});
				try {
					sessionStorage.setItem(monthStorageKey, panels[activeIndex]?.dataset.calendarMonth ?? '');
				} catch {
					// 存储不可用时只丢跨页记忆，翻页本身不受影响。
				}
			};

			previous.addEventListener('click', () => showMonth(activeIndex - 1));
			next.addEventListener('click', () => showMonth(activeIndex + 1));
			chips.forEach((chip) => {
				chip.addEventListener('click', () => showMonth(Number(chip.dataset.chipIndex)));
			});
			navigation.addEventListener('keydown', (event) => {
				const destination = {
					ArrowLeft: activeIndex - 1,
					PageUp: activeIndex - 1,
					ArrowRight: activeIndex + 1,
					PageDown: activeIndex + 1,
					Home: 0,
					End: panels.length - 1,
				}[event.key];
				if (destination === undefined) return;
				event.preventDefault();
				showMonth(destination);
			});

			// 今日刻度：构建产物是静态的，当天标记只能交给运行时补。
			const now = new Date();
			const todayKey = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
			root.querySelector(`td time[datetime="${todayKey}"]`)?.closest('td')?.classList.add('is-today');

			showMonth(activeIndex);
		});
	}

	initArchiveCalendars();
	document.addEventListener('astro:page-load', initArchiveCalendars);
</script>

<style>
	.archive-calendar {
		border-block: 1px solid var(--line);
		color: var(--ink);
	}

	/* 42 格固定高度已保证切换不跳版；这里只补一层方向感：像翻动档案页一样
	   沿切换方向滑入。全局 reduced-motion 兜底会把它压成瞬时切换。 */
	.archive-calendar[data-month-direction] .archive-calendar__month:not([hidden]) {
		animation: archive-month-in-next var(--duration-base) var(--ease-drift) both;
	}

	.archive-calendar[data-month-direction='prev'] .archive-calendar__month:not([hidden]) {
		animation-name: archive-month-in-prev;
	}

	@keyframes archive-month-in-next {
		from { opacity: 0; transform: translateX(14px); }
		to { opacity: 1; transform: translateX(0); }
	}

	@keyframes archive-month-in-prev {
		from { opacity: 0; transform: translateX(-14px); }
		to { opacity: 1; transform: translateX(0); }
	}

	.archive-calendar__header {
		display: flex;
		min-height: 6.5rem;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.25rem 0;
	}

	.archive-calendar__header p,
	.archive-timeline__header p {
		margin: 0 0 0.35rem;
		color: var(--ink-muted);
		font-family: var(--font-ui);
		font-size: 0.625rem;
		font-weight: 500;
		line-height: 1.4;
	}

	.archive-calendar__header h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 500;
		line-height: var(--leading-title);
	}

	.archive-calendar__navigation {
		display: grid;
		grid-template-columns: 2.75rem minmax(8.5rem, auto) 2.75rem;
		align-items: center;
		border: 1px solid var(--line);
	}

	.archive-calendar__navigation button {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
	}

	.archive-calendar__navigation button + *,
	.archive-calendar__month-label + button {
		border-inline-start: 1px solid var(--line);
	}

	.archive-calendar__navigation button:hover:not(:disabled),
	.archive-calendar__navigation button:focus-visible {
		background: var(--color-surface-muted);
		color: var(--accent-strong);
	}

	.archive-calendar__navigation button:disabled {
		color: var(--ink-muted);
		cursor: not-allowed;
		opacity: 0.4;
	}

	.archive-calendar__month-label {
		display: grid;
		height: 2.75rem;
		place-items: center;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	/* 月份速达片：月份不多时翻页太慢，一枚一枚点不如直接跳。 */
	.archive-calendar__chips {
		display: flex;
		justify-content: flex-end;
		gap: 6px;
		margin-bottom: 14px;
	}

	.archive-calendar__chips button {
		min-width: 2.5rem;
		height: 2rem;
		padding-inline: 8px;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		cursor: pointer;
		transition: color var(--duration-base) var(--ease-rain), background-color var(--duration-base) var(--ease-rain), border-color var(--duration-base) var(--ease-rain);
	}

	.archive-calendar__chips button:hover,
	.archive-calendar__chips button:focus-visible {
		color: var(--ink);
		border-color: var(--line-strong);
	}

	.archive-calendar__chips button[aria-pressed='true'] {
		border-color: var(--accent-strong);
		background: var(--accent-strong);
		color: var(--color-paper);
	}

	.archive-calendar__month[hidden] {
		display: none;
	}

	.archive-calendar table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
	}

	.archive-calendar th {
		height: 2.25rem;
		border: 1px solid var(--line);
		color: var(--ink-muted);
		font-family: var(--font-ui);
		font-size: 0.625rem;
		font-weight: 500;
	}

	.archive-calendar td {
		height: 7.5rem;
		padding: 0.6rem;
		vertical-align: top;
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper-0) 78%, transparent);
	}

	.archive-calendar td.is-empty {
		background: color-mix(in srgb, var(--color-surface-muted) 28%, transparent);
	}

	.archive-calendar td.has-posts {
		box-shadow: inset 2px 0 var(--accent-strong);
	}

	.archive-calendar td.has-posts > time {
		color: var(--ink);
		font-weight: 500;
	}

	.archive-calendar td > time {
		display: block;
		margin-bottom: 0.45rem;
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: 0.625rem;
	}

	/* 今日刻度：构建期不知道"今天"，由脚本在当月补上这枚小方点。 */
	.archive-calendar td.is-today > time {
		color: var(--accent-strong);
	}

	.archive-calendar td.is-today > time::after {
		display: inline-block;
		width: 5px;
		height: 5px;
		margin-inline-start: 5px;
		background: var(--accent-strong);
		content: '';
	}

	.archive-calendar td ul {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/*
	 * 格内标题：内边距扩出命中区域（负外边距抵消，不破坏格子排版），
	 * 悬停沿用全站的纸面浮起——投影加深、微微上浮，不做色块。
	 */
	.archive-calendar td a {
		display: -webkit-box;
		overflow: hidden;
		padding: 3px 6px;
		margin: -3px -6px;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 0.75rem;
		line-height: 1.45;
		text-decoration-color: var(--line-strong);
		transition: color var(--duration-base) var(--ease-rain), background-color var(--duration-base) var(--ease-rain), box-shadow 420ms var(--ease-rain), transform var(--duration-base) var(--ease-drift);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.archive-calendar td a:hover,
	.archive-calendar td a:focus-visible {
		background: var(--color-surface);
		color: var(--accent-strong);
		box-shadow: 0 10px 20px rgb(31 71 81 / 16%), 0 2px 5px rgb(31 71 81 / 10%);
		text-decoration-color: currentColor;
		transform: translate(-2px, -1px);
	}

	/*
	 * 时间线：桌面端在日历之下铺开全部记录，移动端是唯一视图。
	 * 整行一枚链接，日期、方纸标记、标题与栏目代码同行排布。
	 */
	.archive-timeline {
		padding: 1.25rem 0 0.5rem;
	}

	.archive-timeline__header {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1.5rem;
		padding-bottom: 0.9rem;
	}

	.archive-timeline__header h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 500;
	}

	.archive-timeline__meta {
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.archive-timeline__group + .archive-timeline__group {
		margin-top: 1.6rem;
	}

	.archive-timeline__month-label {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin: 0;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--line);
		color: var(--accent-strong);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.archive-timeline__month-label small {
		color: var(--ink-muted);
		font-size: 0.625rem;
	}

	.archive-timeline ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.archive-timeline li + li {
		border-top: 1px solid color-mix(in srgb, var(--line) 62%, transparent);
	}

	.archive-timeline li a {
		display: grid;
		grid-template-columns: 3.4rem 7px minmax(0, 1fr) auto;
		gap: 0.9rem;
		align-items: center;
		min-height: 3rem;
		padding: 0.55rem 0.7rem;
		margin-inline: -0.7rem;
		color: var(--ink);
		text-decoration: none;
		transition: background-color var(--duration-base) var(--ease-rain), box-shadow 420ms var(--ease-rain), transform var(--duration-base) var(--ease-drift);
	}

	.archive-timeline li a:hover,
	.archive-timeline li a:focus-visible {
		background: var(--color-surface);
		box-shadow: 0 12px 24px rgb(31 71 81 / 16%), 0 2px 6px rgb(31 71 81 / 10%);
		transform: translate(-2px, -1px);
	}

	.archive-timeline li time {
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	/* 方纸标记与 KindLabel 同一母题：实心 = 项目/指南，空心 = 其余栏目。 */
	.archive-timeline__square {

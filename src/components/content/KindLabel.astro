---
import { POST_KIND_META, type PostKind } from '@/data/site';

interface Props {
	kind: PostKind;
}

const { kind } = Astro.props;
const { code, longLabel } = POST_KIND_META[kind];
---

<span class={`kind-label kind-label--${kind}`}>
	<span aria-hidden="true"></span>
	{code} / {longLabel}
</span>

<style>
	.kind-label {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-ui);
		font-size: 10px;
		line-height: 1.4;
		color: var(--ink-muted);
	}

	.kind-label > span {
		width: 7px;
		aspect-ratio: 1;
		border: 1px solid var(--accent-strong);
	}

	.kind-label--project > span,
	.kind-label--tutorial > span {
		background: var(--accent-strong);
	}
</style>

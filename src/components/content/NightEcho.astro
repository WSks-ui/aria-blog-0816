---
import { ArrowUpRight, Bookmark, Clock3, ListTree } from '@lucide/astro';

interface RelatedPost {
	href: string;
	title: string;
	kind: string;
}

interface Props {
	minutes: number;
	scenes: number;
	related?: RelatedPost[];
}

const { minutes, scenes, related = [] } = Astro.props;
---

<footer class="night-echo" data-night-echo>
	<div class="night-echo__status">
		<p>THEME / NIGHT ECHO</p>
		<strong>阅读在这里收束，线索仍向外延伸。</strong>
	</div>
	<dl class="night-echo__metrics">
		<div>
			<Clock3 size={18} stroke-width={1.5} aria-hidden="true" />
			<dt>阅读时间</dt>
			<dd>{minutes} min</dd>
		</div>
		<div>
			<ListTree size={18} stroke-width={1.5} aria-hidden="true" />
			<dt>章节数量</dt>
			<dd>{scenes}</dd>
		</div>
		<div>
			<Bookmark size={18} stroke-width={1.5} aria-hidden="true" />
			<dt>本地纸片</dt>
			<dd data-memory-count>0</dd>
		</div>
	</dl>
	{related.length > 0 && (
		<div class="night-echo__related">
			<p>EXTENDED READING</p>
			{related.slice(0, 3).map((post) => (
				<a href={post.href} data-article-transition-link>
					<span>{post.kind}</span>
					<strong>{post.title}</strong>
					<ArrowUpRight size={17} stroke-width={1.5} aria-hidden="true" />
				</a>
			))}
		</div>
	)}
</footer>

<style>
	.night-echo {
		position: relative;
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 48px;
		margin-top: 96px;
		padding: 56px;
		background: var(--night-0);
		color: var(--night-text);
		overflow: hidden;
	}

	.night-echo::after {
		position: absolute;
		right: -8%;
		bottom: -70%;
		width: 340px;
		aspect-ratio: 1;
		border: 1px solid rgb(185 216 223 / 20%);
		border-radius: 50%;
		box-shadow: 0 0 0 28px rgb(185 216 223 / 4%), 0 0 0 72px rgb(185 216 223 / 3%);
		content: '';
	}

	.night-echo__status p,
	.night-echo__related > p {
		margin: 0 0 18px;
		font-family: var(--font-ui);
		font-size: 10px;
		color: var(--night-muted);
	}

	.night-echo__status strong {
		display: block;
		max-width: 460px;
		font-family: var(--font-display);
		font-size: 30px;
		font-weight: 500;
		line-height: 1.5;
	}

	.night-echo__metrics {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		align-self: start;
		margin: 0;
		border-block: 1px solid rgb(242 245 244 / 16%);
	}

	.night-echo__metrics > div {
		display: grid;
		grid-template-columns: 22px 1fr;
		gap: 2px 8px;
		padding: 18px 12px;
		border-right: 1px solid rgb(242 245 244 / 12%);
	}

	.night-echo__metrics svg {
		grid-row: 1 / 3;
	}

	.night-echo dt,
	.night-echo dd {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 10px;
	}

	.night-echo dt {
		color: var(--night-muted);
	}

	.night-echo dd {
		font-size: 13px;
	}

	.night-echo__related {
		grid-column: 1 / -1;
		position: relative;
		z-index: 1;
	}

	.night-echo__related a {
		display: grid;
		grid-template-columns: 110px 1fr 24px;
		gap: 16px;
		align-items: center;
		padding: 16px 0;
		border-top: 1px solid rgb(242 245 244 / 14%);
		color: var(--night-text);
		text-decoration: none;
	}

	.night-echo__related span {
		font-family: var(--font-ui);
		font-size: 9px;
		color: var(--night-muted);
	}

	.night-echo__related strong {
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 500;
	}

	@media (max-width: 900px) {
		.night-echo {
			grid-template-columns: 1fr;
			padding: 36px 24px;
		}

		.night-echo__related {
			grid-column: auto;
		}
	}
</style>

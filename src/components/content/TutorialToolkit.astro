---
import { ArrowRight } from '@lucide/astro';
import {
	TUTORIAL_TOOL_STAGES,
	getToolTransitionName,
	getTutorialToolPath,
	type TutorialTool,
} from '@/data/tutorial-tools';

interface Props {
	tools: readonly TutorialTool[];
}

const { tools } = Astro.props;
const stageCounts = new Map(
	TUTORIAL_TOOL_STAGES.map((stage) => [
		stage.id,
		tools.filter((tool) => tool.stage === stage.id).length,
	]),
);
const stageById = new Map(TUTORIAL_TOOL_STAGES.map((stage) => [stage.id, stage]));
// 默认进入第一个实际有工具的学习阶段，避免再引入一个会稀释目录层级的“全部工具”虚拟选项。
const initialStage = TUTORIAL_TOOL_STAGES.find((stage) => (stageCounts.get(stage.id) ?? 0) > 0) ?? TUTORIAL_TOOL_STAGES[0];
const firstTool = tools.find((tool) => tool.stage === initialStage.id) ?? tools[0];
---

<section class="tutorial-toolkit" aria-labelledby="tutorial-toolkit-title" data-tutorial-toolkit>
	<header class="tutorial-toolkit__header">
		<div class="tutorial-toolkit__title">
			<p>TOOLCHAIN / {String(tools.length).padStart(2, '0')}</p>
			<h2 id="tutorial-toolkit-title">必学工具</h2>
		</div>
		<div class="tutorial-toolkit__reference">
			<span>SELECT A STAGE / HOVER A RECORD</span>
			<strong>ON-SITE DOSSIERS / {String(tools.length).padStart(2, '0')}</strong>
			<a class="tutorial-toolkit__source" href="https://github.com/PKUFlyingPig/cs-self-learning/" target="_blank" rel="noreferrer">github.com/PKUFlyingPig/cs-self-learning/</a>
		</div>
	</header>

	<div class="tutorial-toolkit__body">
		<aside class="tutorial-toolkit__rail" aria-label="学习阶段">
			<div class="tutorial-toolkit__rail-inner">
				<p class="tutorial-toolkit__rail-label">LEARNING PATH / 06</p>
				<div class="tutorial-toolkit__stages" role="toolbar" aria-label="工具学习阶段筛选">
					{TUTORIAL_TOOL_STAGES.map((stage) => (
						<button type="button" data-tool-stage-button data-tool-stage={stage.id} aria-pressed={stage.id === initialStage.id ? 'true' : 'false'} style={`--stage-accent: ${stage.accent};`}>
							<span>{stage.index}</span>
							<strong>{stage.label}</strong>
							<small>{String(stageCounts.get(stage.id) ?? 0).padStart(2, '0')}</small>
						</button>
					))}
				</div>
			</div>
		</aside>

		<div class="tutorial-toolkit__directory">
			<div class="tutorial-toolkit__status" aria-live="polite" data-tool-status>
				<div>
					<p>ACTIVE RECORD</p>
					<strong data-tool-status-name>{firstTool?.name ?? '工具导航'}</strong>
				</div>
				<div>
					<p data-tool-status-stage>{firstTool ? stageById.get(firstTool.stage)?.code : 'TOOLCHAIN'}</p>
					<span data-tool-status-summary>{firstTool?.summary}</span>
				</div>
			</div>

			<div class="tutorial-toolkit__grid" data-tool-grid>
				{tools.map((tool, index) => {
					const stage = stageById.get(tool.stage);
					return (
						<article
							class="tutorial-tool"
							data-tool-card
							data-tool-stage={tool.stage}
							data-tool-name={tool.name}
							data-tool-stage-code={stage?.code ?? 'TOOLCHAIN'}
							data-tool-summary={tool.summary}
							style={`--tool-accent: ${stage?.accent ?? 'var(--accent-strong)'}; --tool-delay: ${index * 38}ms;`}
						>
							<!-- 工具目录只进入站内讲义；官网与参考站链接在讲义末尾集中呈现，避免学习路径被外链打断。
								data-article-transition-link 让换页进入与文章一致的软退软入编排，卡片标题与讲义 H1 配对飞行。 -->
							<a class="tutorial-tool__open" href={getTutorialToolPath(tool)} data-article-transition-link>
								<header>
									<span class="tutorial-tool__index">{String(index + 1).padStart(2, '0')}</span>
									<span class="tutorial-tool__code">{tool.code}</span>
									<span class="tutorial-tool__status">{tool.status}</span>
								</header>
								<div class="tutorial-tool__body">
									<p>{stage?.label}</p>
									<h3 transition:name={getToolTransitionName(tool)}>{tool.name}</h3>
									<span>{tool.summary}</span>
								</div>
								<footer>
									<span>阅读工具讲义</span>
									<ArrowRight size={16} stroke-width={1.5} aria-hidden="true" />
								</footer>
							</a>
						</article>
					);
				})}
			</div>
		</div>
	</div>
</section>

<script>
	function initTutorialToolkit() {
		document.querySelectorAll<HTMLElement>('[data-tutorial-toolkit]').forEach((root) => {
			if (root.dataset.interactiveReady === 'true') return;
			root.dataset.interactiveReady = 'true';

			const cards = [...root.querySelectorAll<HTMLElement>('[data-tool-card]')];
			const stageButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-tool-stage-button]')];
			const status = root.querySelector<HTMLElement>('[data-tool-status]');
			const grid = root.querySelector<HTMLElement>('[data-tool-grid]');
			const statusName = root.querySelector<HTMLElement>('[data-tool-status-name]');
			const statusStage = root.querySelector<HTMLElement>('[data-tool-status-stage]');
			const statusSummary = root.querySelector<HTMLElement>('[data-tool-status-summary]');
			// 这里从第一个实际阶段开始，和服务端输出的默认按钮状态保持一致，避免首屏先闪出全部卡片。
			let activeStage = stageButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.toolStage ?? stageButtons[0]?.dataset.toolStage ?? '';
			let stageReady = false;
			let pendingStage = '';
			let transitionSequence = 0;
			const transitionNodes = [status, grid].filter((node): node is HTMLElement => Boolean(node));
			const prefersReducedMotion = () => window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

			const setActiveRecord = (card: HTMLElement | undefined) => {
				if (!card) {
					cards.forEach((item) => item.classList.remove('is-active'));
					statusName && (statusName.textContent = '工具导航');
					statusStage && (statusStage.textContent = 'TOOLCHAIN');
					statusSummary && (statusSummary.textContent = '');
					return;
				}
				cards.forEach((item) => item.classList.toggle('is-active', item === card));
				statusName && (statusName.textContent = card.dataset.toolName ?? '工具导航');
				statusStage && (statusStage.textContent = card.dataset.toolStageCode ?? 'TOOLCHAIN');
				statusSummary && (statusSummary.textContent = card.dataset.toolSummary ?? '');
			};

			const updateStageContent = (stage: string, animateCards: boolean) => {
				const visibleCards = cards.filter((card) => card.dataset.toolStage === stage);
				let visibleIndex = 0;

				cards.forEach((card) => {
					card.classList.remove('is-stage-entering');
					const visible = visibleCards.includes(card);
					card.dataset.filteredOut = String(!visible);
					card.setAttribute('aria-hidden', String(!visible));
					card.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
						link.tabIndex = visible ? 0 : -1;
					});

					if (visible) {
						card.style.setProperty('--tool-stage-delay', `${visibleIndex * 36}ms`);
						if (animateCards) card.classList.add('is-stage-entering');
						visibleIndex += 1;
					} else {
						card.style.removeProperty('--tool-stage-delay');
					}
				});

				setActiveRecord(visibleCards[0]);
				if (animateCards) {
					// 先让浏览器提交“入场前”的样式，再移除状态类，才能稳定触发卡片过渡。
					window.requestAnimationFrame(() => {
						visibleCards.forEach((card) => card.classList.remove('is-stage-entering'));
					});
				}
			};

			const applyStage = (stage: string, animate = true) => {
				if (!stage || (stage === activeStage && (stageReady || pendingStage === stage))) return;
				activeStage = stage;
				pendingStage = stage;
				root.dataset.activeStage = stage;
				stageButtons.forEach((button) => {
					button.setAttribute('aria-pressed', String(button.dataset.toolStage === stage));
				});

				const shouldAnimate = animate && stageReady && !prefersReducedMotion();
				const sequence = ++transitionSequence;
				if (!shouldAnimate) {
					transitionNodes.forEach((node) => node.classList.remove('is-stage-leaving'));
					grid?.removeAttribute('aria-busy');
					updateStageContent(stage, false);
					stageReady = true;
					pendingStage = '';
					return;
				}

				/*
				 * 阶段切换不设置固定高度，也不在过渡期间压缩 Grid 行轨道。
				 * 先淡出当前内容，等离场完成后一次性更新筛选状态，再淡入新内容，
				 * 这样阶段卡片数量变化时不会把“空白占位”暴露给用户。
				 */
				transitionNodes.forEach((node) => node.classList.add('is-stage-leaving'));
				grid?.setAttribute('aria-busy', 'true');
				window.setTimeout(() => {
					if (sequence !== transitionSequence) return;
					updateStageContent(stage, true);
					transitionNodes.forEach((node) => node.classList.remove('is-stage-leaving'));
					grid?.removeAttribute('aria-busy');
					stageReady = true;
					pendingStage = '';
				}, 180);
			};

			stageButtons.forEach((button) => {
				button.addEventListener('click', () => applyStage(button.dataset.toolStage ?? ''));
				button.addEventListener('keydown', (event) => {
					if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
					event.preventDefault();
					const current = stageButtons.indexOf(button);
					const direction = event.key === 'ArrowDown' ? 1 : -1;
					const nextButton = stageButtons[(current + direction + stageButtons.length) % stageButtons.length];
					nextButton?.focus();
					// 工具栏使用上下方向键时同步切换内容，避免焦点已移动但目录仍停留在旧阶段。
					applyStage(nextButton?.dataset.toolStage ?? '');
				});
			});

			cards.forEach((card) => {
				card.addEventListener('pointerenter', () => {
					if (card.dataset.toolStage === activeStage) setActiveRecord(card);
				});
				card.addEventListener('focusin', () => {
					if (card.dataset.toolStage === activeStage) setActiveRecord(card);
				});
			});

			/*
			 * 首屏先直接建立已选阶段，再允许后续交互进入动画路径。
			 * 不复用 applyStage(activeStage)，避免少数页面载入时首个点击仍被判定为初始化而跳过离场动画。
			 */
			updateStageContent(activeStage, false);
			stageReady = true;
		});
	}

	initTutorialToolkit();
	document.addEventListener('astro:page-load', initTutorialToolkit);
</script>

<style>
	.tutorial-toolkit {
		position: relative;
		margin-top: 42px;
		border-block: 1px solid var(--line);
		isolation: isolate;
	}

	.tutorial-toolkit::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		background-image: linear-gradient(to bottom, transparent 0 42px, color-mix(in srgb, var(--line) 44%, transparent) 42px 43px, transparent 43px 100%);
		background-size: 100% 126px;
		opacity: 0.48;
		content: '';
		pointer-events: none;
	}

	.tutorial-toolkit__header {
		display: flex;
		justify-content: space-between;
		gap: 32px;
		align-items: end;
		padding: 38px 0 28px;
		border-bottom: 1px solid var(--line);
	}

	.tutorial-toolkit__title > p,
	.tutorial-toolkit__reference > span,
	.tutorial-toolkit__rail-label,
	.tutorial-toolkit__status p,
	.tutorial-tool__index,
	.tutorial-tool__code,
	.tutorial-tool__status,
	.tutorial-tool__body > p {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 9px;
		letter-spacing: var(--tracking-hud);
	}

	.tutorial-toolkit__title > p { color: var(--accent-strong); }
	.tutorial-toolkit__title h2 {
		margin: 8px 0 0;
		font-family: var(--font-display);
		font-size: 44px;
		font-weight: 500;
		line-height: 1.12;
	}

	.tutorial-toolkit__reference {
		display: grid;
		justify-items: end;
		gap: 12px;
		padding-bottom: 4px;
		color: var(--ink-muted);
	}

	.tutorial-toolkit__reference > strong,
	.tutorial-tool__open > footer {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		font-family: var(--font-ui);
		font-size: 11px;
	}

	.tutorial-toolkit__reference > strong { color: var(--accent-strong); font-weight: 500; }
	.tutorial-toolkit__source {
		max-width: 100%;
		overflow: hidden;
		color: var(--ink-muted);
		font-family: var(--font-ui);
		font-size: 10px;
		line-height: 1.4;
		text-decoration: none;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color var(--duration-base) var(--ease-rain), border-color var(--duration-base) var(--ease-rain);
		border-bottom: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
	}
	.tutorial-toolkit__source:hover,
	.tutorial-toolkit__source:focus-visible { color: var(--accent-strong); border-color: var(--accent-strong); }

	.tutorial-toolkit__body {
		display: grid;
		grid-template-columns: minmax(220px, 0.58fr) minmax(0, 2fr);
		gap: clamp(30px, 4vw, 64px);
		padding-block: 34px 72px;
	}

	.tutorial-toolkit__rail { min-width: 0; }
	.tutorial-toolkit__rail-inner { position: sticky; top: 112px; }
	.tutorial-toolkit__rail-label { padding-bottom: 14px; color: var(--ink-muted); border-bottom: 1px solid var(--line); }
	.tutorial-toolkit__stages { display: grid; }
	.tutorial-toolkit__stages button {
		display: grid;
		grid-template-columns: 32px minmax(0, 1fr) auto;
		gap: 10px;
		align-items: center;
		width: 100%;
		min-height: 48px;
		padding: 0;
		border: 0;
		border-bottom: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
		background: transparent;
		color: var(--ink-muted);
		font-family: var(--font-ui);
		text-align: left;
		cursor: pointer;
		transition: color var(--duration-base) var(--ease-rain), padding-inline var(--duration-base) var(--ease-drift), background-color var(--duration-base) var(--ease-rain);
	}
	.tutorial-toolkit__stages button > span,
	.tutorial-toolkit__stages button > small { font-size: 9px; }
	.tutorial-toolkit__stages button > strong { font-size: 12px; font-weight: 500; }
	.tutorial-toolkit__stages button[aria-pressed='true'] {
		padding-inline: 10px;
		background: color-mix(in srgb, var(--stage-accent, var(--accent-strong)) 12%, transparent);
		color: var(--ink);
	}
	.tutorial-toolkit__stages button[aria-pressed='true'] > span { color: var(--stage-accent, var(--accent-strong)); }
	.tutorial-toolkit__stages button:hover { padding-inline: 8px; color: var(--ink); }

	.tutorial-toolkit__directory { min-width: 0; }
	.tutorial-toolkit__status {
		display: grid;
		grid-template-columns: minmax(180px, 0.75fr) minmax(0, 1.7fr);
		gap: 24px;
		align-items: start;
		min-height: 92px;
		padding: 16px 18px;
		border: 1px solid var(--line);
		border-left: 3px solid var(--accent-strong);
		background: color-mix(in srgb, var(--paper-0) 86%, transparent);
		transition: opacity 180ms var(--ease-rain), transform 240ms var(--ease-drift);
		will-change: opacity, transform;
	}
	.tutorial-toolkit__status.is-stage-leaving,
	.tutorial-toolkit__grid.is-stage-leaving {
		opacity: 0;
		transform: translateY(8px);
	}
	.tutorial-toolkit__status p { color: var(--ink-muted); }
	.tutorial-toolkit__status strong {
		display: block;
		margin-top: 5px;
		font-family: var(--font-display);
		font-size: 25px;
		font-weight: 500;
	}
	.tutorial-toolkit__status span { display: block; margin-top: 6px; font-size: 12px; line-height: 1.65; color: var(--ink-muted); }

	.tutorial-toolkit__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
		margin-top: 10px;
		transition: opacity 180ms var(--ease-rain), transform 240ms var(--ease-drift);
		will-change: opacity, transform;
	}
	.tutorial-toolkit__grid.is-stage-leaving { pointer-events: none; }

	.tutorial-tool {
		min-height: 244px;
		overflow: hidden;
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper-0) 92%, transparent);
		box-shadow: 0 14px 30px rgb(23 48 55 / 0%);
		transition: min-height 420ms var(--ease-drift), opacity 280ms var(--ease-rain), transform 420ms var(--ease-drift), border-color var(--duration-base) var(--ease-rain), box-shadow 420ms var(--ease-rain), margin 420ms var(--ease-drift);
	}

	/*
	 * 被筛掉的卡片必须从 Grid 的布局树中移除。
	 * 仅把高度压到 0 会被卡片内部的 min-height 和 Grid 自动行轨道重新撑开，
	 * 这正是阶段只有一两张工具时出现大面积空白的原因；display:none 也同时保证
	 * 隐藏卡片不会继续参与鼠标命中或键盘焦点顺序。
	 */
	.tutorial-tool[data-filtered-out='true'] { display: none; }

	.tutorial-tool:hover,
	.tutorial-tool:focus-within,
	.tutorial-tool.is-active {
		border-color: var(--tool-accent);
		box-shadow: 0 16px 34px color-mix(in srgb, var(--tool-accent) 18%, transparent);
		transform: translateY(-4px);
	}

	.tutorial-tool__open {
		display: grid;
		grid-template-rows: auto minmax(132px, 1fr) auto;
		min-height: 242px;
		color: inherit;
		text-decoration: none;
	}

	.tutorial-tool__open > header,
	.tutorial-tool__open > footer {
		display: flex;
		gap: 8px;
		align-items: center;
		padding: 13px 14px;
	}
	.tutorial-tool__open > header { border-bottom: 1px solid color-mix(in srgb, var(--line) 76%, transparent); }
	.tutorial-tool__index { color: var(--tool-accent); }
	.tutorial-tool__code { color: var(--ink-muted); }
	.tutorial-tool__status { margin-left: auto; color: var(--ink-muted); }

	.tutorial-tool__body { padding: 18px 14px; }
	.tutorial-tool__body > p { color: var(--tool-accent); }
	.tutorial-tool__body h3 {
		margin: 7px 0 8px;
		font-family: var(--font-display);
		font-size: 26px;
		font-weight: 500;
		line-height: 1.2;
	}
	.tutorial-tool__body > span { display: block; font-size: 12px; line-height: 1.7; color: var(--ink-muted); }
	.tutorial-tool__open > footer { justify-content: space-between; border-top: 1px solid color-mix(in srgb, var(--line) 76%, transparent); color: var(--ink-muted); transition: color var(--duration-base) var(--ease-rain); }
	.tutorial-tool__open > footer svg { transition: transform var(--duration-base) var(--ease-rain); }
	.tutorial-tool:hover .tutorial-tool__open > footer,
	.tutorial-tool:focus-within .tutorial-tool__open > footer,
	.tutorial-tool.is-active .tutorial-tool__open > footer { color: var(--tool-accent); }
	.tutorial-tool:hover .tutorial-tool__open > footer svg,
	.tutorial-tool:focus-within .tutorial-tool__open > footer svg,
	.tutorial-tool.is-active .tutorial-tool__open > footer svg { transform: translateX(4px); }

	/* 新阶段的卡片在父级淡入时错峰回到原位，避免所有内容同时“弹出”。 */
	.tutorial-tool.is-stage-entering {
		opacity: 0;
		pointer-events: none;
		transform: translateY(10px);
		transition-delay: var(--tool-stage-delay, 0ms);
	}

	@media (max-width: 1050px) {
		.tutorial-toolkit__body { grid-template-columns: 1fr; }
		.tutorial-toolkit__rail-inner { position: static; }
		.tutorial-toolkit__stages { grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
		.tutorial-toolkit__stages button { min-height: 56px; }
		.tutorial-toolkit__stages button > strong { font-size: 11px; }
	}

	@media (max-width: 760px) {
		.tutorial-toolkit__header { align-items: start; flex-direction: column; }
		.tutorial-toolkit__reference { justify-items: start; }
		.tutorial-toolkit__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.tutorial-toolkit__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (prefers-reduced-motion: reduce) {
		.tutorial-tool,
		.tutorial-toolkit__status,
		.tutorial-toolkit__grid,
		.tutorial-tool.is-stage-entering,
		.tutorial-toolkit__stages button,
		.tutorial-toolkit__source,
		.tutorial-tool__open > footer,
		.tutorial-tool__open > footer svg { transition: none; }
	}
</style>

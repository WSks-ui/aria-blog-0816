---
import { render, type CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowRight, ExternalLink, GitBranch } from '@lucide/astro';
import ContentCoverScene from '@/components/visual/ContentCoverScene.astro';
import CoverVeil from '@/components/visual/CoverVeil.astro';
import { TUTORIAL_TOOL_STAGES, getToolTransitionName, type TutorialTool } from '@/data/tutorial-tools';
import '@/styles/interactive.css';

interface ToolNeighbor {
	tool: TutorialTool;
	index: number;
}

interface Props {
	tool: TutorialTool;
	guide: CollectionEntry<'toolGuides'>;
	previous?: ToolNeighbor;
	next?: ToolNeighbor;
}

const { tool, guide, previous, next } = Astro.props;
const { Content, headings } = await render(guide);
const stage = TUTORIAL_TOOL_STAGES.find((item) => item.id === tool.stage);
const stageIndex = stage?.index ?? '00';
const stageLabel = stage?.label ?? '工具路线';
const accent = stage?.accent ?? 'var(--accent-strong)';

// CSDIY 当前页面将仓库显示为 pkuflyingpig/cs-self-learning；同步脚本如携带仓库字段，
// 优先使用快照中的地址，避免未来上游迁移时页面仍把访客指向旧仓库。
const upstreamRepository =
	guide.data.sourceRepository ??
	guide.data.sourceRepoUrl ??
	guide.data.upstreamRepository ??
	guide.data.upstreamRepoUrl ??
	guide.data.repositoryUrl ??
	'https://github.com/pkuflyingpig/cs-self-learning/';

// Markdown 的 h1 已由封面标题承担视觉层级；目录从原文 h2/h3 生成，确保链接和正文
// 的 slug 完全由 Astro 编译结果决定，而不是在这里重新改写上游标题。
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<article class="tool-dossier" style={`--tool-dossier-accent: ${accent};`} data-tool-dossier>
	<header class="tool-dossier__hero">
		<div class="tool-dossier__cover">
			<ContentCoverScene kind="tutorial" class="tool-dossier__cover-scene" />
			<CoverVeil />
			<div class="tool-dossier__cover-label" aria-hidden="true">
				<span data-hud-type>TOOLKIT / {tool.code}</span>
				<span data-hud-type>STAGE / {stageIndex}</span>
			</div>
		</div>

		<div class="tool-dossier__heading">
			<a class="tool-dossier__back" href="/types/tutorial/" data-article-transition-link>
				<ArrowLeft size={16} stroke-width={1.5} aria-hidden="true" />
				工具导航
			</a>
			<div class="tool-dossier__eyebrow">
				<span>{stageIndex} / {stage?.code ?? 'TOOLCHAIN'}</span>
				<span>SYNCED GUIDE</span>
			</div>
			<!-- 与目录卡片标题共享同名转场：从卡片进入时标题飞入讲义页头，返回时飞回原卡。 -->
			<h1 transition:name={getToolTransitionName(tool)}>{guide.data.title}</h1>
			<div class="tool-dossier__meta">
				<span>{stageLabel}</span>
				<span>ARIA-7 / FIELD GUIDE</span>
			</div>
		</div>
	</header>

	<div class="tool-dossier__provenance" aria-label="上游来源信息">
		<div class="tool-dossier__provenance-label">
			<span>SOURCE RECORD</span>
			<strong>00</strong>
		</div>
		<div class="tool-dossier__provenance-copy">
			<p>本文正文直接渲染自 CSDIY 同步快照，站内页面只提供阅读框架与来源标记。</p>
			<div class="tool-dossier__provenance-meta">
				<span>同步自 CSDIY</span>
				<span>版本 / {guide.data.sourceRevision}</span>
				<a class="tool-dossier__license" href="/licenses/cs-self-learning-MIT.txt" target="_blank" rel="noreferrer" aria-label="查看 cs-self-learning 的 MIT 许可证文本">{guide.data.license} License</a>
			</div>
		</div>
	</div>

	<div class="tool-dossier__layout">
		<aside class="tool-dossier__guide" aria-label="工具讲义目录">
			<div class="tool-dossier__guide-inner">
				<p class="tool-dossier__guide-label" data-hud-type>CONTENTS / {tool.code}</p>
				<nav aria-label={`${guide.data.title}原文目录`}>
					{tocHeadings.length > 0 ? (
						<ol class="tool-dossier__toc">
							{tocHeadings.map((heading, index) => (
								<li class:list={[heading.depth === 3 && 'is-subheading']}>
									<a href={`#${heading.slug}`}>
										<span>{String(index + 1).padStart(2, '0')}</span>
										<strong>{heading.text}</strong>
									</a>
								</li>
							))}
						</ol>
					) : (
						<p class="tool-dossier__toc-empty">该同步版本未提供二级目录。</p>
					)}
				</nav>
				<div class="tool-dossier__guide-stage">
					<span>LEARNING STAGE</span>
					<strong>{stageIndex} / {stageLabel}</strong>
				</div>
			</div>
		</aside>

		<div class="tool-dossier__content">
			<div class="tool-dossier__source reading-prose" data-source-content data-article-title={guide.data.title}>
			<!-- Content 是 Astro 对同步 Markdown 的编译结果；不在此处拼接、摘要或改写上游正文。 -->
			<Content />
			</div>

			<section class="tool-dossier__resources" id="resources" aria-labelledby="resources-title">
				<header>
					<div>
						<span class="tool-dossier__section-index">SOURCE / 01</span>
						<p>REFERENCE / OPEN SOURCES</p>
					</div>
					<h2 id="resources-title">资料入口</h2>
				</header>
				<p>以下入口用于核对原文、同步版本、许可证和工具官方资料。</p>
				<div class="tool-dossier__resource-grid">
					<a href={tool.csdiyHref} target="_blank" rel="noreferrer noopener">
						<span><small>CSDIY / ORIGINAL PAGE</small><strong>查看 CSDIY 原文</strong></span>
						<ExternalLink size={17} stroke-width={1.5} aria-hidden="true" />
					</a>
					<a href={guide.data.sourceUrl} target="_blank" rel="noreferrer noopener">
						<span><small>SNAPSHOT / SOURCE FILE</small><strong>查看同步文件</strong></span>
						<ExternalLink size={17} stroke-width={1.5} aria-hidden="true" />
					</a>
					<a href={upstreamRepository} target="_blank" rel="noreferrer noopener">
						<span><small>UPSTREAM / REPOSITORY</small><strong>查看上游仓库</strong></span>
						<GitBranch size={17} stroke-width={1.5} aria-hidden="true" />
					</a>
					<a href={tool.href} target="_blank" rel="noreferrer noopener">
						<span><small>OFFICIAL / PRIMARY</small><strong>查看 {tool.name} 官方资料</strong></span>
						<ExternalLink size={17} stroke-width={1.5} aria-hidden="true" />
					</a>
				</div>
			</section>
		</div>
	</div>

	<nav class="tool-dossier__neighbors" aria-label="工具讲义导航">
		{previous ? (
			<a href={`/toolkit/${previous.tool.id}/`} data-article-transition-link>
				<ArrowLeft size={16} stroke-width={1.5} aria-hidden="true" />
				<span><small>PREVIOUS / {String(previous.index + 1).padStart(2, '0')}</small><strong transition:name={getToolTransitionName(previous.tool)}>{previous.tool.name}</strong></span>
			</a>
		) : <span class="tool-dossier__neighbor-placeholder" aria-hidden="true"></span>}
		<a class="tool-dossier__neighbors-index" href="/types/tutorial/" data-article-transition-link>
			<span>TOOLKIT</span>
			<strong>{stageIndex} / {tool.code}</strong>
		</a>
		{next ? (
			<a class="tool-dossier__neighbor-next" href={`/toolkit/${next.tool.id}/`} data-article-transition-link>
				<span><small>NEXT / {String(next.index + 1).padStart(2, '0')}</small><strong transition:name={getToolTransitionName(next.tool)}>{next.tool.name}</strong></span>
				<ArrowRight size={16} stroke-width={1.5} aria-hidden="true" />
			</a>
		) : <span class="tool-dossier__neighbor-placeholder" aria-hidden="true"></span>}
	</nav>
</article>

<style>
	.tool-dossier {
		--tool-dossier-accent: var(--accent-strong);
		max-width: calc(var(--content-wide) + var(--page-gutter) + var(--page-gutter));
		margin-inline: auto;
		padding-inline: var(--page-gutter);
	}

	.tool-dossier__hero {
		display: grid;
		grid-template-columns: minmax(430px, 1.1fr) minmax(420px, 0.9fr);
		padding-top: 42px;
	}

	.tool-dossier__cover {
		position: relative;
		min-height: 500px;
		overflow: hidden;
		background: var(--accent-soft);
	}

	.tool-dossier__cover-scene { position: absolute; inset: 0; }
	.tool-dossier__cover-label {
		position: absolute;
		z-index: 2;
		inset: 18px 20px auto;
		display: flex;
		justify-content: space-between;
		gap: 16px;
		font-family: var(--font-ui);
		font-size: 9px;
		color: var(--ink-muted);
	}

	.tool-dossier__heading {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
		padding: 48px 54px;
		border-block: 1px solid var(--line);
		border-right: 1px solid var(--line);
	}

	.tool-dossier__back {
		display: inline-flex;
		width: fit-content;
		min-height: 42px;
		align-items: center;
		gap: 8px;
		margin-bottom: auto;
		font-family: var(--font-ui);
		font-size: 11px;
		color: var(--ink-muted);
		text-decoration: none;
		transition: color var(--duration-base) var(--ease-rain), transform var(--duration-base) var(--ease-rain);
	}

	.tool-dossier__back:hover { color: var(--tool-dossier-accent); transform: translateX(-3px); }
	.tool-dossier__eyebrow,
	.tool-dossier__meta {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		font-family: var(--font-ui);
		font-size: 9px;
		letter-spacing: var(--tracking-hud);
		color: var(--ink-muted);
	}

	.tool-dossier__eyebrow span:first-child { color: var(--tool-dossier-accent); }
	.tool-dossier h1 {
		margin: 18px 0;
		font-family: var(--font-display);
		font-size: clamp(56px, 6vw, 88px);
		font-weight: 500;
		line-height: 1.1;
		overflow-wrap: anywhere;
	}

	.tool-dossier__meta { padding-top: 16px; border-top: 1px solid var(--line); }

	.tool-dossier__provenance {
		display: grid;
		grid-template-columns: 220px minmax(0, 760px);
		gap: 64px;
		padding-block: 42px 50px;
		border-bottom: 1px solid var(--line);
	}

	.tool-dossier__provenance-label {
		display: flex;
		justify-content: space-between;
		align-items: start;
		padding-right: 20px;
		border-right: 1px solid var(--line);
		font-family: var(--font-ui);
		font-size: 9px;
		color: var(--ink-muted);
	}

	.tool-dossier__provenance-label strong { font-size: 28px; font-weight: 400; color: var(--tool-dossier-accent); }
	.tool-dossier__provenance-copy { max-width: 760px; }
	.tool-dossier__provenance-copy p { margin: 0; font-size: 16px; line-height: 1.85; color: var(--ink-muted); }
	.tool-dossier__provenance-meta { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 22px; font-family: var(--font-ui); font-size: 10px; color: var(--tool-dossier-accent); }
	.tool-dossier__license { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
	.tool-dossier__license:hover { color: var(--ink); }

	.tool-dossier__layout {
		display: grid;
		grid-template-columns: 220px minmax(0, 760px);
		gap: 64px;
		padding-block: 78px 96px;
	}

	.tool-dossier__guide-inner { position: sticky; top: 112px; }
	.tool-dossier__guide-label,
	.tool-dossier__guide-stage span,
	.tool-dossier__resources header p,
	.tool-dossier__section-index,
	.tool-dossier__resource-grid small,
	.tool-dossier__neighbors small {
		font-family: var(--font-ui);
		font-size: 9px;
		letter-spacing: var(--tracking-hud);
	}

	.tool-dossier__guide-label { margin: 0; padding-bottom: 14px; border-bottom: 1px solid var(--line); color: var(--ink-muted); }
	.tool-dossier__toc { margin: 0; padding: 0; list-style: none; }
	.tool-dossier__toc li { border-bottom: 1px solid color-mix(in srgb, var(--line) 74%, transparent); }
	.tool-dossier__toc li.is-subheading a { padding-left: 18px; }
	.tool-dossier__toc a {
		display: grid;
		grid-template-columns: 32px minmax(0, 1fr);
		gap: 10px;
		align-items: center;
		min-height: 52px;
		padding-inline: 0;
		color: var(--ink-muted);
		text-decoration: none;
		transition: color var(--duration-base) var(--ease-rain), padding-inline var(--duration-base) var(--ease-drift), background-color var(--duration-base) var(--ease-rain);
	}

	.tool-dossier__toc a:hover { padding-inline: 10px; background: color-mix(in srgb, var(--tool-dossier-accent) 10%, transparent); color: var(--ink); }
	.tool-dossier__toc a span { font-family: var(--font-ui); font-size: 9px; color: var(--tool-dossier-accent); }
	.tool-dossier__toc a strong { font-size: 12px; font-weight: 500; }
	.tool-dossier__toc-empty { margin: 18px 0; font-size: 12px; color: var(--ink-muted); }
	.tool-dossier__guide-stage { display: grid; gap: 8px; margin-top: 44px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--ink-muted); }
	.tool-dossier__guide-stage strong { font-family: var(--font-display); font-size: 18px; font-weight: 500; color: var(--tool-dossier-accent); }

	.tool-dossier__content { min-width: 0; }
	.tool-dossier__source { min-width: 0; }
	/* 原文 h1 仍保留在编译后的 DOM 中，但视觉标题由上方封面承担，避免页面出现两个主标题。 */
	.tool-dossier__source :global(h1) { display: none; }
	.tool-dossier__source :global(img) { max-width: 100%; height: auto; }
	.tool-dossier__source :global(table) { display: block; max-width: 100%; overflow-x: auto; }
	.tool-dossier__source :global(a) { overflow-wrap: anywhere; }

	.tool-dossier__resources { margin-top: 76px; padding-top: 34px; border-top: 1px solid var(--line); }
	.tool-dossier__resources header { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 24px; align-items: start; }
	.tool-dossier__resources header > div { display: grid; gap: 10px; }
	.tool-dossier__resources header p { margin: 0; color: var(--ink-muted); }
	.tool-dossier__section-index { color: var(--tool-dossier-accent); }
	.tool-dossier__resources h2 { margin: 0; font-family: var(--font-display); font-size: 42px; font-weight: 500; line-height: 1.18; }
	.tool-dossier__resources > p { max-width: 620px; margin: 30px 0 0 164px; font-size: 15px; line-height: 1.75; color: var(--ink-muted); }
	.tool-dossier__resource-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 34px 0 0 164px; }
	.tool-dossier__resource-grid a {
		position: relative;
		display: flex;
		min-height: 112px;
		justify-content: space-between;
		align-items: end;
		gap: 16px;
		padding: 16px;
		border: 1px solid var(--line);
		color: var(--ink);
		text-decoration: none;
		transition: border-color var(--duration-base) var(--ease-rain), transform var(--duration-base) var(--ease-drift), background-color var(--duration-base) var(--ease-rain);
	}
	.tool-dossier__resource-grid a:hover { border-color: var(--tool-dossier-accent); background: color-mix(in srgb, var(--tool-dossier-accent) 8%, transparent); transform: translateY(-3px); }

	/*
	 * 纸角折起：悬停时右上角翻出一枚折页。梯度的折痕边让翻页有厚度，
	 * 从角点 scale 展开近似「掀角」的动作。
	 */
	.tool-dossier__resource-grid a::after {
		position: absolute;
		top: 0;
		right: 0;
		width: 22px;
		height: 22px;
		background: linear-gradient(
			225deg,
			color-mix(in srgb, var(--line) 62%, var(--color-surface)) 0%,
			var(--color-surface) 34%,
			color-mix(in srgb, var(--color-surface-muted) 82%, transparent) 100%
		);
		box-shadow: -4px 4px 9px rgb(23 48 55 / 15%);
		clip-path: polygon(0 0, 100% 100%, 0 100%);
		content: '';
		transform: scale(0);
		transform-origin: 100% 0;
		transition: transform 300ms var(--ease-drift);
	}

	.tool-dossier__resource-grid a:hover::after,
	.tool-dossier__resource-grid a:focus-visible::after {
		transform: scale(1);
	}
	.tool-dossier__resource-grid a > span { display: grid; gap: 10px; min-width: 0; }
	.tool-dossier__resource-grid small { color: var(--tool-dossier-accent); }
	.tool-dossier__resource-grid strong { font-size: 13px; font-weight: 500; }
	.tool-dossier__resource-grid svg { flex: 0 0 auto; color: var(--tool-dossier-accent); }

	.tool-dossier__neighbors { display: grid; grid-template-columns: minmax(0, 1fr) 160px minmax(0, 1fr); gap: 10px; align-items: stretch; margin-bottom: 112px; border-block: 1px solid var(--line); }
	.tool-dossier__neighbors > a { display: flex; min-height: 92px; align-items: center; gap: 12px; padding: 14px 16px; color: var(--ink); text-decoration: none; transition: background-color var(--duration-base) var(--ease-rain), color var(--duration-base) var(--ease-rain); }
	.tool-dossier__neighbors > a:hover { background: color-mix(in srgb, var(--tool-dossier-accent) 8%, transparent); color: var(--tool-dossier-accent); }
	.tool-dossier__neighbors > a > span { display: grid; gap: 8px; min-width: 0; }
	.tool-dossier__neighbors small { color: var(--ink-muted); }
	.tool-dossier__neighbors strong { font-family: var(--font-display); font-size: 18px; font-weight: 500; overflow-wrap: anywhere; }
	.tool-dossier__neighbor-next { justify-content: flex-end; text-align: right; }
	.tool-dossier__neighbors-index { display: grid; align-content: center; justify-items: center; gap: 8px; border-inline: 1px solid var(--line); font-family: var(--font-ui); font-size: 9px; color: var(--ink-muted) !important; }
	.tool-dossier__neighbors-index strong { font-family: var(--font-ui); font-size: 10px; color: var(--tool-dossier-accent); }
	.tool-dossier__neighbor-placeholder { min-width: 0; }

	@media (max-width: 1100px) {
		.tool-dossier__hero { grid-template-columns: 1fr; }
		.tool-dossier__cover { min-height: 380px; }
		.tool-dossier__heading { border-inline: 1px solid var(--line); }
	}

	@media (max-width: 900px) {
		.tool-dossier__provenance,
		.tool-dossier__layout { grid-template-columns: 1fr; gap: 34px; }
		.tool-dossier__provenance-label { padding: 0 0 14px; border-right: 0; border-bottom: 1px solid var(--line); }
		.tool-dossier__guide-inner { position: static; }
		.tool-dossier__toc { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.tool-dossier__toc li { border-right: 1px solid var(--line); }
		.tool-dossier__toc li:nth-child(even) { border-right: 0; }
		.tool-dossier__toc a { min-height: 68px; padding: 12px; }
		.tool-dossier__guide-stage { display: none; }
		.tool-dossier__resources > p,
		.tool-dossier__resource-grid { margin-left: 0; }
		.tool-dossier__resource-grid { grid-template-columns: 1fr; }
	}

	@media (max-width: 760px) {
		.tool-dossier { padding-inline: 20px; }
		.tool-dossier__heading { padding: 36px 24px; }
		.tool-dossier h1 { font-size: 48px; }
		.tool-dossier__cover { min-height: 290px; }
		.tool-dossier__provenance { padding-block: 34px 44px; }
		.tool-dossier__layout { padding-block: 56px 72px; }
		.tool-dossier__resources header { grid-template-columns: 1fr; gap: 12px; }
		.tool-dossier__resources h2 { font-size: 34px; }
		.tool-dossier__neighbors { grid-template-columns: 1fr 1fr; }
		.tool-dossier__neighbors-index { grid-column: 1 / -1; grid-row: 1; min-height: 56px; border-inline: 0; border-bottom: 1px solid var(--line); }
		.tool-dossier__neighbor-placeholder { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.tool-dossier__back,
		.tool-dossier__toc a,
		.tool-dossier__resource-grid a,
		.tool-dossier__neighbors > a { transition: none; }

		.tool-dossier__resource-grid a::after { transition: none; }
	}
</style>

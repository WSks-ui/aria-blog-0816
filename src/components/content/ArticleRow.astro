---
import { ArrowUpRight } from '@lucide/astro';
import type { PostEntry } from '@/lib/content';
import { getPostPath, getPostTransitionName } from '@/lib/content';
import { POST_KIND_LABELS } from '@/data/site';
import KindLabel from './KindLabel.astro';

interface Props {
	post: PostEntry;
	index?: number;
	showSummary?: boolean;
}

const { post, index, showSummary = true } = Astro.props;
// Frontmatter 日期为纯日期字符串（UTC 午夜）。格式化固定 UTC，
// 构建结果才不依赖构建机器的时区。
const dateText = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'UTC',
}).format(post.data.publishedAt);
---

<article class="article-row">
	<div class="article-row__index">
		{index !== undefined ? String(index).padStart(2, '0') : dateText.slice(0, 7)}
	</div>
	<div class="article-row__body">
		<KindLabel kind={post.data.kind} />
			<h3><a href={getPostPath(post)} data-article-transition-link transition:name={getPostTransitionName(post)}>{post.data.title}</a></h3>
		{showSummary && <p>{post.data.summary}</p>}
	</div>
	<div class="article-row__meta">
		<time datetime={post.data.publishedAt.toISOString()}>{dateText}</time>
		<div class="article-row__tags">
			{post.data.tags.slice(0, 2).map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
		</div>
		<span>{POST_KIND_LABELS[post.data.kind]}</span>
	</div>
	<a class="article-row__go" href={getPostPath(post)} aria-label={`阅读《${post.data.title}》`} data-article-transition-link>
		<ArrowUpRight size={20} stroke-width={1.5} aria-hidden="true" />
	</a>
</article>

<style>
	.article-row {
		position: relative;
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr) minmax(180px, 0.35fr) 44px;
		gap: 22px;
		align-items: center;
		min-height: 132px;
		padding-block: 24px;
		border-top: 1px solid var(--line);
		transition: background-color var(--duration-fast) ease;
	}

	.article-row:last-child {
		border-bottom: 1px solid var(--line);
	}

	/*
	 * 整行热区：标题链接的 ::after 铺满整行，行内其余链接（标签、箭头）
	 * 通过定位层级保持独立可点。hover / 键盘焦点共用同一套行级反馈。
	 */
	.article-row:hover,
	.article-row:has(> .article-row__body h3 a:focus-visible) {
		background: color-mix(in srgb, var(--accent-soft) 16%, transparent);
	}

	.article-row__index,
	.article-row__meta,
	.article-row__tags {
		font-family: var(--font-ui);
		font-size: 10px;
		color: var(--ink-muted);
	}

	.article-row__index {
		align-self: stretch;
		padding-top: 3px;
		border-right: 1px solid var(--line);
		transition: color var(--duration-fast) ease;
	}

	.article-row:hover .article-row__index,
	.article-row:has(> .article-row__body h3 a:focus-visible) .article-row__index {
		color: var(--accent-strong);
	}

	.article-row h3 {
		position: relative;
		margin: 8px 0 6px;
		padding-left: 16px;
		font-family: var(--font-display);
		font-size: 21px;
		font-weight: 500;
		line-height: 1.45;
	}

	/* 方纸母题：常驻的 7px 章节方块位，hover 时由纸面浮起为雨青实体。 */
	.article-row h3::before {
		position: absolute;
		top: 0.62em;
		left: 0;
		width: 7px;
		height: 7px;
		content: '';
		background: var(--accent-strong);
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity var(--duration-fast) ease, transform var(--duration-base) var(--ease-drift);
	}

	.article-row:hover h3::before,
	.article-row:has(> .article-row__body h3 a:focus-visible) h3::before {
		opacity: 1;
		transform: translateX(0);
	}

	.article-row h3 a {
		color: var(--ink);
		text-decoration: none;
	}

	.article-row h3 a::after {
		position: absolute;
		inset: -24px -22px;
		content: '';
	}

	.article-row h3 a:hover,
	.article-row h3 a:focus-visible {
		color: var(--accent-strong);
	}

	.article-row__body > p {
		max-width: 680px;
		margin: 0;
		font-size: 13px;
		line-height: 1.75;
		color: var(--ink-muted);
	}

	.article-row__meta {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 8px;
		align-content: center;
	}

	.article-row__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.article-row__tags a {
		position: relative;
		z-index: 1;
		color: var(--accent-strong);
		text-decoration: none;
	}

	.article-row__go {
		position: relative;
		z-index: 1;
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border-left: 1px solid var(--line);
		color: var(--ink-muted);
		transition: color var(--duration-fast) ease, transform var(--duration-base) var(--ease-drift);
	}

	.article-row:hover .article-row__go,
	.article-row:has(> .article-row__body h3 a:focus-visible) .article-row__go {
		color: var(--accent-strong);
		transform: translate(2px, -2px);
	}

	@media (max-width: 760px) {
		.article-row {
			grid-template-columns: 36px minmax(0, 1fr) 44px;
			gap: 14px;
		}

		.article-row h3 a::after {
			inset: -24px -14px;
		}

		.article-row__meta {
			grid-column: 2;
		}

		.article-row__go {
			grid-column: 3;
			grid-row: 1 / 3;
		}
	}
</style>

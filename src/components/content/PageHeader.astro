---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	count?: number;
	/** 将标题中的共享词组单独渲染，供命名 View Transition 匹配使用。 */
	sharedTitle?: string;
	/** 由页面语义决定标题区密度，避免页面组件依赖跨作用域 CSS 覆盖。 */
	variant?: 'default' | 'photo' | 'tutorial';
}

const { eyebrow, title, description, count, sharedTitle, variant = 'default' } = Astro.props;
---

<header class:list={['page-header', variant !== 'default' && `page-header--${variant}`]}>
	<div class="page-header__rail">
		<span>{eyebrow}</span>
		{count !== undefined && <strong>{String(count).padStart(2, '0')}</strong>}
	</div>
	<div class="page-header__main">
		<h1 aria-label={title}>
			{sharedTitle && title.endsWith(sharedTitle) ? (
				<>
					{title.slice(0, -sharedTitle.length)}
					<span class="page-header__shared-title" data-aria7-title-transition transition:name="aria7-title">{sharedTitle}</span>
				</>
			) : title}
		</h1>
		{description && <p>{description}</p>}
	</div>
	<div class="page-header__mark" aria-hidden="true">
		<img src="/assets/brand/rain-archive-mark.svg" alt="" width="84" height="84" />
	</div>
</header>

<style>
	.page-header {
		display: grid;
		grid-template-columns: 140px minmax(0, 1fr) 120px;
		gap: 32px;
		align-items: end;
		/*
		 * 栏目页需要先建立档案感，再把读者带入列表；旧的 300px 起始区在
		 * 项目、札记和归档中把首条内容推得太低。此处收紧通用页头，保留标题
		 * 与标记的呼吸空间，同时让所有非专用变体的栏目保持同一进入节奏。
		 */
		min-height: 236px;
		padding-block: 54px 34px;
		border-bottom: 1px solid var(--line);
	}

	.page-header__rail {
		display: grid;
		gap: 18px;
		align-self: stretch;
		align-content: space-between;
		padding-right: 22px;
		border-right: 1px solid var(--line);
		font-family: var(--font-ui);
		font-size: 10px;
		color: var(--ink-muted);
		overflow-wrap: anywhere;
	}

	.page-header__rail strong {
		font-size: 28px;
		font-weight: 400;
		color: var(--accent-strong);
	}

	.page-header h1 {
		max-width: 900px;
		margin: 0;
		font-family: var(--font-display);
		font-size: 72px;
		font-weight: 500;
		line-height: 1.16;
		overflow-wrap: anywhere;
	}

	.page-header__shared-title { display: inline-block; white-space: nowrap; }

	.page-header p {
		max-width: 680px;
		margin: 22px 0 0;
		font-size: 15px;
		line-height: 1.85;
		color: var(--ink-muted);
		overflow-wrap: anywhere;
	}

	.page-header__mark {
		display: grid;
		place-items: center;
		align-self: center;
		opacity: 0.56;
	}

	/* 收藏底片与工具导航不是文章导读，需要更紧凑的起始节奏。
	   这些变体留在 PageHeader 内部，保证标题字号与组件作用域一起生效。 */
	.page-header--photo { min-height: 210px; padding-block: 44px 30px; }
	.page-header--photo h1 { font-size: 56px; }
	.page-header--tutorial { min-height: 222px; padding-block: 54px 30px; }
	.page-header--tutorial h1 { font-size: 58px; }

	@media (max-width: 1000px) {
		/* 通用页头在平板宽度收一级字号，区间内保持固定。 */
		.page-header h1 {
			font-size: 56px;
		}
	}

	@media (max-width: 760px) {
		.page-header {
			grid-template-columns: 1fr;
			min-height: auto;
			padding-block: 56px 36px;
		}

		.page-header__rail {
			grid-template-columns: 1fr auto;
			padding: 0 0 14px;
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}

		.page-header__mark {
			display: none;
		}

		.page-header h1 {
			font-size: 42px;
		}
	}
</style>

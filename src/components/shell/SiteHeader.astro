---
import { GitBranch, Network, Rss, Search } from '@lucide/astro';
import AmbientToggle from '@/components/interactive/AmbientToggle.astro';
import { SECTION_NAV_ITEMS } from '@/data/site';
import '@/styles/interactive.css';

interface Props {
	pathname: string;
}

const { pathname } = Astro.props;
// 没有真实地址时隐藏入口，避免把访客带到 GitHub 首页这种“看似可用”的占位链接。
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL?.trim() || '';

const navItems = SECTION_NAV_ITEMS;

const isActive = (href: string) => pathname === href || pathname.startsWith(href.replace(/\/$/, '') + '/');
---

<!--
	栏目页由 ClientRouter 交换内容时，页头作为稳定的导航坐标系必须保留原 DOM：
	这样品牌、工具与标签栏不会跟随正文一起卸载再显现，读者能持续辨认当前位置。
	选中态会在下方脚本的 astro:after-swap 回调中按当前 URL 重新同步。
-->
<header class="site-header" data-site-header transition:persist="site-header">
	{/* 品牌链接只在关于页承担「纸面显影」的返回入口；其他页面保持普通导航，
	    编排由 SharedTitleTransition 的镜像路由守卫（/ ↔ /about）统一把关。 */}
	<a
		class="site-brand"
		href="/"
		aria-label="Aria-7 首页"
		data-aria7-title-transition-link={pathname === '/about/' ? '' : undefined}
	>
		<img src="/assets/brand/rain-archive-mark.svg" alt="" width="40" height="40" />
		<span class="site-brand__name">Aria-7</span>
		<span class="site-brand__meta">RAIN ARCHIVE / 001</span>
	</a>

	<nav class="site-nav" aria-label="主导航" data-site-nav>
		<span class="site-nav__indicator" aria-hidden="true" data-site-nav-indicator></span>
		{navItems.map((item, index) => (
			<a
				href={item.href}
				aria-current={isActive(item.href) ? 'page' : undefined}
				data-site-nav-link
				data-site-nav-index={index}
			>
				{item.label}
			</a>
		))}
	</nav>

	<div class="site-tools">
		<a class="icon-button site-tool-button" href="/connections/" aria-label="文章关系图">
			<Network size={19} stroke-width={1.6} />
			<span class="site-tool-button__label" aria-hidden="true">关系图</span>
		</a>
		<button class="icon-button site-tool-button" type="button" aria-label="搜索" data-search-trigger>
			<Search size={19} stroke-width={1.6} />
			<span class="site-tool-button__label" aria-hidden="true">搜索</span>
		</button>
		<a class="icon-button site-tool-button" href="/rss.xml" aria-label="RSS 订阅" data-astro-reload>
			<Rss size={19} stroke-width={1.6} />
			<span class="site-tool-button__label" aria-hidden="true">RSS</span>
		</a>
		<AmbientToggle />
		{githubUrl && (
			<a class="icon-button site-tool-button" href={githubUrl} aria-label="GitHub" data-github-link rel="noreferrer">
				<GitBranch size={19} stroke-width={1.6} />
				<span class="site-tool-button__label" aria-hidden="true">GitHub</span>
			</a>
		)}
		<slot name="weather-control" />
	</div>
</header>

<script>
	const normalizePath = (pathname: string) => pathname.replace(/\/+$/, '') || '/';

	function initSiteHeaderNavigation() {
		document.querySelectorAll<HTMLElement>('[data-site-nav]').forEach((nav) => {
			if (nav.dataset.navigationReady === 'true') return;
			nav.dataset.navigationReady = 'true';
			const indicator = nav.querySelector<HTMLElement>('[data-site-nav-indicator]');
			const links = [...nav.querySelectorAll<HTMLElement>('[data-site-nav-link]')];
			type IndicatorGeometry = { x: number; width: number };
			// 首页没有匹配的栏目路由时，以“随笔”作为视觉起点；进入具体栏目后仍优先使用真实当前项。
			let activeLink: HTMLElement | null = nav.querySelector<HTMLElement>('[data-site-nav-link][aria-current="page"]')
				?? links[0]
				?? null;
			let currentTarget: HTMLElement | null = activeLink;
			const indicatorGeometry = new Map<HTMLElement, IndicatorGeometry>();
			let measurementFrame = 0;
			let placeAfterMeasurement = false;
			let hasEntered = false;
			if (!indicator) return;

			const measureIndicatorTargets = () => {
				/*
				 * 页头由 transition:persist 保留，栏目链接在换页前后没有换节点或换
				 * 几何。只在首帧、字体/视口确实改变 nav 尺寸时批量测量；after-swap
				 * 直接使用缓存，避免 DOM 刚替换时 getBoundingClientRect 强制整页布局。
				 */
				const navBounds = nav.getBoundingClientRect();
				const measured = links.map((link) => ({ link, bounds: link.getBoundingClientRect() }));
				const horizontalInset = 12;
				indicatorGeometry.clear();
				measured.forEach(({ link, bounds }) => {
					indicatorGeometry.set(link, {
						// 坐标取整，让静止的指示线落在整数像素上，1x 屏不因小数坐标发虚。
						x: Math.round(bounds.left - navBounds.left - horizontalInset),
						width: Math.round(bounds.width + horizontalInset * 2),
					});
				});
			};

			const queueIndicatorMeasurement = (placeImmediately = true) => {
				placeAfterMeasurement ||= placeImmediately;
				if (measurementFrame) return;
				measurementFrame = requestAnimationFrame(() => {
					measurementFrame = 0;
					measureIndicatorTargets();
					const shouldPlaceImmediately = placeAfterMeasurement;
					placeAfterMeasurement = false;
					moveIndicator(currentTarget, shouldPlaceImmediately);
				});
			};

			const moveIndicator = (link: HTMLElement | null, placeImmediately = false, mode: 'pointer' | 'route' = 'pointer') => {
				currentTarget = link;
				if (!link) {
					nav.dataset.navCursorVisible = 'false';
					return;
				}
				const geometry = indicatorGeometry.get(link);
				if (!geometry) {
					queueIndicatorMeasurement(placeImmediately);
					return;
				}
				// 指针交互要果断（快启动 ease-out），换页落位保留整站 drift 节奏；
				// transition 取样式变更后的计算值，所以在写入坐标前先切换模式标记。
				if (mode === 'route') nav.dataset.navMove = 'route';
				else delete nav.dataset.navMove;
				indicator.style.setProperty('--nav-indicator-x', `${geometry.x}px`);
				indicator.style.setProperty('--nav-indicator-w', `${geometry.width}px`);
				nav.dataset.navCursorVisible = 'true';
				if (placeImmediately) {
					if (hasEntered) {
						// 重排重测等后续立即落位保持无过渡快照，线不重画。
						indicator.classList.add('is-placing');
						requestAnimationFrame(() => indicator.classList.remove('is-placing'));
					} else {
						// 首次落位让线「自己写出来」：x 即时就位、宽度从 0 描到目标。
						// 入场不是换页滑动，撤掉 route 标记避免 520ms 规则抢走时长。
						delete nav.dataset.navMove;
						indicator.classList.add('is-entering');
						window.setTimeout(() => indicator.classList.remove('is-entering'), 1200);
					}
					hasEntered = true;
				} else {
					// 任何动画换位都终止入场：宽度中途改用常规过渡平滑续接。
					indicator.classList.remove('is-entering');
				}
			};

			/*
			 * transition:persist 会保留旧页头节点，因此服务端渲染给新页面的
			 * aria-current 不会自动落到这个节点上。每次正文交换完成后依据
			 * location 重新计算选中标签，同时让指示线从旧标签滑向新标签。
			 * 品牌链接的 Aria-7 共享标题入口也在这里同步，保证 about→首页
			 * 仍可通过点击品牌触发镜像转场。
			 */
			const syncRouteState = (placeImmediately = false) => {
				const currentPath = normalizePath(window.location.pathname);
				activeLink = links.find((link) => {
					const href = link.getAttribute('href');
					if (!href) return false;
					const targetPath = normalizePath(new URL(href, window.location.href).pathname);
					return currentPath === targetPath || currentPath.startsWith(`${targetPath}/`);
				}) ?? null;

				links.forEach((link) => {
					if (link === activeLink) link.setAttribute('aria-current', 'page');
					else link.removeAttribute('aria-current');
				});

				const header = nav.closest<HTMLElement>('[data-site-header]');
				const brand = header?.querySelector<HTMLAnchorElement>('.site-brand') ?? null;
				if (brand) {
					if (currentPath === '/about') brand.setAttribute('data-aria7-title-transition-link', '');
					else brand.removeAttribute('data-aria7-title-transition-link');
				}

				moveIndicator(activeLink ?? links[0] ?? null, placeImmediately, 'route');
			};

			/*
			 * Astro 默认只按浏览器历史判定 forward/back，普通 Tab 点击都会被当作
			 * forward。栏目索引让“向左找前页”和“向右找后页”拥有真实的空间方向：
			 * 这里改写 preparation.direction 后，ClientRouter 会把它传给原生快照
			 * 以及 fallback 动画，因此两条渲染路径的进出方向始终一致。
			 */
			document.addEventListener('astro:before-preparation', (event) => {
				if (event.navigationType === 'traverse') return;
				if (!(event.sourceElement instanceof Element)) return;

				const targetLink = event.sourceElement.closest<HTMLElement>('[data-site-nav-link][data-site-nav-index]');
				if (!targetLink || !nav.contains(targetLink)) return;

				const currentIndex = Number(activeLink?.dataset.siteNavIndex);
				const targetIndex = Number(targetLink.dataset.siteNavIndex);
				if (!Number.isFinite(currentIndex) || !Number.isFinite(targetIndex) || currentIndex === targetIndex) return;

				event.direction = targetIndex < currentIndex ? 'back' : 'forward';
			});

			links.forEach((link) => {
				link.addEventListener('pointerenter', () => moveIndicator(link, nav.dataset.navCursorVisible !== 'true'));
				link.addEventListener('focus', () => moveIndicator(link, nav.dataset.navCursorVisible !== 'true'));
			});
			nav.addEventListener('pointerleave', () => {
				const focusedLink = document.activeElement instanceof HTMLElement && nav.contains(document.activeElement)
					? document.activeElement.closest<HTMLElement>('[data-site-nav-link]')
					: null;
				moveIndicator(focusedLink ?? activeLink);
			});
			nav.addEventListener('focusout', () => {
				requestAnimationFrame(() => {
					if (!nav.contains(document.activeElement)) moveIndicator(activeLink);
				});
			});

			// 字体载入、窗口变化或工具区宽度改变后重新测量，避免指示器与文字错位。
			const resizeObserver = new ResizeObserver(() => queueIndicatorMeasurement(true));
			resizeObserver.observe(nav);
			// nav 在桌面端可能保持固定网格宽度；字体替换只改变单个链接宽度时，
			// 观察父级未必回调，因此同一观察器也直接覆盖每个测量目标。
			links.forEach((link) => resizeObserver.observe(link));
			// 首屏先完成一轮批量读取，再写选中态和指示线；后续栏目切换完全命中缓存。
			requestAnimationFrame(() => {
				measureIndicatorTargets();
				syncRouteState(true);
			});
			document.addEventListener('astro:after-swap', () => syncRouteState());
		});
	}

	initSiteHeaderNavigation();
	document.addEventListener('astro:page-load', initSiteHeaderNavigation);
</script>

<style>
	.site-header {
		position: relative;
		z-index: var(--z-nav);
		display: grid;
		grid-template-columns: minmax(230px, 1fr) auto;
		align-items: center;
		min-height: 84px;
		margin-inline: auto;
		padding: 0 var(--page-gutter);
		border-bottom: 1px solid var(--line);
		/* 页头先给静态纸面色，支持 color-mix 时再恢复透明玻璃层。 */
		background: var(--paper-0);
		background: color-mix(in srgb, var(--paper-0) 90%, transparent);
		backdrop-filter: blur(12px);
	}

	.site-brand {
		display: grid;
		grid-template-columns: 40px auto;
		grid-template-rows: 1fr auto;
		column-gap: 12px;
		align-items: center;
		width: max-content;
		color: var(--ink);
		text-decoration: none;
	}

	.site-brand img {
		grid-row: 1 / 3;
	}

	.site-brand__name {
		align-self: end;
		font-family: var(--font-display);
		font-size: 24px;
		line-height: 1;
	}

	.site-brand__meta {
		align-self: start;
		font-family: var(--font-ui);
		font-size: 9px;
		line-height: 1.4;
		color: var(--ink-muted);
	}

	.site-nav {
		/*
		 * 导航以页头的几何中心为基准，而不是以品牌与工具区之间的剩余列为基准。
		 * 两侧内容宽度不对称时，这能保持栏目序列始终位于页面中线。
		 */
		position: absolute;
		top: 50%;
		left: 50%;
		isolation: isolate;
		display: flex;
		justify-content: center;
		gap: clamp(16px, 2vw, 34px);
		transform: translate(-50%, -50%);
		white-space: nowrap;
	}

	.site-nav__indicator {
		position: absolute;
		z-index: 0;
		top: 6px;
		left: 0;
		width: var(--nav-indicator-w, 0px);
		height: 32px;
		opacity: 0;
		transform: translate3d(var(--nav-indicator-x, 0px), 0, 0);
		/*
		 * 悬停跟随必须果断：520ms 慢启动的 drift 会让线在光标扫过栏目时
		 * 永远落后 100px 以上，读起来像故障；这里用快启动强减速的 ease-out，
		 * 光标停下后约 100ms 内落位。文字 140ms 变色 → 线 280ms 收拢，
		 * 反馈层级是「先认出、再落定」。
		 *
		 * 宽度必须走布局属性，不能用「1px 基线 × scaleX(54)」：合成器会把
		 * 放大 50 余倍的 1px 纹理重采样，在 1.25/1.5 这类非整数缩放屏上
		 * 右端被拉长 3–5px 且边缘发虚，整条线看起来不居中。指示线是
		 * 脱流绝对定位元素，逐帧 width 重排只涉及它自己，开销可忽略。
		 */
		transition: transform 280ms var(--ease-rain), width 280ms var(--ease-rain), opacity 220ms var(--ease-rain);
		pointer-events: none;
	}

	.site-nav__indicator::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 1px;
		/* 指示线与阴影先给静态值，避免旧浏览器丢失当前栏目落点。 */
		background: var(--accent-strong);
		background: color-mix(in srgb, var(--accent-strong) 88%, var(--ink));
		box-shadow: 0 1px 0 var(--line-strong);
		box-shadow: 0 1px 0 color-mix(in srgb, var(--accent-strong) 22%, transparent);
		content: '';
	}

	.site-nav[data-nav-cursor-visible='true'] .site-nav__indicator {
		opacity: 1;
	}

	/*
	 * 换页落位是单次编排动作，且被整页视图转场遮住，保留较长的 drift；
	 * 只在 after-swap 时由脚本临时标记，下一次指针交互会自行清除。
	 */
	.site-nav[data-nav-move='route'] .site-nav__indicator {
		transition-duration: 520ms, 520ms, 220ms;
	}

	.site-nav__indicator.is-placing {
		transition: none;
	}

	/*
	 * 首次载入：指示线像落笔一样在当前栏目下描出来。x 用 0ms 即时就位，
	 * 宽度延迟 300ms（等标签先落纸）再从 0 描到目标。整条声明覆盖
	 * transition 简写并提到 route 规则之后，入场不会被 520ms drift 抢走。
	 */
	.site-nav .site-nav__indicator.is-entering {
		transition:
			transform 0ms,
			width 620ms var(--ease-rain) 300ms,
			opacity 300ms var(--ease-rain) 300ms;
	}

	.site-nav a {
		position: relative;
		z-index: 1;
		padding-block: 12px;
		font-family: var(--font-ui);
		font-size: 15px;
		font-weight: var(--font-ui-weight);
		line-height: 1.2;
		color: var(--ink-muted);
		text-decoration: none;
		transition: color var(--duration-fast) var(--ease-rain);
	}

	.site-nav a:hover,
	.site-nav a:focus-visible,
	.site-nav a[aria-current='page'] {
		color: var(--ink);
	}

	.site-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 2px;
	}

	/*
	 * 工具按钮族本体（.icon-button / .site-tool-button 及其悬停语法）
	 * 定义在 styles/interactive.css：像 AmbientToggle 这样以独立组件
	 * 渲染的按钮拿不到本组件的样式作用域，只有全局定义才能覆盖到。
	 * 这里只保留工具区的排布与页头自身的组合规则。
	 */

	@media (max-width: 1100px) {
		.site-header {
			grid-template-columns: 1fr auto;
		}

		.site-nav {
			position: relative;
			top: auto;
			left: auto;
			grid-column: 1 / -1;
			grid-row: 2;
			justify-content: flex-start;
			overflow-x: auto;
			border-top: 1px solid var(--line);
			transform: none;
		}
	}

	@media (max-width: 760px) {
		.site-header {
			padding-inline: 20px;
		}

		/*
		 * 只隐品牌 meta、关系图与 GitHub。目标必须用显式标记选中：
		 * last-of-type 之类的兄弟序数在 GitHub 链接缺席时会误伤 RSS。
		 * （工具按钮标签的窄屏隐藏也在 interactive.css 的按钮族里。）
		 */
		.site-brand__meta,
		.site-tools > :global(a:first-child),
		.site-tools > :global([data-github-link]) {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav__indicator,
		.site-nav .site-nav__indicator.is-entering {
			transition: none;
		}
	}

	/* 与 interactive.css 的窄屏挤压配套：品牌与页边距同步让位给工具区。
	 * 430px 以下再藏 RSS（订阅在触屏上价值最低），保证工具区完整放下。 */
	@media (max-width: 430px) {
		.site-header {
			padding-inline: 14px;
		}

		.site-brand {
			column-gap: 8px;
		}

		.site-brand img {
			width: 32px;
			height: 32px;
		}

		.site-brand__name {
			font-size: 20px;
		}

		.site-tools {
			gap: 0;
		}

		.site-tools > :global(a[href='/rss.xml']) {
			display: none;
		}
	}

/*
 * 320–360px 极窄视口：品牌 + 工具区 + 页边距的需求宽度仍超出视口约 15px，
 * 溢出部分会被全局 overflow-x: clip 静默裁掉，天气控件右缘不可见。
 * 雨声是工具区里优先级最低的开关，让位后工具区可完整放下。
 */
@media (max-width: 360px) {
	.site-tools > :global([data-ambient-toggle]) {
		display: none;
	}
}
</style>

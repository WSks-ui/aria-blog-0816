---
import { GitBranch, Network, Rss, Search } from '@lucide/astro';

interface Props {
	pathname: string;
}

const { pathname } = Astro.props;

const navItems = [
	{ href: '/types/essay/', label: '长文' },
	{ href: '/types/note/', label: '笔记' },
	{ href: '/types/project/', label: '项目' },
	{ href: '/types/photo/', label: '影像' },
	{ href: '/types/tutorial/', label: '教程' },
	{ href: '/archive/', label: '归档' },
];

const isActive = (href: string) => pathname === href || pathname.startsWith(href.replace(/\/$/, '') + '/');
---

<header class="site-header" data-site-header>
	<a class="site-brand" href="/" aria-label="Aria-7 首页">
		<img src="/assets/brand/rain-archive-mark.svg" alt="" width="40" height="40" />
		<span class="site-brand__name">Aria-7</span>
		<span class="site-brand__meta">RAIN ARCHIVE / 001</span>
	</a>

	<nav class="site-nav" aria-label="主导航">
		{navItems.map((item) => (
			<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
				{item.label}
			</a>
		))}
	</nav>

	<div class="site-tools">
		<a class="icon-button" href="/connections/" aria-label="文章关系图" data-tooltip="文章关系图">
			<Network size={19} stroke-width={1.6} />
		</a>
		<button class="icon-button" type="button" aria-label="搜索" data-tooltip="搜索" data-search-trigger>
			<Search size={19} stroke-width={1.6} />
		</button>
		<a class="icon-button" href="/rss.xml" aria-label="RSS 订阅" data-tooltip="RSS 订阅">
			<Rss size={19} stroke-width={1.6} />
		</a>
		<a class="icon-button" href="https://github.com/" aria-label="GitHub" data-tooltip="GitHub">
			<GitBranch size={19} stroke-width={1.6} />
		</a>
		<slot name="weather-control" />
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 50;
		display: grid;
		grid-template-columns: minmax(230px, 0.9fr) minmax(520px, 1.8fr) auto;
		align-items: center;
		min-height: 84px;
		margin-inline: auto;
		padding: 0 var(--page-gutter);
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper-0) 90%, transparent);
		backdrop-filter: blur(12px);
	}

	.site-brand {
		display: grid;
		grid-template-columns: 40px auto;
		grid-template-rows: 1fr auto;
		column-gap: 12px;
		align-items: center;
		width: max-content;
		color: var(--ink);
		text-decoration: none;
	}

	.site-brand img {
		grid-row: 1 / 3;
	}

	.site-brand__name {
		align-self: end;
		font-family: var(--font-display);
		font-size: 24px;
		line-height: 1;
	}

	.site-brand__meta {
		align-self: start;
		font-family: var(--font-ui);
		font-size: 9px;
		line-height: 1.4;
		color: var(--ink-muted);
	}

	.site-nav {
		display: flex;
		justify-content: center;
		gap: clamp(16px, 2vw, 34px);
	}

	.site-nav a {
		position: relative;
		padding-block: 12px;
		font-family: var(--font-ui);
		font-size: 13px;
		color: var(--ink-muted);
		text-decoration: none;
	}

	.site-nav a::before {
		position: absolute;
		bottom: 5px;
		left: 0;
		width: 100%;
		height: 1px;
		background: var(--accent-strong);
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--duration-fast) ease-out;
	}

	.site-nav a:hover,
	.site-nav a[aria-current='page'] {
		color: var(--ink);
	}

	.site-nav a:hover::before,
	.site-nav a[aria-current='page']::before {
		transform: scaleX(1);
	}

	.site-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 2px;
	}

	.icon-button {
		display: inline-grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--ink-muted);
		text-decoration: none;
		cursor: pointer;
	}

	.icon-button:hover {
		color: var(--accent-strong);
	}

	@media (max-width: 1100px) {
		.site-header {
			grid-template-columns: 1fr auto;
		}

		.site-nav {
			grid-column: 1 / -1;
			grid-row: 2;
			justify-content: flex-start;
			overflow-x: auto;
			border-top: 1px solid var(--line);
		}
	}

	@media (max-width: 760px) {
		.site-header {
			padding-inline: 20px;
		}

		.site-brand__meta,
		.site-tools > :global(a:first-child),
		.site-tools > :global(a:last-of-type) {
			display: none;
		}
	}
</style>

---
import { GitBranch, Network, Rss, Search } from '@lucide/astro';
import AmbientToggle from '@/components/interactive/AmbientToggle.astro';
import { SECTION_NAV_ITEMS } from '@/data/site';
import '@/styles/interactive.css';

interface Props {
	pathname: string;
}

const { pathname } = Astro.props;
// 没有真实地址时隐藏入口，避免把访客带到 GitHub 首页这种“看似可用”的占位链接。
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL?.trim() || '';

const navItems = SECTION_NAV_ITEMS;

const isActive = (href: string) => pathname === href || pathname.startsWith(href.replace(/\/$/, '') + '/');
---

<!--
	栏目页由 ClientRouter 交换内容时，页头作为稳定的导航坐标系必须保留原 DOM：
	这样品牌、工具与标签栏不会跟随正文一起卸载再显现，读者能持续辨认当前位置。
	选中态会在下方脚本的 astro:after-swap 回调中按当前 URL 重新同步。
-->
<header class="site-header" data-site-header transition:persist="site-header">
	{/* 品牌链接只在关于页承担「纸面显影」的返回入口；其他页面保持普通导航，
	    编排由 SharedTitleTransition 的镜像路由守卫（/ ↔ /about）统一把关。 */}
	<a
		class="site-brand"
		href="/"
		aria-label="Aria-7 首页"
		data-aria7-title-transition-link={pathname === '/about/' ? '' : undefined}
	>
		<img src="/assets/brand/rain-archive-mark.svg" alt="" width="40" height="40" />
		<span class="site-brand__name">Aria-7</span>
		<span class="site-brand__meta">RAIN ARCHIVE / 001</span>
	</a>

	<nav class="site-nav" aria-label="主导航" data-site-nav>
		<span class="site-nav__indicator" aria-hidden="true" data-site-nav-indicator></span>
		{navItems.map((item, index) => (
			<a
				href={item.href}
				aria-current={isActive(item.href) ? 'page' : undefined}
				data-site-nav-link
				data-site-nav-index={index}
			>
				{item.label}
			</a>
		))}
	</nav>

	<div class="site-tools">
		<a class="icon-button site-tool-button" href="/connections/" aria-label="文章关系图">
			<Network size={19} stroke-width={1.6} />
			<span class="site-tool-button__label" aria-hidden="true">关系图</span>
		</a>
		<button class="icon-button site-tool-button" type="button" aria-label="搜索" data-search-trigger>
			<Search size={19} stroke-width={1.6} />
			<span class="site-tool-button__label" aria-hidden="true">搜索</span>
		</button>
		<a class="icon-button site-tool-button" href="/rss.xml" aria-label="RSS 订阅" data-astro-reload>
			<Rss size={19} stroke-width={1.6} />
			<span class="site-tool-button__label" aria-hidden="true">RSS</span>
		</a>
		<AmbientToggle />
		{githubUrl && (
			<a class="icon-button" href={githubUrl} aria-label="GitHub" data-tooltip="GitHub" data-github-link rel="noreferrer">
				<GitBranch size={19} stroke-width={1.6} />
			</a>
		)}
		<slot name="weather-control" />
	</div>
</header>

<script>
	const normalizePath = (pathname: string) => pathname.replace(/\/+$/, '') || '/';

	function initSiteHeaderNavigation() {
		document.querySelectorAll<HTMLElement>('[data-site-nav]').forEach((nav) => {
			if (nav.dataset.navigationReady === 'true') return;
			nav.dataset.navigationReady = 'true';
			const indicator = nav.querySelector<HTMLElement>('[data-site-nav-indicator]');
			const links = [...nav.querySelectorAll<HTMLElement>('[data-site-nav-link]')];
			// 首页没有匹配的栏目路由时，以“随笔”作为视觉起点；进入具体栏目后仍优先使用真实当前项。
			let activeLink: HTMLElement | null = nav.querySelector<HTMLElement>('[data-site-nav-link][aria-current="page"]')
				?? links[0]
				?? null;
			let currentTarget: HTMLElement | null = activeLink;
			if (!indicator) return;

			const moveIndicator = (link: HTMLElement | null, placeImmediately = false) => {
				currentTarget = link;
				if (!link) {
					nav.dataset.navCursorVisible = 'false';
					return;
				}
				const navBounds = nav.getBoundingClientRect();
				const linkBounds = link.getBoundingClientRect();
				const horizontalInset = 12;
				indicator.style.setProperty('--nav-indicator-x', `${linkBounds.left - navBounds.left - horizontalInset}px`);
				indicator.style.setProperty('--nav-indicator-width', `${linkBounds.width + horizontalInset * 2}px`);
				if (placeImmediately) indicator.classList.add('is-placing');
				nav.dataset.navCursorVisible = 'true';
				if (placeImmediately) requestAnimationFrame(() => indicator.classList.remove('is-placing'));
			};

			/*
			 * transition:persist 会保留旧页头节点，因此服务端渲染给新页面的
			 * aria-current 不会自动落到这个节点上。每次正文交换完成后依据
			 * location 重新计算选中标签，同时让指示线从旧标签滑向新标签。
			 * 品牌链接的 Aria-7 共享标题入口也在这里同步，保证 about→首页
			 * 仍可通过点击品牌触发镜像转场。
			 */
			const syncRouteState = (placeImmediately = false) => {
				const currentPath = normalizePath(window.location.pathname);
				activeLink = links.find((link) => {
					const href = link.getAttribute('href');
					if (!href) return false;
					const targetPath = normalizePath(new URL(href, window.location.href).pathname);
					return currentPath === targetPath || currentPath.startsWith(`${targetPath}/`);
				}) ?? null;

				links.forEach((link) => {
					if (link === activeLink) link.setAttribute('aria-current', 'page');
					else link.removeAttribute('aria-current');
				});

				const header = nav.closest<HTMLElement>('[data-site-header]');
				const brand = header?.querySelector<HTMLAnchorElement>('.site-brand') ?? null;
				if (brand) {
					if (currentPath === '/about') brand.setAttribute('data-aria7-title-transition-link', '');
					else brand.removeAttribute('data-aria7-title-transition-link');
				}

				moveIndicator(activeLink ?? links[0] ?? null, placeImmediately);
			};

			/*
			 * Astro 默认只按浏览器历史判定 forward/back，普通 Tab 点击都会被当作
			 * forward。栏目索引让“向左找前页”和“向右找后页”拥有真实的空间方向：
			 * 这里改写 preparation.direction 后，ClientRouter 会把它传给原生快照
			 * 以及 fallback 动画，因此两条渲染路径的进出方向始终一致。
			 */
			document.addEventListener('astro:before-preparation', (event) => {
				if (event.navigationType === 'traverse') return;
				if (!(event.sourceElement instanceof Element)) return;

				const targetLink = event.sourceElement.closest<HTMLElement>('[data-site-nav-link][data-site-nav-index]');
				if (!targetLink || !nav.contains(targetLink)) return;

				const currentIndex = Number(activeLink?.dataset.siteNavIndex);
				const targetIndex = Number(targetLink.dataset.siteNavIndex);
				if (!Number.isFinite(currentIndex) || !Number.isFinite(targetIndex) || currentIndex === targetIndex) return;

				event.direction = targetIndex < currentIndex ? 'back' : 'forward';
			});

			links.forEach((link) => {
				link.addEventListener('pointerenter', () => moveIndicator(link, nav.dataset.navCursorVisible !== 'true'));
				link.addEventListener('focus', () => moveIndicator(link, nav.dataset.navCursorVisible !== 'true'));
			});
			nav.addEventListener('pointerleave', () => {
				const focusedLink = document.activeElement instanceof HTMLElement && nav.contains(document.activeElement)
					? document.activeElement.closest<HTMLElement>('[data-site-nav-link]')
					: null;
				moveIndicator(focusedLink ?? activeLink);
			});
			nav.addEventListener('focusout', () => {
				requestAnimationFrame(() => {
					if (!nav.contains(document.activeElement)) moveIndicator(activeLink);
				});
			});

			// 字体载入、窗口变化或工具区宽度改变后重新测量，避免指示器与文字错位。
			const resizeObserver = new ResizeObserver(() => moveIndicator(currentTarget, true));
			resizeObserver.observe(nav);
			// 首屏指示线直接定位；后续栏目切换则从旧项自然滑向新项。
			requestAnimationFrame(() => syncRouteState(true));
			document.addEventListener('astro:after-swap', () => syncRouteState());
		});
	}

	initSiteHeaderNavigation();
	document.addEventListener('astro:page-load', initSiteHeaderNavigation);
</script>

<style>
	.site-header {
		position: relative;
		z-index: var(--z-nav);
		display: grid;
		grid-template-columns: minmax(230px, 1fr) auto;
		align-items: center;
		min-height: 84px;
		margin-inline: auto;
		padding: 0 var(--page-gutter);
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper-0) 90%, transparent);
		backdrop-filter: blur(12px);
	}

	.site-brand {
		display: grid;
		grid-template-columns: 40px auto;
		grid-template-rows: 1fr auto;
		column-gap: 12px;
		align-items: center;
		width: max-content;
		color: var(--ink);
		text-decoration: none;
	}

	.site-brand img {
		grid-row: 1 / 3;
	}

	.site-brand__name {
		align-self: end;
		font-family: var(--font-display);
		font-size: 24px;
		line-height: 1;
	}

	.site-brand__meta {
		align-self: start;
		font-family: var(--font-ui);
		font-size: 9px;
		line-height: 1.4;
		color: var(--ink-muted);
	}

	.site-nav {
		/*
		 * 导航以页头的几何中心为基准，而不是以品牌与工具区之间的剩余列为基准。
		 * 两侧内容宽度不对称时，这能保持栏目序列始终位于页面中线。
		 */
		position: absolute;
		top: 50%;
		left: 50%;
		isolation: isolate;
		display: flex;
		justify-content: center;
		gap: clamp(16px, 2vw, 34px);
		transform: translate(-50%, -50%);
		white-space: nowrap;
	}

	.site-nav__indicator {
		position: absolute;
		z-index: 0;
		top: 6px;
		left: 0;
		width: var(--nav-indicator-width, 0px);
		height: 32px;
		opacity: 0;
		transform: translate3d(var(--nav-indicator-x, 0px), 0, 0);
		transition: transform 520ms var(--ease-drift), width 420ms var(--ease-rain), opacity 220ms var(--ease-rain);
		will-change: transform, width;
		pointer-events: none;
	}

	.site-nav__indicator::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 1px;
		background: color-mix(in srgb, var(--accent-strong) 88%, var(--ink));
		box-shadow: 0 1px 0 color-mix(in srgb, var(--accent-strong) 22%, transparent);
		content: '';
	}

	.site-nav[data-nav-cursor-visible='true'] .site-nav__indicator {
		opacity: 1;
	}

	.site-nav__indicator.is-placing {
		transition: none;
	}

	.site-nav a {
		position: relative;
		z-index: 1;
		padding-block: 12px;
		font-family: var(--font-ui);
		font-size: 15px;
		font-weight: var(--font-ui-weight);
		line-height: 1.2;
		color: var(--ink-muted);
		text-decoration: none;
		transition: color var(--duration-fast) var(--ease-rain), font-weight var(--duration-fast) var(--ease-rain);
	}

	.site-nav a:hover,
	.site-nav a:focus-visible,
	.site-nav a[aria-current='page'] {
		color: var(--ink);
	}

	.site-nav a:hover,
	.site-nav a:focus-visible {
		font-weight: var(--font-ui-weight-hover);
	}

	.site-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 2px;
	}

	.icon-button {
		display: inline-grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--ink-muted);
		text-decoration: none;
		cursor: pointer;
	}

	.icon-button:hover {
		color: var(--accent-strong);
	}

	/*
	 * 页眉工具入口保持固定尺寸，标签只在按钮内部显现，避免悬停时撑大
	 * .site-tools 进而重新分配页眉网格宽度。标签使用单独节点而不是全局
	 * data-tooltip，便于与天气控件保持一致的渐入、位移和底线反馈。
	 */
	.site-tool-button {
		position: relative;
		isolation: isolate;
		display: inline-grid;
		overflow: hidden;
		place-items: center;
		transition: color 180ms var(--ease-rain), transform 320ms var(--ease-drift), background-color 260ms var(--ease-rain);
	}

	.site-tool-button::after {
		position: absolute;
		right: 8px;
		bottom: 4px;
		left: 8px;
		height: 1px;
		background: currentColor;
		content: '';
		opacity: 0;
		pointer-events: none;
		transform: scaleX(0.2);
		transform-origin: center;
		transition: opacity 180ms var(--ease-rain), transform 320ms var(--ease-drift);
	}

	.site-tool-button svg {
		position: relative;
		z-index: 1;
		transition: transform 320ms var(--ease-drift);
	}

	.site-tool-button__label {
		position: absolute;
		z-index: 1;
		bottom: 5px;
		left: 50%;
		max-width: 0;
		overflow: hidden;
		font-family: var(--font-ui);
		font-size: 9px;
		line-height: 1;
		opacity: 0;
		transform: translate(-50%, 5px);
		transition: max-width 320ms var(--ease-drift), opacity 160ms var(--ease-rain), transform 320ms var(--ease-drift);
		white-space: nowrap;
	}

	@media (hover: hover) and (min-width: 1241px) {
		.site-tool-button:hover,
		.site-tool-button:focus-visible {
			background: color-mix(in srgb, var(--accent-soft) 72%, transparent);
			transform: translateY(-1px);
		}

		.site-tool-button:hover::after,
		.site-tool-button:focus-visible::after {
			opacity: 0.82;
			transform: scaleX(1);
		}

		.site-tool-button:hover svg,
		.site-tool-button:focus-visible svg {
			transform: translateY(-5px);
		}

		.site-tool-button:hover .site-tool-button__label,
		.site-tool-button:focus-visible .site-tool-button__label {
			max-width: 38px;
			opacity: 1;
			transform: translate(-50%, 0);
		}
	}

	.site-tool-button:focus-visible {
		outline: 1px solid var(--accent-strong);
		outline-offset: -3px;
	}

	@media (max-width: 1100px) {
		.site-header {
			grid-template-columns: 1fr auto;
		}

		.site-nav {
			position: relative;
			top: auto;
			left: auto;
			grid-column: 1 / -1;
			grid-row: 2;
			justify-content: flex-start;
			overflow-x: auto;
			border-top: 1px solid var(--line);
			transform: none;
		}
	}

	@media (max-width: 760px) {
		.site-header {
			padding-inline: 20px;
		}

		/*
		 * 只隐品牌 meta、关系图与 GitHub。目标必须用显式标记选中：
		 * last-of-type 之类的兄弟序数在 GitHub 链接缺席时会误伤 RSS。
		 */
		.site-brand__meta,
		.site-tools > :global(a:first-child),
		.site-tools > :global([data-github-link]) {
			display: none;
		}

		.site-tool-button__label {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav__indicator,
		.site-tool-button,
		.site-tool-button::after,
		.site-tool-button svg,
		.site-tool-button__label {
			transition: none;
		}
	}
</style>

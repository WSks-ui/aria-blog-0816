---
import { ArrowUp } from '@lucide/astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__signal" aria-hidden="true">
		<img src="/assets/brand/rain-archive-mark.svg" alt="" width="72" height="72" />
		<span></span>
	</div>
	<div>
		<p class="site-footer__name">Aria-7 / Rain Archive</p>
		<p class="site-footer__note">记录学习、创作与仍在形成的想法。</p>
	</div>
	<nav aria-label="页脚导航">
		<a href="/about/">关于</a>
		<a href="/archive/">归档</a>
		<a href="/connections/">关系图</a>
		<a href="/rss.xml" data-astro-reload>RSS</a>
		<button class="site-footer__top" type="button" data-back-to-top aria-label="回到页面顶部">
			<ArrowUp size={16} stroke-width={1.5} aria-hidden="true" />
		</button>
	</nav>
	<p class="site-footer__copy">
		© <span data-footer-year>{year}</span> Aria-7
		<a
			class="site-footer__beian"
			href="https://beian.miit.gov.cn/"
			target="_blank"
			rel="noopener noreferrer"
		>
			豫ICP备2026042988号
		</a>
		<a
			class="site-footer__beian"
			href="https://beian.mps.gov.cn/#/query/webSearch?code=41170202411843"
			target="_blank"
			rel="noopener noreferrer"
		>
			豫公网安备41170202411843号
		</a>
	</p>
</footer>

<script>
	function initBackToTopButtons() {
		document.querySelectorAll<HTMLButtonElement>('[data-back-to-top]').forEach((button) => {
			if (button.dataset.interactiveReady === 'true') return;
			button.dataset.interactiveReady = 'true';
			button.addEventListener('click', () => {
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
			});
		});
	}

	// 构建时年份会被固化进静态 HTML；客户端每次加载刷新为当前年份，
	// 这样跨年后即使不重新构建部署，页脚年份也能自动更新。
	function initFooterYear() {
		const y = String(new Date().getFullYear());
		document.querySelectorAll<HTMLElement>('[data-footer-year]').forEach((el) => {
			el.textContent = y;
		});
	}

	initBackToTopButtons();
	initFooterYear();
	document.addEventListener('astro:page-load', () => {
		initBackToTopButtons();
		initFooterYear();
	});
</script>

<style>
	/*
	 * 页脚底材跟随当前天气场景：晴天与雨天是带雾青的纸面，夜间自然沉入夜海。
	 * 不再固定深色，避免晴天模式下页脚像一块贴上去的夜色补丁。
	 */
	.site-footer {
		display: grid;
		grid-template-columns: 120px 1fr auto;
		gap: 32px;
		align-items: center;
		max-width: var(--content-max);
		min-height: 240px;
		margin: var(--space-6) auto 0;
		padding: var(--space-4) var(--page-gutter);
		border-top: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper-0) 84%, var(--weather-haze) 16%);
		color: var(--ink);
		transition: background-color var(--duration-base) ease, color var(--duration-base) ease;
	}

	.site-footer__signal {
		display: grid;
		grid-template-columns: 72px 1fr;
		align-items: center;
	}

	.site-footer__signal img {
		opacity: 0.72;
	}

	.site-footer__signal span {
		height: 1px;
		background: var(--line);
	}

	.site-footer__name {
		margin: 0 0 8px;
		font-family: var(--font-display);
		font-size: 26px;
	}

	.site-footer__note,
	.site-footer__copy {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 12px;
		color: var(--ink-muted);
	}

	.site-footer nav {
		display: flex;
		align-items: center;
		gap: 22px;
	}

	.site-footer a {
		color: var(--ink);
		font-family: var(--font-ui);
		font-size: 12px;
		font-weight: var(--font-ui-weight);
		transition: color var(--duration-fast) var(--ease-rain), font-weight var(--duration-fast) var(--ease-rain);
	}

	.site-footer a:hover,
	.site-footer a:focus-visible {
		color: var(--accent-strong);
		font-weight: var(--font-ui-weight-hover);
	}

	.site-footer__top {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		margin-right: -12px;
		border: 1px solid var(--line);
		background: none;
		color: var(--ink-muted);
		cursor: pointer;
		transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease, transform var(--duration-base) var(--ease-drift);
	}

	.site-footer__top:hover,
	.site-footer__top:focus-visible {
		color: var(--accent-strong);
		border-color: var(--accent-strong);
		transform: translateY(-2px);
	}

	.site-footer__copy {
		grid-column: 2 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
	}

	/* 备案号：与版权同行弱化展示，按工信部要求可点击跳转 */
	.site-footer a.site-footer__beian {
		color: var(--ink-muted);
		font-size: 12px;
		text-decoration: none;
		transition: color var(--duration-fast) ease;
	}

	.site-footer a.site-footer__beian:hover,
	.site-footer a.site-footer__beian:focus-visible {
		color: var(--accent-strong);
		font-weight: var(--font-ui-weight);
	}

	/* 夜间模式下站标恢复为浅色线稿，与深底保持制图线的可读对比。 */
	:global(html[data-weather-mode='night']) .site-footer__signal img {
		filter: brightness(0) invert(1);
		opacity: 0.9;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer,
		.site-footer__top {
			transition: none;
		}
	}

	@media (max-width: 760px) {
		.site-footer {
			grid-template-columns: 1fr;
		}

		.site-footer nav,
		.site-footer__copy {
			grid-column: auto;
			flex-wrap: wrap;
		}
	}
</style>

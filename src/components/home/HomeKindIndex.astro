---
import { ArrowRight } from '@lucide/astro';
import { IMAGE_COLLECTION } from '@/data/image-collection';
import { POST_KINDS, POST_KIND_LABELS, POST_KIND_TRACKS } from '@/data/site';
import { collectTagCounts, type PostEntry } from '@/lib/content';

interface Props {
	posts: PostEntry[];
}

const { posts } = Astro.props;
const tagCounts = collectTagCounts(posts).slice(0, 8);
const maxTagCount = Math.max(1, ...tagCounts.map((tag) => tag.count));
const kindCounts = POST_KINDS.map((kind) => ({
	kind,
	count: posts.filter((post) => post.data.kind === kind).length + (kind === 'photo' ? IMAGE_COLLECTION.length : 0),
}));
---

<section class="home-scene home-scene--index" aria-label="内容索引" data-home-reveal data-home-kind-index>
	<div class="scene-inner">
		<header class="section-heading index-heading">
			<div>
				<p>03 / INDEX SYSTEM</p>
			</div>
			<span>{String(posts.length).padStart(2, '0')} RECORDS / {String(tagCounts.length).padStart(2, '0')} SIGNALS</span>
		</header>
		<div class="kind-index" data-index-field>
			{kindCounts.map(({ kind, count }, index) => {
				const track = POST_KIND_TRACKS[kind];
				return (
					<a
						href={`/types/${kind}/`}
						data-index-track
						data-track-index={index}
						style={`--track-height: ${track.height}%; --track-mobile-height: ${Math.round(180 + track.height * 0.65)}px; --track-delay: ${index * 80}ms;`}
					>
						<span class="kind-index__number">{String(index + 1).padStart(2, '0')}</span>
						<span class="kind-index__label">
							<strong>{POST_KIND_LABELS[kind]}</strong>
							<em>{track.code}</em>
						</span>
						<small>{String(count).padStart(2, '0')} ENTRIES</small>
						<ArrowRight class="kind-index__arrow" size={18} stroke-width={1.4} aria-hidden="true" />
					</a>
				);
			})}
			<div class="kind-index__coordinate" aria-hidden="true" data-index-coordinate>X 000 / Y 000</div>
		</div>
		<div class="tag-index">
			<p>TAGS / FREQUENCY</p>
			<div>
				{tagCounts.map((tag) => (
					<a href={`/tags/${encodeURIComponent(tag.label)}/`} style={`--tag-frequency: ${Math.round((tag.count / maxTagCount) * 100)}%;`}>
						<span aria-hidden="true"><i></i></span>
						<b>#{tag.label}</b>
						<small>{tag.count}</small>
					</a>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	let disposeKindIndex: (() => void) | undefined;

	function initKindIndex() {
		disposeKindIndex?.();

		const section = document.querySelector<HTMLElement>('[data-home-kind-index]');
		if (!section) return;

		const controller = new AbortController();
		const { signal } = controller;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const supportsResizeObserver = typeof window.ResizeObserver === 'function';

		const indexField = section.querySelector<HTMLElement>('[data-index-field]');
		const indexTracks = [...section.querySelectorAll<HTMLElement>('[data-index-track]')];
		const indexCoordinate = section.querySelector<HTMLElement>('[data-index-coordinate]');
		let indexBounds: DOMRect | undefined;
		let indexBoundsFrame = 0;
		let indexResizeObserver: ResizeObserver | undefined;
		const setActiveTrack = (track: HTMLElement | null) => {
			indexTracks.forEach((candidate) => candidate.classList.toggle('is-active', candidate === track));
			indexField?.classList.toggle('has-active', Boolean(track));
			if (indexField) indexField.dataset.activeIndex = track?.dataset.trackIndex ?? '';
		};

		if (indexField && !reduceMotion) {
			// 只在进入、缩放或页面滚动后更新一次区域边界；指针移动只使用缓存，
			// 避免在高频 pointermove 中反复触发布局读取。
			const measureIndexBounds = () => {
				indexBounds = indexField?.getBoundingClientRect();
			};
			const queueIndexBoundsMeasurement = () => {
				if (indexBoundsFrame) return;
				indexBoundsFrame = requestAnimationFrame(() => {
					indexBoundsFrame = 0;
					measureIndexBounds();
				});
			};
			measureIndexBounds();
			if (supportsResizeObserver) {
				indexResizeObserver = new ResizeObserver(queueIndexBoundsMeasurement);
				indexResizeObserver.observe(indexField);
			} else {
				window.addEventListener('resize', queueIndexBoundsMeasurement, { signal });
			}
			window.addEventListener('scroll', queueIndexBoundsMeasurement, { passive: true, signal });
			indexField.addEventListener('pointerenter', measureIndexBounds, { signal });
			// 坐标线只跟随索引区内部的指针，离开后立即收束；链接焦点沿用同一套强调状态。
			indexField.addEventListener('pointermove', (event) => {
				const bounds = indexBounds ?? indexField.getBoundingClientRect();
				const x = Math.max(0, Math.min(bounds.width, event.clientX - bounds.left));
				const y = Math.max(0, Math.min(bounds.height, event.clientY - bounds.top));
				indexField.style.setProperty('--index-pointer-x', `${x}px`);
				indexField.style.setProperty('--index-pointer-y', `${y}px`);
				indexField.classList.add('is-tracking');
				if (indexCoordinate) indexCoordinate.textContent = `X ${String(Math.round(x)).padStart(3, '0')} / Y ${String(Math.round(y)).padStart(3, '0')}`;
			}, { signal });
			indexField.addEventListener('pointerleave', () => {
				indexField.classList.remove('is-tracking');
				if (!indexField.contains(document.activeElement)) setActiveTrack(null);
			}, { signal });
			indexTracks.forEach((track) => {
				track.addEventListener('pointerenter', () => setActiveTrack(track), { signal });
				track.addEventListener('focus', () => setActiveTrack(track), { signal });
				track.addEventListener('blur', () => setActiveTrack(null), { signal });
			});
		}

		disposeKindIndex = () => {
			controller.abort();
			indexResizeObserver?.disconnect();
			if (indexBoundsFrame) cancelAnimationFrame(indexBoundsFrame);
		};
	}

	initKindIndex();
	document.addEventListener('astro:page-load', initKindIndex);
	document.addEventListener('astro:before-swap', () => disposeKindIndex?.());
</script>

<style>
	.home-scene--index { padding-block: 112px 96px; background: color-mix(in srgb, var(--accent-soft) 44%, var(--paper-0)); }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-bottom: 42px; }
	/* 索引标题移除后只保留编号与统计，缩短页眉底距，避免留下不可见的标题占位。 */
	.index-heading { margin-bottom: 28px; }
	.index-heading > div { display: grid; gap: 0; }
	.index-heading > div p { margin: 0; }
	.index-heading > span { font-family: var(--font-ui); font-size: 9px; color: var(--ink-muted); }
	/* 格宽形变是本区的招牌交互，保留；但并发成本削减：字号改瞬时切换、
	   非活动轨只降透明度不再位移——每帧重排工作量约减半。 */
	.kind-index { --index-pointer-x: 50%; --index-pointer-y: 50%; position: relative; isolation: isolate; display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr; align-items: end; height: 410px; border-bottom: 1px solid var(--line-strong); transition: grid-template-columns var(--duration-scene) var(--ease-drift); }
	.kind-index::before,
	.kind-index::after { position: absolute; z-index: 3; background: color-mix(in srgb, var(--accent-strong) 48%, transparent); content: ''; opacity: 0; pointer-events: none; transition: opacity 280ms var(--ease-rain); }
	.kind-index::before { top: 0; bottom: 0; left: var(--index-pointer-x); width: 1px; }
	.kind-index::after { top: var(--index-pointer-y); right: 0; left: 0; height: 1px; }
	.kind-index.is-tracking::before,
	.kind-index.is-tracking::after { opacity: 0.52; }
	/* 六种状态保持完全一致的轨道列表结构，浏览器才能连续插值宽度而不是瞬间跳列。 */
	.kind-index[data-active-index='0'] { grid-template-columns: 1.55fr 0.89fr 0.89fr 0.89fr 0.89fr 0.89fr; }
	.kind-index[data-active-index='1'] { grid-template-columns: 0.89fr 1.55fr 0.89fr 0.89fr 0.89fr 0.89fr; }
	.kind-index[data-active-index='2'] { grid-template-columns: 0.89fr 0.89fr 1.55fr 0.89fr 0.89fr 0.89fr; }
	.kind-index[data-active-index='3'] { grid-template-columns: 0.89fr 0.89fr 0.89fr 1.55fr 0.89fr 0.89fr; }
	.kind-index[data-active-index='4'] { grid-template-columns: 0.89fr 0.89fr 0.89fr 0.89fr 1.55fr 0.89fr; }
	.kind-index[data-active-index='5'] { grid-template-columns: 0.89fr 0.89fr 0.89fr 0.89fr 0.89fr 1.55fr; }
	.kind-index a { position: relative; z-index: 1; display: grid; height: var(--track-height); min-height: 188px; align-content: space-between; padding: 18px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); color: var(--ink); text-decoration: none; transform-origin: bottom; transition: height 640ms var(--ease-drift), color var(--duration-base) var(--ease-rain), background-color 520ms var(--ease-rain), border-color 520ms var(--ease-rain), opacity 520ms var(--ease-rain), transform 640ms var(--ease-drift); }
	.kind-index a:last-child { border-right: 1px solid var(--line); }
	.kind-index a::before { position: absolute; top: 0; left: -1px; width: 4px; height: 22%; background: var(--accent-strong); content: ''; transition: height 640ms var(--ease-drift), width 520ms var(--ease-rain); }
	.kind-index a:nth-child(4)::before { background: var(--color-warm); }
	.kind-index.has-active a:not(.is-active) { opacity: 0.42; }
	.kind-index a.is-active { z-index: 2; height: min(100%, calc(var(--track-height) + 54px)); border-color: var(--line-strong); background: color-mix(in srgb, var(--paper-0) 82%, transparent); color: var(--accent-strong); transform: translateY(-18px); }
	.kind-index a.is-active::before { width: 6px; height: 100%; }
	.kind-index__number,
	.kind-index small,
	.tag-index p,
	.tag-index small { font-family: var(--font-ui); font-size: 9px; color: var(--ink-muted); }
	.kind-index__label { display: grid; gap: 5px; }
	.kind-index strong { font-family: var(--font-display); font-size: 19px; font-weight: 500; }
	.kind-index em { font-family: var(--font-ui); font-size: 9px; font-style: normal; color: var(--ink-muted); opacity: 0; transform: translateY(7px); transition: opacity 420ms var(--ease-rain), transform 420ms var(--ease-rain); }
	.kind-index a.is-active strong { font-size: 26px; }
	.kind-index a.is-active em { opacity: 1; transform: translateY(0); }
	.kind-index__arrow { position: absolute; right: 18px; bottom: 18px; opacity: 0; transform: translateX(-8px); transition: opacity 420ms var(--ease-rain), transform 420ms var(--ease-rain); }
	.kind-index a.is-active .kind-index__arrow { opacity: 1; transform: translateX(0); }
	.kind-index__coordinate { position: absolute; z-index: 4; top: 9px; right: 12px; font-family: var(--font-ui); font-size: 8px; color: var(--accent-strong); opacity: 0; pointer-events: none; transition: opacity 280ms var(--ease-rain); }
	.kind-index.is-tracking .kind-index__coordinate { opacity: 0.74; }
	.tag-index { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 24px; align-items: start; margin-top: 30px; padding-top: 18px; border-top: 1px solid var(--line); }
	.tag-index p { margin: 0; }
	.tag-index > div { display: flex; flex-wrap: wrap; gap: 10px 22px; }
	.tag-index a { display: inline-flex; min-height: 30px; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 11px; color: var(--ink); text-decoration: none; }
	/* 方纸母题：前置小方块以填充高度编码标签频次，方块全填充表示最高频标签。 */
	.tag-index a > span { display: grid; width: 8px; height: 8px; align-self: center; border: 1px solid var(--accent-strong); }
	.tag-index a > span i { width: 100%; height: var(--tag-frequency, 100%); margin-top: auto; background: var(--accent-strong); }
	.tag-index a b { font-weight: 400; }
	.tag-index a:hover b,
	.tag-index a:focus-visible b { color: var(--accent-strong); }

	@media (max-width: 1000px) {
		.kind-index { grid-template-columns: repeat(3, 1fr); height: auto; align-items: stretch; border: 0; }
		.kind-index[data-active-index] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.kind-index a { height: var(--track-mobile-height); }
		.kind-index a.is-active { height: calc(var(--track-mobile-height) + 20px); transform: translateY(-10px); }
	}

	@media (max-width: 760px) {
		.kind-index { grid-template-columns: repeat(2, 1fr); }
		.kind-index[data-active-index] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.tag-index { grid-template-columns: 1fr; }
	}
</style>

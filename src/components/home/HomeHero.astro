---
import { ArrowRight } from '@lucide/astro';
import HeroScene from '@/components/visual/HeroScene.astro';

interface Props {
	recordsCount: number;
	lastUpdateText: string;
}

const { recordsCount, lastUpdateText } = Astro.props;
---

<section class="home-scene home-scene--hero" aria-labelledby="home-title">
	<div class="scene-inner">
		<div class="home-hero">
			<HeroScene />
			<div class="home-hero__status">
				<span>RECORDS / {String(recordsCount).padStart(2, '0')}</span>
				<span data-weather-theme-label>THEME / RAIN</span>
				<span>LAST / {lastUpdateText}</span>
			</div>
			<div class="home-hero__copy">
				<p>PERSONAL ARCHIVE / 2026</p>
				<h1 id="home-title"><span class="home-hero__shared-title" data-aria7-title-transition transition:name="aria7-title">Aria-7</span></h1>
				<strong>欢迎来到我的个人博客，随便看看</strong>
				<span>随笔、学习笔记、项目、底片、代码与指南。</span>
				<a class="home-hero__enter" href="/about/" data-aria7-title-transition-link>
					<span>关于我</span>
					<ArrowRight size={20} stroke-width={1.5} aria-hidden="true" />
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.home-scene--hero { z-index: 1; }
	/* 文案区参与 12 栏栅格占左 6 栏，与 Canvas 场景互不挤压；短视口不再依赖绝对定位的居中近似。 */
	.home-hero { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: center; min-height: clamp(500px, calc(100vh - 290px), 620px); margin-top: 28px; overflow: hidden; background: var(--accent-soft); color: var(--ink); }
	/* 底缘雨痕带：规范允许水痕做页面边缘局部蒙版，不进入文案可读区。 */
	.home-hero::after {
		position: absolute;
		inset: auto 0 0 0;
		z-index: 5;
		height: 80px;
		content: '';
		pointer-events: none;
		background: url('/assets/patterns/atmosphere-rain.svg') bottom center / cover no-repeat;
		mask-image: linear-gradient(180deg, transparent, rgb(0 0 0 / 100%) 58%);
		opacity: 0.5;
		mix-blend-mode: multiply;
	}
	/* 入场序列回归动效规范（内容显现 360–480ms）：级联总长压到 ~0.8s，
	   气势交给 HeroScene 的四拍循环，而不是靠入场拖长。 */
	.home-hero__status { position: absolute; top: 22px; right: 24px; z-index: 6; display: flex; gap: 20px; font-family: var(--font-ui); font-size: 9px; color: var(--ink-muted); opacity: 0; animation: home-meta-enter 380ms var(--ease-rain) 80ms forwards; }
	.home-hero__copy { grid-column: 1 / 7; grid-row: 1; z-index: 6; max-width: 610px; padding-inline: clamp(34px, 7vw, 112px) 24px; }
	.home-hero__copy > p,
	.home-hero__copy > span { font-family: var(--font-ui); font-size: 11px; color: var(--ink-muted); opacity: 0; animation: home-copy-enter 420ms var(--ease-rain) 120ms forwards; }
	.home-hero h1 { margin: 18px 0 6px; font-family: var(--font-display); font-size: 132px; font-weight: 500; line-height: 0.96; overflow-wrap: anywhere; opacity: 0; animation: home-title-enter 480ms var(--ease-rain) 160ms forwards; }
	.home-hero__shared-title { display: inline-block; white-space: nowrap; }
	/* 字号三级跳：巨型标题下直接接常规文案，再落到微型元数据，断层即层级。 */
	.home-hero__copy > strong { display: block; max-width: 580px; margin-bottom: 20px; font-family: var(--font-display); font-size: 15px; font-weight: 400; line-height: 1.7; overflow-wrap: anywhere; opacity: 0; animation: home-copy-enter 420ms var(--ease-rain) 260ms forwards; }
	.home-hero__copy > span { display: block; animation-delay: 340ms; }
	.home-hero__enter { display: inline-flex; min-height: 44px; align-items: center; gap: 18px; margin-top: 30px; padding: 0 14px 0 18px; border: 1px solid var(--ink); background: color-mix(in srgb, var(--paper-0) 86%, transparent); font-family: var(--font-ui); font-size: 11px; color: var(--ink); text-decoration: none; backdrop-filter: blur(10px); opacity: 0; animation: home-action-enter 380ms var(--ease-rain) 420ms forwards; }
	.home-hero__enter:hover svg { transform: translateX(4px); }
	.home-hero__enter svg { transition: transform var(--duration-base) var(--ease-rain); }

	@keyframes home-meta-enter {
		from { opacity: 0; transform: translateY(-8px); }
		to { opacity: 1; transform: translateY(0); }
	}
	@keyframes home-title-enter {
		from { opacity: 0; transform: translateX(42px); clip-path: inset(0 100% 0 0); }
		to { opacity: 1; transform: translateX(0); clip-path: inset(0); }
	}
	@keyframes home-title-enter-mobile {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: translateY(0); }
	}
	@keyframes home-copy-enter {
		from { opacity: 0; transform: translateY(16px); }
		to { opacity: 1; transform: translateY(0); }
	}
	@keyframes home-action-enter {
		from { opacity: 0; transform: translateY(12px); }
		to { opacity: 1; transform: translateY(0); }
	}

	/*
	 * 「纸面显影」离场拍：SharedTitleTransition 在点击关于入口时设置 html 标记，
	 * 文案组按 0–120ms 错峰上浮退场（新动画覆盖入场动画的 forwards 填充）；
	 * 巨型标题保持原位，交给命名 View Transition 在纸幕上飞行。
	 */
	:global(html[data-title-veil='leaving']) .home-hero__status { animation: home-hero-exit 200ms var(--ease-drift) both; }
	:global(html[data-title-veil='leaving']) .home-hero__copy > p { animation: home-hero-exit 200ms var(--ease-drift) 40ms both; }
	:global(html[data-title-veil='leaving']) .home-hero__copy > strong { animation: home-hero-exit 220ms var(--ease-drift) 70ms both; }
	:global(html[data-title-veil='leaving']) .home-hero__copy > span { animation: home-hero-exit 200ms var(--ease-drift) 95ms both; }
	:global(html[data-title-veil='leaving']) .home-hero__enter { animation: home-hero-exit 200ms var(--ease-drift) 120ms both; }

	@keyframes home-hero-exit {
		from { opacity: 1; transform: translateY(0); }
		to { opacity: 0; transform: translateY(-10px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero__status,
		.home-hero__copy > p,
		.home-hero__copy > strong,
		.home-hero__copy > span,
		.home-hero h1,
		.home-hero__enter { opacity: 1; animation: none; }
	}

	:global(html[data-weather-mode='clear']) .home-hero::after {
		background-image: url('/assets/patterns/atmosphere-clear.svg');
		opacity: 0.36;
	}

	:global(html[data-weather-mode='night']) .home-hero::after {
		background-image: url('/assets/patterns/atmosphere-night.svg');
		mix-blend-mode: screen;
		opacity: 0.4;
	}

	@media (max-width: 1000px) {
		.home-hero__copy { grid-column: 1 / 9; }
	}

	@media (max-width: 760px) {
		.home-hero { min-height: 500px; }
		.home-hero__copy { grid-column: 1 / -1; padding-inline: 26px 20px; }
		/* 首屏文案在窄屏上更早显现，避免用户先看到一整块空舞台。 */
		.home-hero__status { animation-delay: 0ms; animation-duration: 320ms; }
		.home-hero h1 { font-size: 64px; animation-name: home-title-enter-mobile; animation-delay: 0ms; animation-duration: 420ms; }
		.home-hero__copy > p { animation-delay: 0ms; animation-duration: 320ms; }
		.home-hero__copy > strong { font-size: 14px; animation-delay: 80ms; animation-duration: 380ms; }
		.home-hero__copy > span { animation-delay: 150ms; animation-duration: 340ms; }
		.home-hero__enter { margin-top: 22px; animation-delay: 220ms; animation-duration: 340ms; }
		.home-hero__status { left: 24px; right: auto; flex-wrap: wrap; }
	}
</style>

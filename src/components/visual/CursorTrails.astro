---
/**
 * 光标水痕：雨日在纸面留下停留、打滑、下滑的小水珠，夜里换成上浮明灭
 * 的星尘，晴日无痕——没有雨，也没有星尘可扬。水珠用多道工序画成（接触
 * 阴影、透明水体、清晰边缘、底部折射、高光、滑行湿痕），而不是一团软
 * 渐变。canvas 经 transition:persist 跨换页存活；触屏与
 * prefers-reduced-motion 下整组退场。
 */
---

<canvas class="cursor-trails" data-cursor-trails transition:persist="cursor-trails" aria-hidden="true"></canvas>

<style>
	.cursor-trails {
		position: fixed;
		inset: 0;
		z-index: var(--z-overlay);
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>

<script>
	function initCursorTrails() {
		const canvas = document.querySelector<HTMLCanvasElement>('[data-cursor-trails]');
		if (!canvas || canvas.dataset.trailsReady === 'true') return;
		if (!window.matchMedia('(pointer: fine)').matches) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;
		canvas.dataset.trailsReady = 'true';

		interface Trail {
			x: number;
			y: number;
			vx: number;
			vy: number;
			r: number;
			age: number;
			ttl: number;
			stickUntil: number;
			seed: number;
			night: boolean;
		}

		let trails: Trail[] = [];
		let rafId = 0;
		let lastX = -1;
		let lastY = -1;
		let dpr = 1;

		const resize = () => {
			dpr = Math.min(2, window.devicePixelRatio || 1);
			canvas.width = Math.round(window.innerWidth * dpr);
			canvas.height = Math.round(window.innerHeight * dpr);
		};
		resize();
		window.addEventListener('resize', resize);

		const weatherMode = () => document.documentElement.dataset.weatherMode ?? 'rain';

		const spawn = (x: number, y: number) => {
			const mode = weatherMode();
			if (mode === 'clear') return;
			const night = mode === 'night';
			const trail: Trail = night
				? {
						x: x + (Math.random() - 0.5) * 18,
						y: y + (Math.random() - 0.5) * 18,
						vx: (Math.random() - 0.5) * 0.12,
						vy: -0.14 - Math.random() * 0.22,
						r: 0.6 + Math.random() * 1.1,
						age: 0,
						ttl: 1500 + Math.random() * 900,
						stickUntil: 0,
						seed: Math.random() * Math.PI * 2,
						night: true,
					}
				: {
						x: x + (Math.random() - 0.5) * 10,
						y: y + (Math.random() - 0.5) * 8,
						vx: (Math.random() - 0.5) * 0.16,
						vy: 0,
						r: 1.6 + Math.random() * 2.2,
						age: 0,
						ttl: 1600 + Math.random() * 800,
						// 纸面先吸住水珠片刻，吸饱了才开始打滑下滑。
						stickUntil: 180 + Math.random() * 520,
						seed: Math.random() * Math.PI * 2,
						night: false,
					};
			trails.push(trail);
			// 粒子上限：密集晃动指针时丢掉最旧的，画面保持干净。
			if (trails.length > 70) trails = trails.slice(-70);
			if (!rafId) rafId = window.requestAnimationFrame(tick);
		};

		window.addEventListener(
			'pointermove',
			(event) => {
				if (lastX < 0) {
					lastX = event.clientX;
					lastY = event.clientY;
					return;
				}
				// 每滑过约 34px 落下一滴；偶发并排双滴，像指尖带起的水。
				if (Math.hypot(event.clientX - lastX, event.clientY - lastY) < 34) return;
				lastX = event.clientX;
				lastY = event.clientY;
				spawn(event.clientX, event.clientY);
				if (Math.random() < 0.18) spawn(event.clientX + 10, event.clientY + 6);
			},
			{ passive: true },
		);

		const drawRaindrop = (trail: Trail, alpha: number) => {
			const { x, y, vx, vy, r } = trail;
			const speed = Math.hypot(vx, vy);
			const stretch = 1 + Math.min(0.55, speed * 0.5);
			const angle = Math.atan2(vy, Math.abs(vx) < 0.001 ? 0.001 : vx);

			ctx.save();
			ctx.translate(x, y);
			ctx.rotate(angle);

			// 滑行湿痕：水珠走过的路留下一条渐隐的水线。
			if (speed > 0.18) {
				const trailLength = Math.min(46, 14 + speed * 34);
				const wash = ctx.createLinearGradient(-trailLength, 0, -r, 0);
				wash.addColorStop(0, 'rgba(31, 71, 81, 0)');
				wash.addColorStop(1, `rgba(31, 71, 81, ${(alpha * 0.16).toFixed(3)})`);
				ctx.strokeStyle = wash;
				ctx.lineWidth = r * 0.9;
				ctx.beginPath();
				ctx.moveTo(-trailLength, 0);
				ctx.lineTo(-r * 0.6, 0);
				ctx.stroke();
			}

			// 接触阴影：纸面在水珠边缘微微沉暗，这是「停着一滴水」的关键。
			ctx.fillStyle = `rgba(23, 48, 55, ${(alpha * 0.12).toFixed(3)})`;
			ctx.beginPath();
			ctx.ellipse(r * 0.08, r * 0.42, r * 1.12, r * 0.92 * stretch, 0, 0, Math.PI * 2);
			ctx.fill();

			// 水体：近乎透明的一层浅洗，边缘略深——水主要靠边缘被看见。
			const body = ctx.createRadialGradient(-r * 0.2, -r * 0.3, r * 0.1, 0, 0, r);
			body.addColorStop(0, `rgba(255, 255, 255, ${(alpha * 0.16).toFixed(3)})`);
			body.addColorStop(0.72, `rgba(196, 216, 222, ${(alpha * 0.1).toFixed(3)})`);
			body.addColorStop(1, `rgba(150, 180, 189, ${(alpha * 0.2).toFixed(3)})`);
			ctx.fillStyle = body;
			ctx.beginPath();
			ctx.ellipse(0, 0, r * 0.88, r * 0.98 * stretch, 0, 0, Math.PI * 2);
			ctx.fill();

			// 边缘线：清晰、细、略深——与软渐变拉开差距的一道工序。
			ctx.strokeStyle = `rgba(31, 71, 81, ${(alpha * 0.4).toFixed(3)})`;
			ctx.lineWidth = 1;
			ctx.beginPath();
			ctx.ellipse(0, 0, r * 0.88, r * 0.98 * stretch, 0, 0, Math.PI * 2);
			ctx.stroke();

			// 底部折射：光穿过水珠在下缘聚出一道暗弧。
			ctx.strokeStyle = `rgba(31, 71, 81, ${(alpha * 0.2).toFixed(3)})`;
			ctx.lineWidth = r * 0.34;
			ctx.beginPath();
			ctx.ellipse(0, r * 0.08, r * 0.6, r * 0.66 * stretch, 0, Math.PI * 0.24, Math.PI * 0.76);
			ctx.stroke();

			// 高光：左上一颗实心亮点 + 一粒更小的伴光。
			ctx.fillStyle = `rgba(255, 255, 255, ${(alpha * 0.88).toFixed(3)})`;
			ctx.beginPath();
			ctx.ellipse(-r * 0.32, -r * 0.4 * stretch, r * 0.24, r * 0.16, -0.5, 0, Math.PI * 2);
			ctx.fill();
			ctx.fillStyle = `rgba(255, 255, 255, ${(alpha * 0.5).toFixed(3)})`;
			ctx.beginPath();
			ctx.ellipse(r * 0.1, -r * 0.52 * stretch, r * 0.1, r * 0.07, 0.4, 0, Math.PI * 2);
			ctx.fill();

			ctx.restore();
		};

		const drawStardust = (trail: Trail, alpha: number) => {
			ctx.save();
			ctx.globalCompositeOperation = 'lighter';
			// 星尘 = 亮核 + 一圈微光，不必复杂。
			const glow = ctx.createRadialGradient(trail.x, trail.y, 0, trail.x, trail.y, trail.r * 3.4);
			glow.addColorStop(0, `rgba(207, 230, 236, ${(alpha * 0.5).toFixed(3)})`);
			glow.addColorStop(1, 'rgba(207, 230, 236, 0)');
			ctx.fillStyle = glow;
			ctx.beginPath();
			ctx.arc(trail.x, trail.y, trail.r * 3.4, 0, Math.PI * 2);
			ctx.fill();
			ctx.fillStyle = `rgba(226, 243, 247, ${alpha.toFixed(3)})`;
			ctx.beginPath();
			ctx.arc(trail.x, trail.y, trail.r, 0, Math.PI * 2);
			ctx.fill();
			ctx.restore();
		};

		const tick = () => {
			rafId = 0;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

			trails = trails.filter((trail) => {
				trail.age += 16.7;
				if (trail.age >= trail.ttl) return false;
				if (trail.night) {
					trail.x += trail.vx + Math.sin(trail.age / 420 + trail.seed) * 0.14;
					trail.y += trail.vy;
				} else if (trail.age < trail.stickUntil) {
					// 吸附期：只随指针惯性微微晃，几乎不动。
					trail.x += trail.vx * 0.3;
					trail.y += Math.sin(trail.age / 90 + trail.seed) * 0.05;
				} else {
					// 打滑期：重力一点点占上风，沿轨迹拉长下滑。
					trail.vy = Math.min(1.1, trail.vy + 0.02);
					trail.x += trail.vx;
					trail.y += trail.vy;
				}
				const life = trail.age / trail.ttl;
				const fadeIn = Math.min(1, trail.age / 90);
				const fadeOut = Math.min(1, (1 - life) / 0.25);
				const alpha = (trail.night
					? Math.sin(Math.PI * Math.min(1, life * 1.15)) * 0.85
					: 0.92) * fadeIn * fadeOut;

				if (trail.night) drawStardust(trail, alpha);
				else drawRaindrop(trail, alpha);
				return true;
			});

			if (trails.length > 0) rafId = window.requestAnimationFrame(tick);
			else ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
		};

		// 切到晴日立即收干所有水痕，避免无雨的天空飘着旧水珠。
		document.addEventListener('weather-mode-change', () => {
			trails = [];
		});
	}

	initCursorTrails();
</script>

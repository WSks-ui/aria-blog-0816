---
import { POST_KIND_LABELS, type PostKind } from '@/data/site';

interface Props {
	kind: PostKind;
	compact?: boolean;
	class?: string;
}

const { kind, compact = false, class: className } = Astro.props;
const instanceId = `cover-${kind}-${Math.random().toString(36).slice(2, 9)}`;
const calendarCells = Array.from({ length: 24 }, (_, index) => ({
	index,
	x: 228 + (index % 6) * 76,
	y: 126 + Math.floor(index / 6) * 76,
	active: [1, 4, 7, 8, 9, 13, 15, 19, 22].includes(index),
}));
const dataBars = Array.from({ length: 22 }, (_, index) => ({
	index,
	x: 54 + index * 33,
	height: 72 + ((index * 47) % 260),
	width: index % 5 === 0 ? 8 : index % 3 === 0 ? 4 : 2,
}));
const tutorialSteps = Array.from({ length: 9 }, (_, index) => ({
	index,
	y: 428 - index * 34,
	left: 92 + index * 39,
	right: 752 - index * 22,
}));
const kindCode = {
	essay: '01 / ESSAY',
	note: '02 / NOTE',
	project: '03 / PROJECT',
	photo: '04 / FRAME',
	code: '05 / CODE',
	tutorial: '06 / GUIDE',
} satisfies Record<PostKind, string>;
---

<div
	class:list={['content-cover', `content-cover--${kind}`, compact && 'content-cover--compact', className]}
	data-content-cover={kind}
	aria-hidden="true"
>
	<svg viewBox="0 0 800 520" preserveAspectRatio="xMidYMid slice">
		<defs>
			<filter id={`${instanceId}-grain`} x="-12%" y="-12%" width="124%" height="124%">
				<feTurbulence type="fractalNoise" baseFrequency="0.72" numOctaves="2" seed="7" />
				<feColorMatrix type="saturate" values="0" />
			</filter>
			<filter id={`${instanceId}-soft`} x="-24%" y="-24%" width="148%" height="148%">
				<feGaussianBlur stdDeviation="9" />
			</filter>
			<filter id={`${instanceId}-liquid`} x="-20%" y="-35%" width="140%" height="170%">
				<feTurbulence type="fractalNoise" baseFrequency="0.008 0.035" numOctaves="2" seed="11" result="noise" />
				<feDisplacementMap in="SourceGraphic" in2="noise" scale="12" xChannelSelector="R" yChannelSelector="B" />
			</filter>
			<clipPath id={`${instanceId}-photo-a`}><rect x="348" y="76" width="286" height="324" /></clipPath>
			<clipPath id={`${instanceId}-photo-b`}><rect x="176" y="218" width="230" height="214" /></clipPath>
		</defs>

		<rect class="content-cover__base" width="800" height="520" />
		<rect class="content-cover__grain" width="800" height="520" filter={`url(#${instanceId}-grain)`} />
		<g class="content-cover__frame">
			<path d="M24 82V24H84M716 24h60v58M24 438v58h60M716 496h60v-58" />
			<path d="M24 102h752M24 418h752M164 24v472M676 24v472" />
		</g>

		{kind === 'essay' && (
			<g class="essay-scene">
				<g class="essay-scene__arcs">
					<path d="M-88 458Q272-56 776 288" />
					<path d="M86 496Q414 50 842 196" />
					<path d="M104 166H548M104 166v122" />
				</g>
				<g class="essay-scene__umbrella" transform="translate(538 276)">
					<path class="cover-fill" d="M-128 44Q0-112 128 44Z" />
					<path d="M-128 44Q-86 0-43 44Q0 0 43 44Q86 0 128 44M0-70v114M-128 44 0-70 128 44M0 44v92c0 35 48 35 48 0" />
				</g>
				<g class="essay-scene__index">
					<text x="104" y="244">ESSAY / 001</text>
					<path d="M104 260h118M104 278h74" />
				</g>
				<g class="content-cover__papers">
					<!-- 碎片使用不等边纸形，避免封面场景退化为规则 UI 方块。 -->
					<path d="M432 92 446 93 450 106 440 112 429 104Z" style="--i: 0" />
					<path d="M650 144 671 146 677 164 662 174 645 163 644 151Z" style="--i: 1" />
					<path d="M580 418 590 417 593 427 585 433 577 427Z" style="--i: 2" />
				</g>
			</g>
		)}

		{kind === 'note' && (
			<g class="note-scene">
				<g class="note-scene__rays">
					<path d="M108 442 498 104M192 496 498 104M710 496 498 104M786 382 498 104" />
				</g>
				<g class="note-scene__calendar">
					{calendarCells.map((cell) => (
						<g class:list={['note-scene__cell', cell.active && 'is-active']} style={`--i: ${cell.index}`}>
							<rect x={cell.x} y={cell.y} width="66" height="66" />
							<text x={cell.x + 8} y={cell.y + 17}>{String(cell.index + 1).padStart(2, '0')}</text>
						</g>
					))}
				</g>
				<g class="note-scene__markers">
					<path d="M116 138h76M116 154h48M648 402h74M674 386v48" />
					<circle cx="150" cy="350" r="42" />
					<path d="M108 350h84M150 308v84" />
				</g>
			</g>
		)}

		{kind === 'project' && (
			<g class="project-scene">
				<g class="project-scene__links">
					<path d="M102 154 358 228 690 128M102 372 358 228 704 388M358 228 556 318M220 442 556 318 742 254" />
					<path d="M102 154v218l118 70M690 128l14 260 38-134" />
				</g>
				<g class="project-scene__blocks project-scene__blocks--a">
					<path class="cover-fill" d="M174 202 292 144l116 56-118 61Z" />
					<path d="M174 202v116l116 59V261m118-61v116l-118 61" />
				</g>
				<g class="project-scene__blocks project-scene__blocks--b">
					<path class="cover-fill" d="m466 302 88-44 84 42-88 45Z" />
					<path d="M466 302v76l84 43v-76m88-45v76l-88 45" />
				</g>
				<g class="project-scene__nodes">
					<circle cx="102" cy="154" r="10" /><circle cx="102" cy="372" r="10" />
					<circle cx="690" cy="128" r="10" /><circle cx="704" cy="388" r="10" />
				</g>
				<g class="project-scene__signal">
					<path d="m326 420 42 20-42 20M380 420l42 20-42 20" />
				</g>
			</g>
		)}

		{kind === 'photo' && (
			<g class="photo-scene">
				<g clip-path={`url(#${instanceId}-photo-a)`} class="photo-scene__image photo-scene__image--a">
					<rect x="326" y="52" width="334" height="372" class="photo-scene__image-base" />
					<circle cx="574" cy="156" r="88" class="photo-scene__light" filter={`url(#${instanceId}-soft)`} />
					<path d="M312 344Q468 236 676 286V438H312Z" class="photo-scene__horizon" />
					<path d="M342 314Q482 184 642 266M376 354Q502 244 652 298" class="photo-scene__trails" />
				</g>
				<g clip-path={`url(#${instanceId}-photo-b)`} class="photo-scene__image photo-scene__image--b">
					<rect x="150" y="196" width="280" height="260" class="photo-scene__image-base" />
					<circle cx="246" cy="286" r="64" class="photo-scene__light photo-scene__light--warm" filter={`url(#${instanceId}-soft)`} />
					<path d="M128 404Q276 264 454 350V480H128Z" class="photo-scene__horizon" />
				</g>
				<g class="photo-scene__windows">
					<rect x="348" y="76" width="286" height="324" />
					<rect x="176" y="218" width="230" height="214" />
					<circle cx="638" cy="408" r="46" />
					<path d="M638 344v128M574 408h128" />
				</g>
				<g class="photo-scene__reflection">
					<path d="M350 438h286M388 454h210M430 470h128" />
				</g>
			</g>
		)}

		{kind === 'code' && (
			<g class="code-scene">
				<g class="code-scene__rain">
					{dataBars.map((bar) => (
						<rect x={bar.x} y={28} width={bar.width} height={bar.height} style={`--i: ${bar.index}`} />
					))}
				</g>
				<g class="code-scene__corridor">
					<path d="M72 478 418 176 760 478M168 478 418 176M286 478 418 176M550 478 418 176M668 478 418 176" />
					<path d="M118 438h602M164 398h512M210 358h420M256 318h328M302 278h236M348 238h144" />
				</g>
				<g class="code-scene__glyph" filter={`url(#${instanceId}-liquid)`}>
					<text class="code-scene__glyph--red" x="216" y="352">07</text>
					<text class="code-scene__glyph--cyan" x="224" y="352">07</text>
					<text x="220" y="352">07</text>
				</g>
				<g class="code-scene__brackets"><path d="M118 190 72 260l46 70M682 190l46 70-46 70" /></g>
				<line class="code-scene__scan" x1="24" y1="0" x2="776" y2="0" />
			</g>
		)}

		{kind === 'tutorial' && (
			<g class="tutorial-scene">
				<g class="tutorial-scene__corridor">
					<path d="M54 472 602 92 776 472M146 472 602 92M242 472 602 92M338 472 602 92M520 472 602 92M680 472 602 92" />
				</g>
				<g class="tutorial-scene__steps">
					{tutorialSteps.map((step) => (
						<path d={`M${step.left} ${step.y}H${step.right}`} style={`--i: ${step.index}`} />
					))}
				</g>
				<g class="tutorial-scene__nodes">
					<g transform="translate(246 346)"><circle r="25" /><text x="-8" y="4">01</text></g>
					<g transform="translate(382 278)"><circle r="22" /><text x="-8" y="4">02</text></g>
					<g transform="translate(494 210)"><circle r="19" /><text x="-8" y="4">03</text></g>
					<g transform="translate(574 142)"><circle r="16" /><text x="-8" y="4">04</text></g>
				</g>
				<g class="tutorial-scene__arrow"><path d="m466 410 50 22-50 22M530 410l50 22-50 22" /></g>
			</g>
		)}

		<g class="content-cover__telemetry">
			<text x="44" y="56">{kindCode[kind]}</text>
			<text x="692" y="56">RA / 07</text>
			<text x="44" y="470">{POST_KIND_LABELS[kind]} / LIVE</text>
			<text x="682" y="470">FRAME / 01</text>
		</g>
	</svg>
	<!-- WebGL 涟漪层：指针行进时扰动场景纹理，静止后与 DOM 完全一致 -->
	<canvas class="content-cover__glass" aria-hidden="true"></canvas>
	<!-- 指针光斑：像举着放大镜看档案场景，颜色随天气。 -->
	<i class="content-cover__lens" aria-hidden="true"></i>
</div>

<style>
	.content-cover {
		--cover-bg: var(--paper-0);
		--cover-line: var(--line);
		--cover-line-strong: var(--line-strong);
		--cover-ink: var(--ink);
		--cover-muted: var(--ink-muted);
		--cover-accent: var(--color-rain-deep);
		--cover-fill: color-mix(in srgb, var(--color-rain) 64%, transparent);
		position: relative;
		width: 100%;
		height: 100%;
		min-height: inherit;
		overflow: hidden;
		background: var(--cover-bg);
		color: var(--cover-line);
		isolation: isolate;
	}

	/*
	 * 封面继续由 SVG 控制类型化的制图结构，但底部改用共享纸张纹理。
	 * 这让首页预览、栏目封面和文章 Hero 拥有同一套材质，而无需让每个
	 * 场景额外生成一张位图或持续运行复杂滤镜。
	 */
	.content-cover::before {
		position: absolute;
		z-index: 0;
		inset: 0;
		background-image:
			url('/assets/patterns/archive-fiber.svg'),
			radial-gradient(ellipse at 74% 18%, color-mix(in srgb, var(--color-rain) 24%, transparent), transparent 36%);
		background-size: 340px 340px, cover;
		opacity: 0.48;
		mix-blend-mode: multiply;
		content: '';
		pointer-events: none;
	}

	.content-cover svg {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: 100%;
	}

	/* compact 封面用于首页滚动预览：保留构图线索，降低滤镜和运动频率，
	   避免同一页同时维护多套高密度 SVG 动画。 */
	.content-cover--compact .content-cover__grain { display: none; }
	/* 首屏最近记录会并行展示多张紧凑封面，保留材质但降低强度，避免纤维层压过文章信息。 */
	.content-cover--compact::before { opacity: 0.24; }
	.content-cover--compact .essay-scene__arcs,
	.content-cover--compact .essay-scene__umbrella,
	.content-cover--compact .content-cover__papers path,
	.content-cover--compact .note-scene__markers,
	.content-cover--compact .project-scene__links,
	.content-cover--compact .project-scene__blocks,
	.content-cover--compact .photo-scene__image,
	.content-cover--compact .photo-scene__reflection,
	.content-cover--compact .code-scene__rain rect,
	.content-cover--compact .code-scene__scan,
	.content-cover--compact .tutorial-scene__steps path,
	.content-cover--compact .tutorial-scene__arrow {
		animation-duration: 14s;
	}

	/* 无限滚动流的第二组只是回环占位，不需要重复消耗动效帧。 */
	:global(.recent-stage__group[aria-hidden='true']) .content-cover * {
		animation-play-state: paused !important;
	}

	/* 第二组仅用于无缝回环，隐藏其重复的纸纤维合成层以控制长列表的绘制成本。 */
	:global(.recent-stage__group[aria-hidden='true']) .content-cover::before {
		display: none;
	}

	.content-cover__base { fill: color-mix(in srgb, var(--cover-bg) 89%, transparent); }
	.content-cover__grain { fill: var(--cover-ink); opacity: 0.045; mix-blend-mode: multiply; }
	.content-cover__frame,
	.essay-scene__arcs,
	.essay-scene__umbrella,
	.essay-scene__index,
	.note-scene__rays,
	.note-scene__markers,
	.project-scene__links,
	.project-scene__blocks,
	.project-scene__nodes,
	.photo-scene__windows,
	.photo-scene__reflection,
	.code-scene__corridor,
	.code-scene__brackets,
	.tutorial-scene__corridor,
	.tutorial-scene__steps,
	.tutorial-scene__nodes {
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}

	.content-cover__frame { opacity: 0.58; }
	.content-cover__telemetry { fill: var(--cover-muted); font-family: var(--font-ui); font-size: 9px; opacity: 0.75; }
	.cover-fill { fill: var(--cover-fill); stroke: var(--cover-accent); }

	.essay-scene__arcs { stroke-dasharray: 1120; animation: cover-line-build 8.8s var(--ease-drift) infinite alternate; }
	.essay-scene__umbrella { color: var(--cover-accent); stroke-width: 1.4; animation: cover-float 7.2s var(--ease-drift) infinite alternate; }
	.essay-scene__index { color: var(--cover-muted); }
	.essay-scene__index text { fill: currentColor; stroke: none; font-family: var(--font-ui); font-size: 9px; }

	.content-cover__papers path {
		fill: var(--color-paper);
		stroke: var(--cover-line-strong);
		transform-box: fill-box;
		transform-origin: center;
		animation: cover-paper-fall 7.6s linear infinite;
		animation-delay: calc(var(--i) * -2.1s);
	}

	.note-scene__rays { opacity: 0.28; }
	.note-scene__cell { opacity: 0.86; }
	.note-scene__cell rect { fill: color-mix(in srgb, var(--cover-bg) 90%, transparent); stroke: var(--cover-line-strong); }
	.note-scene__cell.is-active rect { fill: color-mix(in srgb, var(--color-rain) 62%, transparent); }
	.note-scene__cell text { fill: var(--cover-muted); font-family: var(--font-ui); font-size: 10px; }
	.note-scene__markers { color: var(--cover-accent); opacity: 0.65; animation: note-marker-breathe 5.2s ease-in-out infinite alternate; }

	.project-scene__links { opacity: 0.56; stroke-dasharray: 980; animation: cover-line-build 7s var(--ease-rain) infinite alternate; }
	.project-scene__blocks { color: var(--cover-line-strong); stroke-width: 1.3; animation: project-block-shift 7.8s var(--ease-drift) infinite alternate; }
	.project-scene__blocks--b { animation-delay: -3.4s; }
	.project-scene__nodes { color: var(--cover-accent); fill: var(--cover-bg); stroke-width: 2; }
	.project-scene__signal { fill: none; stroke: var(--color-warm); stroke-width: 6; animation: project-signal 2.8s ease-in-out infinite alternate; }

	.photo-scene__image { animation: photo-window-drift 9.8s var(--ease-drift) infinite alternate; }
	.photo-scene__image--b { animation-delay: -4.2s; }
	.photo-scene__image-base { fill: color-mix(in srgb, var(--color-rain-deep) 38%, var(--night-0)); }
	.photo-scene__light { fill: var(--color-rain-pale); opacity: 0.8; }
	.photo-scene__light--warm { fill: var(--color-warm); opacity: 0.58; }
	.photo-scene__horizon { fill: color-mix(in srgb, var(--night-0) 80%, transparent); }
	.photo-scene__trails { fill: none; stroke: var(--night-text); stroke-width: 5; opacity: 0.52; }
	.photo-scene__windows { color: var(--cover-line-strong); stroke-width: 1.3; }
	.photo-scene__reflection { color: var(--cover-accent); opacity: 0.48; animation: photo-reflection 4.8s ease-in-out infinite alternate; }

	.content-cover--code {
		--cover-bg: #071014;
		--cover-line: #39545d;
		--cover-line-strong: #87a2aa;
		--cover-ink: #edf1ef;
		--cover-muted: #9eb1b5;
		--cover-accent: #75c5d8;
		--cover-fill: rgb(117 197 216 / 18%);
	}
	.content-cover--code::before { mix-blend-mode: screen; opacity: 0.34; }
	.content-cover--code .content-cover__grain { mix-blend-mode: screen; opacity: 0.08; }
	.code-scene__rain rect { fill: var(--cover-accent); opacity: 0.42; animation: code-rain-fall 3.8s linear infinite; animation-delay: calc(var(--i) * -170ms); }
	.code-scene__corridor { opacity: 0.3; }
	.code-scene__glyph text { fill: var(--night-text); font-family: var(--font-display); font-size: 220px; font-weight: 500; opacity: 0.72; }
	.code-scene__glyph--red { fill: #d87570 !important; transform: translateX(-4px); opacity: 0.24 !important; }
	.code-scene__glyph--cyan { fill: #75c5d8 !important; transform: translateX(4px); opacity: 0.32 !important; }
	.code-scene__brackets { color: var(--cover-accent); stroke-width: 2; }
	.code-scene__scan { stroke: var(--night-text); stroke-width: 1; opacity: 0.5; animation: code-scan 5.4s linear infinite; }

	.tutorial-scene__corridor { opacity: 0.4; }
	.tutorial-scene__steps path { stroke: var(--cover-line-strong); stroke-width: 4; opacity: 0; animation: tutorial-step-build 5.8s var(--ease-rain) infinite; animation-delay: calc(var(--i) * 95ms); }
	.tutorial-scene__nodes { color: var(--cover-accent); fill: var(--cover-bg); stroke-width: 1.5; }
	.tutorial-scene__nodes text { fill: var(--cover-muted); stroke: none; font-family: var(--font-ui); font-size: 10px; }
	.tutorial-scene__arrow { fill: none; stroke: var(--color-warm); stroke-width: 6; animation: project-signal 2.8s ease-in-out infinite alternate; }

	:global(html[data-weather-mode='night']) .content-cover:not(.content-cover--code) {
		--cover-bg: var(--night-0);
		--cover-line: #39545d;
		--cover-line-strong: #87a2aa;
		--cover-ink: var(--night-text);
		--cover-muted: var(--night-muted);
		--cover-accent: #75c5d8;
		--cover-fill: rgb(117 197 216 / 18%);
	}

	:global(html[data-weather-mode='night']) .content-cover__grain { mix-blend-mode: screen; opacity: 0.07; }
	:global(html[data-weather-mode='night']) .content-cover:not(.content-cover--code)::before {
		mix-blend-mode: screen;
		opacity: 0.32;
	}

	@keyframes cover-line-build {
		from { stroke-dashoffset: 920; opacity: 0.22; }
		to { stroke-dashoffset: 0; opacity: 0.76; }
	}
	@keyframes cover-float {
		from { transform: translate3d(-4px, 8px, 0) scale(0.97); }
		to { transform: translate3d(7px, -7px, 0) scale(1.02); }
	}
	@keyframes cover-paper-fall {
		0% { opacity: 0; transform: translate3d(-14px, -90px, 0) rotate(0deg); }
		18%, 78% { opacity: 0.78; }
		100% { opacity: 0; transform: translate3d(22px, 160px, 0) rotate(80deg); }
	}
	@keyframes cover-pulse {
		from { opacity: 0.28; transform: scale(0.96); }
		to { opacity: 0.72; transform: scale(1.02); }
	}
	@keyframes note-marker-breathe {
		from { opacity: 0.34; }
		to { opacity: 0.7; }
	}
	@keyframes project-block-shift {
		from { transform: translate3d(-8px, 8px, 0); }
		to { transform: translate3d(10px, -9px, 0); }
	}
	@keyframes project-signal {
		from { opacity: 0.3; transform: translateX(-8px); }
		to { opacity: 0.9; transform: translateX(8px); }
	}
	@keyframes photo-window-drift {
		from { transform: translate3d(-8px, 6px, 0) scale(1.02); }
		to { transform: translate3d(9px, -8px, 0) scale(1.06); }
	}
	@keyframes photo-reflection {
		from { opacity: 0.18; transform: scaleX(0.78); }
		to { opacity: 0.58; transform: scaleX(1); }
	}
	@keyframes code-rain-fall {
		0% { opacity: 0; transform: translateY(-150px) scaleY(0.4); }
		22%, 72% { opacity: 0.48; }
		100% { opacity: 0; transform: translateY(440px) scaleY(1.5); }
	}
	@keyframes code-scan {
		0% { opacity: 0; transform: translateY(18px); }
		12%, 76% { opacity: 0.54; }
		100% { opacity: 0; transform: translateY(470px); }
	}
	@keyframes tutorial-step-build {
		0%, 10% { opacity: 0; stroke-dasharray: 0 900; }
		32%, 76% { opacity: 0.82; stroke-dasharray: 900 0; }
		100% { opacity: 0.1; stroke-dasharray: 900 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.content-cover *,
		.content-cover *::before,
		.content-cover *::after {
			animation: none !important;
		}
		.tutorial-scene__steps path { opacity: 1; transform: none; }
	}

	/*
	 * 指针光斑：跟随指针的柔光斑，像举着放大镜看档案场景。颜色随天气——
	 * 雨天玻璃反光、晴日暖尘、夜间冷月。位置由脚本写入根元素的 CSS 变量。
	 */
	.content-cover__lens {
		position: absolute;
		inset: 0;
		z-index: 6;
		pointer-events: none;
		opacity: 0;
		background: radial-gradient(
			250px circle at var(--lens-x, 50%) var(--lens-y, 42%),
			var(--lens-tint, rgb(255 255 255 / 9%)),
			transparent 72%
		);
		mix-blend-mode: screen;
		transition: opacity 480ms var(--ease-rain);
	}

	.content-cover:hover .content-cover__lens { opacity: 1; }

	:global(html[data-weather-mode='rain']) .content-cover__lens { --lens-tint: rgb(224 240 244 / 10%); }
	:global(html[data-weather-mode='clear']) .content-cover__lens { --lens-tint: rgb(255 244 212 / 13%); }
	:global(html[data-weather-mode='night']) .content-cover__lens { --lens-tint: rgb(166 214 226 / 15%); }

	/*
	 * WebGL 涟漪层：铺满封面、指针事件全透。着色器只在指针行进时扰动
	 * 场景纹理（速度衰减后与 DOM 逐像素一致），柔光由 DOM 光斑负责。
	 */
	.content-cover__glass {
		position: absolute;
		inset: 0;
		z-index: 5;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>

<script>
	/*
	 * 场景指针干涉：程序生成的底图从此可以被拨动。WebGL 可用时由涟漪
	 * 着色器接管（见下方玻璃模块），这里只作为回退的矢量层——构图分组
	 * 按深度随指针错位（层视差），日历格、数据柱、步骤线、节点圆在指针
	 * 半径内被斥开、缓慢弹回。只在足够大的封面启用（小尺寸预览不动），
	 * 触屏与 reduced-motion 跳过；元素中心在初始化时按页面坐标缓存一次。
	 */
	const SCENE_ITEM_SELECTOR = [
		'.note-scene__cell',
		'.tutorial-scene__steps path',
		'.tutorial-scene__nodes > g',
		'.project-scene__nodes circle',
		'.photo-scene__windows rect',
		'.photo-scene__windows circle',
	].join(', ');

	interface SceneItem {
		el: SVGElement;
		cx: number;
		cy: number;
		x: number;
		y: number;
		tx: number;
		ty: number;
	}

	interface SceneLayer {
		el: SVGGElement;
		depth: number;
		x: number;
		y: number;
		tx: number;
		ty: number;
	}

	interface SceneField {
		root: HTMLElement;
		items: SceneItem[];
		layers: SceneLayer[];
		px: number;
		py: number;
		tpx: number;
		tpy: number;
	}

	const fields: SceneField[] = [];
	let fieldRaf = 0;

	const stepField = () => {
		fieldRaf = 0;
		let live = false;

		for (const field of fields) {
			field.px += (field.tpx - field.px) * 0.1;
			field.py += (field.tpy - field.py) * 0.1;
			if (Math.abs(field.tpx - field.px) > 0.002 || Math.abs(field.tpy - field.py) > 0.002) live = true;

			for (const layer of field.layers) {
				layer.tx = field.px * -11 * layer.depth;
				layer.ty = field.py * -8 * layer.depth;
				layer.x += (layer.tx - layer.x) * 0.12;
				layer.y += (layer.ty - layer.y) * 0.12;
				if (Math.abs(layer.x) > 0.05 || Math.abs(layer.y) > 0.05) {
					layer.el.style.transform = `translate(${layer.x.toFixed(2)}px, ${layer.y.toFixed(2)}px)`;
					live = true;
				} else if (layer.x !== 0) {
					layer.x = 0; layer.y = 0;
					layer.el.style.removeProperty('transform');
				}
			}

			for (const item of field.items) {
				item.x += (item.tx - item.x) * 0.16;
				item.y += (item.ty - item.y) * 0.16;
				if (Math.abs(item.x) > 0.05 || Math.abs(item.y) > 0.05) {
					item.el.style.transform = `translate(${item.x.toFixed(2)}px, ${item.y.toFixed(2)}px)`;
					live = true;
				} else if (item.x !== 0) {
					item.x = 0; item.y = 0;
					item.el.style.removeProperty('transform');
				}
			}
		}

		if (live) fieldRaf = window.requestAnimationFrame(stepField);
	};

	const wakeField = () => {
		if (!fieldRaf) fieldRaf = window.requestAnimationFrame(stepField);
	};

	function initScenePointerFields() {
		if (!window.matchMedia('(pointer: fine)').matches) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		document.querySelectorAll<HTMLElement>('[data-content-cover]').forEach((root) => {
			if (root.dataset.sceneFieldReady === 'true') return;
			// 小尺寸预览（首页滚动条带等）不参与干涉，只留给大封面。
			const rect = root.getBoundingClientRect();
			if (rect.width < 420 || rect.height < 240) return;
			root.dataset.sceneFieldReady = 'true';

			// WebGL 玻璃着色器优先：接管折射/色散/涟漪时，DOM 视差与斥力退场，
			// 避免静态纹理与被推开的矢量元素在透镜边缘对不上。
			const glass = (window as unknown as {
				__aria7SceneGlass?: (root: HTMLElement) => boolean;
			}).__aria7SceneGlass;
			if (glass && glass(root)) return;

			const originX = rect.left + window.scrollX;
			const originY = rect.top + window.scrollY;
			const items: SceneItem[] = [...root.querySelectorAll<SVGElement>(SCENE_ITEM_SELECTOR)]
				.map((el) => {
					const box = el.getBoundingClientRect();
					return {
						el,
						cx: box.left + box.width / 2 + window.scrollX - originX,
						cy: box.top + box.height / 2 + window.scrollY - originY,
						x: 0, y: 0, tx: 0, ty: 0,
					};
				});
			// 场景内的构图分组按 DOM 前后赋深度：先画的是远景，动得少。
			const layers: SceneLayer[] = [...root.querySelectorAll<SVGGElement>("g[class$='-scene'] > g")]
				.map((el, index, all) => ({
					el,
					depth: 0.35 + (all.length > 1 ? index / (all.length - 1) : 0) * 0.65,
					x: 0, y: 0, tx: 0, ty: 0,
				}));

			const field: SceneField = { root, items, layers, px: 0, py: 0, tpx: 0, tpy: 0 };
			fields.push(field);

			root.addEventListener('pointermove', (event) => {
				const localX = event.clientX + window.scrollX - originX;
				const localY = event.clientY + window.scrollY - originY;
				field.tpx = localX / rect.width - 0.5;
				field.tpy = localY / rect.height - 0.5;
				root.style.setProperty('--lens-x', `${localX.toFixed(1)}px`);
				root.style.setProperty('--lens-y', `${localY.toFixed(1)}px`);

				for (const item of field.items) {
					const dx = item.cx - localX;
					const dy = item.cy - localY;
					const distance = Math.hypot(dx, dy);
					if (distance < 120 && distance > 0.5) {
						const push = Math.pow(1 - distance / 120, 1.6) * 12;
						item.tx = (dx / distance) * push;
						item.ty = (dy / distance) * push;
					} else {
						item.tx = 0; item.ty = 0;
					}
				}
				wakeField();
			});

			root.addEventListener('pointerleave', () => {
				field.tpx = 0; field.tpy = 0;
				for (const item of field.items) { item.tx = 0; item.ty = 0; }
				wakeField();
			});
		});
	}

	// 延后一拍初始化：让玻璃着色器模块先完成注册，接管与否才判定得准。
	window.requestAnimationFrame(initScenePointerFields);
	document.addEventListener('astro:page-load', initScenePointerFields);
</script>

<script>
	/*
	 * WebGL 玻璃透镜：把程序生成的场景捕获成纹理，交给片段着色器做真正的
	 * 光学——水珠圆域内的折射与中央放大、边缘 RGB 色散、折缘高光环、指针
	 * 速度激起的涟漪、活性颗粒。透镜圆域之外 alpha=0，露出 DOM 场景。
	 * 场景颜色的作用域样式与设计令牌在捕获时内联进独立 SVG 文档；
	 * 天气切换会改变令牌，因此纹理随 weather-mode-change 延迟重拍。
	 */
	type SceneGlassEntry = (root: HTMLElement) => boolean;

	const VERT = `
attribute vec2 aPos;
varying vec2 vUv;
void main() {
	vUv = aPos * 0.5 + 0.5;
	gl_Position = vec4(aPos, 0.0, 1.0);
}`;

	const FRAG = `
precision highp float;
varying vec2 vUv;
uniform sampler2D uScene;
uniform vec2 uRes;
uniform vec2 uPointer;
uniform float uTime;
uniform float uVelocity;
uniform vec2 uParallax;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void main() {
	vec2 frag = gl_FragCoord.xy;
	vec2 baseUv = vUv + uParallax * vec2(0.008, 0.006);

	vec2 d = frag - uPointer;
	float dist = length(d);
	vec2 dir = d / max(dist, 0.001);

	// 涟漪：只在指针行进时存在，速度衰减后位移归零，
	// 画面回到与 DOM 场景逐像素一致——没有可见的圆域边界。
	float ripple = sin(dist * 0.07 - uTime * 5.2) * exp(-dist * 0.0095) * uVelocity;
	vec2 uv = baseUv + dir * ripple * 9.0 / uRes;

	vec3 col = texture2D(uScene, clamp(uv, vec2(0.001), vec2(0.999))).rgb;
	col += (hash(frag + fract(uTime) * 61.7) - 0.5) * 0.03;

	float alpha = clamp(abs(ripple) * 2.4, 0.0, 0.9);
	gl_FragColor = vec4(col * alpha, alpha);
}`;

	// 捕获时必须随行内样式一起进独立 SVG 文档的令牌，否则 var() 全部落空。
	const TOKEN_NAMES = [
		'--cover-bg', '--cover-line', '--cover-line-strong', '--cover-ink', '--cover-muted',
		'--cover-accent', '--cover-fill', '--paper-0', '--line', '--line-strong', '--ink',
		'--ink-muted', '--color-rain', '--color-rain-deep', '--color-warm', '--night-text',
		'--font-ui', '--font-display',
	];

	function collectScopedCss(root: HTMLElement): string {
		const cid = [...root.attributes]
			.find((attr) => attr.name.startsWith('data-astro-cid-'))
			?.name.slice('data-astro-cid-'.length);
		if (!cid) return '';
		let css = '';
		for (const sheet of document.styleSheets) {
			let rules: CSSRuleList | undefined;
			try {
				rules = sheet.cssRules;
			} catch {
				continue;
			}
			if (!rules) continue;
			for (const rule of rules) {
				if (rule.cssText && rule.cssText.includes(`-${cid}`)) css += `${rule.cssText}\n`;
			}
		}
		return css;
	}

	function renderSceneToCanvas(
		root: HTMLElement,
		width: number,
		height: number,
		onReady: (canvas: HTMLCanvasElement) => void,
	): void {
		const svg = root.querySelector('svg');
		if (!svg) return;
		const clone = svg.cloneNode(true) as SVGSVGElement;
		const rootStyle = getComputedStyle(root);
		// 令牌走 <style> 的根选择器注入而非 style 属性——字体令牌里的双引号
		// 会撞破属性引号，让整个文档解析失败。
		const vars = TOKEN_NAMES
			.map((name) => {
				const value = rootStyle.getPropertyValue(name).trim();
				return value ? `${name}: ${value};` : '';
			})
			.join(' ');
		const markup = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${clone.getAttribute('viewBox') ?? '0 0 800 520'}" width="800" height="520" preserveAspectRatio="xMidYMid slice"><style>svg { ${vars} } ${collectScopedCss(root)}</style>${clone.innerHTML}</svg>`;
		const blob = new Blob([markup], { type: 'image/svg+xml' });
		const url = URL.createObjectURL(blob);
		const image = new Image();
		const out = document.createElement('canvas');
		out.width = Math.max(2, Math.round(width));
		out.height = Math.max(2, Math.round(height));
		const ctx = out.getContext('2d');
		image.onload = () => {
			// 与 slice 语义一致：等比放大到盖满画布后居中裁切
			const scale = Math.max(out.width / 800, out.height / 520);
			const w = 800 * scale;
			const h = 520 * scale;
			ctx?.drawImage(image, (out.width - w) / 2, (out.height - h) / 2, w, h);
			URL.revokeObjectURL(url);
			onReady(out);
		};
		image.onerror = () => URL.revokeObjectURL(url);
		image.src = url;
	}

	function tryAttachSceneGlass(root: HTMLElement): boolean {
		const canvas = root.querySelector<HTMLCanvasElement>('.content-cover__glass');
		if (!canvas) return false;
		const gl = (canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: true })
			?? canvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;
		if (!gl) return false;

		const compile = (type: number, source: string) => {
			const shader = gl.createShader(type);
			if (!shader) return null;
			gl.shaderSource(shader, source);
			gl.compileShader(shader);
			if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
				gl.deleteShader(shader);
				return null;
			}
			return shader;
		};
		const vs = compile(gl.VERTEX_SHADER, VERT);
		const fs = compile(gl.FRAGMENT_SHADER, FRAG);
		const program = gl.createProgram();
		if (!vs || !fs || !program) return false;
		gl.attachShader(program, vs);
		gl.attachShader(program, fs);
		gl.linkProgram(program);
		if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return false;
		gl.useProgram(program);

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const aPos = gl.getAttribLocation(program, 'aPos');
		gl.enableVertexAttribArray(aPos);
		gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

		const uScene = gl.getUniformLocation(program, 'uScene');
		const uRes = gl.getUniformLocation(program, 'uRes');
		const uPointer = gl.getUniformLocation(program, 'uPointer');
		const uTime = gl.getUniformLocation(program, 'uTime');
		const uVelocity = gl.getUniformLocation(program, 'uVelocity');
		const uParallax = gl.getUniformLocation(program, 'uParallax');
		gl.uniform1i(uScene, 0);

		const texture = gl.createTexture();
		gl.bindTexture(gl.TEXTURE_2D, texture);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
		gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, 1);
		gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([0, 0, 0, 0]));

		const dpr = Math.min(1.6, window.devicePixelRatio || 1);
		const resize = () => {
			const box = root.getBoundingClientRect();
			canvas.width = Math.max(2, Math.round(box.width * dpr));
			canvas.height = Math.max(2, Math.round(box.height * dpr));
			gl.viewport(0, 0, canvas.width, canvas.height);
			gl.uniform2f(uRes, canvas.width, canvas.height);
		};
		resize();
		window.addEventListener('resize', resize);

		const upload = () => {
			renderSceneToCanvas(root, canvas.width, canvas.height, (captured) => {
				gl.bindTexture(gl.TEXTURE_2D, texture);
				gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, captured);
			});
		};
		upload();
		// 天气切换会翻转变量色板，等转场演完再重拍纹理。
		let recaptureTimer = 0;
		const onWeatherChange = () => {
			window.clearTimeout(recaptureTimer);
			recaptureTimer = window.setTimeout(upload, 1200);
		};
		document.addEventListener('weather-mode-change', onWeatherChange);

		let pointerX = -9999;
		let pointerY = -9999;
		let smoothX = -9999;
		let smoothY = -9999;
		let velocity = 0;
		let inside = false;
		let fade = 0;
		let rafId = 0;
		const time0 = performance.now();

		const render = () => {
			rafId = 0;
			velocity *= 0.95;
			if (!inside) fade = Math.max(0, fade - 0.06);
			const local = root.getBoundingClientRect();
			if (pointerX > -9000) {
				const targetX = (pointerX - local.left) * dpr;
				const targetY = (local.height - (pointerY - local.top)) * dpr;
				if (smoothX < -9000) { smoothX = targetX; smoothY = targetY; }
				smoothX += (targetX - smoothX) * 0.18;
				smoothY += (targetY - smoothY) * 0.18;
			}
			const parallaxX = smoothX > -9000 ? ((smoothX / canvas.width) - 0.5) * 2 : 0;
			const parallaxY = smoothY > -9000 ? ((smoothY / canvas.height) - 0.5) * 2 : 0;

			gl.uniform2f(uPointer, smoothX, smoothY);
			gl.uniform1f(uTime, (performance.now() - time0) / 1000);
			gl.uniform1f(uVelocity, velocity);
			gl.uniform2f(uParallax, parallaxX, parallaxY);
			gl.clearColor(0, 0, 0, 0);
			gl.clear(gl.COLOR_BUFFER_BIT);
			gl.drawArrays(gl.TRIANGLES, 0, 3);

			if (inside || velocity > 0.01 || fade > 0) {
				if (inside) fade = 1;
				rafId = window.requestAnimationFrame(render);
			}
		};

		const wake = () => {
			if (!rafId) rafId = window.requestAnimationFrame(render);
		};

		root.addEventListener('pointerenter', () => {
			inside = true;
			wake();
		});
		root.addEventListener('pointermove', (event) => {
			velocity = Math.min(1, velocity + Math.min(0.35, Math.hypot(event.clientX - pointerX, event.clientY - pointerY) / 260));
			pointerX = event.clientX;
			pointerY = event.clientY;
			inside = true;
			// 柔光交还给 DOM 光斑：位置变量照常驱动，着色器只管涟漪扰动。
			const localRect = root.getBoundingClientRect();
			root.style.setProperty('--lens-x', `${(event.clientX - localRect.left).toFixed(1)}px`);
			root.style.setProperty('--lens-y', `${(event.clientY - localRect.top).toFixed(1)}px`);
			wake();
		}, { passive: true });
		root.addEventListener('pointerleave', () => {
			inside = false;
			wake();
		});

		root.setAttribute('data-glass-active', '');
		return true;
	}

	(window as unknown as { __aria7SceneGlass?: SceneGlassEntry }).__aria7SceneGlass = tryAttachSceneGlass;
</script>

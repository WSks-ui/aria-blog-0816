<div class="shared-title-transition" data-shared-title-transition transition:persist="aria7-title-carrier" aria-hidden="true">
	<div class="shared-title-transition__exposure" data-shared-title-exposure>
		<span class="shared-title-transition__label" data-shared-title-label>PROFILE / ARIA-7</span>
	</div>
	<span class="shared-title-transition__carrier" data-shared-title-carrier>Aria-7</span>
</div>

<script>
	import { navigate } from 'astro:transitions/client';

	type Rect = {
		left: number;
		top: number;
		width: number;
		height: number;
	};

	type TitleStyle = {
		fontFamily: string;
		fontSize: string;
		fontWeight: string;
		fontStretch: string;
		fontStyle: string;
		fontVariant: string;
		lineHeight: string;
		letterSpacing: string;
		color: string;
		textTransform: string;
		fontFeatureSettings: string;
		fontVariationSettings: string;
	};

	type PendingTransition = {
		rect: Rect;
		style: TitleStyle;
	};

	type RouterTransitionEvent = Event & {
		sourceElement?: Element | null;
		from?: URL;
		to?: URL;
		newDocument?: Document;
	};

	const FALLBACK_DURATION = 420;
	/*
	 * 「离场呼吸 + 到达显影」编拍（点击 → 导航 → 抵达）：
	 *   Hero 文案先退场（HomeHero/about 内 CSS，160–220ms），
	 *   巨型标题同步微微上浮（280ms）；
	 *   曝光幕借 WeatherTransition 晴天档的透明度语言涨满（延迟 90ms 起，300ms 升满，
	 *   无移动边缘、无色块扫屏），430ms 提交导航；
	 *   标题经命名 View Transition 在成形中的目标页上方飞行；
	 *   抵达即随页内显影级联把曝光撤下（480ms）。字面值为编排内有意错拍；
	 *   兜底计时防导航被拦截后曝光滞留首屏。
	 */
	const EXPOSURE_IN_DELAY = 90;
	const EXPOSURE_IN_DURATION = 300;
	const NAVIGATE_AT = 430;
	const EXPOSURE_OUT_DURATION = 480;
	const SAFETY_TIMEOUT = 2400;
	const RAIN_EASING = 'cubic-bezier(0.22, 0.75, 0.28, 1)';

	let root: HTMLElement | null = null;
	let carrier: HTMLElement | null = null;
	let exposure: HTMLElement | null = null;
	let label: HTMLElement | null = null;
	let pendingTransition: PendingTransition | null = null;
	let pendingTimer = 0;
	let carrierAnimation: Animation | null = null;
	let targetAnimation: Animation | null = null;
	let source: HTMLElement | null = null;
	let target: HTMLElement | null = null;
	let sourceOpacity = '';
	let sourceOpacityPriority = '';
	let targetOpacity = '';
	let targetOpacityPriority = '';
	let journeyActive = false;
	let submitTimer = 0;
	let safetyTimer = 0;
	let settleTimer = 0;
	let exposureAnimation: Animation | null = null;

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const supportsNativeTransition = typeof document.startViewTransition === 'function';

	const getRect = (element: Element): Rect => {
		const rect = element.getBoundingClientRect();
		return { left: rect.left, top: rect.top, width: rect.width, height: rect.height };
	};

	const isValidRect = (rect: Rect) => rect.width > 0 && rect.height > 0;

	const getStyle = (element: HTMLElement): TitleStyle => {
		const style = getComputedStyle(element);
		return {
			fontFamily: style.fontFamily,
			fontSize: style.fontSize,
			fontWeight: style.fontWeight,
			fontStretch: style.fontStretch,
			fontStyle: style.fontStyle,
			fontVariant: style.fontVariant,
			lineHeight: style.lineHeight,
			letterSpacing: style.letterSpacing,
			color: style.color,
			textTransform: style.textTransform,
			fontFeatureSettings: style.fontFeatureSettings,
			fontVariationSettings: style.fontVariationSettings,
		};
	};

	const normalizePath = (pathname: string) => pathname.replace(/\/+$/, '') || '/';

	const setCarrierStyle = (element: HTMLElement, rect: Rect, style: TitleStyle) => {
		element.style.left = `${rect.left}px`;
		element.style.top = `${rect.top}px`;
		element.style.width = `${rect.width}px`;
		element.style.height = `${rect.height}px`;
		element.style.fontFamily = style.fontFamily;
		element.style.fontSize = style.fontSize;
		element.style.fontWeight = style.fontWeight;
		element.style.fontStretch = style.fontStretch;
		element.style.fontStyle = style.fontStyle;
		element.style.fontVariant = style.fontVariant;
		element.style.lineHeight = style.lineHeight;
		element.style.letterSpacing = style.letterSpacing;
		element.style.color = style.color;
		element.style.textTransform = style.textTransform;
		element.style.fontFeatureSettings = style.fontFeatureSettings;
		element.style.fontVariationSettings = style.fontVariationSettings;
		element.style.opacity = '1';
		element.style.transform = 'translate3d(0, 0, 0) scale(1)';
	};

	const restoreOpacity = (element: HTMLElement | null, value: string, priority: string) => {
		if (!element) return;
		if (value) {
			element.style.setProperty('opacity', value, priority);
		} else {
			element.style.removeProperty('opacity');
		}
	};

	const reset = () => {
		window.clearTimeout(pendingTimer);
		pendingTimer = 0;
		carrierAnimation?.cancel();
		targetAnimation?.cancel();
		carrierAnimation = null;
		targetAnimation = null;
		restoreOpacity(source, sourceOpacity, sourceOpacityPriority);
		restoreOpacity(target, targetOpacity, targetOpacityPriority);
		source = null;
		target = null;
		sourceOpacity = '';
		sourceOpacityPriority = '';
		targetOpacity = '';
		targetOpacityPriority = '';
		pendingTransition = null;
		carrier?.removeAttribute('style');
	};

	const clearJourneyTimers = () => {
		window.clearTimeout(submitTimer);
		window.clearTimeout(safetyTimer);
		window.clearTimeout(settleTimer);
		submitTimer = 0;
		safetyTimer = 0;
		settleTimer = 0;
	};

	const hardReset = () => {
		clearJourneyTimers();
		exposureAnimation?.cancel();
		exposureAnimation = null;
		journeyActive = false;
		reset();
		root?.classList.remove('is-veiling');
		delete document.documentElement.dataset.titleVeil;
		delete document.documentElement.dataset.titleFlight;
		if (exposure) {
			// 进入动画 fill 会持续压过行内样式，必须全部取消后停靠态才生效。
			exposure.getAnimations().forEach((animation) => animation.cancel());
			exposure.style.removeProperty('opacity');
		}
		if (label) label.textContent = 'PROFILE / ARIA-7';
	};

	/*
	 * 到达侧：撤掉曝光露出成形中的页面。此前玻璃纸幕靠 transform 下滑时，
	 * 命名转场会把新页快照整页冻住，级联只能在幕后偷偷跑完再被硬掀开；
	 * 现在根元素不参与视图转场（见 BaseLayout 的 view-transition-name: none），
	 * 抵达后的页面是活层，曝光透明度衰减与显影级联可以实时同台演出。
	 */
	const beginExposureFall = () => {
		if (!root || !exposure) {
			hardReset();
			return;
		}
		window.clearTimeout(submitTimer);
		delete document.documentElement.dataset.titleVeil;
		exposure.getAnimations().forEach((animation) => animation.cancel());
		exposureAnimation = null;
		exposure.style.opacity = '1';
		exposureAnimation = exposure.animate(
			[{ opacity: '1' }, { opacity: '0' }],
			{ duration: EXPOSURE_OUT_DURATION, easing: RAIN_EASING, fill: 'forwards' },
		);
		settleTimer = window.setTimeout(() => hardReset(), EXPOSURE_OUT_DURATION + 80);
	};

	const beginExposureJourney = (destination: URL, trigger: HTMLAnchorElement) => {
		if (!root || !exposure || journeyActive) return;
		journeyActive = true;
		root.classList.add('is-veiling');
		// HomeHero/about 依此标记让文案组先行呼吸退场；巨型标题保持可见，
		// 只微微上浮，随后交给命名 View Transition 飞行。这里先给旧快照命名；
		// 目标文档会在 astro:before-swap 内同步命名，避免根属性交换把它清掉。
		document.documentElement.dataset.titleVeil = 'leaving';
		document.documentElement.dataset.titleFlight = 'active';
		if (label) {
			label.textContent = normalizePath(destination.pathname) === '/about'
				? 'PROFILE / ARIA-7'
				: 'INDEX / RAIN ARCHIVE';
		}
		// 行内终态先行：跨文档搬运或动画丢弃时，新文档同一帧仍是覆盖态，不会露出硬切。
		exposure.getAnimations().forEach((animation) => animation.cancel());
		exposure.style.opacity = '1';
		exposureAnimation = exposure.animate(
			[{ opacity: '0' }, { opacity: '1' }],
			{ duration: EXPOSURE_IN_DURATION, delay: EXPOSURE_IN_DELAY, easing: RAIN_EASING, fill: 'both' },
		);
		submitTimer = window.setTimeout(() => {
			try {
				navigate(destination.href, { sourceElement: trigger });
			} catch {
				hardReset();
			}
		}, NAVIGATE_AT);
		safetyTimer = window.setTimeout(() => {
			if (journeyActive) hardReset();
		}, SAFETY_TIMEOUT);
	};

	const handleClick = (event: Event) => {
		if (!(event instanceof MouseEvent) || event.defaultPrevented) return;
		if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		if (journeyActive) {
			event.preventDefault();
			return;
		}
		if (reduceMotion.matches || typeof navigate !== 'function') return;

		const target = event.target;
		if (!(target instanceof Element)) return;
		const link = target.closest<HTMLAnchorElement>('a[data-aria7-title-transition-link]');
		if (!link || link.target || link.hasAttribute('download')) return;
		const rawHref = link.getAttribute('href');
		if (!rawHref || rawHref.startsWith('#')) return;
		let destination: URL;
		try {
			destination = new URL(rawHref, window.location.href);
		} catch {
			return;
		}
		if (destination.origin !== window.location.origin) return;
		if (destination.pathname === window.location.pathname && destination.search === window.location.search) return;
		// 编排只服务首页↔关于这对镜面路由，品牌链接在其他页面保持普通导航。
		const from = normalizePath(window.location.pathname);
		const to = normalizePath(destination.pathname);
		const mirroredPair = (from === '/' && to === '/about') || (from === '/about' && to === '/');
		if (!mirroredPair) return;

		event.preventDefault();
		beginExposureJourney(destination, link);
	};

	// ClientRouter 已确认本次导航并取得目标文档后才触发该事件。后备载体在此刻
	// 接管当前页标题，与路由器共用同一条导航事务，不会和链接点击监听器竞争时机。
	const prepareFallback = (event: RouterTransitionEvent) => {
		if (reduceMotion.matches || supportsNativeTransition) return;
		const trigger = event.sourceElement instanceof Element
			? event.sourceElement.closest<HTMLAnchorElement>('a[data-aria7-title-transition-link]')
			: null;
		if (!trigger || trigger.target || trigger.hasAttribute('download')) {
			return;
		}
		const destination = new URL(trigger.href, window.location.href);
		if (destination.origin !== window.location.origin) return;
		const from = normalizePath(window.location.pathname);
		const to = normalizePath(destination.pathname);
		const mirroredPair = (from === '/' && to === '/about') || (from === '/about' && to === '/');
		if (!mirroredPair) return;
		const title = document.querySelector<HTMLElement>('[data-aria7-title-transition]');
		if (!title) {
			return;
		}

		const rect = getRect(title);
		if (!isValidRect(rect)) {
			return;
		}
		reset();
		source = title;
		sourceOpacity = title.style.getPropertyValue('opacity');
		sourceOpacityPriority = title.style.getPropertyPriority('opacity');
		if (carrier) setCarrierStyle(carrier, rect, getStyle(title));
		title.style.setProperty('opacity', '0', 'important');
		pendingTransition = { rect, style: getStyle(title) };
		// 取页失败或被新导航取消时恢复源标题，防止载体长时间占住首屏。
		pendingTimer = window.setTimeout(() => reset(), 1800);
	};

	/*
	 * Astro 会在交换阶段以 newDocument 的 <html> 属性覆盖当前根节点。命名
	 * View Transition 的旧快照已在此回调前固定，而新快照会在 swap 后采集；
	 * 因此必须在这里给目标文档补上同一标记，才能让两个 Aria-7 归入同一
	 * aria7-title 组并插值位置。不能只依赖当前 documentElement 的属性，
	 * 否则交换后目标标题会回到 view-transition-name: none，表现为没有跟踪。
	 */
	const armIncomingTitle = (event: RouterTransitionEvent) => {
		if (reduceMotion.matches || !journeyActive) return;
		const trigger = event.sourceElement instanceof Element
			? event.sourceElement.closest<HTMLAnchorElement>('a[data-aria7-title-transition-link]')
			: null;
		if (!trigger || trigger.target || trigger.hasAttribute('download')) return;

		const from = normalizePath(event.from?.pathname ?? window.location.pathname);
		const to = normalizePath(event.to?.pathname ?? new URL(trigger.href, window.location.href).pathname);
		const mirroredPair = (from === '/' && to === '/about') || (from === '/about' && to === '/');
		if (!mirroredPair) return;

		event.newDocument?.documentElement.setAttribute('data-title-flight', 'active');
	};

	const completeFallback = () => {
		if (!pendingTransition || reduceMotion.matches || supportsNativeTransition) return;
		const title = document.querySelector<HTMLElement>('[data-aria7-title-transition]');
		if (!title || !carrier) {
			reset();
			return;
		}
		const destinationRect = getRect(title);
		if (!isValidRect(destinationRect)) {
			reset();
			return;
		}

		target = title;
		targetOpacity = title.style.getPropertyValue('opacity');
		targetOpacityPriority = title.style.getPropertyPriority('opacity');
		title.style.setProperty('opacity', '0');
		const { rect } = pendingTransition;
		const finalTransform = `translate3d(${destinationRect.left - rect.left}px, ${destinationRect.top - rect.top}px, 0) scale(${destinationRect.width / rect.width}, ${destinationRect.height / rect.height})`;
		carrierAnimation = carrier.animate([
			{ transform: 'translate3d(0, 0, 0) scale(1)', opacity: 1, offset: 0 },
			{ transform: finalTransform, opacity: 1, offset: 0.8 },
			{ transform: finalTransform, opacity: 0, offset: 1 },
		], {
			duration: FALLBACK_DURATION,
			easing: RAIN_EASING,
			fill: 'forwards',
		});
		targetAnimation = title.animate(
			[{ opacity: 0 }, { opacity: 1 }],
			{ duration: 110, delay: FALLBACK_DURATION - 110, easing: 'ease-out', fill: 'forwards' },
		);
		Promise.allSettled([carrierAnimation.finished, targetAnimation.finished]).then(() => reset());
	};

	function initSharedTitleTransition() {
		root = document.querySelector<HTMLElement>('[data-shared-title-transition]') ?? null;
		carrier = root?.querySelector<HTMLElement>('[data-shared-title-carrier]') ?? null;
		exposure = root?.querySelector<HTMLElement>('[data-shared-title-exposure]') ?? null;
		label = root?.querySelector<HTMLElement>('[data-shared-title-label]') ?? null;
		// 上一次旅程被浏览器缓存打断时会残留行内覆盖态；非旅程状态下直接归零。
		// 注意：不能在这里清除 data-title-flight。这个组件会随 ClientRouter 持久化，
		// 而目标根节点刚由 armIncomingTitle 接手标记；过早清除会让标题飞行断开。
		if (!journeyActive && exposure) exposure.style.removeProperty('opacity');
	}

	initSharedTitleTransition();
	document.addEventListener('astro:page-load', initSharedTitleTransition);
	document.addEventListener('click', handleClick, true);
	document.addEventListener('astro:before-preparation', prepareFallback);
	document.addEventListener('astro:before-swap', armIncomingTitle);
	// 抵达侧：fallback="swap" 模式下节点会被整体替换，先重查引用再撤幕，
	// 保证持久化与非持久化两条路径的曝光都从覆盖态继续退去。
	document.addEventListener('astro:after-swap', () => {
		initSharedTitleTransition();
		completeFallback();
		if (!journeyActive) return;
		beginExposureFall();
	});
	window.addEventListener('pageshow', (event) => {
		if (event.persisted) hardReset();
	});
</script>

<style>
	.shared-title-transition {
		position: fixed;
		inset: 0;
		z-index: var(--z-route);
		pointer-events: none;
	}

	/* 编排进行中整幕拦截点击与键盘误触，结束后由 hardReset 释放。 */
	.shared-title-transition.is-veiling {
		pointer-events: auto;
	}

	/*
	 * 曝光幕：不滑动、无边缘，只做透明度呼吸。基色取天气光晕与纸面的调和
	 * （--weather-glow 在雨/晴/夜三档都有合适亮度：雨天浅青、晴天近白、夜间
	 * 中亮的青，避免夜间被漂白成刺目闪屏），上亮下沉的极浅渐变模拟暗房灯箱，
	 * 叠 archive-fiber 纤维维持档案质感。平时完全透明，编拍时由 WAAPI 涨满再退去。
	 */
	.shared-title-transition__exposure {
		position: fixed;
		inset: 0;
		opacity: 0;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--weather-glow) 52%, var(--weather-surface)) 0%,
			color-mix(in srgb, var(--weather-glow) 34%, var(--weather-surface)) 64%,
			color-mix(in srgb, var(--weather-glow) 22%, var(--weather-surface)) 100%
		);
		will-change: opacity;
	}

	.shared-title-transition__exposure::before {
		position: absolute;
		inset: 0;
		content: '';
		background: url('/assets/patterns/archive-fiber.svg') 0 0 / 220px 220px;
		opacity: var(--weather-fiber-opacity, 0.18);
		mix-blend-mode: var(--weather-fiber-blend, multiply);
	}

	.shared-title-transition__label {
		position: absolute;
		left: 28px;
		bottom: 24px;
		font-family: var(--font-ui);
		font-size: 9px;
		letter-spacing: 0.14em;
		color: var(--ink-muted);
	}

	.shared-title-transition__carrier {
		position: fixed;
		box-sizing: border-box;
		display: inline-block;
		margin: 0;
		padding: 0;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transform-origin: top left;
		will-change: transform, opacity;
		text-rendering: geometricPrecision;
	}

	@media (prefers-reduced-motion: reduce) {
		.shared-title-transition { display: none; }
	}
</style>

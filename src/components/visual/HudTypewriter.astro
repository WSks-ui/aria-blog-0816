---
/**
 * HUD 打字机：带 data-hud-type 的等宽小标注（ARCHIVE / TIME、SCENE / 001
 * 这类登记条目）首次进入视口时逐字敲出，带一拍光标闪烁，像田野录音机在
 * 登记。只对 ASCII 标注生效——中文整词敲字只会拖慢阅读。reduced-motion
 * 下直接跳过，标注保持原样。
 */
---

<script>
	import { afterPageTransition } from '@/lib/page-transition';
	interface HudEntry {
		target: Element;
		isIntersecting: boolean;
	}

	let observer: IntersectionObserver | null = null;
	let cancelPending: (() => void) | undefined;
	const activeAnimations = new Map<HTMLElement, Animation>();

	const typeOut = (element: HTMLElement) => {
		if (element.dataset.hudTyped === 'true') return;
		const text = element.textContent ?? '';
		element.dataset.hudTyped = 'true';
		// 只敲 ASCII 标注；空文本与中文直接放行。
		if (!text.trim() || !/^[\x20-\x7e]+$/.test(text)) return;
		element.classList.add('hud-typing');
		// 文本始终保留完整宽度：逐字替换 textContent 会使换页后的 HUD 每隔
		// 约 24ms 重新塑形、重排。阶梯裁剪只改变显露范围，不改变文字和邻居的位置。
		const animation = element.animate(
			[{ clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0 0 0)' }],
			{ duration: Math.min(720, text.length * 24), delay: 240, easing: `steps(${text.length}, end)`, fill: 'backwards' },
		);
		activeAnimations.set(element, animation);
		animation.finished.then(() => {
			element.classList.remove('hud-typing');
			activeAnimations.delete(element);
		}, () => {});
	};

	function initHudTypewriter() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		if (!observer) {
			observer = new IntersectionObserver((entries: HudEntry[]) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					typeOut(entry.target as HTMLElement);
					observer?.unobserve(entry.target);
				}
			}, { threshold: 0.6 });
		}
		document.querySelectorAll<HTMLElement>('[data-hud-type]').forEach((element) => {
			if (element.dataset.hudTyped === 'true' || element.dataset.hudObserved === 'true') return;
			element.dataset.hudObserved = 'true';
			observer?.observe(element);
		});
	}

	const scheduleHud = () => {
		cancelPending?.();
		cancelPending = afterPageTransition(initHudTypewriter);
	};
	scheduleHud();
	document.addEventListener('astro:page-load', scheduleHud);
	// swap 会整体替换文档：先释放上一页被观察的全部元素（含未进入视口、
	// 未打完字的），observer 单例保持复用，下一页 page-load 再观察当前元素。
	document.addEventListener('astro:before-swap', () => {
		cancelPending?.();
		observer?.disconnect();
		activeAnimations.forEach((animation, element) => {
			animation.cancel();
			element.classList.remove('hud-typing');
		});
		activeAnimations.clear();
	});
</script>

<style is:global>
	[data-hud-type].hud-typing::after {
		position: absolute;
		display: inline-block;
		width: 6px;
		height: 1em;
		margin-inline-start: 2px;
		background: currentColor;
		content: '';
		vertical-align: text-bottom;
		opacity: 0.8;
		animation: hud-caret 0.85s steps(2, start) infinite;
	}

	@keyframes hud-caret {
		50% { opacity: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		[data-hud-type].hud-typing::after {
			animation: none;
		}
	}
</style>

<div class="hero-scene" data-hero-scene aria-hidden="true">
	<!-- 独立材质层承接纸张、青色雾面与远景构图；上方 SVG 只负责可读的制图标注。 -->
	<div class="hero-scene__material"></div>
	<canvas class="hero-scene__weather" data-hero-weather></canvas>

	<svg class="hero-scene__draft" viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid slice">
		<defs>
			<pattern id="hero-grid" width="76" height="76" patternUnits="userSpaceOnUse">
				<path d="M76 0H0V76" fill="none" stroke="currentColor" stroke-width="1" />
			</pattern>
			<filter id="hero-liquid" x="-18%" y="-45%" width="136%" height="190%">
				<!-- 失真纹理由静态噪声提供；动态改由文字组的合成层漂移承担，避免逐帧重算滤镜。 -->
				<feTurbulence type="fractalNoise" baseFrequency="0.006 0.025" numOctaves="2" seed="7" result="noise">
				</feTurbulence>
				<feDisplacementMap in="SourceGraphic" in2="noise" scale="18" xChannelSelector="R" yChannelSelector="B" />
				<feGaussianBlur stdDeviation="0.45" />
			</filter>
		</defs>

		<!-- 四拍换景作用在世界组上：视差仍由 svg 根承担，推镜只走这一层的合成 transform。 -->
		<g class="hero-scene__world">
			<rect class="hero-scene__grid" x="0" y="0" width="1200" height="620" fill="url(#hero-grid)" />
			<g class="hero-scene__frame">
				<path d="M28 92V28H94M1106 28h66v64M28 528v64h66M1106 592h66v-64" />
				<path d="M28 126h1144M28 494h1144M292 28v564M1012 28v564" />
			</g>

			<g class="hero-scene__perspective">
				<path d="M442 592 814 292 1172 592M566 592 814 292M690 592 814 292M938 592 814 292M1062 592 814 292" />
				<path d="M488 554h650M531 519h565M573 485h480M616 451h394M658 417h309M701 383h224M743 349h139" />
			</g>

			<g class="hero-scene__columns">
				<rect x="520" y="133" width="36" height="344" style="--column-index: 0" />
				<rect x="571" y="99" width="52" height="378" style="--column-index: 1" />
				<rect x="638" y="167" width="31" height="310" style="--column-index: 2" />
				<rect x="684" y="72" width="69" height="405" style="--column-index: 3" />
				<rect x="768" y="124" width="42" height="353" style="--column-index: 4" />
				<rect x="825" y="87" width="58" height="390" style="--column-index: 5" />
				<rect x="898" y="152" width="34" height="325" style="--column-index: 6" />
				<rect x="947" y="111" width="63" height="366" style="--column-index: 7" />
			</g>

			<!-- 消失点标记：同心弧、十字刻度与中心方块。伞退场后，首屏焦点交还给抽象制图语言。 -->
			<g class="hero-scene__apex">
				<circle cx="814" cy="292" r="16" />
				<circle cx="814" cy="292" r="38" />
				<circle cx="814" cy="292" r="66" />
				<path d="M814 258v-18M814 326v18M780 292h-18M848 292h18" />
				<rect x="811" y="289" width="6" height="6" />
			</g>

			<!-- 签名伞：中央大伞退场后，伞以线稿小签名的形式留在右上角——当“章”不当“主角”。 -->
			<g class="hero-scene__signature" transform="translate(1042 196) scale(.6)">
				<path d="M-66 24Q0-56 66 24Z" />
				<path d="M0-36v60M-66 24 0-36 66 24M0 24v58" />
			</g>
			<g class="hero-scene__satellites">
				<g transform="translate(490 384) scale(.34)">
					<path d="M-66 24Q0-56 66 24Z" />
					<path d="M0-36v60M-66 24 0-36 66 24M0 24v58" />
				</g>
			</g>

			<g class="hero-scene__papers">
				<!-- 纸片不再使用标准矩形；每块都保留轻微缺口与不等边，形成手工裁切感。 -->
				<path d="M542 88 561 87 565 105 553 113 540 104 539 95Z" style="--paper-index: 0" />
				<path d="M636 214 647 214 650 224 642 229 635 225Z" style="--paper-index: 1" />
				<path d="M711 64 736 66 744 87 729 101 707 95 705 76Z" style="--paper-index: 2" />
				<path d="M777 231 790 230 794 244 782 251 774 243Z" style="--paper-index: 3" />
				<path d="M875 49 891 50 896 64 885 73 871 66Z" style="--paper-index: 4" />
				<path d="M947 254 978 257 983 280 965 298 941 286 939 267Z" style="--paper-index: 5" />
				<path d="M1031 127 1044 126 1048 139 1038 146 1027 140Z" style="--paper-index: 6" />
				<path d="M1104 344 1127 348 1131 368 1112 378 1097 365Z" style="--paper-index: 7" />
				<path d="M501 475 514 474 519 487 508 496 497 488Z" style="--paper-index: 8" />
				<path d="M743 505 764 507 769 527 753 537 738 525Z" style="--paper-index: 9" />
				<path d="M971 468 984 467 988 479 978 486 967 480Z" style="--paper-index: 10" />
			</g>

			<g class="hero-scene__night-word" filter="url(#hero-liquid)">
				<text x="790" y="446">ARCHIVE / 07</text>
			</g>
		</g>
	</svg>

	<!-- 置于左侧遮罩之上，保留制图标注气质，同时确保浅色背景下仍有足够对比度。 -->
	<div class="hero-scene__telemetry" aria-hidden="true">
		<span>VISUAL WEATHER / LIVE</span>
		<span>PRECIPITATION / LIVE · CN / UTC+8</span>
	</div>

	<div class="hero-scene__wet-glass hero-scene__wet-glass--a"></div>
	<div class="hero-scene__wet-glass hero-scene__wet-glass--b"></div>
	<div class="hero-scene__scanline"></div>
	<div class="hero-scene__beat">
		<span data-hero-beat>PHASE 01 / LOCATE</span>
		<i aria-hidden="true"><b></b><b></b><b></b><b></b></i>
	</div>
</div>

<script>
	type WeatherMode = 'clear' | 'rain' | 'night';

	interface RainDrop {
		x: number;
		y: number;
		length: number;
		speed: number;
		weight: number;
		alpha: number;
		phase: number;
	}

	function initHeroScenes() {
		document.querySelectorAll<HTMLElement>('[data-hero-scene]').forEach((root) => {
			if (root.dataset.interactiveReady === 'true') return;
			root.dataset.interactiveReady = 'true';
			root.dataset.beat = '0';

			const canvas = root.querySelector<HTMLCanvasElement>('[data-hero-weather]');
			const beat = root.querySelector<HTMLElement>('[data-hero-beat]');
			const draft = root.querySelector<SVGSVGElement>('.hero-scene__draft');
			const context = canvas?.getContext('2d');
			if (!canvas || !context) return;

			/*
			 * Astro 的页面切换会移除首页节点，但 document 监听、ResizeObserver 和
			 * IntersectionObserver 不会随 DOM 自动释放。统一通过 AbortController 收口，
			 * 避免多次进入首页后旧雨幕继续响应天气切换或占用动画帧。
			 */
			const lifecycle = new AbortController();
			let disposed = false;
			let resizeObserver: ResizeObserver | undefined;
			let visibilityObserver: IntersectionObserver | undefined;
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			let width = 1;
			let height = 1;
			let pixelRatio = 1;
			let animationFrame = 0;
			let visible = true;
			let lastTime = performance.now();
			let beatIndex = 0;
			let beatElapsed = -1200;
			let rainEnergy = 0.18;
			let pointerX = 0.68;
			let pointerY = 0.46;
			let pointerTargetX = pointerX;
			let pointerTargetY = pointerY;
			let rainColor = '#1887aa';
			let drops: RainDrop[] = [];
			let randomSeed = 0x7a11ce;

			/*
			 * 四拍不只调节密度，而是“换景”：定位幕近乎无雨、消失点标记登台；
			 * 雨幕幕全量落雨抬柱；聚焦幕雨量让位、世界组向消失点轻推镜；
			 * 余辉幕一切褪场，只留制图线与下一轮的留白。
			 */
			const beats = [
				{ duration: 3600, label: 'PHASE 01 / LOCATE', rain: 0.06 },
				{ duration: 4200, label: 'PHASE 02 / RAIN', rain: 1 },
				{ duration: 3800, label: 'PHASE 03 / FOCUS', rain: 0.5 },
				{ duration: 3200, label: 'PHASE 04 / AFTERGLOW', rain: 0.04 },
			] as const;

			const mode = (): WeatherMode => {
				const value = document.documentElement.dataset.weatherMode;
				return value === 'clear' || value === 'night' ? value : 'rain';
			};

			// 固定种子让首屏每次以同一场景开场；画布缩放不会再令整片雨幕突然换位。
			const random = () => {
				randomSeed = (randomSeed * 1664525 + 1013904223) >>> 0;
				return randomSeed / 4294967296;
			};

			const randomDrop = (initial = false): RainDrop => ({
				x: random(),
				y: initial ? random() : -0.2 - random() * 0.4,
				length: 26 + random() * 86,
				speed: 0.14 + random() * 0.36,
				weight: 0.55 + random() * 1.3,
				alpha: 0.1 + random() * 0.34,
				phase: random() * Math.PI * 2,
			});

			const syncRainDensity = () => {
				// 只增减归一化雨线数组，保留既有粒子位置，避免 ResizeObserver 触发视觉跳帧。
				const areaRatio = Math.min(1.5, Math.max(0.7, (width * height) / (1200 * 620)));
				const targetCount = Math.round(92 * areaRatio);
				if (drops.length < targetCount) {
					drops.push(...Array.from({ length: targetCount - drops.length }, () => randomDrop(true)));
				} else if (drops.length > targetCount) {
					drops.length = targetCount;
				}
			};

			const resize = () => {
				const bounds = root.getBoundingClientRect();
				width = Math.max(1, bounds.width);
				height = Math.max(1, bounds.height);
				pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
				canvas.width = Math.round(width * pixelRatio);
				canvas.height = Math.round(height * pixelRatio);
				canvas.style.width = `${width}px`;
				canvas.style.height = `${height}px`;
				context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
				syncRainDensity();
			};

			const updateColors = () => {
				// 主题色只在初始化和模式切换时读取，避免全尺寸 Canvas 每帧触发样式解析。
				const styles = getComputedStyle(document.documentElement);
				rainColor = styles.getPropertyValue('--color-rain-deep').trim() || '#1887aa';
			};

			const setBeat = (nextBeat: number, restart = false) => {
				beatIndex = nextBeat;
				root.dataset.beat = String(beatIndex);
				if (restart) beatElapsed = 0;
				if (!beat) return;
				beat.textContent = beats[beatIndex].label;
				if (!reduceMotion.matches) {
					beat.animate(
						[
							{ opacity: 0.18, transform: 'translateY(5px)' },
							{ opacity: 1, transform: 'translateY(0)' },
						],
						{ duration: 520, easing: 'cubic-bezier(.22,.75,.28,1)' },
					);
				}
			};

			const draw = (now: number) => {
				if (disposed) return;
				const delta = Math.min(48, now - lastTime) / 1000;
				lastTime = now;
				beatElapsed += delta * 1000;
				while (beatElapsed >= beats[beatIndex].duration) {
					beatElapsed -= beats[beatIndex].duration;
					setBeat((beatIndex + 1) % beats.length);
				}
				rainEnergy += (beats[beatIndex].rain - rainEnergy) * Math.min(1, delta * 1.35);
				pointerX += (pointerTargetX - pointerX) * Math.min(1, delta * 4.5);
				pointerY += (pointerTargetY - pointerY) * Math.min(1, delta * 4.5);

				context.clearRect(0, 0, width, height);
				const currentMode = mode();
				context.globalCompositeOperation = currentMode === 'night' ? 'screen' : 'multiply';

				if (currentMode !== 'clear') {
					context.strokeStyle = rainColor;
					context.lineCap = 'round';
					drops.forEach((drop, index) => {
						drop.y += drop.speed * delta * (0.45 + rainEnergy * 0.72) * (currentMode === 'night' ? 0.8 : 1);
						if (drop.y > 1.24) drops[index] = randomDrop();
						const sway = Math.sin(now * 0.0012 + drop.phase) * 8 + (pointerX - 0.5) * 10;
						const x = drop.x * width + sway;
						const y = drop.y * height;
						context.globalAlpha = drop.alpha * rainEnergy * (currentMode === 'night' ? 0.72 : 0.56);
						context.lineWidth = drop.weight;
						context.beginPath();
						context.moveTo(x, y);
						context.lineTo(x - 3, y + drop.length);
						context.stroke();
					});
				}

				context.globalAlpha = 1;
				context.globalCompositeOperation = 'source-over';
				root.style.setProperty('--hero-draft-x', `${(pointerX - 0.5) * -9}px`);
				root.style.setProperty('--hero-draft-y', `${(pointerY - 0.5) * -6}px`);

				if (visible && !document.hidden && !reduceMotion.matches) {
					animationFrame = requestAnimationFrame(draw);
				}
			};

			const renderStaticFrame = () => {
				lastTime = performance.now();
				draw(lastTime);
				cancelAnimationFrame(animationFrame);
			};

			const start = () => {
				if (disposed) return;
				cancelAnimationFrame(animationFrame);
				// Canvas 与 SVG 必须共用可见性状态，否则离开首屏后液态层仍会独自推进。
				if (reduceMotion.matches || !visible || document.hidden) draft?.pauseAnimations();
				else draft?.unpauseAnimations();
				if (reduceMotion.matches || !visible || document.hidden) {
					renderStaticFrame();
					return;
				}
				lastTime = performance.now();
				animationFrame = requestAnimationFrame(draw);
			};

			const syncMotionPreference = () => {
				start();
			};

			const dispose = () => {
				if (disposed) return;
				disposed = true;
				cancelAnimationFrame(animationFrame);
				resizeObserver?.disconnect();
				visibilityObserver?.disconnect();
				draft?.pauseAnimations();
				lifecycle.abort();
			};

			root.addEventListener('pointermove', (event) => {
				const bounds = root.getBoundingClientRect();
				pointerTargetX = Math.min(1, Math.max(0, (event.clientX - bounds.left) / bounds.width));
				pointerTargetY = Math.min(1, Math.max(0, (event.clientY - bounds.top) / bounds.height));
			}, { signal: lifecycle.signal });
			root.addEventListener('pointerleave', () => {
				pointerTargetX = 0.68;
				pointerTargetY = 0.46;
			}, { signal: lifecycle.signal });

			resizeObserver = new ResizeObserver(resize);
			resizeObserver.observe(root);
			visibilityObserver = new IntersectionObserver(([entry]) => {
				visible = entry?.isIntersecting ?? true;
				start();
			}, { threshold: 0.05 });
			visibilityObserver.observe(root);

			document.addEventListener('visibilitychange', start, { signal: lifecycle.signal });
			document.addEventListener('weather-mode-change', () => {
				updateColors();
				// 天气遮罩覆盖期间重启场景，使新模式总是从“定位”阶段温和建立。
				setBeat(0, true);
				rainEnergy = beats[0].rain;
				draft?.setCurrentTime(0);
				start();
			}, { signal: lifecycle.signal });
			reduceMotion.addEventListener('change', syncMotionPreference, { signal: lifecycle.signal });
			document.addEventListener('astro:before-swap', dispose, { once: true, signal: lifecycle.signal });
			updateColors();
			resize();
			syncMotionPreference();
		});
	}

	initHeroScenes();
	document.addEventListener('astro:page-load', initHeroScenes);
</script>

<style>
	.hero-scene {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: var(--weather-base);
		isolation: isolate;
	}

	.hero-scene::before {
		position: absolute;
		inset: 0 44% 0 0;
		z-index: 3;
		background: linear-gradient(
			90deg,
			color-mix(in srgb, var(--paper-0) 96%, transparent),
			color-mix(in srgb, var(--paper-0) 86%, transparent) 68%,
			transparent
		);
		content: '';
		pointer-events: none;
	}

	.hero-scene__material {
		position: absolute;
		z-index: 0;
		inset: -3%;
		background-image: url('/assets/patterns/atmosphere-rain.svg'), url('/assets/patterns/archive-fiber.svg');
		background-position: 64% 46%, center;
		background-size: cover, 420px 420px;
		background-repeat: no-repeat, repeat;
		opacity: 0.86;
		mix-blend-mode: multiply;
		transform: scale(1.035);
		animation: hero-material-drift 24s var(--ease-drift) infinite alternate;
		transition: opacity 900ms var(--ease-rain), filter 900ms var(--ease-rain), background-image 1ms linear;
		will-change: transform;
	}

	.hero-scene__material::after {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse at 77% 23%, color-mix(in srgb, var(--weather-glow) 42%, transparent), transparent 30%),
			linear-gradient(112deg, transparent 36%, color-mix(in srgb, var(--weather-haze) 20%, transparent) 68%, transparent);
		content: '';
	}

	.hero-scene__weather,
	.hero-scene__draft,
	.hero-scene__scanline {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-scene__weather {
		z-index: 2;
		pointer-events: none;
	}

	.hero-scene__draft {
		z-index: 1;
		color: var(--line);
		transform: translate3d(
			var(--hero-draft-x, 0px),
			var(--hero-draft-y, 0px),
			0
		);
		transition: color var(--duration-slow) var(--ease-rain);
		will-change: transform;
	}

	.hero-scene__grid {
		opacity: 0.28;
		transition: opacity 1100ms var(--ease-rain);
	}

	/* 世界组承接四拍推镜：视差在 svg 根上逐帧写变量，这里只消费慢速缩放。 */
	.hero-scene__world {
		transform-box: view-box;
		transform-origin: 814px 292px;
		transform: scale(var(--hero-beat-zoom, 1));
		transition: transform 1500ms var(--ease-drift);
	}

	.hero-scene__frame,
	.hero-scene__perspective,
	.hero-scene__apex,
	.hero-scene__signature,
	.hero-scene__satellites {
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}

	.hero-scene__frame {
		opacity: 0.7;
	}

	/* 透视廊道与消失点共同承担主视觉：伞退场后这里就是画面的“主角”。 */
	.hero-scene__perspective {
		opacity: 0.34;
		transform: scaleY(0.975);
		transform-origin: 814px 292px;
		transition: opacity 1100ms var(--ease-rain), transform 1500ms var(--ease-drift);
	}

	.hero-scene__apex {
		transform-box: view-box;
		transform-origin: 814px 292px;
		transform: scale(var(--hero-apex-scale, 1));
		transition: opacity 1100ms var(--ease-rain), transform 1500ms var(--ease-drift);
	}

	.hero-scene__apex rect {
		fill: var(--accent-strong);
		stroke: none;
	}

	/* 签名伞：线稿、小幅、稳定在场，是站标与“伞骨”命名的画面呼应。 */
	.hero-scene__signature {
		stroke: var(--accent-strong);
		stroke-width: 1.4;
		opacity: 0.44;
		transition: opacity 900ms var(--ease-rain);
	}

	.hero-scene__columns {
		fill: color-mix(in srgb, var(--color-rain) 54%, transparent);
		opacity: 0.1;
		transition: opacity 1100ms var(--ease-rain);
	}

	.hero-scene__columns rect {
		transform-box: fill-box;
		transform-origin: center top;
		transform: scaleY(0.08);
		transition: transform 1500ms var(--ease-rain), opacity 900ms var(--ease-rain);
		transition-delay: calc(var(--column-index) * 70ms);
	}

	.hero-scene__satellites {
		color: var(--accent-strong);
		opacity: 0.24;
		transition: opacity 900ms var(--ease-rain), transform 1400ms var(--ease-drift);
	}

	.hero-scene__papers path {
		fill: var(--color-paper);
		stroke: var(--line-strong);
		stroke-width: 1;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		transform: translate3d(-5px, -16px, 0) rotate(calc(var(--paper-index) * 3deg));
		transition: transform 1900ms var(--ease-drift), opacity 900ms var(--ease-rain);
		transition-delay: calc(var(--paper-index) * 38ms);
	}

		.hero-scene[data-beat='0'] {
			--hero-beat-zoom: 1;
			--hero-apex-scale: 1;
		}

		.hero-scene[data-beat='0'] .hero-scene__columns { opacity: 0.1; }
		.hero-scene[data-beat='0'] .hero-scene__columns rect { transform: scaleY(0.08); }
		.hero-scene[data-beat='0'] .hero-scene__perspective { opacity: 0.5; transform: scaleY(0.975); }
		.hero-scene[data-beat='0'] .hero-scene__apex { opacity: 0.85; }
		.hero-scene[data-beat='0'] .hero-scene__satellites { opacity: 0.12; }
		.hero-scene[data-beat='0'] .hero-scene__papers path {
			opacity: 0;
			transform: translate3d(-5px, -16px, 0) rotate(calc(var(--paper-index) * 3deg));
			/* 上一幕已将纸片淡出，此处立即归位，避免逆向飞回顶部。 */
			transition-duration: 0ms, 700ms;
		}

		.hero-scene[data-beat='1'] {
			--hero-beat-zoom: 1.004;
			--hero-apex-scale: 0.92;
		}
	.hero-scene[data-beat='1'] .hero-scene__columns { opacity: 0.4; }
	.hero-scene[data-beat='1'] .hero-scene__columns rect { transform: scaleY(1); }
	.hero-scene[data-beat='1'] .hero-scene__perspective { opacity: 0.58; transform: scaleY(1.01); }
	.hero-scene[data-beat='1'] .hero-scene__apex { opacity: 0.3; }
	.hero-scene[data-beat='1'] .hero-scene__signature { opacity: 0.56; }
	.hero-scene[data-beat='1'] .hero-scene__papers path {

	.route-transition__papers span:nth-child(10) { --paper-x: -46vw; --paper-y: 3vh; --paper-r: 9deg; --paper-delay: 64ms; width: 44px; height: 57px; }
	.route-transition__papers span:nth-child(11) { --paper-x: 17vw; --paper-y: 17vh; --paper-r: -22deg; --paper-delay: 6ms; width: 38px; height: 50px; }

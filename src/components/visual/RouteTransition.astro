	.route-transition__papers span:nth-child(4) { --paper-x: 34vw; --paper-y: -27vh; --paper-r: 22deg; --paper-delay: 58ms; }
	.route-transition__papers span:nth-child(5) { --paper-x: 43vw; --paper-y: -2vh; --paper-r: -12deg; --paper-delay: 20ms; width: 46px; height: 60px; }

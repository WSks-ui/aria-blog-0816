<div class="route-transition" data-route-transition aria-hidden="true">
	<div class="route-transition__backdrop"></div>
	<svg class="route-transition__corridor" viewBox="0 0 1000 600" preserveAspectRatio="none">
		<path d="M0 0 500 300 1000 0M0 600 500 300 1000 600M0 0 500 300 0 600M1000 0 500 300 1000 600" />
		<path d="M92 55 500 300 908 55M92 545 500 300 908 545M188 112 500 300 812 112M188 488 500 300 812 488" />
	</svg>
	<div class="route-transition__rain">
		<span></span><span></span><span></span><span></span><span></span><span></span><span></span>
		<span></span><span></span><span></span><span></span><span></span><span></span><span></span>
	</div>
	<div class="route-transition__papers">
		<span></span><span></span><span></span><span></span><span></span><span></span>
		<span></span><span></span><span></span><span></span><span></span><span></span>
	</div>
	<div class="route-transition__axis"></div>
	<span class="route-transition__label">ROUTE / SCENE SHIFT</span>
</div>

<script>
	const ROUTE_ARRIVAL_KEY = 'aria7-route-arrival';

	function initRouteTransition() {
		const root = document.querySelector<HTMLElement>('[data-route-transition]');
		if (!root || root.dataset.interactiveReady === 'true') return;
		root.dataset.interactiveReady = 'true';

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let navigationTimer = 0;
		let arrivalTimer = 0;
		let safetyTimer = 0;
		let arrivalPrimeFrame = 0;
		let arrivalFrame = 0;
		let navigating = false;

		const resetTransition = () => {
			window.clearTimeout(navigationTimer);
			window.clearTimeout(arrivalTimer);
			window.clearTimeout(safetyTimer);
			window.cancelAnimationFrame(arrivalPrimeFrame);
			window.cancelAnimationFrame(arrivalFrame);
			navigating = false;
			root.classList.remove('is-leaving', 'is-arrival-ready', 'is-arriving');
			delete document.documentElement.dataset.routeTransition;
			delete document.documentElement.dataset.routeArrival;
			try {
				window.sessionStorage.removeItem(ROUTE_ARRIVAL_KEY);
			} catch {
				// 会话存储不可用时无需额外清理，视觉状态仍由当前页面解除。
			}
		};

		if (document.documentElement.dataset.routeArrival === 'true' && !reduceMotion.matches) {
			// 先用不透明遮罩接住 HTML 首帧，再移除 body 黑底；下一帧才开始退场，
			// 否则遮罩淡出时下层仍是黑色，末尾会整页突然显现为一次白闪。
			root.classList.add('is-arrival-ready');
			arrivalPrimeFrame = window.requestAnimationFrame(() => {
				arrivalFrame = window.requestAnimationFrame(() => {
					delete document.documentElement.dataset.routeArrival;
					root.classList.remove('is-arrival-ready');
					root.classList.add('is-arriving');
					arrivalTimer = window.setTimeout(resetTransition, 680);
				});
			});
		} else {
			delete document.documentElement.dataset.routeArrival;
		}

		document.addEventListener('click', (event) => {
			if (!(event instanceof MouseEvent) || event.defaultPrevented) return;
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			if (navigating) {
				event.preventDefault();
				return;
			}

			const target = event.target;
			if (!(target instanceof Element)) return;
			// 文章入口与主导航共用同一套整页转场；其余链接不主动接管，避免影响搜索、关系图、哈希定位和外部跳转。
			const link = target.closest('a[data-article-transition-link], a[data-route-transition-link]');
			if (!link || link.hasAttribute('download')) return;
			const rawTarget = link.getAttribute('target');
			const rawHref = link.getAttribute('href');
			if (!rawHref || rawHref.startsWith('#') || link.hasAttribute('data-scene-link')) return;
			if (rawTarget && rawTarget !== '_self') return;

			// 关系图中的入口是 SVGAnchorElement，必须读取属性值，不能依赖 HTMLAnchorElement.href。
			const destination = new URL(rawHref, window.location.href);
			const sameDocument = destination.origin === window.location.origin
				&& destination.pathname === window.location.pathname
				&& destination.search === window.location.search;
			if (destination.origin !== window.location.origin || sameDocument) return;
			if (reduceMotion.matches) return;

			event.preventDefault();
			navigating = true;
			// 到达动画尚未结束时也允许继续导航，但必须先取消旧清理任务，
			// 避免它在离场中途移除遮罩并取消本次 navigationTimer。
			window.clearTimeout(arrivalTimer);
			window.cancelAnimationFrame(arrivalPrimeFrame);
			window.cancelAnimationFrame(arrivalFrame);
			root.classList.remove('is-arrival-ready', 'is-arriving');
			root.classList.add('is-leaving');
			document.documentElement.dataset.routeTransition = 'leaving';

			navigationTimer = window.setTimeout(() => {
				// 标记绑定具体目标，并在真正导航前才写入；浏览器后退或重定向不会让无关页面误播入场。
				try {
					window.sessionStorage.setItem(ROUTE_ARRIVAL_KEY, JSON.stringify({
						pathname: destination.pathname,
						search: destination.search,
					}));
				} catch {
					// 隐私模式禁用会话存储时仍完成离场与导航，只省略下一页的反向镜头。
				}
				// 哈希导航、浏览器拦截或异常路由都不应把全屏遮罩永久留在当前页面。
				safetyTimer = window.setTimeout(resetTransition, 1400);
				window.location.assign(destination.href);
			}, 800);
		});

		// 浏览器从往返缓存恢复旧页面时，离场类可能被完整保存，必须立刻解除遮罩。
		window.addEventListener('pageshow', (event) => {
			if (event.persisted) resetTransition();
		});
	}

	initRouteTransition();
	document.addEventListener('astro:page-load', initRouteTransition);
</script>

<style>

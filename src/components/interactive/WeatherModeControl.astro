---
import { CloudRain, Moon, Sun } from '@lucide/astro';

export type WeatherMode = 'clear' | 'rain' | 'night';

interface Props {
  class?: string;
  label?: string;
  storageKey?: string;
}

const {
  class: className,
  label = '天气主题',
  storageKey = 'aria7-weather-mode',
} = Astro.props;
---

<div
  class:list={['weather-mode-control', className]}
  data-weather-mode-control
  data-storage-key={storageKey}
  role="group"
  aria-label={label}
>
  <button
    class="weather-mode-control__button"
    type="button"
    data-weather-mode-value="clear"
    aria-label="切换到晴朗模式"
    aria-pressed="false"
  >
    <Sun size={20} stroke-width={1.5} aria-hidden="true" />
    <span class="weather-mode-control__label">Clear</span>
  </button>
  <button
    class="weather-mode-control__button"
    type="button"
    data-weather-mode-value="rain"
    aria-label="切换到雨天模式"
    aria-pressed="false"
  >
    <CloudRain size={20} stroke-width={1.5} aria-hidden="true" />
    <span class="weather-mode-control__label">Rain</span>
  </button>
  <button
    class="weather-mode-control__button"
    type="button"
    data-weather-mode-value="night"
    aria-label="切换到夜间模式"
    aria-pressed="false"
  >
    <Moon size={20} stroke-width={1.5} aria-hidden="true" />
    <span class="weather-mode-control__label">Night</span>
  </button>
</div>

<script>
  type WeatherMode = 'clear' | 'rain' | 'night';

  const weatherModes: WeatherMode[] = ['clear', 'rain', 'night'];

  function isWeatherMode(value: string | null): value is WeatherMode {
    return value !== null && weatherModes.includes(value as WeatherMode);
  }

  function initWeatherModeControls() {
    document.querySelectorAll<HTMLElement>('[data-weather-mode-control]').forEach((root) => {
      if (root.dataset.interactiveReady === 'true') return;
      root.dataset.interactiveReady = 'true';

      const storageKey = root.dataset.storageKey || 'aria7-weather-mode';
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-weather-mode-value]'),
      );
      const darkPreference = window.matchMedia('(prefers-color-scheme: dark)');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let hasStoredPreference = false;

      const readStoredMode = (): WeatherMode | null => {
        try {
          const value = localStorage.getItem(storageKey);
          const mode = isWeatherMode(value) ? value : null;
          hasStoredPreference = mode !== null;
          return mode;
        } catch {
          return null;
        }
      };

      const commitMode = (mode: WeatherMode, persist = false, initial = false) => {
        const previousMode = isWeatherMode(document.documentElement.dataset.weatherMode ?? null)
          ? document.documentElement.dataset.weatherMode as WeatherMode
          : null;
        document.documentElement.dataset.weatherMode = mode;
        document.documentElement.dataset.theme = mode === 'night' ? 'night' : 'light';
        document.documentElement.style.colorScheme = mode === 'night' ? 'dark' : 'light';
        root.dataset.activeMode = mode;
        delete root.dataset.pendingMode;
        const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]:not([media])');
        if (themeColor) {
		  // 地址栏颜色必须与场景底材同步，避免主题切换时浏览器边缘闪出旧色板。
          themeColor.content = mode === 'night' ? '#0d1216' : mode === 'clear' ? '#f6f7f3' : '#ebedec';
        }

        buttons.forEach((button) => {
          const selected = button.dataset.weatherModeValue === mode;
          button.setAttribute('aria-pressed', String(selected));
          button.dataset.active = String(selected);
        });

        document.querySelectorAll<HTMLElement>('[data-weather-theme-label]').forEach((label) => {
          label.textContent = `THEME / ${mode.toUpperCase()}`;
          label.dataset.weatherMode = mode;
        });

        if (persist) {
          try {
            localStorage.setItem(storageKey, mode);
            hasStoredPreference = true;
          } catch {
            // 隐私模式可能禁用存储；主题仍在当前页面立即生效。
          }
        }

        document.dispatchEvent(
          new CustomEvent('weather-mode-change', {
            detail: { mode, previousMode, source: persist ? 'control' : 'system', initial },
          }),
        );
      };

      const requestMode = (mode: WeatherMode, persist = false, initial = false) => {
        const previousMode = isWeatherMode(document.documentElement.dataset.weatherMode ?? null)
          ? document.documentElement.dataset.weatherMode as WeatherMode
          : null;
        if (initial || previousMode === mode || reduceMotion.matches) {
          commitMode(mode, persist, initial);
          return;
        }

        let committed = false;
        const commit = () => {
          if (committed) return;
          committed = true;
          commitMode(mode, persist, false);
        };
        root.dataset.pendingMode = mode;
        const request = new CustomEvent('weather-mode-request', {
          cancelable: true,
          detail: { mode, previousMode, commit },
        });
        // 没有转场组件接管请求时立即提交，确保控件可以独立复用。
        if (document.dispatchEvent(request)) commit();
      };

      const storedMode = readStoredMode();
      requestMode(storedMode ?? (darkPreference.matches ? 'night' : 'rain'), false, true);

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const mode = button.dataset.weatherModeValue;
          if (mode && isWeatherMode(mode)) requestMode(mode, true);
        });
      });

      darkPreference.addEventListener('change', (event) => {
        if (!hasStoredPreference) requestMode(event.matches ? 'night' : 'rain');
      });

      window.addEventListener('storage', (event) => {
        if (event.key !== storageKey && event.key !== null) return;
        const mode = isWeatherMode(event.newValue) ? event.newValue : null;
        hasStoredPreference = mode !== null;
        requestMode(mode ?? (darkPreference.matches ? 'night' : 'rain'));
      });
    });
  }

  initWeatherModeControls();
  document.addEventListener('astro:page-load', initWeatherModeControls);
</script>

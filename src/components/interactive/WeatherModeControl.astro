---
import { CloudRain, Moon, Sun } from '@lucide/astro';
import { WEATHER_MODE_STORAGE_KEY } from '@/lib/weather-mode';
import '@/styles/interactive.css';

export type WeatherMode = 'clear' | 'rain' | 'night';

interface Props {
  class?: string;
  label?: string;
  storageKey?: string;
}

const {
  class: className,
  label = '天气主题',
  storageKey = WEATHER_MODE_STORAGE_KEY,
} = Astro.props;
---

<div
  class:list={['weather-mode-control', className]}
  data-weather-mode-control
  data-storage-key={storageKey}
  role="radiogroup"
  aria-label={label}
>
  <button
    class="weather-mode-control__button"
    type="button"
    role="radio"
    aria-checked="false"
    data-weather-mode-value="clear"
    aria-label="切换到晴朗模式"
  >
    <Sun size={20} stroke-width={1.5} aria-hidden="true" />
    <span class="weather-mode-control__label">Clear</span>
  </button>
  <button
    class="weather-mode-control__button"
    type="button"
    role="radio"
    aria-checked="false"
    data-weather-mode-value="rain"
    aria-label="切换到雨天模式"
  >
    <CloudRain size={20} stroke-width={1.5} aria-hidden="true" />
    <span class="weather-mode-control__label">Rain</span>
  </button>
  <button
    class="weather-mode-control__button"
    type="button"
    role="radio"
    aria-checked="false"
    data-weather-mode-value="night"
    aria-label="切换到夜间模式"
  >
    <Moon size={20} stroke-width={1.5} aria-hidden="true" />
    <span class="weather-mode-control__label">Night</span>
  </button>
</div>

<script>
  import {
    commitWeatherMode,
    isWeatherMode,
    readStoredWeatherMode,
    WEATHER_MODE_STORAGE_KEY,
    type WeatherMode,
  } from '@/lib/weather-mode';

  type RouterSwapEvent = Event & { newDocument?: Document };

  // 与 lib/weather-mode.ts 的地址栏色保持一致。这里写入的是尚未交换的
  // newDocument，不能调用只操作当前 document 的 commitWeatherMode。
  const THEME_COLORS: Record<WeatherMode, string> = {
    clear: '#f6f7f3',
    rain: '#ebedec',
    night: '#0d1216',
  };

  /*
   * 每个控件实例挂在 document/window 上的监听统一放进一个 AbortController：
   * 控件被 transition:persist 保留时，这些监听理应跨换页存活；一旦控件在
   * 非持久化上下文中被换页丢弃，下一次初始化会回收已脱离文档实例的监听，
   * 避免旧闭包在换页后把天气模式改回旧值或重复提交。
   */
  const controlTeardowns = new Map<HTMLElement, AbortController>();

  function initWeatherModeControls() {
    controlTeardowns.forEach((controller, root) => {
      if (!root.isConnected) {
        controller.abort();
        controlTeardowns.delete(root);
      }
    });
    document.querySelectorAll<HTMLElement>('[data-weather-mode-control]').forEach((root) => {
      if (root.dataset.interactiveReady === 'true') return;
      root.dataset.interactiveReady = 'true';

      const controller = new AbortController();
      controlTeardowns.get(root)?.abort();
      controlTeardowns.set(root, controller);

      const storageKey = root.dataset.storageKey || WEATHER_MODE_STORAGE_KEY;
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-weather-mode-value]'),
      );
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const commitMode = (mode: WeatherMode, persist = false, initial = false) => {
        // 提交动作的单一实现在 lib/weather-mode；这里只维护本实例的状态：
        // activeMode 是换页恢复的可信来源，pendingMode 随提交作废。
        commitWeatherMode(mode, {
          storageKey: persist ? storageKey : undefined,
          source: persist ? 'control' : 'system',
          initial,
        });
        root.dataset.activeMode = mode;
        delete root.dataset.pendingMode;
      };

      const requestMode = (mode: WeatherMode, persist = false, initial = false) => {
        const previousMode = isWeatherMode(document.documentElement.dataset.weatherMode ?? null)
          ? document.documentElement.dataset.weatherMode as WeatherMode
          : null;
        if (initial || previousMode === mode || reduceMotion.matches) {
          commitMode(mode, persist, initial);
          return;
        }

        let committed = false;
        const commit = () => {
          if (committed) return;
          committed = true;
          commitMode(mode, persist, false);
        };
        root.dataset.pendingMode = mode;
        const request = new CustomEvent('weather-mode-request', {
          cancelable: true,
          detail: { mode, previousMode, commit },
        });
        // 没有转场组件接管请求时立即提交，确保控件可以独立复用。
        if (document.dispatchEvent(request)) commit();
      };

      const storedMode = readStoredWeatherMode(storageKey);
      // 首访默认固定为 Rain，不再跟随系统深浅色偏好；读者手动切换后才记住选择。
      requestMode(storedMode ?? 'rain', false, true);

      /*
       * 页头会在 ClientRouter 换页时持久化，但 Astro 仍会把目标文档的
       * <html data-weather-mode="rain"> 属性写回当前根节点。若等 after-swap
       * 再恢复，整棵页面会先按 Rain 结算一次样式、随后又按真实主题结算一次，
       * 两轮失效都发生在转场关键帧内。交换前直接修正 newDocument，当前页只
       * 接收最终主题；after-swap 仅保留异常路径兜底。
       */
      const carryModeIntoNewDocument = (event: RouterSwapEvent) => {
        const activeMode = root.dataset.activeMode ?? null;
        const mode = isWeatherMode(activeMode) ? activeMode : readStoredWeatherMode(storageKey) ?? 'rain';
        const incoming = event.newDocument;
        if (!incoming) return;

        incoming.documentElement.dataset.weatherMode = mode;
        incoming.documentElement.dataset.theme = mode === 'night' ? 'night' : 'light';
        incoming.documentElement.style.colorScheme = mode === 'night' ? 'dark' : 'light';
        const themeColor = incoming.querySelector<HTMLMetaElement>('meta[name="theme-color"]:not([media])');
        if (themeColor) themeColor.content = THEME_COLORS[mode];
      };
      const restoreModeAfterSwap = () => {
        const activeMode = root.dataset.activeMode ?? null;
        const mode = isWeatherMode(activeMode) ? activeMode : readStoredWeatherMode(storageKey) ?? 'rain';
        if (document.documentElement.dataset.weatherMode !== mode) {
          commitMode(mode, false);
        } else {
          // 正常路径已经在 newDocument 上完成提交；只维护控件私有状态，避免
          // 重复广播 weather-mode-change 触发纹理重建和全局样式更新。
          root.dataset.activeMode = mode;
          delete root.dataset.pendingMode;
        }
      };
      document.addEventListener('astro:before-swap', carryModeIntoNewDocument, { signal: controller.signal });
      document.addEventListener('astro:after-swap', restoreModeAfterSwap, { signal: controller.signal });

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const mode = button.dataset.weatherModeValue;
          if (mode && isWeatherMode(mode)) requestMode(mode, true);
        });
      });

      // 单选组键盘模型：方向键在成员间移动并直接选中，Home/End 跳到两端。
      root.addEventListener('keydown', (event) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
        const isHome = event.key === 'Home';
        const isEnd = event.key === 'End';
        if (step === undefined && !isHome && !isEnd) return;
        if (buttons.length === 0) return;
        event.preventDefault();
        const currentIndex = buttons.findIndex((item) => item.getAttribute('aria-checked') === 'true');
        // 分支内明确得到数字索引，避免将未处理的键盘输入带入数组访问。
        const nextIndex = step !== undefined
          ? (Math.max(0, currentIndex) + step + buttons.length) % buttons.length
          : isHome ? 0 : buttons.length - 1;
        const next = buttons[nextIndex];
        if (!next) return;
        next.focus();
        const mode = next.dataset.weatherModeValue;
        if (mode && isWeatherMode(mode)) requestMode(mode, true);
      });

      window.addEventListener('storage', (event) => {
        if (event.key !== storageKey && event.key !== null) return;
        const mode = isWeatherMode(event.newValue) ? event.newValue : null;
        requestMode(mode ?? 'rain');
      }, { signal: controller.signal });
    });
  }

  initWeatherModeControls();
  document.addEventListener('astro:page-load', initWeatherModeControls);
</script>

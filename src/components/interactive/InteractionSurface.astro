---
import '@/styles/interactive.css';
---

<script>
  /*
   * 原生光标开关：DOM 跟随光标的坐标只能在主线程收到 PointerEvent 后再写入
   * transform，必然落后于操作系统直接合成的硬件光标。视觉光标改为 CSS
   * cursor:url(...) 后，本组件只负责根据设备能力给 <html> 挂状态，不再
   * 创建或更新任何跟随节点。这样鼠标轨迹、点击与首页场景都不会有额外延迟。
   *
   * companion 保留为首页的表现分支：它明确使用系统光标，而非再绘制一个
   * 低透明度的延迟副本。高对比度、强制色彩和 reduced-motion 一律回退原生
   * 系统光标，避免影响平台提供的可访问性能力。
   */
  let teardownInteractionSurface: (() => void) | null = null;
  let lifecycleBound = false;

  function initInteractionSurface() {
    teardownInteractionSurface?.();

    const root = document.documentElement;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const highContrast = window.matchMedia('(prefers-contrast: more), (forced-colors: active)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const controller = new AbortController();
    const { signal } = controller;

    const syncAvailability = () => {
      const usable = finePointer.matches && !highContrast.matches && !reduceMotion.matches;
      root.dataset.archiveCursor = usable
        ? (document.body.classList.contains('cursor-companion') ? 'companion' : 'enabled')
        : 'disabled';
    };

    finePointer.addEventListener('change', syncAvailability, { signal });
    highContrast.addEventListener('change', syncAvailability, { signal });
    reduceMotion.addEventListener('change', syncAvailability, { signal });
    syncAvailability();

    teardownInteractionSurface = () => {
      controller.abort();
      delete root.dataset.archiveCursor;
      teardownInteractionSurface = null;
    };
  }

  const bindLifecycleListeners = () => {
    if (lifecycleBound) return;
    lifecycleBound = true;
    document.addEventListener('astro:before-swap', () => {
      teardownInteractionSurface?.();
    });
  };

  bindLifecycleListeners();
  initInteractionSurface();
  document.addEventListener('astro:page-load', initInteractionSurface);
</script>

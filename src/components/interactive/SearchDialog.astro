---
import { Search, X } from '@lucide/astro';
import { POST_KIND_LABELS, POST_KINDS } from '@/data/site';
import '@/styles/interactive.css';

interface Props {
  class?: string;
  indexUrl?: string;
  limit?: number;
  placeholder?: string;
  triggerLabel?: string;
}

const {
  class: className,
  indexUrl = '/search-index.json',
  limit = 8,
  placeholder = '搜索文章、标签或正文',
  triggerLabel = '搜索',
} = Astro.props;

const dialogId = `search-dialog-${Math.random().toString(36).slice(2, 10)}`;
const titleId = `${dialogId}-title`;
const statusId = `${dialogId}-status`;
const resultsId = `${dialogId}-results`;
---

<div
  class:list={['search-dialog', className]}
  data-search-dialog-root
  data-index-url={indexUrl}
  data-result-limit={limit}
>
  <button
    class="search-dialog__trigger"
    type="button"
    data-search-open
    aria-haspopup="dialog"
    aria-controls={dialogId}
    aria-expanded="false"
  >
    <Search size={20} stroke-width={1.5} aria-hidden="true" />
    <span class="search-dialog__trigger-label">{triggerLabel}</span>
    <span class="search-dialog__shortcut" aria-hidden="true">/</span>
  </button>

  <dialog
    class="search-dialog__window"
    id={dialogId}
    data-search-dialog
    aria-labelledby={titleId}
  >
    <section class="search-dialog__surface">
      <header class="search-dialog__header">
        <h2 class="search-dialog__title" id={titleId}>站内搜索</h2>
        <button
          class="search-dialog__close"
          type="button"
          data-search-close
          aria-label="关闭搜索"
        >
          <X size={20} stroke-width={1.5} aria-hidden="true" />
        </button>
      </header>

      <label class="search-dialog__field">
        <span class="search-dialog__field-label">搜索关键词</span>
        <span class="search-dialog__input-wrap">
          <Search size={20} stroke-width={1.5} aria-hidden="true" />
          <input
            class="search-dialog__input"
            data-search-input
            type="search"
            name="q"
            placeholder={placeholder}
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
            aria-controls={resultsId}
            aria-describedby={statusId}
          />
        </span>
      </label>

	  <div class="search-dialog__filters" role="group" aria-label="按内容类型筛选">
		<button type="button" data-search-kind="" data-kind-label="全部" aria-pressed="true">全部</button>
		{POST_KINDS.map((kind) => (
			<button type="button" data-search-kind={kind} data-kind-label={POST_KIND_LABELS[kind]} aria-pressed="false">
				{POST_KIND_LABELS[kind]}
			</button>
		))}
	  </div>

      <p
        class="search-dialog__status"
        id={statusId}
        data-search-status
        role="status"
        aria-live="polite"
      >
        输入关键词开始搜索
      </p>
      <ul
        class="search-dialog__results"
        id={resultsId}
        data-search-results
        aria-label="搜索结果"
      ></ul>
    </section>
  </dialog>
</div>

<script>
  interface SearchEntry {
    title: string;
    url: string;
    excerpt: string;
    tags: string[];
    kind: string;
    kindLabel: string;
    content: string;
    searchable: string;
  }

  const externalSearchTriggerCleanups = new WeakMap<HTMLElement, () => void>();
  let activeSearchShortcutController: AbortController | null = null;

  function initSearchDialogs() {
    document.querySelectorAll<HTMLElement>('[data-search-dialog-root]').forEach((root) => {
      if (root.dataset.interactiveReady === 'true') return;
      root.dataset.interactiveReady = 'true';

      const trigger = root.querySelector<HTMLButtonElement>('[data-search-open]');
      const dialog = root.querySelector<HTMLDialogElement>('[data-search-dialog]');
      const closeButton = root.querySelector<HTMLButtonElement>('[data-search-close]');
      const input = root.querySelector<HTMLInputElement>('[data-search-input]');
      const status = root.querySelector<HTMLElement>('[data-search-status]');
      const resultList = root.querySelector<HTMLUListElement>('[data-search-results]');
      const filterButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-search-kind]'),
      );
      if (!trigger || !dialog || !closeButton || !input || !status || !resultList || filterButtons.length === 0) return;

      const indexUrl = root.dataset.indexUrl || '/search-index.json';
      const resultLimit = Math.max(1, Number(root.dataset.resultLimit) || 8);
      const externalTriggers = Array.from(
        document.querySelectorAll<HTMLElement>('[data-search-trigger]'),
      );
      const allTriggers: HTMLElement[] = [trigger, ...externalTriggers];
      const fallbackTrigger = externalTriggers[0] ?? trigger;
      let lastOpenTrigger: HTMLElement = fallbackTrigger;
      let entries: SearchEntry[] | null = null;
      let loadPromise: Promise<SearchEntry[]> | null = null;
      let activeKind = '';
      let loadState: 'idle' | 'loading' | 'ready' | 'error' = 'idle';
      // 输入防抖与“显示更多”共用这一组渲染状态；查询词变化时展开档位回到初始值。
      let renderDebounceTimer: number | undefined;
      let activeLimit = resultLimit;
      let lastRenderedQuery: string | null = null;
      const kindLabels = new Map(
        filterButtons.map((button) => [button.dataset.searchKind ?? '', button.dataset.kindLabel ?? '']),
      );

      // 与 ReadingSession 共享同一份本地阅读记录：同分结果里未读的排在前面。
      // 每次排名现读而不是打开时快照——会话内刚读过的文章应当场改变排序。
      const getReadPaths = (): Set<string> => {
        try {
          const records = JSON.parse(localStorage.getItem('aria7-reading-progress') || '{}') as Record<string, unknown>;
          return new Set(Object.keys(records && typeof records === 'object' ? records : {}));
        } catch {
          return new Set<string>();
        }
      };

      allTriggers.forEach((dialogTrigger) => {
        dialogTrigger.setAttribute('aria-haspopup', 'dialog');
        dialogTrigger.setAttribute('aria-controls', dialog.id);
        dialogTrigger.setAttribute('aria-expanded', 'false');
      });
      // 页眉已提供搜索入口时，避免全局弹层挂载点再显示一枚重复按钮。
      trigger.hidden = externalTriggers.length > 0;

      const normalize = (value: unknown) =>
        String(value ?? '')
          .normalize('NFKC')
          .toLocaleLowerCase();

      const safeResultUrl = (value: string) => {
        try {
          const url = new URL(value, window.location.href);
          return ['http:', 'https:'].includes(url.protocol) ? url.href : null;
        } catch {
          return null;
        }
      };

      const toSearchEntries = (payload: unknown): SearchEntry[] => {
        let candidates: unknown[] = [];
        if (Array.isArray(payload)) {
          candidates = payload;
        } else if (payload && typeof payload === 'object') {
          const objectPayload = payload as Record<string, unknown>;
          if (Array.isArray(objectPayload.items)) candidates = objectPayload.items;
          else if (Array.isArray(objectPayload.entries)) candidates = objectPayload.entries;
        }

        return candidates.flatMap((candidate) => {
          if (!candidate || typeof candidate !== 'object') return [];
          const item = candidate as Record<string, unknown>;
          const title = String(item.title ?? '').trim();
          const url = safeResultUrl(String(item.url ?? item.href ?? '').trim());
          // 搜索索引可能来自独立的生成流程，不让异常 scheme 进入可点击结果。
          if (!title || !url) return [];

          const excerpt = String(item.excerpt ?? item.description ?? item.summary ?? '').trim();
          const content = String(item.content ?? item.text ?? '').trim();
          const kind = String(item.kind ?? '').trim();
          const tags = Array.isArray(item.tags)
            ? item.tags.map(String).filter(Boolean)
            : String(item.tags ?? '')
                .split(',')
                .map((tag) => tag.trim())
                .filter(Boolean);

          return [{
            title,
            url,
            excerpt,
            tags,
            kind,
            kindLabel: kindLabels.get(kind) || kind.toUpperCase() || '记录',
            content,
            searchable: normalize([title, excerpt, content, ...tags].join(' ')),
          }];
        });
      };

      const loadIndex = () => {
        if (entries) return Promise.resolve(entries);
        if (loadPromise) return loadPromise;

        loadState = 'loading';
        status.textContent = '正在载入搜索索引…';
        loadPromise = fetch(indexUrl, { headers: { Accept: 'application/json' } })
          .then((response) => {
            if (!response.ok) throw new Error(`Search index returned ${response.status}`);
            return response.json();
          })
          .then((payload) => {
            entries = toSearchEntries(payload);
            loadState = 'ready';
            status.textContent = entries.length > 0
              ? '输入关键词开始搜索'
              : '搜索索引中暂无可用文章';
            return entries;
          })
          .catch((error) => {
            console.error('[SearchDialog] 无法读取搜索索引', error);
            status.textContent = '搜索索引尚未生成，请稍后再试。';
            loadState = 'error';
            loadPromise = null;
            return [];
          });
        return loadPromise;
      };

      const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

      const appendHighlightedText = (target: HTMLElement, value: string, tokens: string[]) => {
        const visibleTokens = tokens
          .map((token) => token.trim())
          .filter(Boolean)
          .sort((a, b) => b.length - a.length);
        if (visibleTokens.length === 0) {
          target.textContent = value;
          return;
        }

        const pattern = new RegExp(`(${visibleTokens.map(escapeRegExp).join('|')})`, 'gi');
        value.split(pattern).forEach((part) => {
          if (!part) return;
          if (visibleTokens.some((token) => normalize(part) === normalize(token))) {
            const mark = document.createElement('mark');
            mark.className = 'search-dialog__mark';
            mark.textContent = part;
            target.append(mark);
          } else {
            target.append(document.createTextNode(part));
          }
        });
      };

      const getMatchExcerpt = (entry: SearchEntry, normalizedTokens: string[]) => {
        if (normalizedTokens.some((token) => normalize(entry.excerpt).includes(token))) {
          return entry.excerpt;
        }
        // 搜索索引保留 Markdown 原文；片段展示只去除常见标记，不使用 innerHTML 解释不受信任内容。
        const compactContent = entry.content
          .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
          .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
          .replace(/(^|\s)[#>*_`~-]+(?=\s|$)/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
        const normalizedContent = normalize(compactContent);
        const matchIndex = normalizedTokens
          .map((token) => normalizedContent.indexOf(token))
          .filter((index) => index >= 0)
          .sort((a, b) => a - b)[0];
        if (matchIndex === undefined) return entry.excerpt;
        const start = Math.max(0, matchIndex - 42);
        const end = Math.min(compactContent.length, matchIndex + 92);
        return `${start > 0 ? '…' : ''}${compactContent.slice(start, end)}${end < compactContent.length ? '…' : ''}`;
      };

      const renderResults = (query: string) => {
        resultList.replaceChildren();
        if (query !== lastRenderedQuery) {
          // 新的查询词从初始档位重新计，只有“显示更多”的点击才扩大展示量。
          lastRenderedQuery = query;
          activeLimit = resultLimit;
        }
        const normalizedQuery = normalize(query).trim();
		if (loadState === 'loading') {
			status.textContent = '正在载入搜索索引…';
			return;
		}
		if (loadState === 'error') {
			status.textContent = '搜索索引载入失败；再次打开搜索时会重试。';
			return;
		}
        if (!normalizedQuery) {
          status.textContent = entries?.length
              ? activeKind
                ? `已选择 ${kindLabels.get(activeKind) ?? activeKind}，输入关键词开始搜索`
                : '输入关键词开始搜索'
              : status.textContent;
          return;
        }

        const tokens = normalizedQuery.split(/\s+/).filter(Boolean);
        const readPaths = getReadPaths();
        const isReadEntry = (entry: SearchEntry) => {
          try {
            return readPaths.has(new URL(entry.url, window.location.href).pathname);
          } catch {
            return false;
          }
        };
        const rankedMatches = (entries ?? [])
          .filter((entry) => !activeKind || entry.kind === activeKind)
          .filter((entry) => tokens.every((token) => entry.searchable.includes(token)))
          .map((entry) => {
            const normalizedTitle = normalize(entry.title);
            const score = normalizedTitle === normalizedQuery
              ? 4
              : normalizedTitle.startsWith(normalizedQuery)
                ? 3
                : normalizedTitle.includes(normalizedQuery)
                  ? 2
                  : 1;
            return { entry, score };
          })
          .sort((a, b) => b.score - a.score
            || Number(isReadEntry(a.entry)) - Number(isReadEntry(b.entry))
            || a.entry.title.localeCompare(b.entry.title, 'zh-CN'));
        const totalMatches = rankedMatches.length;
        const matches = rankedMatches.slice(0, activeLimit);

        matches.forEach(({ entry }, index) => {
          const item = document.createElement('li');
          item.className = 'search-dialog__result';
          item.dataset.searchResult = '';
          item.style.setProperty('--result-index', String(index));

          const link = document.createElement('a');
          link.className = 'search-dialog__result-link';
          link.dataset.searchResultLink = '';
          link.dataset.articleTransitionLink = '';
          link.href = entry.url;

          const meta = document.createElement('span');
          meta.className = 'search-dialog__result-meta';
          const resultIndex = document.createElement('span');
          resultIndex.textContent = String(index + 1).padStart(2, '0');
          const kind = document.createElement('span');
          kind.textContent = entry.kindLabel;
          meta.append(resultIndex, kind);

          const title = document.createElement('span');
          title.className = 'search-dialog__result-title';
          appendHighlightedText(title, entry.title, tokens);
          link.append(meta, title);

          const matchExcerpt = getMatchExcerpt(entry, tokens);
          if (matchExcerpt) {
            const excerpt = document.createElement('span');
            excerpt.className = 'search-dialog__result-excerpt';
            appendHighlightedText(excerpt, matchExcerpt, tokens);
            link.append(excerpt);
          }

          if (entry.tags.length > 0) {
            const tags = document.createElement('span');
            tags.className = 'search-dialog__result-tags';
            appendHighlightedText(tags, entry.tags.map((tag) => `#${tag}`).join(' '), tokens);
            link.append(tags);
          }

          item.append(link);
          resultList.append(item);
        });

        if (totalMatches > matches.length) {
          const moreItem = document.createElement('li');
          moreItem.className = 'search-dialog__more';
          const moreButton = document.createElement('button');
          moreButton.type = 'button';
          moreButton.dataset.searchMore = '';
          moreButton.textContent = `显示更多（还有 ${totalMatches - matches.length} 条）`;
          moreButton.addEventListener('click', () => {
            activeLimit += 16;
            renderResults(input.value);
          });
          moreItem.append(moreButton);
          resultList.append(moreItem);
        }

        status.textContent = totalMatches > 0
          ? totalMatches > matches.length
            ? `找到 ${totalMatches} 条结果，当前显示前 ${matches.length} 条`
            : `找到 ${totalMatches} 条结果`
          : '没有匹配结果';
      };

      const setActiveKind = (kind: string) => {
        activeKind = kind;
        filterButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String((button.dataset.searchKind ?? '') === kind));
        });
        renderResults(input.value);
      };

      const updateTriggerState = (expanded: boolean) => {
        allTriggers.forEach((dialogTrigger) => {
          dialogTrigger.setAttribute('aria-expanded', String(expanded));
        });
      };

      const restoreTriggerFocus = () => {
        if (lastOpenTrigger.isConnected && !lastOpenTrigger.hasAttribute('disabled')) {
          lastOpenTrigger.focus();
        }
      };

      const openDialog = async (opener: HTMLElement = fallbackTrigger) => {
        lastOpenTrigger = opener;
        if (!dialog.open) {
          if (typeof dialog.showModal === 'function') dialog.showModal();
          else dialog.setAttribute('open', '');
        }
        updateTriggerState(true);
        await loadIndex();
        // 索引较慢时用户可能已关闭弹窗，不要再把焦点抢回隐藏输入框。
        if (!dialog.open) return;
        renderResults(input.value);
        input.focus();
      };

      const closeDialog = () => {
        if (!dialog.open) return;
        if (typeof dialog.close === 'function') dialog.close();
        else {
          dialog.removeAttribute('open');
          updateTriggerState(false);
          restoreTriggerFocus();
        }
      };

      const isEditableTarget = (target: EventTarget | null) => {
        const element = target instanceof HTMLElement ? target : null;
        return Boolean(element?.closest('input, textarea, select, [contenteditable="true"]'));
      };

      trigger.addEventListener('click', () => void openDialog(trigger));
      externalTriggers.forEach((externalTrigger) => {
        // 持久化页眉在 Astro 页面切换后会复用，先移除旧弹窗的绑定再指向新实例。
        externalSearchTriggerCleanups.get(externalTrigger)?.();
        const handleExternalOpen = (event: Event) => {
          event.preventDefault();
          void openDialog(externalTrigger);
        };
        externalTrigger.addEventListener('click', handleExternalOpen);
        externalSearchTriggerCleanups.set(
          externalTrigger,
          () => externalTrigger.removeEventListener('click', handleExternalOpen),
        );
      });
      closeButton.addEventListener('click', closeDialog);
      input.addEventListener('input', () => {
        // 中文输入法组词期间会连续触发 input；短暂防抖避免每次按键都全量过滤索引。
        window.clearTimeout(renderDebounceTimer);
        renderDebounceTimer = window.setTimeout(() => {
          renderDebounceTimer = undefined;
          renderResults(input.value);
        }, 90);
      });

      filterButtons.forEach((button, buttonIndex) => {
        button.addEventListener('click', () => setActiveKind(button.dataset.searchKind ?? ''));
        button.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          const direction = event.key === 'ArrowRight' ? 1 : -1;
          const nextIndex = (buttonIndex + direction + filterButtons.length) % filterButtons.length;
          filterButtons[nextIndex]?.focus();
          filterButtons[nextIndex]?.click();
        });
      });

      input.addEventListener('keydown', (event) => {
        if (event.isComposing) return;
        const links = Array.from(resultList.querySelectorAll<HTMLAnchorElement>('[data-search-result-link]'));
        const target = event.key === 'ArrowUp' ? links.at(-1) : links[0];
        if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && target) {
          event.preventDefault();
          target.focus();
        }
        if (event.key === 'Enter' && links[0]) {
          event.preventDefault();
          links[0].click();
        }
      });

      resultList.addEventListener('keydown', (event) => {
        if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
        const links = Array.from(
          resultList.querySelectorAll<HTMLAnchorElement>('[data-search-result-link]'),
        );
        const currentIndex = links.indexOf(document.activeElement as HTMLAnchorElement);
        if (currentIndex < 0) return;
        event.preventDefault();

        if (event.key === 'Home') {
          links[0]?.focus();
          return;
        }
        if (event.key === 'End') {
          links.at(-1)?.focus();
          return;
        }
        if (event.key === 'ArrowUp' && currentIndex === 0) {
          input.focus();
          return;
        }
        const nextIndex = event.key === 'ArrowDown'
          ? Math.min(currentIndex + 1, links.length - 1)
          : Math.max(currentIndex - 1, 0);
        links[nextIndex]?.focus();
      });

      const updateKeyboardResult = (target: EventTarget | null) => {
		const node = target instanceof Node ? target : null;
        resultList.querySelectorAll<HTMLElement>('[data-search-result]').forEach((item) => {
			item.dataset.keyboardActive = String(Boolean(node && item.contains(node)));
        });
	  };

	  // 焦点回到输入框或筛选器时同步清除结果强调线，避免残留键盘选中态。
	  dialog.addEventListener('focusin', (event) => updateKeyboardResult(event.target));

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });
      dialog.addEventListener('close', () => {
		updateKeyboardResult(null);
        updateTriggerState(false);
        restoreTriggerFocus();
      });

      activeSearchShortcutController?.abort();
      const shortcutController = new AbortController();
      activeSearchShortcutController = shortcutController;
      document.addEventListener('keydown', (event) => {
        if (event.defaultPrevented || event.isComposing) return;
        const commandShortcut = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k';
        const slashShortcut = event.key === '/' && !event.ctrlKey && !event.metaKey && !event.altKey;
        if ((commandShortcut || slashShortcut) && !isEditableTarget(event.target)) {
          event.preventDefault();
          void openDialog(fallbackTrigger);
          return;
        }
		if (event.key === 'Escape' && dialog.open) {
			event.preventDefault();
			closeDialog();
		}
      }, { signal: shortcutController.signal });
    });
  }

  initSearchDialogs();
  document.addEventListener('astro:page-load', initSearchDialogs);
</script>

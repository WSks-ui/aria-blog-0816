---
import { LogOut } from '@lucide/astro';

interface Props {
  class?: string;
  contentSelector?: string;
  postTitle?: string;
  returnHref?: string;
  storageKey?: string;
}

const {
  class: className,
  contentSelector = '.reading-prose',
  postTitle = '',
  returnHref = '/posts/',
  storageKey = 'aria7-reading-progress',
} = Astro.props;
---

<section
  class:list={['reading-session', className]}
  data-reading-session
  data-content-selector={contentSelector}
  data-post-title={postTitle}
  data-storage-key={storageKey}
  aria-label="阅读进度"
>
  <div class="reading-session__meta">
    <span class="reading-session__label">阅读记录</span>
    <output class="reading-session__value" data-reading-value>0%</output>
  </div>
  <progress class="reading-session__meter" data-reading-meter max="1" value="0">0%</progress>
  <a class="reading-session__exit" href={returnHref} aria-label="退出阅读，返回文章列表" data-tooltip="退出阅读">
    <LogOut size={17} stroke-width={1.5} aria-hidden="true" />
  </a>
</section>

<script>
  interface ReadingRecord {
    progress: number;
    title: string;
    updatedAt: string;
  }

  const readingSessionCleanups = new Map<HTMLElement, () => void>();
  let readingSessionLifecycleBound = false;

  const cleanupReadingSessions = () => {
    Array.from(readingSessionCleanups.values()).forEach((cleanup) => cleanup());
  };

  function initReadingSessions() {
    if (!readingSessionLifecycleBound) {
      readingSessionLifecycleBound = true;
      document.addEventListener('astro:before-swap', cleanupReadingSessions);
    }

    document.querySelectorAll<HTMLElement>('[data-reading-session]').forEach((root) => {
      if (root.dataset.interactiveReady === 'true') return;
      const meter = root.querySelector<HTMLProgressElement>('[data-reading-meter]');
      const value = root.querySelector<HTMLOutputElement>('[data-reading-value]');
      if (!meter || !value) return;

      let content: HTMLElement | null = null;
      try {
        content = document.querySelector<HTMLElement>(root.dataset.contentSelector || '.reading-prose');
      } catch (error) {
        console.error('[ReadingSession] 正文选择器无效', error);
      }
      if (!content) return;

      root.dataset.interactiveReady = 'true';
      const storageKey = root.dataset.storageKey || 'aria7-reading-progress';
      const pageKey = window.location.pathname + window.location.search;
      const controller = new AbortController();
      const { signal } = controller;
      let latestProgress = 0;
      let lastSavedProgress = -1;
      let lastSavedAt = 0;
      let persistTimer: number | undefined;

      const readRecords = (): Record<string, ReadingRecord> => {
        try {
          const parsed: unknown = JSON.parse(localStorage.getItem(storageKey) || '{}');
          return parsed && typeof parsed === 'object' && !Array.isArray(parsed)
            ? parsed as Record<string, ReadingRecord>
            : {};
        } catch {
          return {};
        }
      };

      const persistProgress = (force = false) => {
        const now = Date.now();
        if (!force && Math.abs(latestProgress - lastSavedProgress) < 0.01 && now - lastSavedAt < 5000) return;
        try {
          const records = readRecords();
          records[pageKey] = {
            progress: Number(latestProgress.toFixed(4)),
            title: root.dataset.postTitle || document.title,
            updatedAt: new Date(now).toISOString(),
          };
          localStorage.setItem(storageKey, JSON.stringify(records));
          lastSavedProgress = latestProgress;
          lastSavedAt = now;
        } catch {
          // 阅读记录仅作为本机增强功能，本地存储不可用时不影响文章阅读。
        }
      };

      const schedulePersist = () => {
        if (persistTimer !== undefined) window.clearTimeout(persistTimer);
        // 滚动过程中只更新视觉状态；停止一小段时间后再写入本地存储，避免同步
        // localStorage 读写进入滚动帧，造成主线程抖动。
        persistTimer = window.setTimeout(() => {
          persistTimer = undefined;
          persistProgress();
        }, 900);
      };

      const flushPersist = () => {
        if (persistTimer !== undefined) {
          window.clearTimeout(persistTimer);
          persistTimer = undefined;
        }
        persistProgress(true);
      };

      const updateProgress = (nextRatio?: number) => {
        // 正常滚动时复用 SceneGuide 已经算好的比例；首次初始化在事件尚未
        // 建立前保留一次本地几何计算，保证独立使用该组件时仍能显示正确状态。
        const ratio = typeof nextRatio === 'number'
          ? Math.min(1, Math.max(0, nextRatio))
          : (() => {
              const rect = content.getBoundingClientRect();
              const contentTop = rect.top + window.scrollY;
              const scrollableDistance = Math.max(1, content.offsetHeight - window.innerHeight);
              return Math.min(1, Math.max(0, (window.scrollY - contentTop) / scrollableDistance));
            })();
        latestProgress = ratio;
        const percent = Math.round(ratio * 100);
        meter.value = ratio;
        meter.textContent = String(percent) + '%';
        meter.setAttribute('aria-valuetext', '已阅读 ' + String(percent) + '%');
        value.value = String(percent) + '%';
        value.textContent = String(percent) + '%';
        root.style.setProperty('--reading-session-progress', String(ratio));
        schedulePersist();
      };

      const handleSharedProgress = (event: Event) => {
        if (!(event instanceof CustomEvent)) return;
        const detail = event.detail as { content?: unknown; ratio?: unknown } | null;
        if (!detail || !(detail.content instanceof HTMLElement) || typeof detail.ratio !== 'number') return;

        // SceneGuide 默认观察 .prose，而本组件默认绑定 .reading-prose；用包含关系
        // 识别同一正文，避免把两个选择器不同误判成两篇文章。
        const sameContent = detail.content === content
          || detail.content.contains(content)
          || content.contains(detail.content);
        if (sameContent) updateProgress(detail.ratio);
      };

      document.addEventListener('aria7-reading-progress', handleSharedProgress, { signal });
      window.addEventListener('pagehide', flushPersist, { signal });

      const stored = readRecords()[pageKey];
      if (stored && typeof stored.progress === 'number') {
        root.dataset.hasHistory = 'true';
        lastSavedProgress = stored.progress;
      }
      updateProgress();

      readingSessionCleanups.set(root, () => {
        flushPersist();
        controller.abort();
        readingSessionCleanups.delete(root);
        delete root.dataset.interactiveReady;
      });
    });
  }

  initReadingSessions();
  document.addEventListener('astro:page-load', initReadingSessions);
</script>

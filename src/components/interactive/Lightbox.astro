---
import { X } from '@lucide/astro';
import '@/styles/interactive.css';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<dialog class:list={['lightbox', className]} data-lightbox aria-label="图片查看">
  <figure class="lightbox__figure">
    <img class="lightbox__image" data-lightbox-image alt="" />
    <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
  </figure>
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="关闭图片查看">
    <X size={20} stroke-width={1.5} aria-hidden="true" />
  </button>
</dialog>

<script>
  function openLightboxFor(dialog: HTMLDialogElement, source: HTMLImageElement) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    if (!image || !caption || !closeButton) return;

    // 用 currentSrc 尊 Responsive srcset 的实际选择；alt 原样作为图注。
    image.src = source.currentSrc || source.src;
    image.alt = source.alt || '';
    caption.textContent = source.alt || '';
    caption.hidden = !source.alt;
    if (!dialog.open) {
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
    }
    closeButton.focus();
  }

  function initLightboxes() {
    document.querySelectorAll<HTMLDialogElement>('[data-lightbox]').forEach((dialog) => {
      if (dialog.dataset.interactiveReady === 'true') return;
      dialog.dataset.interactiveReady = 'true';

      const closeButton = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]');
      if (!closeButton) return;

      closeButton.addEventListener('click', () => {
        if (typeof dialog.close === 'function') dialog.close();
        else dialog.removeAttribute('open');
      });

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });

    bindLightboxDelegation();
  }

  // 只接管正文里未被链接包裹的插图：链接内的图片点击应继续跟随链接。
  // 委托必须挂在模块级且只注册一次——ClientRouter 换页会整体替换 dialog，
  // 若随实例重复注册，旧闭包会给脱离 DOM 的旧 <img> 赋值并对旧 <dialog>
  // 调 showModal()。句柄在每次点击时实时解析，天然跟随当前页面。
  let lightboxDelegationBound = false;

  function bindLightboxDelegation() {
    if (lightboxDelegationBound) return;
    lightboxDelegationBound = true;

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof HTMLImageElement)) return;
      if (event.target.closest('[data-lightbox]')) return;
      const prose = event.target.closest('.reading-prose, .article-hero__cover');
      if (!prose || event.target.closest('a')) return;
      const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
      if (!dialog || dialog.dataset.interactiveReady !== 'true') return;
      event.preventDefault();
      openLightboxFor(dialog, event.target);
    });
  }

  initLightboxes();
  document.addEventListener('astro:page-load', initLightboxes);
</script>

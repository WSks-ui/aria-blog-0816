---
import { Volume2, VolumeX } from '@lucide/astro';

/**
 * 雨声环境音：播放一段真实雨声录音的循环（Mixkit「Light rain looping」，
 * Mixkit License 免署名商用，文件在本站 assets 下按需加载）。音量经
 * rAF 缓动渐起渐歇——雨不是开关，是慢慢下起来、慢慢停住。默认关闭；
 * 记住偏好后，下次访问的第一次手势自动续上（浏览器不允许无手势起声）。
 */
---

<button
	class="icon-button site-tool-button"
	type="button"
	aria-pressed="false"
	aria-label="雨声环境音"
	data-ambient-toggle
>
	<span class="ambient-icon ambient-icon--off" aria-hidden="true">
		<VolumeX size={19} stroke-width={1.6} />
	</span>
	<span class="ambient-icon ambient-icon--on" aria-hidden="true">
		<Volume2 size={19} stroke-width={1.6} />
	</span>
	<span class="site-tool-button__label" aria-hidden="true">雨声</span>
</button>

<style>
	.ambient-icon {
		display: grid;
		grid-area: 1 / 1;
		place-items: center;
		transition: opacity 240ms var(--ease-rain), transform 320ms var(--ease-drift);
	}

	.ambient-icon--on {
		opacity: 0;
		transform: scale(0.55);
	}

	[aria-pressed='true'] .ambient-icon--off {
		opacity: 0;
		transform: scale(0.55);
	}

	[aria-pressed='true'] .ambient-icon--on {
		opacity: 1;
		transform: scale(1);
	}
</style>

<script>
	function initAmbientToggle() {
		document.querySelectorAll<HTMLButtonElement>('[data-ambient-toggle]').forEach((button) => {
			if (button.dataset.ambientReady === 'true') return;
			button.dataset.ambientReady = 'true';

			const STORAGE_KEY = 'aria7-ambient-sound';
			const TARGET_VOLUME = 0.55;

			// 真实录音循环：preload=none，只有打开开关才开始拉取这 2.9MB。
			const audio = new Audio('/assets/audio/rain-loop.mp3');
			audio.loop = true;
			audio.preload = 'none';

			let target = 0;
			let fadeRaf = 0;
			let pauseTimer = 0;
			const fadeStep = () => {
				fadeRaf = 0;
				const current = audio.volume;
				const next = current + (target - current) * 0.09;
				audio.volume = Math.abs(target - next) < 0.015 ? target : next;
				if (audio.volume !== target) {
					fadeRaf = window.requestAnimationFrame(fadeStep);
					return;
				}
				// 渐歇到位后真正暂停，不挂着无声的解码循环。
				if (target === 0) {
					window.clearTimeout(pauseTimer);
					pauseTimer = window.setTimeout(() => {
						if (target === 0) audio.pause();
					}, 200);
				}
			};
			const fadeTo = (value: number) => {
				target = value;
				if (!fadeRaf) fadeRaf = window.requestAnimationFrame(fadeStep);
			};

			const apply = (on: boolean, persist: boolean) => {
				if (on) {
					window.clearTimeout(pauseTimer);
					void audio.play().catch(() => {
						// 自动播放被策略拦下时静默放弃；下一次点击开关仍可起声。
					});
					fadeTo(TARGET_VOLUME);
				} else {
					fadeTo(0);
				}
				button.setAttribute('aria-pressed', String(on));
				if (persist) {
					try {
						localStorage.setItem(STORAGE_KEY, on ? 'on' : 'off');
					} catch {
						// 存储不可用时只丢偏好记忆。
					}
				}
			};

			button.addEventListener('click', () => {
				apply(button.getAttribute('aria-pressed') !== 'true', true);
			});

			let stored: string | null = null;
			try {
				stored = localStorage.getItem(STORAGE_KEY);
			} catch {
				stored = null;
			}
			if (stored === 'on') {
				// 上次离开时雨还在下：第一次任意手势后自动续上。
				const resume = () => {
					window.removeEventListener('keydown', resume);
					apply(true, false);
				};
				window.addEventListener('pointerdown', resume, { once: true, passive: true });
				window.addEventListener('keydown', resume, { once: true });
			}
		});
	}

	initAmbientToggle();
	document.addEventListener('astro:page-load', initAmbientToggle);
</script>

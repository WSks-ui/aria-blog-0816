---
import { Volume2, VolumeX } from '@lucide/astro';

/**
 * 雨声环境音：WebAudio 现场合成——两层布朗化噪声经滤波叠出雨幕（低频
 * 远景雨势 + 窄带高频近景雨点），LFO 缓慢呼吸模拟阵风。不加载任何音频
 * 文件。默认关闭；记住偏好后，下次访问的第一次点击会自动续上（浏览器
 * 不允许无手势起声）。
 */
---

<button
	class="icon-button site-tool-button"
	type="button"
	aria-pressed="false"
	aria-label="雨声环境音"
	data-ambient-toggle
>
	<span class="ambient-icon ambient-icon--off" aria-hidden="true">
		<VolumeX size={19} stroke-width={1.6} />
	</span>
	<span class="ambient-icon ambient-icon--on" aria-hidden="true">
		<Volume2 size={19} stroke-width={1.6} />
	</span>
	<span class="site-tool-button__label" aria-hidden="true">雨声</span>
</button>

<style>
	.ambient-icon {
		display: grid;
		grid-area: 1 / 1;
		place-items: center;
		transition: opacity 240ms var(--ease-rain), transform 320ms var(--ease-drift);
	}

	.ambient-icon--on {
		opacity: 0;
		transform: scale(0.55);
	}

	[aria-pressed='true'] .ambient-icon--off {
		opacity: 0;
		transform: scale(0.55);
	}

	[aria-pressed='true'] .ambient-icon--on {
		opacity: 1;
		transform: scale(1);
	}
</style>

<script>
	function initAmbientToggle() {
		document.querySelectorAll<HTMLButtonElement>('[data-ambient-toggle]').forEach((button) => {
			if (button.dataset.ambientReady === 'true') return;
			button.dataset.ambientReady = 'true';

			const STORAGE_KEY = 'aria7-ambient-sound';
			interface AmbientEngine {
				setEnabled(on: boolean): void;
			}

			let engine: AmbientEngine | null = null;

			const buildEngine = (): AmbientEngine | null => {
				const Ctx = window.AudioContext
					?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
				if (!Ctx) return null;
				const ctx = new Ctx();

				const master = ctx.createGain();
				master.gain.value = 0;
				master.connect(ctx.destination);

				// 布朗化噪声：白噪经一阶低通积累，听感沉底，像雨幕而不是沙沙白噪。
				const makeNoise = (seconds: number) => {
					const buffer = ctx.createBuffer(1, Math.floor(ctx.sampleRate * seconds), ctx.sampleRate);
					const data = buffer.getChannelData(0);
					let last = 0;
					for (let i = 0; i < data.length; i += 1) {
						const white = Math.random() * 2 - 1;
						last = (last + 0.02 * white) / 1.02;
						data[i] = last * 3.4;
					}
					const source = ctx.createBufferSource();
					source.buffer = buffer;
					source.loop = true;
					return source;
				};

				// 远景雨势：低通 + 0.08Hz 呼吸（阵风起落）。
				const body = makeNoise(2.4);
				const bodyFilter = ctx.createBiquadFilter();
				bodyFilter.type = 'lowpass';
				bodyFilter.frequency.value = 880;
				const bodyGain = ctx.createGain();
				bodyGain.gain.value = 0.5;
				const bodyLfo = ctx.createOscillator();
				bodyLfo.frequency.value = 0.08;
				const bodyLfoGain = ctx.createGain();
				bodyLfoGain.gain.value = 0.16;
				bodyLfo.connect(bodyLfoGain).connect(bodyGain.gain);
				body.connect(bodyFilter).connect(bodyGain).connect(master);

				// 近景雨点：3.2kHz 窄带沙沙，更慢更浅的呼吸错开远景。
				const patter = makeNoise(1.7);
				const patterFilter = ctx.createBiquadFilter();
				patterFilter.type = 'bandpass';
				patterFilter.frequency.value = 3200;
				patterFilter.Q.value = 0.55;
				const patterGain = ctx.createGain();
				patterGain.gain.value = 0.14;
				const patterLfo = ctx.createOscillator();
				patterLfo.frequency.value = 0.043;
				const patterLfoGain = ctx.createGain();
				patterLfoGain.gain.value = 0.07;
				patterLfo.connect(patterLfoGain).connect(patterGain.gain);
				patter.connect(patterFilter).connect(patterGain).connect(master);

				body.start();
				patter.start();
				bodyLfo.start();
				patterLfo.start();

				return {
					setEnabled(on: boolean) {
						void ctx.resume();
						const now = ctx.currentTime;
						master.gain.cancelScheduledValues(now);
						master.gain.setValueAtTime(Math.max(0.0001, master.gain.value), now);
						// 1.1s 起落：雨不是开关，是慢慢下起来 / 慢慢停住。
						master.gain.linearRampToValueAtTime(on ? 0.15 : 0.0001, now + 1.1);
					},
				};
			};

			const apply = (on: boolean, persist: boolean) => {
				if (on && !engine) engine = buildEngine();
				engine?.setEnabled(on);
				button.setAttribute('aria-pressed', String(on));
				if (persist) {
					try {
						localStorage.setItem(STORAGE_KEY, on ? 'on' : 'off');
					} catch {
						// 存储不可用时只丢偏好记忆。
					}
				}
			};

			button.addEventListener('click', () => {
				apply(button.getAttribute('aria-pressed') !== 'true', true);
			});

			let stored: string | null = null;
			try {
				stored = localStorage.getItem(STORAGE_KEY);
			} catch {
				stored = null;
			}
			if (stored === 'on') {
				// 上次离开时雨还在下：第一次任意手势后自动续上。
				const resume = () => {
					window.removeEventListener('keydown', resume);
					apply(true, false);
				};
				window.addEventListener('pointerdown', resume, { once: true, passive: true });
				window.addEventListener('keydown', resume, { once: true });
			}
		});
	}

	initAmbientToggle();
	document.addEventListener('astro:page-load', initAmbientToggle);
</script>

---
import { Clock3, ListTree } from '@lucide/astro';
import '@/styles/interactive.css';

interface Props {
  class?: string;
  contentSelector?: string;
  headingSelector?: string;
  title?: string;
  wordsPerMinute?: number;
  totalMinutes?: number;
}

const {
  class: className,
  contentSelector = 'article',
  headingSelector = 'h2, h3',
  title = '场景导览',
  wordsPerMinute = 300,
  totalMinutes,
} = Astro.props;

const titleId = `scene-guide-${Math.random().toString(36).slice(2, 10)}`;
---

<aside
  class:list={['scene-guide', 'scene-guide--desktop', className]}
  data-scene-guide
  data-desktop-only
  data-content-selector={contentSelector}
  data-heading-selector={headingSelector}
  data-words-per-minute={wordsPerMinute}
  data-total-minutes={totalMinutes}
  aria-labelledby={titleId}
>
  <header class="scene-guide__header">
    <div class="scene-guide__heading">
      <ListTree size={19} stroke-width={1.5} aria-hidden="true" />
      <h2 class="scene-guide__title" id={titleId}>{title}</h2>
    </div>
    <button class="scene-guide__expand" type="button" data-scene-expand aria-expanded="false">
      展开
    </button>
  </header>

  <nav class="scene-guide__toc" data-scene-toc aria-label="本文目录">
    <ol class="scene-guide__list" data-scene-list></ol>
  </nav>

  <div class="scene-guide__reading" data-scene-reading>
    <label class="scene-guide__progress-label">
      <span>阅读进度</span>
      <progress class="scene-guide__progress" data-scene-progress max="1" value="0">0%</progress>
    </label>
    <p class="scene-guide__remaining">
      <Clock3 size={17} stroke-width={1.5} aria-hidden="true" />
      <span data-scene-remaining>正在估算剩余时间</span>
    </p>
  </div>
</aside>

<script>
  interface SceneChapter {
    id: string;
    element: HTMLLIElement;
    heading: HTMLElement;
    link: HTMLAnchorElement;
    children: Array<{ heading: HTMLElement; link: HTMLAnchorElement }>;
    sublist?: HTMLOListElement;
    toggle?: HTMLButtonElement;
  }

  const sceneGuideCleanups = new Map<HTMLElement, () => void>();

  function initSceneGuides() {
    document.querySelectorAll<HTMLElement>('[data-scene-guide]').forEach((root) => {
      if (root.dataset.interactiveReady === 'true') return;
      root.dataset.interactiveReady = 'true';

      const list = root.querySelector<HTMLOListElement>('[data-scene-list]');
      const toc = root.querySelector<HTMLElement>('[data-scene-toc]');
      const progress = root.querySelector<HTMLProgressElement>('[data-scene-progress]');
      const remaining = root.querySelector<HTMLElement>('[data-scene-remaining]');
      const expandButton = root.querySelector<HTMLButtonElement>('[data-scene-expand]');
      if (!list || !toc || !progress || !remaining || !expandButton) return;

      // 显式 behavior:'smooth' 不受 CSS 的 scroll-behavior 兜底约束，
      // reduced-motion 用户改为瞬时定位。
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      let content: HTMLElement | null = null;
      try {
        content = document.querySelector<HTMLElement>(root.dataset.contentSelector || 'article');
      } catch (error) {
        console.error('[SceneGuide] 正文选择器无效', error);
      }

      if (!content) {
        root.dataset.empty = 'true';
        toc.hidden = true;
        expandButton.hidden = true;
        remaining.textContent = '未找到正文区域';
        return;
      }

      let headings: HTMLElement[] = [];
      try {
        headings = Array.from(
          content.querySelectorAll<HTMLElement>(root.dataset.headingSelector || 'h2, h3'),
        );
      } catch (error) {
        console.error('[SceneGuide] 标题选择器无效', error);
      }

      const usedIds = new Set(Array.from(document.querySelectorAll<HTMLElement>('[id]')).map((item) => item.id));
      const createHeadingId = (heading: HTMLElement, index: number) => {
        if (heading.id) return heading.id;
        const base = heading.textContent
          ?.normalize('NFKC')
          .toLocaleLowerCase()
          .replace(/[^\p{Letter}\p{Number}]+/gu, '-')
          .replace(/^-|-$/g, '')
          .slice(0, 48) || `section-${index + 1}`;
        let candidate = `scene-${base}`;
        let suffix = 2;
        while (usedIds.has(candidate)) candidate = `scene-${base}-${suffix++}`;
        usedIds.add(candidate);
        heading.id = candidate;
        return candidate;
      };

      const chapters: SceneChapter[] = [];
      const headingToChapter = new Map<string, SceneChapter>();
      const links = new Map<string, HTMLAnchorElement>();
      let activeChapter: SceneChapter | null = null;
      let expandedAll = false;
      let ticking = false;

      const setSubsectionsFocusable = (chapter: SceneChapter, expanded: boolean) => {
        if (!chapter.sublist) return;
        chapter.sublist.setAttribute('aria-hidden', String(!expanded));
        chapter.children.forEach(({ link }) => {
          if (expanded) link.removeAttribute('tabindex');
          else link.tabIndex = -1;
        });
      };

      const setChapterExpanded = (chapter: SceneChapter, expanded: boolean) => {
        chapter.element.dataset.expanded = String(expanded);
        chapter.toggle?.setAttribute('aria-expanded', String(expanded));
        if (chapter.toggle) {
          const chapterTitle = chapter.link.textContent?.trim() || '当前章节';
          chapter.toggle.setAttribute('aria-label', `${expanded ? '收起' : '展开'}“${chapterTitle}”的小节`);
        }
        setSubsectionsFocusable(chapter, expanded);
      };

      const syncExpandControl = () => {
        expandButton.textContent = expandedAll ? '收起' : '展开';
        expandButton.setAttribute('aria-expanded', String(expandedAll));
        expandButton.setAttribute('aria-label', expandedAll ? '收起全部二级标题' : '展开全部二级标题');
      };

      const createChapter = (heading: HTMLElement, headingIndex: number) => {
        const id = createHeadingId(heading, headingIndex);
        const chapterIndex = chapters.length + 1;
        const item = document.createElement('li');
        item.className = 'scene-guide__chapter';
        item.dataset.expanded = 'false';

        const row = document.createElement('div');
        row.className = 'scene-guide__chapter-row';

        const number = document.createElement('span');
        number.className = 'scene-guide__chapter-number';
        number.textContent = String(chapterIndex).padStart(2, '0');

        const link = document.createElement('a');
        link.className = 'scene-guide__chapter-link';
        link.dataset.sceneLink = id;
        link.href = `#${encodeURIComponent(id)}`;
        link.textContent = heading.textContent?.trim() || `章节 ${chapterIndex}`;

        row.append(number, link);
        item.append(row);
        list.append(item);

        const chapter: SceneChapter = { id, element: item, heading, link, children: [] };
        chapters.push(chapter);
        headingToChapter.set(id, chapter);
        links.set(id, link);
        return chapter;
      };

      headings.forEach((heading, index) => {
        const isPrimary = heading.tagName.toLowerCase() === 'h2';
        const currentChapter = chapters[chapters.length - 1];

        // h3 没有前置 h2 时不能丢失跳转入口，退化为一条独立一级记录。
        if (isPrimary || !currentChapter) {
          createChapter(heading, index);
          return;
        }

        const id = createHeadingId(heading, index);
        if (!currentChapter.sublist) {
          const toggle = document.createElement('button');
          toggle.className = 'scene-guide__chapter-toggle';
          toggle.type = 'button';
          toggle.setAttribute('aria-label', `展开“${currentChapter.link.textContent}”的小节`);
          toggle.setAttribute('aria-expanded', 'false');
          toggle.innerHTML = '<span class="sr-only">展开小节</span>';
          currentChapter.element.querySelector('.scene-guide__chapter-row')?.append(toggle);
          currentChapter.toggle = toggle;

          const sublist = document.createElement('ol');
          sublist.className = 'scene-guide__subsections';
          sublist.setAttribute('aria-hidden', 'true');
          // 外层 clip 容器承载 grid-template-rows 0fr/1fr 的高度过渡，
          // 列表本身保持 overflow:hidden，小节再多也不会被展开上限裁掉。
          const clip = document.createElement('div');
          clip.className = 'scene-guide__subsections-clip';
          clip.append(sublist);
          currentChapter.element.append(clip);
          currentChapter.sublist = sublist;

          toggle.addEventListener('click', () => {
            const nextExpanded = currentChapter.element.dataset.expanded !== 'true';
            expandedAll = false;
            setChapterExpanded(currentChapter, nextExpanded);
            syncExpandControl();
          });
        }

        const item = document.createElement('li');
        item.className = 'scene-guide__subsection';
        const link = document.createElement('a');
        link.className = 'scene-guide__subsection-link';
        link.dataset.sceneLink = id;
        link.href = `#${encodeURIComponent(id)}`;
        link.textContent = heading.textContent?.trim() || `小节 ${currentChapter.children.length + 1}`;
        link.tabIndex = -1;
        item.append(link);
        currentChapter.sublist?.append(item);
        currentChapter.children.push({ heading, link });
        headingToChapter.set(id, currentChapter);
        links.set(id, link);
      });

      if (headings.length === 0) {
        root.dataset.empty = 'true';
        toc.hidden = true;
        expandButton.hidden = true;
      }

      const setActiveHeading = (id: string) => {
        const nextChapter = headingToChapter.get(id);
        if (!nextChapter) return;
        activeChapter = nextChapter;

        links.forEach((link, linkId) => {
          const active = linkId === id;
          link.dataset.active = String(active);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });

        chapters.forEach((chapter) => {
          const containsActiveHeading = chapter === activeChapter;
          chapter.element.dataset.active = String(containsActiveHeading);
          setChapterExpanded(chapter, expandedAll || containsActiveHeading);
        });

        // 当前子标题如果被目录视窗裁掉，才进行就近滚动，避免目录随正文观察器频繁跳动。
        const activeLink = links.get(id);
        if (activeLink) {
          const linkRect = activeLink.getBoundingClientRect();
          const tocRect = toc.getBoundingClientRect();
          if (linkRect.top < tocRect.top + 18 || linkRect.bottom > tocRect.bottom - 22) {
            activeLink.scrollIntoView({ block: 'nearest', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
          }
        }
      };

      expandButton.addEventListener('click', () => {
        expandedAll = !expandedAll;
        chapters.forEach((chapter) => setChapterExpanded(chapter, expandedAll || chapter === activeChapter));
        syncExpandControl();
      });
      syncExpandControl();

      const observer = new IntersectionObserver(
        (entries) => {
          const visibleHeading = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visibleHeading?.target instanceof HTMLElement) {
            setActiveHeading(visibleHeading.target.id);
          }
        },
        { rootMargin: '-18% 0px -68% 0px', threshold: [0, 1] },
      );
      headings.forEach((heading) => observer.observe(heading));
      if (headings[0]) setActiveHeading(headings[0].id);

      // 中文按单字、拉丁文本按词计数，避免直接用空格统计而严重低估中文阅读量。
      // 页面传入构建时算好的分钟数时优先使用，保证与列表页显示的时长一致。
      const providedMinutes = Number(root.dataset.totalMinutes);
      let totalMinutes: number;
      if (Number.isFinite(providedMinutes) && providedMinutes > 0) {
        totalMinutes = providedMinutes;
      } else {
        const text = content.innerText.replace(/\s+/g, ' ').trim();
        const cjkUnits = (text.match(/[\u3400-\u9fff\uf900-\ufaff\u3040-\u30ff\uac00-\ud7af]/g) ?? []).length;
        const latinUnits = (text.replace(/[\u3400-\u9fff\uf900-\ufaff\u3040-\u30ff\uac00-\ud7af]/g, ' ').match(/[\p{Letter}\p{Number}]+/gu) ?? []).length;
        const totalUnits = Math.max(1, cjkUnits + latinUnits);
        const readingSpeed = Math.max(100, Number(root.dataset.wordsPerMinute) || 300);
        totalMinutes = totalUnits / readingSpeed;
      }
      const controller = new AbortController();
      let resizeObserver: ResizeObserver | undefined;
      // abort 只能移除 scroll/resize 监听，已经排队的帧仍可能在换页后执行并
      // 闭包引用旧正文；保存句柄后由 cleanup 显式取消，避免旧页面继续广播进度。
      let progressFrame: number | undefined;

      const updateProgress = () => {
        const rect = content.getBoundingClientRect();
        const contentTop = rect.top + window.scrollY;
        const scrollableDistance = Math.max(1, content.offsetHeight - window.innerHeight);
        const ratio = Math.min(1, Math.max(0, (window.scrollY - contentTop) / scrollableDistance));
        const percent = Math.round(ratio * 100);
        const minutesLeft = Math.max(0, Math.ceil(totalMinutes * (1 - ratio)));

        progress.value = ratio;
        progress.textContent = `${percent}%`;
        progress.setAttribute('aria-valuetext', `${percent}%`);
        remaining.textContent = minutesLeft > 0 ? `约剩 ${minutesLeft} 分钟` : '已读完';
        root.style.setProperty('--scene-reading-progress', String(ratio));

        // 目录已经完成正文几何计算，阅读记录直接复用结果，避免同一篇文章上
        // 再启动一套 scroll + requestAnimationFrame + getBoundingClientRect 链路。
        document.dispatchEvent(new CustomEvent('aria7-reading-progress', {
          detail: { content, ratio },
        }));
        ticking = false;
      };

      const requestProgressUpdate = () => {
        if (ticking) return;
        ticking = true;
        progressFrame = window.requestAnimationFrame(() => {
          progressFrame = undefined;
          updateProgress();
        });
      };

      window.addEventListener('scroll', requestProgressUpdate, { passive: true, signal: controller.signal });
      window.addEventListener('resize', requestProgressUpdate, { signal: controller.signal });
      if ('ResizeObserver' in window) {
        resizeObserver = new ResizeObserver(requestProgressUpdate);
        resizeObserver.observe(content);
      }
      updateProgress();

      // Astro 的页面切换会替换正文节点；统一释放观察器和事件，避免旧文章继续驱动新页面目录。
      sceneGuideCleanups.set(root, () => {
        controller.abort();
        if (progressFrame !== undefined) {
          window.cancelAnimationFrame(progressFrame);
          progressFrame = undefined;
          ticking = false;
        }
        resizeObserver?.disconnect();
        observer.disconnect();
        sceneGuideCleanups.delete(root);
        delete root.dataset.interactiveReady;
      });
    });
  }

  const destroySceneGuides = () => {
    Array.from(sceneGuideCleanups.values()).forEach((cleanup) => cleanup());
  };

  initSceneGuides();
  document.addEventListener('astro:page-load', initSceneGuides);
  document.addEventListener('astro:before-swap', destroySceneGuides);
</script>

---
import { Clock3, ListTree } from '@lucide/astro';

interface Props {
  class?: string;
  contentSelector?: string;
  headingSelector?: string;
  title?: string;
  wordsPerMinute?: number;
}

const {
  class: className,
  contentSelector = 'article',
  headingSelector = 'h2, h3',
  title = '场景导览',
  wordsPerMinute = 300,
} = Astro.props;

const titleId = `scene-guide-${Math.random().toString(36).slice(2, 10)}`;
---

<aside
  class:list={['scene-guide', 'scene-guide--desktop', className]}
  data-scene-guide
  data-desktop-only
  data-content-selector={contentSelector}
  data-heading-selector={headingSelector}
  data-words-per-minute={wordsPerMinute}
  aria-labelledby={titleId}
>
  <header class="scene-guide__header">
    <ListTree size={20} stroke-width={1.5} aria-hidden="true" />
    <h2 class="scene-guide__title" id={titleId}>{title}</h2>
  </header>

  <nav class="scene-guide__toc" data-scene-toc aria-label="本文目录">
    <ol class="scene-guide__list" data-scene-list></ol>
  </nav>

  <div class="scene-guide__reading" data-scene-reading>
    <label class="scene-guide__progress-label">
      <span>阅读进度</span>
      <progress class="scene-guide__progress" data-scene-progress max="1" value="0">0%</progress>
    </label>
    <p class="scene-guide__remaining">
      <Clock3 size={18} stroke-width={1.5} aria-hidden="true" />
      <span data-scene-remaining>正在估算剩余时间</span>
    </p>
  </div>
</aside>

<script>
  function initSceneGuides() {
    document.querySelectorAll<HTMLElement>('[data-scene-guide]').forEach((root) => {
      if (root.dataset.interactiveReady === 'true') return;
      root.dataset.interactiveReady = 'true';

      const list = root.querySelector<HTMLOListElement>('[data-scene-list]');
      const toc = root.querySelector<HTMLElement>('[data-scene-toc]');
      const progress = root.querySelector<HTMLProgressElement>('[data-scene-progress]');
      const remaining = root.querySelector<HTMLElement>('[data-scene-remaining]');
      if (!list || !toc || !progress || !remaining) return;

      let content: HTMLElement | null = null;
      try {
        content = document.querySelector<HTMLElement>(root.dataset.contentSelector || 'article');
      } catch (error) {
        console.error('[SceneGuide] 正文选择器无效', error);
      }

      if (!content) {
        root.dataset.empty = 'true';
        toc.hidden = true;
        remaining.textContent = '未找到正文区域';
        return;
      }

      let headings: HTMLElement[] = [];
      try {
        headings = Array.from(
          content.querySelectorAll<HTMLElement>(root.dataset.headingSelector || 'h2, h3'),
        );
      } catch (error) {
        console.error('[SceneGuide] 标题选择器无效', error);
      }

      const usedIds = new Set(Array.from(document.querySelectorAll<HTMLElement>('[id]')).map((item) => item.id));
      const createHeadingId = (heading: HTMLElement, index: number) => {
        if (heading.id) return heading.id;
        const base = heading.textContent
          ?.normalize('NFKC')
          .toLocaleLowerCase()
          .replace(/[^\p{Letter}\p{Number}]+/gu, '-')
          .replace(/^-|-$/g, '')
          .slice(0, 48) || `section-${index + 1}`;
        let candidate = `scene-${base}`;
        let suffix = 2;
        while (usedIds.has(candidate)) candidate = `scene-${base}-${suffix++}`;
        usedIds.add(candidate);
        heading.id = candidate;
        return candidate;
      };

      headings.forEach((heading, index) => {
        const id = createHeadingId(heading, index);
        const item = document.createElement('li');
        item.className = 'scene-guide__item';
        item.dataset.sceneLevel = heading.tagName.toLowerCase();

        const link = document.createElement('a');
        link.className = 'scene-guide__link';
        link.dataset.sceneLink = id;
        link.href = `#${encodeURIComponent(id)}`;
        link.textContent = heading.textContent?.trim() || `章节 ${index + 1}`;
        item.append(link);
        list.append(item);
      });

      if (headings.length === 0) {
        root.dataset.empty = 'true';
        toc.hidden = true;
      }

      const setActiveHeading = (id: string) => {
        root.querySelectorAll<HTMLAnchorElement>('[data-scene-link]').forEach((link) => {
          const active = link.dataset.sceneLink === id;
          link.dataset.active = String(active);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visibleHeading = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visibleHeading?.target instanceof HTMLElement) {
            setActiveHeading(visibleHeading.target.id);
          }
        },
        { rootMargin: '-18% 0px -68% 0px', threshold: [0, 1] },
      );
      headings.forEach((heading) => observer.observe(heading));

      // 中文按单字、拉丁文本按词计数，避免直接用空格统计而严重低估中文阅读量。
      const text = content.innerText.replace(/\s+/g, ' ').trim();
      const cjkUnits = (text.match(/[\u3400-\u9fff\uf900-\ufaff\u3040-\u30ff\uac00-\ud7af]/g) ?? []).length;
      const latinUnits = (text.replace(/[\u3400-\u9fff\uf900-\ufaff\u3040-\u30ff\uac00-\ud7af]/g, ' ').match(/[\p{Letter}\p{Number}]+/gu) ?? []).length;
      const totalUnits = Math.max(1, cjkUnits + latinUnits);
      const readingSpeed = Math.max(100, Number(root.dataset.wordsPerMinute) || 300);
      const totalMinutes = totalUnits / readingSpeed;
      let ticking = false;

      const updateProgress = () => {
        const rect = content.getBoundingClientRect();
        const contentTop = rect.top + window.scrollY;
        const scrollableDistance = Math.max(1, content.offsetHeight - window.innerHeight);
        const ratio = Math.min(1, Math.max(0, (window.scrollY - contentTop) / scrollableDistance));
        const percent = Math.round(ratio * 100);
        const minutesLeft = Math.max(0, Math.ceil(totalMinutes * (1 - ratio)));

        progress.value = ratio;
        progress.textContent = `${percent}%`;
        progress.setAttribute('aria-valuetext', `${percent}%`);
        remaining.textContent = minutesLeft > 0 ? `约剩 ${minutesLeft} 分钟` : '已读完';
        root.style.setProperty('--scene-reading-progress', String(ratio));
        ticking = false;
      };

      const requestProgressUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateProgress);
      };

      window.addEventListener('scroll', requestProgressUpdate, { passive: true });
      window.addEventListener('resize', requestProgressUpdate);
      if ('ResizeObserver' in window) new ResizeObserver(requestProgressUpdate).observe(content);
      updateProgress();
    });
  }

  initSceneGuides();
  document.addEventListener('astro:page-load', initSceneGuides);
</script>

---
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { ArrowLeft, GitBranch, Mail, Rss, Users } from '@lucide/astro';
import PageHeader from '@/components/content/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

/*
 * 个人入口：公开值直接内置为默认（克隆即构建，无需部署平台配置），
 * 环境变量仅作覆盖通道——值变更或失效时改 .env / 平台变量即可，不动代码。
 */
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL?.trim() || 'https://github.com/WSks-ui';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL?.trim() || 'aria_7@yeah.net';
// QQ 群分享链接里的 authKey 是群分享令牌，会过期：加群按钮失效时到 QQ 群
// 「分享群」重新生成一条链接整体替换即可，busi_data 等参数随新链接一起换。
const qqGroupUrl = import.meta.env.PUBLIC_QQ_GROUP_URL?.trim()
	|| 'https://qun.qq.com/universal-share/share?ac=1&authKey=TvbAWmh4kftVoQxrUuqIXbpq8ZEFhjGMPDklklYXTbY4O4vRHmQAAdWCXd03lP9T&busi_data=eyJncm91cENvZGUiOiI3MDEyNjc1NjEiLCJ0b2tlbiI6IkxraUh5aVhLdi81dFdLOVpYK2lKOW9KWmI0aFh5Ym8yc2daaEZSdDMybVJXczNudzJnRS9oMmRZWGwxNnJXR2IiLCJ1aW4iOiIyMzgzNDAzMjA2In0=&data=FFtTF0Zb5T9pTfj3527xyXqTdWp1AAIMQ8Mg65q_ltHlV5dnwju3HWFyMl7ssQoNwUhRW-jEWFMcDIJ-9Jcbax5s-dOaYKClKi3Iwa8GtEs&svctype=5&tempid=h5_group_info';

/*
 * 肖像真图：把照片放进 public/assets/about/portrait.{avif,webp,jpg,jpeg,png}
 * 即在构建时自动启用（同多张时按此优先级取第一张）；缺图回退现有占位 SVG。
 */
const PORTRAIT_EXTENSIONS = ['avif', 'webp', 'jpg', 'jpeg', 'png'];
let portraitFile: string | null = null;
try {
	const files = readdirSync(join(process.cwd(), 'public', 'assets', 'about'));
	portraitFile = files
		.map((file) => ({ file, ext: file.split('.').pop()?.toLowerCase() ?? '' }))
		.filter(({ ext }) => PORTRAIT_EXTENSIONS.includes(ext))
		.sort((a, b) => PORTRAIT_EXTENSIONS.indexOf(a.ext) - PORTRAIT_EXTENSIONS.indexOf(b.ext))[0]?.file ?? null;
} catch {
	// 目录尚未创建时静默保持占位图，不阻断构建。
}
const portraitUrl = portraitFile ? `/assets/about/${portraitFile}` : '/assets/patterns/umbrella-field.svg';

/*
 * 自我介绍打字机：构建期把每条切分为 token（中文逐字、英文与数字整词、
 * 空白成组），每个 token 一个透明占位的 span，按 --char-i 错时显现——
 * 布局从首帧就是最终形态，逐字浮现不推挤页面。链接段整体保持 <a> 语义。
 */
const tokenizeFact = (text: string): string[] => text.match(/\s+|[A-Za-z0-9]+|./gs) ?? [];

type FactSegment = { t: string; link?: boolean };
const factSegments: FactSegment[][] = [
	[{ t: '在读 29 届大学生，喜欢玩各种类型的游戏，也一直向往游戏行业。' }],
	[{ t: '初中时自学过板绘，虽然画得不太好。高三时开始对游戏行业产生兴趣，进入大学前了解到技术美术（Technical Artist / TA）这个职业，找到了自己喜欢的方向。' }],
	[{ t: '曾以为自己喜欢人工智能，后来才慢慢意识到，这份兴趣更多是受到时代浪潮的影响。我想重新听一听自己的声音，找回原本想走的路。' }],
	[{ t: '大一的种种琐事，让我陷入了将近十个月的迷茫。现在，我决定重拾那个关于游戏与技术美术的梦想，从计算机图形学出发，继续学习，慢慢靠近。' }],
	[{ t: '目前以 C++、计算机图形学和 Shader 为学习方向，也在探索 Python 在工具开发中的应用。这个博客用 Astro 搭建，记录我的学习与尝试。' }],
	[{ t: '如果你也喜欢游戏、图形学，或正在琢磨一个有趣的点子，欢迎给我' }, { t: '发邮件', link: true }, { t: '。一起交流，也一起把想法做出来。' }],
];
const factLines = factSegments.map((segments) => {
	let cursor = 0;
	return segments.map((segment) => {
		const tokens = tokenizeFact(segment.t);
		const start = cursor;
		cursor += tokens.length;
		return { ...segment, tokens, start };
	});
});
---

<BaseLayout title="关于" description="关于 Aria-7 与这个个人档案站。">
	<div class="page-shell about-page">
		<div class="about-header">
			<PageHeader eyebrow="PROFILE / ARIA-7" title="关于 Aria-7" sharedTitle="Aria-7" />
		</div>
		<section class="about-grid">
			<div class="about-portrait" aria-hidden="true">
				<img src={portraitUrl} alt="" width="700" height="900" />
				<span>VISUAL ARCHIVE / RAIN STUDY</span>
			</div>
			<div class="about-copy">
				{/* 按站长自述整理兴趣与经历，保留清单式介绍；技术栈取自 GitHub 公开仓库。 */}
				<p class="about-greet" style="--reveal-order: 0">Hi，我是 Aria-7。</p>
				<ul class="about-facts">
					{factLines.map((segments, i) => (
						<li style={`--reveal-order: ${i + 1}`}>
							{segments.map((segment) =>
								segment.link ? (
									<a href={`mailto:${contactEmail}`}>
										{segment.tokens.map((ch, j) => (
											<span class="ch" style={`--char-i: ${segment.start + j}`}>{ch}</span>
										))}
									</a>
								) : (
									segment.tokens.map((ch, j) => (
										<span class="ch" style={`--char-i: ${segment.start + j}`}>{ch}</span>
									))
								)
							)}
						</li>
					))}
				</ul>
				{/* 寄语与后续入口的显影序号跟随正文条数，增删介绍时无需手动调整。 */}
				<p class="about-motto" style={`--reveal-order: ${factLines.length + 1}`}>
					<span lang="en">computer graphics is awesome</span>
					<span class="about-motto-note">与君共勉。</span>
				</p>
				<div class="about-links" style={`--reveal-order: ${factLines.length + 2}`}>
					<a href={githubUrl} rel="noopener noreferrer"><GitBranch size={18} stroke-width={1.5} aria-hidden="true" /> GitHub</a>
					<a href={`mailto:${contactEmail}`}><Mail size={18} stroke-width={1.5} aria-hidden="true" /> 邮箱</a>
					<a href="/rss.xml" data-astro-reload><Rss size={18} stroke-width={1.5} aria-hidden="true" /> RSS</a>
					{/* QQ 群：默认即为加群分享链接，一键直达；链接失效时在 .env 覆盖新值。 */}
					<a href={qqGroupUrl} target="_blank" rel="noopener noreferrer"><Users size={18} stroke-width={1.5} aria-hidden="true" /> QQ 群</a>
				</div>
				{/* 与首页「关于我 →」同构的镜像返回入口：挂在同一镜像路由守卫下，
				    点击即走「纸面显影」返回编排；不加该标记时仍是普通返回路径。 */}
				<a class="about-return" href="/" data-aria7-title-transition-link style={`--reveal-order: ${factLines.length + 3}`}>
					<ArrowLeft size={20} stroke-width={1.5} aria-hidden="true" />
					<span>返回首页</span>
				</a>
			</div>
		</section>
	</div>
</BaseLayout>

<style is:global>
	/*
	 * 「离场呼吸 + 到达显影」双拍（about 侧）：
	 * 到达——曝光幕退去的同时 eyebrow 页头栏先落定，标题下基线从左画出，
	 * 描述与肖像 clip-path 展开随后，正文按 --reveal-order 以 65ms 字面错拍
	 * 落定：具体时长随正文条数递增，正文 0.25s 起可读。键帧与引用全部收在同一个
	 * 全局块里，避免 scoped 与 global 混用时 dev/build 的键帧改名差异；规则用
	 * .about-page 前缀限定作用域。直接访问本页时同一套级联充当入场，
	 * reduced-motion 下由 motion.css 一级兜底瞬时到达并把延迟清零。
	 * 离场——点击返回首页时同一 html 标记驱动反向呼吸：文案组错峰上浮退场，
	 * 巨型标题微微上浮，交由命名 View Transition 接力飞行。
	 */
	@keyframes about-rise {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes about-baseline {
		0% { opacity: 0; transform: scaleX(0); }
		16% { opacity: 0.55; }
		46%, 66% { opacity: 0.45; transform: scaleX(1); }
		100% { opacity: 0; transform: scaleX(1); }
	}

	@keyframes about-develop {
		from { clip-path: inset(0 0 100% 0); }
		to { clip-path: inset(0 0 0 0); }
	}

	@keyframes about-develop-img {
		from { transform: scale(1.05); }
		to { transform: scale(1); }
	}

	@keyframes about-exit-rise {
		from { opacity: 1; transform: translateY(0); }
		to { opacity: 0; transform: translateY(-8px); }
	}

	@keyframes about-type-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes about-title-lift {
		from { opacity: 1; transform: translateY(0); }
		to { opacity: 1; transform: translateY(-8px); }
	}

	@keyframes about-portrait-exit {
		from { opacity: 1; }
		to { opacity: 0; }
	}

	/* 页头基线：沿页头既有底线画一条青色墨线，画出后自行隐去，页面恢复原设计。 */
	.about-page .about-header { position: relative; }
	.about-page .about-header::after {
		position: absolute;
		inset: auto 0 -1px 0;
		height: 1px;
		content: '';
		background: var(--weather-accent);
		opacity: 0;
		transform: scaleX(0);
		transform-origin: left center;
		animation: about-baseline 1100ms var(--ease-rain) 130ms both;
	}

	/* 到达显影顺序：页头栏 → 基线 → 描述 → 肖像展开 → 正文条目。 */
	.about-page .page-header__rail { animation: about-rise 400ms var(--ease-rain) 110ms both; }
	.about-page .page-header__mark { animation: about-rise 440ms var(--ease-rain) 150ms both; }
	.about-page .page-header p { animation: about-rise 420ms var(--ease-rain) 200ms both; }

	/* 肖像显影：容器自上而下揭开（clip-path），图像同时从轻缩放落定。 */
	.about-page .about-portrait { animation: about-develop 560ms var(--ease-rain) 240ms both; }
	.about-page .about-portrait img { animation: about-develop-img 620ms var(--ease-rain) 240ms both; }

	/* 正文条目 65ms 错拍落定，透过正在退去的曝光幕 0.25s 左右即可读。 */
	.about-page .about-copy > * {
		animation: about-rise 400ms var(--ease-rain) both;
		animation-delay: calc(250ms + var(--reveal-order, 0) * 65ms);
	}

	/*
	 * 自我介绍打字机：清单整体不再淡入（布局占位由透明 token 承担）。每个
	 * 字符在所属条目的节拍上依 --char-i 以 26ms 字面步进打出，先落在自身
	 * 位置的右下偏移点上，随即各自滑进预定位置，落版随打字波次递进。
	 * 行内方点跟随条目第一个字同时落点，不在空行上提前亮出。
	 */
	.about-page .about-facts { animation: none; }
	.about-page .about-facts .ch {
		opacity: 0;
		animation: about-type-in 1ms linear both;
		animation-delay: calc(430ms + var(--reveal-order, 1) * 70ms + var(--char-i, 0) * 26ms);
	}
	.about-page .about-facts li::before {
		opacity: 0;
		animation: about-type-in 1ms linear both;
		animation-delay: calc(430ms + var(--reveal-order, 1) * 70ms);
	}

	/*
	 * token 继续保持原生 inline 排版，链接下划线和空白宽度都不改变；每个
	 * 延迟点只做一次 opacity 翻转，保留逐字打出的节奏。旧版 240ms 的 left/top
	 * 动画会让上百个字符在抵达阶段持续参与布局，现已从关键路径移除。
	 */

	/*
	 * 离场呼吸：标记挂上后文案组按 fast 档字面错拍上浮退场，巨型标题微微
	 * 上浮保持可见。选择器链比到达规则高一级，确保覆盖已完成的入场填充；
	 * 曝光幕同时从 SharedTitleTransition 涨满接管画面。
	 */
	html[data-title-veil='leaving'] .about-page .page-header__rail { animation: about-exit-rise 180ms var(--ease-drift) both; }
	html[data-title-veil='leaving'] .about-page .page-header__mark { animation: about-exit-rise 200ms var(--ease-drift) 30ms both; }
	html[data-title-veil='leaving'] .about-page .page-header p { animation: about-exit-rise 180ms var(--ease-drift) 50ms both; }
	html[data-title-veil='leaving'] .about-page .about-portrait,
	html[data-title-veil='leaving'] .about-page .about-portrait img { animation: about-portrait-exit 220ms var(--ease-drift) both; }
	html[data-title-veil='leaving'] .about-page .about-copy > * {
		animation: about-exit-rise 200ms var(--ease-drift) both;
		animation-delay: calc(var(--reveal-order, 0) * 30ms);
	}
	html[data-title-veil='leaving'] .about-page .page-header h1 { animation: about-title-lift 280ms var(--ease-drift) 30ms both; }

	@media (prefers-reduced-motion: reduce) {
		.about-page .about-header::after,
		.about-page .about-portrait,
		.about-page .about-portrait img,
		.about-page .about-copy > *,
		.about-page .page-header__rail,
		.about-page .page-header__mark,
		.about-page .page-header p { animation-delay: 0ms; }

		/* 打字机是正文内容动效：减弱动态时跳过逐字节奏，全文直接可读。 */
		.about-page .about-facts .ch,
		.about-page .about-facts li::before { animation: none; opacity: 1; }
	}
</style>

<style>
	.page-shell { max-width: var(--content-max); margin-inline: auto; padding-inline: var(--page-gutter); }

	/* min() 让列在容器不足时可压缩，配合 1080px 断点（内容最小宽度 952px + 页边距），
	   901–1080px 视口不会再溢出后被 overflow-x: clip 静默裁切。 */
	.about-grid { display: grid; grid-template-columns: minmax(min(360px, 100%), 0.85fr) minmax(min(520px, 100%), 1.15fr); gap: 72px; margin-top: 72px; }
	.about-portrait { position: relative; min-height: 660px; overflow: hidden; background: var(--accent-soft); }
	.about-portrait img { width: 100%; height: 100%; object-fit: cover; }
	.about-portrait span { position: absolute; left: 18px; bottom: 16px; font-family: var(--font-ui); font-size: 9px; color: var(--ink-muted); }
	.about-copy { padding-top: 24px; }

	/* 清单式自我介绍（学 lvy 主页）：问候 + 方点短句，行距放宽，不再写文档腔。 */
	.about-greet { margin: 0 0 24px; font-size: 22px; font-weight: 500; }
	.about-facts { display: grid; gap: 18px; margin: 0 0 40px; padding: 0; list-style: none; }
	.about-facts li { position: relative; padding-left: 22px; line-height: 1.9; }
	.about-facts li::before { position: absolute; top: 0.92em; left: 2px; width: 5px; height: 5px; content: ''; background: var(--weather-accent); }
	.about-facts a { color: var(--accent-strong); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.22em; }
	.about-facts a:hover { text-decoration-thickness: 2px; }
	.about-motto { margin: 0; font-size: 20px; font-weight: 500; line-height: 1.6; color: var(--accent-strong); }
	.about-motto-note { display: block; margin-top: 8px; font-size: 14px; font-weight: 400; color: var(--ink-muted); }
	.about-links { display: grid; grid-template-columns: repeat(2, 1fr); margin-top: 28px; border-block: 1px solid var(--line); }
	.about-links a { display: flex; min-height: 64px; align-items: center; gap: 10px; padding-inline: 12px; border-right: 1px solid var(--line); font-family: var(--font-ui); font-size: 11px; color: var(--ink); text-decoration: none; }
	.about-links a:last-child { border-right: 0; }

	/* 「← 返回首页」与首页「关于我 →」同构：同一按钮语法，箭头朝左、悬停反向位移。 */
	.about-return { display: inline-flex; min-height: 44px; align-items: center; gap: 18px; margin-top: 30px; padding: 0 18px 0 14px; border: 1px solid var(--ink); background: color-mix(in srgb, var(--paper-0) 86%, transparent); font-family: var(--font-ui); font-size: 11px; color: var(--ink); text-decoration: none; backdrop-filter: blur(10px); }
	.about-return svg { transition: transform var(--duration-base) var(--ease-rain); }
	.about-return:hover svg { transform: translateX(-4px); }

	@media (max-width: 1080px) { .about-grid { grid-template-columns: 1fr; } .about-portrait { min-height: 420px; } }
		@media (max-width: 760px) { .page-shell { padding-inline: 20px; } .about-links { grid-template-columns: 1fr; } .about-links a { border-right: 0; border-bottom: 1px solid var(--line); } }
</style>

---
import { GitBranch, Mail, Rss } from '@lucide/astro';
import PageHeader from '@/components/content/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="关于" description="关于 Aria-7 与这个个人档案站。">
	<div class="page-shell">
		<PageHeader eyebrow="PROFILE / ARIA-7" title="关于 Aria-7" description="这里将补充一段更完整的个人介绍。现在先保存正在学习、制作和观察的事物。" />
		<section class="about-grid">
			<div class="about-portrait" aria-hidden="true">
				<img src="/assets/patterns/umbrella-field.svg" alt="" width="700" height="900" />
				<span>PORTRAIT / PLACEHOLDER</span>
			</div>
			<div class="about-copy prose">
				<h2>现在</h2>
				<p>个人简介、所在城市和当前关注方向将在这里补充。站点目前用于记录长文、短学习笔记、GitHub 项目、摄影与插画、代码笔记，以及可重复实践的教程。</p>
				<h2>关注的主题</h2>
				<ul>
					<li>前端开发与界面设计</li>
					<li>学习方法与知识整理</li>
					<li>开源项目与小型工具</li>
					<li>摄影、插画与视觉观察</li>
				</ul>
				<h2>联系</h2>
				<div class="about-links">
					<a href="https://github.com/" rel="noreferrer"><GitBranch size={18} stroke-width={1.5} aria-hidden="true" /> GitHub</a>
					<a href="mailto:hello@example.com"><Mail size={18} stroke-width={1.5} aria-hidden="true" /> 邮箱占位</a>
					<a href="/rss.xml"><Rss size={18} stroke-width={1.5} aria-hidden="true" /> RSS</a>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.page-shell { max-width: var(--content-max); margin-inline: auto; padding-inline: var(--page-gutter); }
	.about-grid { display: grid; grid-template-columns: minmax(360px, 0.85fr) minmax(520px, 1.15fr); gap: 72px; margin-top: 72px; }
	.about-portrait { position: relative; min-height: 660px; overflow: hidden; background: var(--accent-soft); }
	.about-portrait img { width: 100%; height: 100%; object-fit: cover; }
	.about-portrait span { position: absolute; left: 18px; bottom: 16px; font-family: var(--font-ui); font-size: 9px; color: var(--ink-muted); }
	.about-copy { padding-top: 24px; }
	.about-links { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 28px; border-block: 1px solid var(--line); }
	.about-links a { display: flex; min-height: 64px; align-items: center; gap: 10px; padding-inline: 12px; border-right: 1px solid var(--line); font-family: var(--font-ui); font-size: 11px; color: var(--ink); text-decoration: none; }
	.about-links a:last-child { border-right: 0; }
	@media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; } .about-portrait { min-height: 420px; } }
	@media (max-width: 760px) { .page-shell { padding-inline: 20px; } .about-links { grid-template-columns: 1fr; } .about-links a { border-right: 0; border-bottom: 1px solid var(--line); } }
</style>

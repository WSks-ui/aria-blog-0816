---
import ArticleGraph from '@/components/content/ArticleGraph.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/content';

const posts = await getPosts();
---

<BaseLayout title="伞骨关系图" description="通过共享标签查看文章之间的关系。">
	<div class="page-shell">
		<PageHeader eyebrow="MAP / CONNECTIONS" title="伞骨关系图" count={posts.length} />
		<div class="graph-mount">
			<ArticleGraph posts={posts} heading="" />
		</div>
	</div>
</BaseLayout>

<style>
	/* 图谱与关系轨道并排后需要更宽的版面，这一页用 --content-wide 而不是阅读宽度。 */
	.page-shell { max-width: 96rem; margin-inline: auto; padding-inline: var(--page-gutter); }
	.graph-mount { margin-top: 64px; }
	@media (max-width: 760px) { .page-shell { padding-inline: 20px; } }
</style>

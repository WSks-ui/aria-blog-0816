---
import { ArrowDown, ArrowLeft, ArrowUpRight, GitBranch, Mail } from '@lucide/astro';
import TopographyBackdrop from '@/components/ta/TopographyBackdrop.astro';
import { SITE } from '@/data/site';
import { LAB_DISCIPLINES } from '@/data/ta';
import { getPosts, getPostPath } from '@/lib/content';
import '@/styles/ta.css';

const posts = await getPosts();
const projects = posts.filter((post) => post.data.lab?.type === 'project');
const notes = posts.filter((post) => post.data.lab?.type === 'note');
// 栏目与导航使用同一内容条件；没有公开内容时不输出占位说明或无效锚点。
// 仅收录明确带 lab 标记的内容，不再用主博客文章补齐版面。
const disciplines = [...new Set(projects.map((post) => post.data.lab!.discipline))];
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL?.trim() || 'https://github.com/WSks-ui';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL?.trim() || 'aria_7@yeah.net';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const title = `图形实验室 / ${SITE.name}`;
const description = 'Aria-7 / 图形实验室。技术美术、实时渲染与图形实验。';
const date = (value: Date) => new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC',
}).format(value);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<!-- 启用脚本时由入场动画从黑屏揭开地图，静态后备图只在渲染失败或无脚本时显示。 -->
		<script is:inline>document.documentElement.classList.add('js')</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#111315" />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="stylesheet" href="/fonts/fonts.css" />
		<link rel="stylesheet" href="/fonts/harmonyos-sans.css" />
		<link rel="preload" href="/fonts/space-grotesk/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/source-serif-4/source-serif-4-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/assets/ta/topography-og.webp', canonical)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body class="ta-page">
		<a href="#main-content" class="lab-skip">跳到正文</a>
		<TopographyBackdrop />
		<header class="lab-header">
			<a href="/ta/" class="lab-brand" aria-label="Aria-7 图形实验室">
				<img src="/assets/brand/rain-archive-mark.svg" alt="" width="30" height="30" />
				<span>Aria-7<span class="lab-brand__suffix"> / LAB</span></span>
			</a>
			<nav aria-label="实验室导航">
				{projects.length > 0 && <a href="#work">项目</a>}
				{notes.length > 0 && <a href="#journal">笔记</a>}
				<a href="#contact">联系</a>
			</nav>
			<a class="lab-back" href="/" aria-label="返回博客" title="返回博客"><ArrowLeft size={15} aria-hidden="true" /><span>返回博客</span></a>
		</header>

		<main id="main-content">
			<section class="lab-hero" aria-labelledby="lab-title">
				<div class="lab-hero__copy">
					<p class="lab-hero__eyebrow"><span></span> 图形实验室</p>
					<h1 id="lab-title">Aria-7<span class="lab-title-dot">.</span></h1>
					<p class="lab-hero__intro">技术美术 / 实时渲染</p>
					{(projects.length > 0 || notes.length > 0) && (
						<a class="lab-hero__link" href={projects.length > 0 ? '#work' : '#journal'}>
							{projects.length > 0 ? '项目' : '笔记'} <ArrowDown size={18} aria-hidden="true" />
						</a>
					)}
				</div>
			</section>

			<section class="lab-veil">
			{projects.length > 0 && <section class="lab-section lab-work" id="work" aria-labelledby="work-title">
				<div class="lab-section__head">
					<h2 id="work-title">项目<span class="lab-count mono">{String(projects.length).padStart(2, '0')}</span></h2>
				</div>
						{disciplines.length > 1 && (
							<div class="lab-filters" role="group" aria-label="按项目方向筛选" data-project-filters hidden>
								<button type="button" data-filter="all" aria-pressed="true">全部</button>
								{disciplines.map((discipline) => <button type="button" data-filter={discipline} aria-pressed="false">{LAB_DISCIPLINES[discipline]}</button>)}
							</div>
						)}
						<div class="lab-project-grid">
							{projects.map((project) => (
								<article class="lab-project" data-discipline={project.data.lab!.discipline}>
									<a href={getPostPath(project)}>
										{project.data.cover && <img class="lab-project__cover" src={project.data.cover} alt={`${project.data.title}项目画面`} width="720" height="450" loading="lazy" />}
										<div class="lab-project__meta mono"><span>{LAB_DISCIPLINES[project.data.lab!.discipline]}</span><span>{project.data.lab!.status === 'complete' ? '已完成' : '进行中'}</span></div>
										<h3>{project.data.title}<ArrowUpRight size={20} aria-hidden="true" /></h3>
										<p>{project.data.summary}</p>
									</a>
								</article>
							))}
						</div>
			</section>}

			{notes.length > 0 && <section class="lab-section lab-journal" id="journal" aria-labelledby="journal-title">
				<div class="lab-section__head">
					<h2 id="journal-title">笔记</h2>
				</div>
					<div class="lab-note-list">
						{notes.map((note) => (
							<a class="lab-note" href={getPostPath(note)}>
								<time class="mono" datetime={note.data.publishedAt.toISOString()}>{date(note.data.publishedAt)}</time>
								<div><span class="lab-note__category">{LAB_DISCIPLINES[note.data.lab!.discipline]} · {note.data.lab!.status === 'complete' ? '已完成' : '学习中'}</span><h3>{note.data.title}</h3><p>{note.data.summary}</p></div>
								<ArrowUpRight size={21} stroke-width={1.3} aria-hidden="true" />
							</a>
						))}
					</div>
			</section>}

			<section class="lab-contact" id="contact" aria-labelledby="contact-title">
				<h2 id="contact-title">联系</h2>
				<div class="lab-contact__links">
					<a href={`mailto:${email}`}><Mail size={19} aria-hidden="true" /><span>发邮件</span><ArrowUpRight size={17} aria-hidden="true" /></a>
					<a href={githubUrl} rel="noreferrer"><GitBranch size={19} aria-hidden="true" /><span>GitHub</span><ArrowUpRight size={17} aria-hidden="true" /></a>
				</div>
			</section>
			</section>
		</main>

		<footer class="lab-footer">
			<a href="/ta/" class="lab-footer__brand">Aria-7<span> / LAB</span></a>
			<span class="mono">© {new Date().getFullYear()} Aria-7</span>
			<div class="lab-footer__legal">
				<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">豫ICP备2026042988号</a>
				<a href="https://beian.mps.gov.cn/#/query/webSearch?code=41170202411843" target="_blank" rel="noopener noreferrer">豫公网安备41170202411843号</a>
			</div>
		</footer>
	</body>
</html>

<script>
	// 只有真实项目跨越多个方向时才显示筛选，空档案不堆无效控件。
	const filters = document.querySelector<HTMLElement>('[data-project-filters]');
	if (filters) {
		filters.hidden = false;
		filters.addEventListener('click', (event) => {
			const button = (event.target as Element).closest<HTMLButtonElement>('[data-filter]');
			if (!button) return;
			filters.querySelectorAll<HTMLButtonElement>('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
			document.querySelectorAll<HTMLElement>('[data-discipline]').forEach((project) => {
				project.hidden = button.dataset.filter !== 'all' && project.dataset.discipline !== button.dataset.filter;
			});
		});
	}
</script>

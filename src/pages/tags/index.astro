---
import PageHeader from '@/components/content/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { collectTagCounts, getPosts } from '@/lib/content';

const posts = await getPosts();
const tags = collectTagCounts(posts);
---

<BaseLayout title="标签" description="Aria-7 的文章标签。">
	<div class="page-shell">
		<PageHeader eyebrow="INDEX / TAGS" title="标签索引" count={tags.length} />
		{tags.length > 0 ? (
			<div class="tag-cloud">
				{tags.map((tag, index) => (
					<a href={`/tags/${encodeURIComponent(tag.label)}/`}>
						<span>{String(index + 1).padStart(2, '0')}</span>
						<strong>#{tag.label}</strong>
						<small>{tag.count} 篇</small>
					</a>
				))}
			</div>
		) : (
			<p class="tag-cloud-empty">还没有任何标签。</p>
		)}
	</div>
</BaseLayout>

<style>
	.page-shell { max-width: var(--content-max); margin-inline: auto; padding-inline: var(--page-gutter); }
	.tag-cloud { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 64px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
	.tag-cloud a { display: grid; min-height: 150px; align-content: space-between; padding: 20px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
	.tag-cloud a:hover { background: var(--accent-soft); }
	.tag-cloud span, .tag-cloud small { font-family: var(--font-ui); font-size: 12px; color: var(--ink-muted); }
	.tag-cloud strong { font-family: var(--font-display); font-size: 20px; font-weight: 500; }
	/* 与 types/[kind] 的 .empty 同款空状态，避免无标签时只剩一个空网格框线。 */
	.tag-cloud-empty { margin-top: 64px; padding-block: 72px; border-block: 1px solid var(--line); color: var(--ink-muted); }
	@media (max-width: 900px) { .tag-cloud { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 760px) { .page-shell { padding-inline: 20px; } }
</style>

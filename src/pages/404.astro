---
import { MoveLeft } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="没有找到这条记录" description="请求的页面不存在。">
	<section class="not-found">
		<img src="/assets/covers/default-night.webp" alt="" width="1600" height="900" />
		<div>
			<p>SCENE / 404</p>
			<h1>记录不在这里</h1>
			<span>可能被移动、尚未发布，或从未写下。</span>
			<a href="/"><MoveLeft size={18} stroke-width={1.5} aria-hidden="true" /> 返回首页</a>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found { position: relative; max-width: var(--content-max); min-height: 680px; margin: 28px auto 0; overflow: hidden; }
	.not-found > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.not-found > div { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px; background: rgb(9 11 12 / 56%); color: var(--night-text); text-align: center; }
	.not-found p { font-family: var(--font-ui); font-size: 10px; color: var(--night-muted); }
	.not-found h1 { margin: 18px 0; font-family: var(--font-display); font-size: 64px; font-weight: 500; }
	.not-found span { color: var(--night-muted); }
	.not-found a { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; margin-top: 32px; color: var(--night-text); }
</style>

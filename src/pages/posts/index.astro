---
import ArticleRow from '@/components/content/ArticleRow.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/content';

const posts = await getPosts();
---

<BaseLayout title="全部文章" description="Aria-7 的全部随笔、笔记、项目、底片、代码与指南。">
	<div class="page-shell">
		<PageHeader eyebrow="ARCHIVE / ALL ENTRIES" title="全部文章" count={posts.length} />
		<section class="page-list" aria-label="文章列表">
			{posts.map((post, index) => <ArticleRow post={post} index={index + 1} />)}
		</section>
	</div>
</BaseLayout>

<style>
	.page-shell { max-width: var(--content-max); margin-inline: auto; padding-inline: var(--page-gutter); }
	.page-list { margin-top: 64px; }
	@media (max-width: 760px) { .page-shell { padding-inline: 20px; } }
</style>

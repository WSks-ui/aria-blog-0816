---
import { getCollection, type CollectionEntry } from 'astro:content';
import TutorialToolDossier from '@/components/content/TutorialToolDossier.astro';
import { TUTORIAL_TOOLS, type TutorialTool } from '@/data/tutorial-tools';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const guides = await getCollection('toolGuides');
	const guideByToolId = new Map(guides.map((guide) => [guide.data.toolId, guide]));

	return TUTORIAL_TOOLS.map((tool, index) => {
		const guide = guideByToolId.get(tool.id);
		// 工具目录和同步内容必须一一对应。静默跳过会让线上目录出现无法打开的卡片，
		// 因此把缺失快照升级为构建错误，提醒维护者先运行同步命令再部署。
		if (!guide) {
			throw new Error(`缺少 CSDIY 工具讲义：${tool.id}。请先生成 src/content/tool-guides/${tool.id}.md`);
		}

		const previousTool = TUTORIAL_TOOLS[index - 1];
		const nextTool = TUTORIAL_TOOLS[index + 1];
		return {
			params: { id: tool.id },
			props: {
				tool,
				guide,
				previous: previousTool ? { tool: previousTool, index: index - 1 } : undefined,
				next: nextTool ? { tool: nextTool, index: index + 1 } : undefined,
			},
		};
	});
}

interface Props {
	tool: TutorialTool;
	guide: CollectionEntry<'toolGuides'>;
	previous?: { tool: TutorialTool; index: number };
	next?: { tool: TutorialTool; index: number };
}

const { tool, guide, previous, next } = Astro.props;
---

<BaseLayout title={`${guide.data.title} 工具讲义`} description={`来自 CSDIY 的 ${guide.data.title} 工具讲义。`} className="tutorial-tool-page">
	<TutorialToolDossier tool={tool} guide={guide} previous={previous} next={next} />
</BaseLayout>

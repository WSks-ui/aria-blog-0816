---
import { ArrowRight, CalendarRange, Network, Search } from '@lucide/astro';
import ArticleRow from '@/components/content/ArticleRow.astro';
import KindLabel from '@/components/content/KindLabel.astro';
import PostMeta from '@/components/content/PostMeta.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCoverScene from '@/components/visual/ContentCoverScene.astro';
import HeroScene from '@/components/visual/HeroScene.astro';
import { IMAGE_COLLECTION } from '@/data/image-collection';
import { POST_KIND_LABELS, POST_KINDS } from '@/data/site';
import { collectTagCounts, getPostPath, getPosts } from '@/lib/content';

const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const recent = posts.filter((post) => post.id !== featured?.id).slice(0, 5);
const tagCounts = collectTagCounts(posts).slice(0, 8);
const kindCounts = POST_KINDS.map((kind) => ({
	kind,
	count: posts.filter((post) => post.data.kind === kind).length + (kind === 'photo' ? IMAGE_COLLECTION.length : 0),
}));
const kindTrackHeights = [58, 82, 68, 94, 74, 86];
const kindTrackCodes = ['ESSAY', 'NOTE', 'PROJECT', 'FRAME', 'CODE', 'GUIDE'];
const featuredCover = featured?.data.cover && !featured.data.cover.endsWith('/hero-bg.webp')
	? featured.data.cover
	: null;
const featuredCoverFit = featured?.data.kind === 'photo' ? 'cover' : 'contain';
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
}).format(date);
---

<BaseLayout className="home-page">
	<div class="home-page-scenes">
		<section class="home-scene home-scene--hero" aria-labelledby="home-title">
			<div class="scene-inner">
				<div class="home-hero">
					<HeroScene />
					<div class="home-hero__status">
						<span>SCENE / HOME</span>
						<span data-weather-theme-label>THEME / RAIN</span>
						<span>LOC / CN</span>
					</div>
					<div class="home-hero__copy">
						<p>PERSONAL ARCHIVE / 2026</p>
						<h1 id="home-title">Aria-7</h1>
						<strong>欢迎来到我的个人博客，随便看看</strong>
						<span>随笔、学习笔记、项目、底片、代码与指南。</span>
						<a class="home-hero__enter" href="/about/" data-route-transition-link>
							<span>关于我</span>
							<ArrowRight size={20} stroke-width={1.5} aria-hidden="true" />
						</a>
					</div>
				</div>
			</div>
		</section>

		{featured && (
			<section class="home-scene home-scene--featured" aria-labelledby="featured-title" data-home-reveal>
				<div class="scene-inner">
					<div class="featured-band">
						<div class="section-index">
							<span>01</span>
							<p>FEATURED RECORD</p>
						</div>
						<div class="featured-band__copy">
							<KindLabel kind={featured.data.kind} />
							<h2 id="featured-title"><a href={getPostPath(featured)} data-article-transition-link>{featured.data.title}</a></h2>
							<p>{featured.data.summary}</p>
							<PostMeta date={featured.data.publishedAt} weather={featured.data.readingWeather} compact />
						</div>
						<a class="featured-band__visual" href={getPostPath(featured)} aria-label={`阅读《${featured.data.title}》`} data-article-transition-link>
							<ContentCoverScene kind={featured.data.kind} class="featured-band__cover-scene" />
							{featuredCover && (
								<span class:list={['featured-band__media', `featured-band__media--${featuredCoverFit}`]}>
									<img src={featuredCover} alt="" width="760" height="430" />
								</span>
							)}
							<span class="featured-band__open">OPEN / RECORD</span>
						</a>
					</div>
				</div>
			</section>
		)}

		<section class="home-scene home-scene--recent" aria-labelledby="recent-title" data-home-reveal>
			<div class="scene-inner recent-layout">
				<aside class="recent-stage">
					<div class="recent-stage__sticky">
						<p class="section-kicker">02 / LATEST ENTRIES</p>
						<h2 id="recent-title">最近记录</h2>
						{recent.length > 0 && (
							<div
								class="recent-stage__visual"
								data-recent-scroll-viewport
								role="region"
								aria-label="最近记录预览滚动"
								tabindex="0"
							>
								<div class="recent-stage__track">
									{[false, true].map((isDuplicate) => (
										<div
											class="recent-stage__group"
											data-recent-scroll-group={isDuplicate ? 'duplicate' : 'primary'}
											aria-hidden={isDuplicate ? 'true' : undefined}
											inert={isDuplicate ? true : undefined}
										>
											{recent.map((post, index) => (
												<a
													class="recent-preview"
													href={getPostPath(post)}
													data-recent-preview
													data-recent-preview-index={index}
													data-article-transition-link
													tabindex={isDuplicate ? -1 : undefined}
													>
														<ContentCoverScene kind={post.data.kind} compact class="recent-preview__cover" />
														<span class="recent-preview__shade" aria-hidden="true"></span>
														<span class="recent-preview__copy">
															<span class="recent-preview__meta">
																<b>{String(index + 1).padStart(2, '0')}</b>
																<small>FRAME / {formatDate(post.data.publishedAt)}</small>
															</span>
															<span class="recent-preview__signal">VISUAL TRACE / {String(index + 1).padStart(2, '0')}</span>
														</span>
													<ArrowRight class="recent-preview__arrow" size={16} stroke-width={1.4} aria-hidden="true" />
												</a>
											))}
										</div>
									))}
								</div>
							</div>
						)}
						<a class="recent-stage__all" href="/posts/">查看全部 <ArrowRight size={17} stroke-width={1.5} aria-hidden="true" /></a>
					</div>
				</aside>

				<div class="recent-stream">
					<div class="recent-stream__axis" aria-hidden="true"><span>LIVE / {String(recent.length).padStart(2, '0')}</span><i></i></div>
					<div class="article-list">
						{recent.map((post, index) => (
							<div
								class="recent-entry"
								data-home-row
								data-recent-index={String(index + 1).padStart(2, '0')}
							>
								<ArticleRow post={post} index={index + 1} />
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="home-scene home-scene--index" aria-label="内容索引" data-home-reveal>
			<div class="scene-inner">
				<header class="section-heading index-heading">
					<div>
						<p>03 / INDEX SYSTEM</p>
					</div>
					<span>{String(posts.length).padStart(2, '0')} RECORDS / {String(tagCounts.length).padStart(2, '0')} SIGNALS</span>
				</header>
				<div class="kind-index" data-index-field>
					{kindCounts.map(({ kind, count }, index) => (
						<a
							href={`/types/${kind}/`}
							data-index-track
							data-track-index={index}
							style={`--track-height: ${kindTrackHeights[index]}%; --track-mobile-height: ${Math.round(180 + kindTrackHeights[index] * 0.65)}px; --track-delay: ${index * 80}ms;`}
						>
							<span class="kind-index__number">{String(index + 1).padStart(2, '0')}</span>
							<span class="kind-index__label">
								<strong>{POST_KIND_LABELS[kind]}</strong>
								<em>{kindTrackCodes[index]}</em>
							</span>
							<small>{String(count).padStart(2, '0')} ENTRIES</small>
							<ArrowRight class="kind-index__arrow" size={18} stroke-width={1.4} aria-hidden="true" />
						</a>
					))}
					<div class="kind-index__coordinate" aria-hidden="true" data-index-coordinate>X 000 / Y 000</div>
				</div>
				<div class="tag-index">
					<p>TAGS / FREQUENCY</p>
					<div>
						{tagCounts.map((tag) => (
							<a href={`/tags/${encodeURIComponent(tag.label)}/`}>
								<span>#{tag.label}</span>
								<small>{tag.count}</small>
							</a>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="home-scene home-scene--coda" aria-labelledby="explore-title" data-home-reveal>
			<div class="scene-inner coda-layout">
				<header>
					<p>04 / TRACE TOOLS</p>
					<h2 id="explore-title">继续寻找</h2>
					<span>ARCHIVE / CONNECTION / SEARCH</span>
				</header>
				<div class="explore-band">
					<a href="/archive/">
						<CalendarRange size={24} stroke-width={1.4} aria-hidden="true" />
						<span><small>按时间寻找</small><strong>雨日历</strong></span>
						<ArrowRight size={19} stroke-width={1.4} aria-hidden="true" />
					</a>
					<a href="/connections/">
						<Network size={24} stroke-width={1.4} aria-hidden="true" />
						<span><small>按关联寻找</small><strong>伞骨关系图</strong></span>
						<ArrowRight size={19} stroke-width={1.4} aria-hidden="true" />
					</a>
					<button type="button" data-search-trigger>
						<Search size={24} stroke-width={1.4} aria-hidden="true" />
						<span><small>按词语寻找</small><strong>搜索档案</strong></span>
						<ArrowRight size={19} stroke-width={1.4} aria-hidden="true" />
					</button>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<script>
	function initHomeScenes() {
		const page = document.querySelector<HTMLElement>('.home-page-scenes');
		if (!page || page.dataset.motionReady === 'true') return;
		page.dataset.motionReady = 'true';
		document.documentElement.classList.add('home-motion-ready');

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const revealTargets = page.querySelectorAll<HTMLElement>('[data-home-reveal]');
		if (reduceMotion || !('IntersectionObserver' in window)) {
			revealTargets.forEach((target) => target.classList.add('is-in-view'));
		} else {
			const revealObserver = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-in-view');
					revealObserver.unobserve(entry.target);
				});
			}, { rootMargin: '0px 0px -14% 0px', threshold: 0.08 });
			revealTargets.forEach((target) => revealObserver.observe(target));
		}

		const rows = [...page.querySelectorAll<HTMLElement>('[data-home-row]')];
		const recentViewport = page.querySelector<HTMLElement>('[data-recent-scroll-viewport]');
		const recentGroups = [...page.querySelectorAll<HTMLElement>('[data-recent-scroll-group]')];
		const recentPreviews = [...page.querySelectorAll<HTMLElement>('[data-recent-preview]')];
		let loopDistance = 0;
		let activeRecentIndex = -1;
		let pointerPaused = false;
		let focusPaused = false;
		let manualPauseUntil = 0;
		let previousFrameTime = 0;
		let streamPosition = 0;

		const setActiveRecent = (index: number) => {
			if (index === activeRecentIndex || index < 0) return;
			activeRecentIndex = index;
			rows.forEach((row, rowIndex) => row.classList.toggle('is-current', rowIndex === index));
			recentPreviews.forEach((preview) => {
				preview.classList.toggle('is-current', Number(preview.dataset.recentPreviewIndex) === index);
			});
		};

		const measureRecentStream = () => {
			const [primaryGroup, duplicateGroup] = recentGroups;
			if (!primaryGroup || !duplicateGroup) return;
			loopDistance = duplicateGroup.offsetTop - primaryGroup.offsetTop;
		};

		const normalizeRecentScroll = () => {
			if (!recentViewport || loopDistance <= 0) return recentViewport?.scrollTop ?? 0;
			while (recentViewport.scrollTop >= loopDistance) recentViewport.scrollTop -= loopDistance;
			return recentViewport.scrollTop;
		};

		const syncRecentHighlight = () => {
			if (!recentViewport || recentPreviews.length === 0) return;
			// 以窗口上方约四分之一处作为阅读焦点，让初始状态明确对应时间序列中的第一条记录。
			const viewportFocus = recentViewport.getBoundingClientRect().top + recentViewport.clientHeight * 0.26;
			const nearestPreview = recentPreviews.reduce<{ preview: HTMLElement; distance: number } | null>((nearest, preview) => {
				const bounds = preview.getBoundingClientRect();
				const distance = Math.abs(bounds.top + bounds.height / 2 - viewportFocus);
				return !nearest || distance < nearest.distance ? { preview, distance } : nearest;
			}, null);
			setActiveRecent(Number(nearestPreview?.preview.dataset.recentPreviewIndex ?? 0));
		};

		// 移动端已经隐藏预览窗口，继续维持无限 RAF 只会白白占用电量；
		// 记录列表本身仍然保留，因此窄屏不需要这条桌面滚动舞台。
		const compactViewport = window.matchMedia('(max-width: 760px)').matches;
		if (recentViewport && !compactViewport) {
			measureRecentStream();
			streamPosition = normalizeRecentScroll();
			syncRecentHighlight();
			recentViewport.addEventListener('pointerdown', () => {
				pointerPaused = true;
			});
			window.addEventListener('pointerup', () => {
				pointerPaused = false;
			});
			recentViewport.addEventListener('pointercancel', () => {
				pointerPaused = false;
			});
			recentViewport.addEventListener('wheel', () => {
				// 滚轮输入优先交给访客；停止操作片刻后，从用户选定的位置继续自动推进。
				manualPauseUntil = performance.now() + 1400;
			}, { passive: true });
			recentViewport.addEventListener('focusin', () => {
				focusPaused = true;
			});
			recentViewport.addEventListener('focusout', () => {
				requestAnimationFrame(() => {
					focusPaused = recentViewport.contains(document.activeElement);
				});
			});
			recentViewport.addEventListener('scroll', () => {
				const normalizedPosition = normalizeRecentScroll();
				// 自动写入会产生细小的像素量化差；只有明显偏差才视为访客的滚轮或滚动条输入。
				if (Math.abs(normalizedPosition - streamPosition) > 2) streamPosition = normalizedPosition;
				syncRecentHighlight();
			}, { passive: true });
			recentPreviews.forEach((preview) => {
				const selectPreview = () => setActiveRecent(Number(preview.dataset.recentPreviewIndex ?? 0));
				preview.addEventListener('pointerenter', selectPreview);
				preview.addEventListener('focus', selectPreview);
			});

			// 预览流只在可见时推进；每帧按真实时间增量移动，刷新率变化不会改变滚动速度。
			const advanceRecentStream = (frameTime: number) => {
				if (!page.isConnected) return;
				const elapsed = previousFrameTime === 0 ? 0 : Math.min(frameTime - previousFrameTime, 48);
				previousFrameTime = frameTime;
				const viewportBounds = recentViewport.getBoundingClientRect();
				const streamIsVisible = viewportBounds.bottom > 0 && viewportBounds.top < window.innerHeight;
				if (!reduceMotion && streamIsVisible && !pointerPaused && !focusPaused && frameTime >= manualPauseUntil) {
					streamPosition += elapsed * 0.026;
					while (loopDistance > 0 && streamPosition >= loopDistance) streamPosition -= loopDistance;
					recentViewport.scrollTop = streamPosition;
					syncRecentHighlight();
				}
				requestAnimationFrame(advanceRecentStream);
			};
			requestAnimationFrame(advanceRecentStream);

			const resizeObserver = new ResizeObserver(() => {
				measureRecentStream();
				streamPosition = normalizeRecentScroll();
				syncRecentHighlight();
			});
			resizeObserver.observe(recentViewport);
			recentGroups.forEach((group) => resizeObserver.observe(group));
		}

		const indexField = page.querySelector<HTMLElement>('[data-index-field]');
		const indexTracks = [...page.querySelectorAll<HTMLElement>('[data-index-track]')];
		const indexCoordinate = page.querySelector<HTMLElement>('[data-index-coordinate]');
		const setActiveTrack = (track: HTMLElement | null) => {
			indexTracks.forEach((candidate) => candidate.classList.toggle('is-active', candidate === track));
			indexField?.classList.toggle('has-active', Boolean(track));
			if (indexField) indexField.dataset.activeIndex = track?.dataset.trackIndex ?? '';
		};

		if (indexField && !reduceMotion) {
			// 坐标线只跟随索引区内部的指针，离开后立即收束；链接焦点沿用同一套强调状态。
			indexField.addEventListener('pointermove', (event) => {
				const bounds = indexField.getBoundingClientRect();
				const x = Math.max(0, Math.min(bounds.width, event.clientX - bounds.left));
				const y = Math.max(0, Math.min(bounds.height, event.clientY - bounds.top));
				indexField.style.setProperty('--index-pointer-x', `${x}px`);
				indexField.style.setProperty('--index-pointer-y', `${y}px`);
				indexField.classList.add('is-tracking');
				if (indexCoordinate) indexCoordinate.textContent = `X ${String(Math.round(x)).padStart(3, '0')} / Y ${String(Math.round(y)).padStart(3, '0')}`;
			});
			indexField.addEventListener('pointerleave', () => {
				indexField.classList.remove('is-tracking');
				if (!indexField.contains(document.activeElement)) setActiveTrack(null);
			});
			indexTracks.forEach((track) => {
				track.addEventListener('pointerenter', () => setActiveTrack(track));
				track.addEventListener('focus', () => setActiveTrack(track));
				track.addEventListener('blur', () => setActiveTrack(null));
			});
		}
	}

	initHomeScenes();
	document.addEventListener('astro:page-load', initHomeScenes);
</script>

<style>
	.home-page-scenes { margin-inline: var(--frame-inset); overflow: clip; }
	.scene-inner { width: min(100%, calc(var(--content-wide) + var(--page-gutter) + var(--page-gutter))); margin-inline: auto; padding-inline: var(--page-gutter); }
	.home-scene { position: relative; }
	.home-scene--hero { z-index: 1; }
	.home-hero { position: relative; min-height: clamp(500px, calc(100vh - 290px), 620px); margin-top: 28px; overflow: hidden; background: var(--accent-soft); color: var(--ink); }
	.home-hero__status { position: absolute; top: 22px; right: 24px; z-index: 6; display: flex; gap: 20px; font-family: var(--font-ui); font-size: 9px; color: var(--ink-muted); opacity: 0; animation: home-meta-enter 540ms var(--ease-rain) 180ms forwards; }
	.home-hero__copy { position: absolute; top: 50%; left: clamp(34px, 7vw, 112px); z-index: 6; width: min(610px, 51%); transform: translateY(-50%); }
	.home-hero__copy > p,
	.home-hero__copy > span { font-family: var(--font-ui); font-size: 11px; color: var(--ink-muted); opacity: 0; animation: home-copy-enter 620ms var(--ease-rain) 280ms forwards; }
	.home-hero h1 { margin: 18px 0 10px; font-family: var(--font-display); font-size: 132px; font-weight: 500; line-height: 0.96; overflow-wrap: anywhere; opacity: 0; animation: home-title-enter 760ms var(--ease-rain) 340ms forwards; }
	.home-hero__copy > strong { display: block; max-width: 580px; margin-bottom: 14px; font-family: var(--font-display); font-size: 31px; font-weight: 500; line-height: 1.52; overflow-wrap: anywhere; opacity: 0; animation: home-copy-enter 680ms var(--ease-rain) 520ms forwards; }
	.home-hero__copy > span { display: block; animation-delay: 660ms; }
	.home-hero__enter { display: inline-flex; min-height: 44px; align-items: center; gap: 18px; margin-top: 30px; padding: 0 14px 0 18px; border: 1px solid var(--ink); background: color-mix(in srgb, var(--paper-0) 86%, transparent); font-family: var(--font-ui); font-size: 11px; color: var(--ink); text-decoration: none; backdrop-filter: blur(10px); opacity: 0; animation: home-action-enter 560ms var(--ease-rain) 780ms forwards; }
	.home-hero__enter:hover svg { transform: translateX(4px); }
	.home-hero__enter svg { transition: transform var(--duration-base) var(--ease-rain); }

	/* 精选内容的深色舞台与其它场景共用同一个 scene-inner 内边界，避免整块底色向外溢出。 */
	.home-scene--featured { z-index: 2; margin-top: -46px; padding-block: 82px 68px; background: transparent; color: #edf1ef; }
	.featured-band { --ink: #edf1ef; --ink-muted: #a8b8bb; --line: #47616a; --line-strong: #87a2aa; --accent-strong: #96d9e7; --paper-0: #101d22; --color-surface: #101d22; --color-ink: #edf1ef; --color-ink-muted: #a8b8bb; --color-line: #47616a; --color-line-strong: #87a2aa; --color-rain: #75c5d8; --color-rain-deep: #96d9e7; display: grid; grid-template-columns: minmax(74px, 1fr) repeat(11, minmax(0, 1fr)); min-height: 500px; border-block: 1px solid var(--line); background: #10242a; }
	.section-index { grid-column: 1 / 2; display: flex; flex-direction: column; justify-content: space-between; padding: 28px 18px 28px 0; border-right: 1px solid var(--line); font-family: var(--font-ui); color: var(--ink-muted); }
	.section-index span { font-size: 34px; color: var(--color-warm); }
	.section-index p { margin: 0; font-size: 9px; writing-mode: vertical-rl; }
	.featured-band__copy { grid-column: 2 / 7; display: flex; flex-direction: column; justify-content: center; padding: 48px clamp(30px, 4vw, 62px); }
	.featured-band h2 { margin: 18px 0; font-family: var(--font-display); font-size: 50px; font-weight: 500; line-height: 1.26; overflow-wrap: anywhere; }
	.featured-band h2 a { color: var(--ink); text-decoration: none; }
	.featured-band__copy > p { margin: 0 0 28px; font-size: 14px; line-height: 1.85; color: var(--ink-muted); }
	.featured-band__visual { position: relative; grid-column: 7 / -1; display: block; min-height: 500px; overflow: hidden; border-left: 1px solid var(--line); }
	.featured-band__visual :global(.featured-band__cover-scene) { width: 100%; height: 100%; transition: transform 900ms var(--ease-drift), filter 900ms var(--ease-drift); }
	.featured-band__visual:hover :global(.featured-band__cover-scene) { transform: scale(1.018); filter: contrast(1.06); }
	.featured-band__media { position: absolute; z-index: 2; top: 22%; left: 18%; display: grid; width: 62%; height: 52%; place-items: center; overflow: hidden; border: 1px solid rgb(237 241 239 / 46%); background: rgb(237 241 239 / 88%); box-shadow: 0 22px 54px rgb(0 0 0 / 22%); transition: transform 760ms var(--ease-drift); }
	.featured-band__visual:hover .featured-band__media { transform: translate3d(8px, -6px, 0); }
	.featured-band__media img { width: 100%; height: 100%; }
	.featured-band__media--contain img { object-fit: contain; padding: 10%; }
	.featured-band__media--cover img { object-fit: cover; }
	.featured-band__open { position: absolute; right: 18px; bottom: 16px; z-index: 3; font-family: var(--font-ui); font-size: 9px; color: var(--ink-muted); }

	.home-scene--recent { padding-block: 168px 72px; }

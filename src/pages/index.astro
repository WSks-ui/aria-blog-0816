---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeCoda from '@/components/home/HomeCoda.astro';
import HomeFeatured from '@/components/home/HomeFeatured.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeKindIndex from '@/components/home/HomeKindIndex.astro';
import HomeRecent from '@/components/home/HomeRecent.astro';
import { getPosts } from '@/lib/content';
import '@/styles/home.css';

const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const recent = posts.filter((post) => post.id !== featured?.id).slice(0, 5);
const featuredCover = featured?.data.cover && !featured.data.cover.endsWith('/hero-bg.webp')
	? featured.data.cover
	: null;
const featuredCoverFit = featured?.data.kind === 'photo' ? 'cover' : 'contain';
const lastUpdateText = new Intl.DateTimeFormat('zh-CN', {
	month: '2-digit',
	day: '2-digit',
	timeZone: 'UTC',
}).format(posts[0]?.data.publishedAt ?? new Date());
---

<BaseLayout className="home-page cursor-companion">
	<div class="home-page-scenes">
		<HomeHero recordsCount={posts.length} lastUpdateText={lastUpdateText} />
		{featured && (
			<HomeFeatured featured={featured} featuredCover={featuredCover} featuredCoverFit={featuredCoverFit} />
		)}
		<HomeRecent recent={recent} />
		<HomeKindIndex posts={posts} />
		<HomeCoda />
	</div>
</BaseLayout>

<script>
	let disposeHomeReveal: (() => void) | undefined;

	function initHomeReveal() {
		// 章节显现是全页协调器：区块各自渲染，进入视口的揭幕状态统一在这里管理。
		disposeHomeReveal?.();

		const page = document.querySelector<HTMLElement>('.home-page-scenes');
		if (!page) return;
		page.dataset.motionReady = 'true';
		document.documentElement.classList.add('home-motion-ready');

		const controller = new AbortController();
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const supportsIntersectionObserver = typeof window.IntersectionObserver === 'function';
		const revealTargets = page.querySelectorAll<HTMLElement>('[data-home-reveal]');
		let revealObserver: IntersectionObserver | undefined;
		if (reduceMotion || !supportsIntersectionObserver) {
			revealTargets.forEach((target) => target.classList.add('is-in-view'));
		} else {
			revealObserver = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-in-view');
					revealObserver?.unobserve(entry.target);
				});
			}, { rootMargin: '0px 0px -14% 0px', threshold: 0.08 });
			revealTargets.forEach((target) => revealObserver?.observe(target));
		}

		disposeHomeReveal = () => {
			controller.abort();
			revealObserver?.disconnect();
			if (page.isConnected) delete page.dataset.motionReady;
			document.documentElement.classList.remove('home-motion-ready');
		};
	}

	initHomeReveal();
	document.addEventListener('astro:page-load', initHomeReveal);
	document.addEventListener('astro:before-swap', () => disposeHomeReveal?.());
</script>

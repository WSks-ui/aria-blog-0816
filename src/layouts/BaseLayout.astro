---
import SiteFooter from '@/components/shell/SiteFooter.astro';
import SiteFrame from '@/components/shell/SiteFrame.astro';
import SiteHeader from '@/components/shell/SiteHeader.astro';
import RainField from '@/components/visual/RainField.astro';
import RouteTransition from '@/components/visual/RouteTransition.astro';
import SharedTitleTransition from '@/components/visual/SharedTitleTransition.astro';
import WeatherTransition from '@/components/visual/WeatherTransition.astro';
import { ClientRouter } from 'astro:transitions';
import { InteractionSurface, Lightbox, SearchDialog, TooltipLayer, WeatherModeControl } from '@/components/interactive';
import '@/styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	className?: string;
}

const {
	title = 'Aria-7',
	description = 'Aria-7 的个人写作档案，记录学习、创作、项目与技术实践。',
	image = '/assets/covers/default-day.webp',
	type = 'website',
	className = '',
} = Astro.props;

const pageTitle = title === 'Aria-7' ? title : `${title} / Aria-7`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="zh-CN" data-weather-mode="rain" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ebedec" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="Aria-7 RSS" href="/rss.xml" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{pageTitle}</title>
		{/*
			首屏只预载最常出现的三个字形子集：UI拉丁、正文拉丁与中文常用字。
			其余Noto分片仍由unicode-range按需请求，JetBrains Mono留给代码/HUD按需加载。
		*/}
		<link rel="preload" href="/fonts/space-grotesk/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/source-serif-4/source-serif-4-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/noto-serif-sc/H4chBXePl9DZ0Xe7gG9cyOj7oqP0dTpxZbB9E9gjjmzKvaeKHUTtJDWv3z-us4bxD8F5og.118.woff2" as="font" type="font/woff2" crossorigin />
		{/* Chromium 系浏览器对站内链接在悬停/按下时预取目标页（moderate 档），
		    800ms 的文章转场遮罩正好把加载时间藏进去；不支持的浏览器静默忽略。 */}
		<script
			is:inline
			type="speculationrules"
			set:html={JSON.stringify({ prefetch: [{ source: 'document', where: { href_matches: '/*' }, eagerness: 'moderate' }] })}
		/>
		<!--
			非原生 View Transition 浏览器需要运行 fallback 的 old/new 两段动画；
			具体规则只命中 data-page-main，因此持久化页头仍固定在原位。
		-->
		<ClientRouter fallback="animate" />
		<style is:inline>
			/* 外部样式表尚未下载时先建立页面画布，避免完整页面导航暴露浏览器默认白底。 */
			html { background-color: #ebedec; }
			html[data-weather-mode='clear'] { background-color: #f6f7f3; }
			html[data-weather-mode='rain'] { background-color: #ebedec; }
			html[data-weather-mode='night'],
			html[data-route-arrival='scene'] { background-color: #0d1216; }
			html[data-route-arrival='scene'] body { background-color: #0d1216 !important; }
			/* 命名标题由浏览器保存旧、新快照并插值位置；不再跨文档重建克隆节点。 */
			::view-transition-group(aria7-title) {
				animation-duration: var(--duration-arrival, 560ms);
				animation-timing-function: var(--ease-rain, ease);
			}
			/*
			 * 栏目 tab 的正文换页不做双层叠影：两层文本同屏时，旧页文字会透过
			 * 新页快照的透明背景显形，并一直停留到快照销毁，读起来像未完成的
			 * 淡切。这里改为先后式——旧页先带方向整体退净，纸面留出一拍，新页
			 * 再从行进方向落定，两层文本永不重叠。方向由栏目顺序决定（SiteHeader
			 * 依索引改写 direction）：前进向左翻页，后退向右翻回。
			 */
			html:not([data-title-flight='active'])::view-transition-group(aria7-page-main) {
				animation-duration: 510ms;
				animation-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1);
			}
			html:not([data-title-flight='active'])::view-transition-image-pair(aria7-page-main) {
				isolation: isolate;
			}
			html:not([data-title-flight='active'])::view-transition-old(aria7-page-main) {
				z-index: 1;
				will-change: opacity, transform;
				animation: aria7-page-exit-forward 240ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) both;
			}
			html:not([data-title-flight='active'])::view-transition-new(aria7-page-main) {
				z-index: 2;
				will-change: opacity, transform;
				animation: aria7-page-reveal-forward 360ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) 150ms both;
			}
			html[data-astro-transition='back']:not([data-title-flight='active'])::view-transition-old(aria7-page-main) {
				animation-name: aria7-page-exit-back;
			}
			html[data-astro-transition='back']:not([data-title-flight='active'])::view-transition-new(aria7-page-main) {
				animation-name: aria7-page-reveal-back;
			}
			/* fallback 没有新旧快照，old/new 两段本来就先后播放，直接复用同一组关键帧。 */
			html:not([data-title-flight='active'])[data-astro-transition-fallback='old'] [data-page-main] {
				animation: aria7-page-exit-forward 240ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) both;
			}
			html:not([data-title-flight='active'])[data-astro-transition-fallback='new'] [data-page-main] {
				animation: aria7-page-reveal-forward 360ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) both;
			}
			html[data-astro-transition='back']:not([data-title-flight='active'])[data-astro-transition-fallback='old'] [data-page-main] {
				animation-name: aria7-page-exit-back;
			}
			html[data-astro-transition='back']:not([data-title-flight='active'])[data-astro-transition-fallback='new'] [data-page-main] {
				animation-name: aria7-page-reveal-back;
			}
			html[data-title-flight='active'][data-astro-transition-fallback] [data-page-main] {
				animation: none;
			}
			@keyframes aria7-page-exit-forward {
				from { opacity: 1; transform: translate3d(0, 0, 0); }
				to { opacity: 0; transform: translate3d(-3.2%, 0, 0); }
			}
			@keyframes aria7-page-reveal-forward {
				from { opacity: 0; transform: translate3d(2.6%, 0, 0); }
				to { opacity: 1; transform: translate3d(0, 0, 0); }
			}
			@keyframes aria7-page-exit-back {
				from { opacity: 1; transform: translate3d(0, 0, 0); }
				to { opacity: 0; transform: translate3d(3.2%, 0, 0); }
			}
			@keyframes aria7-page-reveal-back {
				from { opacity: 0; transform: translate3d(-2.6%, 0, 0); }
				to { opacity: 1; transform: translate3d(0, 0, 0); }
			}
			/*
			 * 根元素退出视图转场分组：整页不再被快照冻结，换页瞬间即是活层。
			 * 「纸面显影」的到达编排（曝光退去 + about 显影级联）因此在标题飞行
			 * 期间实时演出，而不是被冻在幕后等飞行结束才被硬掀开；遮住换帧的
			 * 职责交给 SharedTitleTransition 自己的曝光幕。不支持该值的浏览器
			 * 会回退到旧行为（根快照盖场），曝光幕的行内覆盖态仍能兜住换帧。
			 */
			html {
				view-transition-name: none;
			}

			/*
			 * 命名转场只为首页↔关于这对镜像旅程服务：其余导航不给标题命名，
			 * 否则浏览器会对单侧存在的命名元素播放孤儿渐显/渐隐——从其它页
			 * 返回首页时标题的闪烁即由此而来。旅程开始时 SharedTitleTransition
			 * 先给当前根节点挂 data-title-flight，再在 astro:before-swap 阶段给
			 * newDocument 的根节点同步该标记；属性交换后飞行的两个快照才能同名。
			 */
			html [data-aria7-title-transition] { view-transition-name: none; }
			html[data-title-flight='active'] [data-aria7-title-transition] { view-transition-name: aria7-title; }
			html [data-page-main] { view-transition-name: aria7-page-main; }
			html[data-title-flight='active'] [data-page-main] { view-transition-name: none; }

			@media (prefers-reduced-motion: reduce) {
				::view-transition-group(aria7-title) { animation-duration: 1ms; }
				html:not([data-title-flight='active'])::view-transition-group(aria7-page-main),
				html:not([data-title-flight='active'])::view-transition-old(aria7-page-main),
				html:not([data-title-flight='active'])::view-transition-new(aria7-page-main) {
					animation-duration: 1ms !important;
					animation-delay: 0ms !important;
				}
				html[data-astro-transition-fallback] [data-page-main] {
					animation-duration: 1ms !important;
				}
			}
		</style>
		<script is:inline>
			(() => {
				const modes = new Set(['clear', 'rain', 'night']);
				const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
				let saved = null;
				try {
					saved = localStorage.getItem('aria7-weather-mode');
				} catch {
					// 禁用本地存储时仍按系统主题完成无闪烁首屏，不让读取异常中断页面初始化。
				}
				const initial = modes.has(saved)
					? saved
					: 'rain';
				document.documentElement.dataset.weatherMode = initial;
				document.documentElement.dataset.theme = initial === 'night' ? 'night' : 'light';
				document.documentElement.style.colorScheme = initial === 'night' ? 'dark' : 'light';

				// 只有场景转场需要先建立黑场；主导航的左右滑动沿用当前天气画布，避免
				// 清爽的栏目切换被误切成深色闪屏。缺失 mode 的旧标记按 scene 兼容处理。
				try {
					const arrivalValue = sessionStorage.getItem('aria7-route-arrival');
					if (arrivalValue) {
						sessionStorage.removeItem('aria7-route-arrival');
						const arrival = JSON.parse(arrivalValue);
						const arrivalAge = typeof arrival?.createdAt === 'number'
							? Date.now() - arrival.createdAt
							: Number.NaN;
						const isFresh = Number.isFinite(arrivalAge) && arrivalAge >= 0 && arrivalAge < 5000;
						if (!prefersReducedMotion && isFresh && arrival?.pathname === location.pathname && arrival?.search === location.search) {
							// 文章和讲义的完整场景转场仍需在新文档首帧建立黑场；
							// 普通站内导航则由 ClientRouter 的正文快照负责，不写会话标记。
							document.documentElement.dataset.routeArrival = 'scene';
						}
					}
				} catch {
					// 会话存储不可用或旧标记格式失效时退化为普通页面抵达，不阻断主题初始化。
				}

			})();
		</script>
	</head>
	<body class={className}>
		<a class="skip-link" href="#main-content">跳到正文</a>
		<SiteFrame />
		<RainField />
		<WeatherTransition />
		<RouteTransition />
		<SharedTitleTransition />
		<InteractionSurface />
		<TooltipLayer />
		<SiteHeader pathname={Astro.url.pathname}>
			<WeatherModeControl slot="weather-control" />
		</SiteHeader>
		<!--
			Astro 只有在模板中声明 transition:animate 后，才会把该元素登记为
			ClientRouter 的可交换层。实际运动由上方的命名 View Transition 规则
			接管；data-page-main 保留给首页与关于页的专用标题旅程进行排除控制。
		-->
		<main id="main-content" data-page-main transition:name="aria7-page-main" transition:animate="none">
			<slot />
		</main>
		<SiteFooter />
		<SearchDialog />
		<Lightbox />
	</body>
</html>

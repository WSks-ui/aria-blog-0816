---
import SiteFooter from '@/components/shell/SiteFooter.astro';
import SiteFrame from '@/components/shell/SiteFrame.astro';
import SiteHeader from '@/components/shell/SiteHeader.astro';
import RainField from '@/components/visual/RainField.astro';
import SharedTitleTransition from '@/components/visual/SharedTitleTransition.astro';
import WeatherTransition from '@/components/visual/WeatherTransition.astro';
import ArrivalRipples from '@/components/visual/ArrivalRipples.astro';
import HudTypewriter from '@/components/visual/HudTypewriter.astro';
import { ClientRouter } from 'astro:transitions';
import { InteractionSurface, Lightbox, SearchDialog, TooltipLayer, WeatherModeControl } from '@/components/interactive';
import { SITE } from '@/data/site';
import '@/styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	/**
	 * 首屏 LCP 图的真实地址：仅当页面实际渲染该图时才传入并注入 preload。
	 * 文章页无自定义封面时首屏是 CSS 场景，传 image（og 用）而不传 preloadImage，
	 * 避免预载一张从不显示的默认封面。
	 */
	preloadImage?: string;
	type?: 'website' | 'article';
	/** 站点级不收录标记：404 等无内容路由跳过 canonical 并输出 robots noindex。 */
	noindex?: boolean;
	className?: string;
}

const {
	title,
	description = SITE.description,
	image = '/assets/covers/default-day.webp',
	preloadImage,
	type = 'website',
	noindex = false,
	className = '',
} = Astro.props;

// 首页（未传 title）用站点全名，其余页面追加站名后缀；RSS 与 og:site_name
// 用的都是同一份 SITE 配置，站点叫什么只有一个出处。
const pageTitle = title ? `${title} / ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="zh-CN" data-weather-mode="rain" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="theme-color" content="#ebedec" />
		{!noindex && <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1600" />
		<meta property="og:image:height" content="900" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<title>{pageTitle}</title>
		{/*
			首屏只预载最常出现的两组拉丁字形子集：UI 与正文。
			中文载体是 HarmonyOS Sans SC 分片（unicode-range 按需请求）；
			Noto Serif SC 仅是生僻字兜底，预载其分片几乎不会命中，故不预载。
			JetBrains Mono 留给代码/HUD 按需加载。
		*/}
		<link rel="preload" href="/fonts/space-grotesk/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/source-serif-4/source-serif-4-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
		{/*
			字体声明清单以独立静态样式表下发（public/fonts/，纯 @font-face 无级联依赖），
			不经 Astro 样式管线：避免约 220KB 声明被复制进每个页面的服务端样式集
			（dev 下每页产生数 MB 模块字符串），浏览器端亦可跨页缓存同一份清单。
			声明仍随全站每页下发，字体栈回退行为与原 @import 方案一致。
		*/}
		<link rel="stylesheet" href="/fonts/fonts.css" />
		<link rel="stylesheet" href="/fonts/harmonyos-sans.css" />
		{/*
			文章页的 LCP 元素是首屏封面：preloadImage 由调用方在「页面确实渲染
			这张图」时传入（目前是带自定义封面的文章页），在头部抢先发起请求。
		*/}
		{preloadImage && (
			<link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
		)}
		{/* Chromium 系浏览器对站内链接在悬停/按下时预取目标页（moderate 档），
		    800ms 的文章转场遮罩正好把加载时间藏进去；不支持的浏览器静默忽略。 */}
		<script
			is:inline
			type="speculationrules"
			set:html={JSON.stringify({ prefetch: [{ source: 'document', where: { href_matches: '/*' }, eagerness: 'moderate' }] })}
		/>
		<!--
			非原生 View Transition 浏览器需要运行 fallback 的 old/new 两段动画；
			具体规则只命中 data-page-main，因此持久化页头仍固定在原位。
		-->
		<ClientRouter fallback="animate" />
		<style is:inline>
			/* 外部样式表尚未下载时先建立页面画布，避免完整页面导航暴露浏览器默认白底。 */
			html { background-color: #ebedec; }
			html[data-weather-mode='clear'] { background-color: #f6f7f3; }
			html[data-weather-mode='rain'] { background-color: #ebedec; }
			html[data-weather-mode='night'] { background-color: #0d1216; }
			/* 命名标题由浏览器保存旧、新快照并插值位置；不再跨文档重建克隆节点。 */
			::view-transition-group(aria7-title) {
				animation-duration: var(--duration-arrival, 560ms);
				animation-timing-function: var(--ease-rain, ease);
			}
			/*
			 * 栏目 tab 的正文换页不做双层叠影：两层文本同屏时，旧页文字会透过
			 * 新页快照的透明背景显形，并一直停留到快照销毁，读起来像未完成的
			 * 淡切。这里改为先后式——旧页先带方向整体退净，纸面留出一拍，新页
			 * 再从行进方向落定，两层文本永不重叠。方向由栏目顺序决定（SiteHeader
			 * 依索引改写 direction）：前进向左翻页，后退向右翻回。
			 */
			html:not([data-title-flight='active'])::view-transition-group(aria7-page-main) {
				animation-duration: 510ms;
				animation-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1);
			}
			html:not([data-title-flight='active'])::view-transition-image-pair(aria7-page-main) {
				isolation: isolate;
			}
			html:not([data-title-flight='active'])::view-transition-old(aria7-page-main) {
				z-index: 1;
				will-change: opacity, transform;
				animation: aria7-page-exit-forward 240ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) both;
			}
			html:not([data-title-flight='active'])::view-transition-new(aria7-page-main) {
				z-index: 2;
				will-change: opacity, transform;
				animation: aria7-page-reveal-forward 360ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) 150ms both;
			}
			html[data-astro-transition='back']:not([data-title-flight='active'])::view-transition-old(aria7-page-main) {
				animation-name: aria7-page-exit-back;
			}
			html[data-astro-transition='back']:not([data-title-flight='active'])::view-transition-new(aria7-page-main) {
				animation-name: aria7-page-reveal-back;
			}
			/* fallback 没有新旧快照，old/new 两段本来就先后播放，直接复用同一组关键帧。 */
			html:not([data-title-flight='active'])[data-astro-transition-fallback='old'] [data-page-main] {
				animation: aria7-page-exit-forward 240ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) both;
			}
			html:not([data-title-flight='active'])[data-astro-transition-fallback='new'] [data-page-main] {
				animation: aria7-page-reveal-forward 360ms var(--ease-rain, cubic-bezier(0.22, 0.75, 0.28, 1)) both;
			}
			html[data-astro-transition='back']:not([data-title-flight='active'])[data-astro-transition-fallback='old'] [data-page-main] {
				animation-name: aria7-page-exit-back;
			}
			html[data-astro-transition='back']:not([data-title-flight='active'])[data-astro-transition-fallback='new'] [data-page-main] {
				animation-name: aria7-page-reveal-back;
			}
			html[data-title-flight='active'][data-astro-transition-fallback] [data-page-main] {
				animation: none;
			}
			/*
			 * 文章导航（article-nav）：旧页软退、新页软入，让位给标题与封面的
			 * 命名共享元素飞行。命名对先按通用节奏淡切——旧字快散、新字迟显，
			 * 快照被盒子拉伸的过程藏在溶解里；aria7-page-main 的专属规则在后面
			 * 按同特异性覆写回来。列表里其余未配对的行标题作为孤儿组原地随页
			 * 淡出，与整页软退同拍，不留残影。
			 */
			html[data-article-nav='active']::view-transition-group(*) {
				animation-duration: 300ms;
				animation-timing-function: var(--ease-rain, ease);
			}
			html[data-article-nav='active']::view-transition-old(*),
			html[data-article-nav='active']::view-transition-new(*) {
				animation-duration: 150ms;
				animation-timing-function: ease-out;
			}
			html[data-article-nav='active']::view-transition-new(*) {
				animation-delay: 140ms;
			}
			/*
			 * 细线航轨的可见性：默认的新旧快照交叉溶解会把 1px 的线在飞行中段
			 * 淡没（old 150ms 退净、new 迟 140ms 才显），跟随几乎不可见。配对
			 * 飞行时新旧快照在同一盒内完全重合，让 new 全程实心，线就整段可见；
			 * 再放慢到 560ms、滞后 60ms 起飞——标题先动，细线拖在后面追上落位。
			 * 只覆写 new：孤儿航轨（去程无配对）的 old 仍按通用节奏随整页淡出，
			 * 不会留下悬空的一根线。
			 */
			html[data-article-nav='active']::view-transition-new(aria7-rule-top),
			html[data-article-nav='active']::view-transition-new(aria7-rule-bottom) {
				animation: none;
				opacity: 1;
			}
			html[data-article-nav='active']::view-transition-group(aria7-rule-top),
			html[data-article-nav='active']::view-transition-group(aria7-rule-bottom) {
				animation-duration: 560ms;
				animation-delay: 60ms;
				animation-timing-function: var(--ease-rain, ease);
			}
			html[data-article-nav='active']::view-transition-old(root) {
				animation-name: aria7-article-soft-exit;
				animation-duration: 220ms;
				animation-delay: 0ms;
			}
			html[data-article-nav='active']::view-transition-new(root) {
				animation-name: aria7-article-soft-reveal;
				animation-duration: 380ms;
				animation-delay: 80ms;
			}
			/* 后备浏览器没有命名共享元素，正文沿用同一套软退软入，节奏一致。
			   old 段发生在交换前，此刻标记还是 leaving；new 段在交换后，是 active。 */
			html[data-article-nav='leaving'][data-astro-transition-fallback='old'] [data-page-main] {
				animation-name: aria7-article-soft-exit;
				animation-duration: 220ms;
				animation-delay: 0ms;
			}
			html[data-article-nav='active'][data-astro-transition-fallback='new'] [data-page-main] {
				animation-name: aria7-article-soft-reveal;
				animation-duration: 380ms;
				animation-delay: 80ms;
			}
			@keyframes aria7-article-soft-exit {
				from { opacity: 1; }
				to { opacity: 0; }
			}
			@keyframes aria7-article-soft-reveal {
				from { opacity: 0; }
				to { opacity: 1; }
			}
			@keyframes aria7-page-exit-forward {
				from { opacity: 1; transform: translate3d(0, 0, 0); }
				to { opacity: 0; transform: translate3d(-3.2%, 0, 0); }
			}
			@keyframes aria7-page-reveal-forward {
				from { opacity: 0; transform: translate3d(2.6%, 0, 0); }
				to { opacity: 1; transform: translate3d(0, 0, 0); }
			}
			@keyframes aria7-page-exit-back {
				from { opacity: 1; transform: translate3d(0, 0, 0); }
				to { opacity: 0; transform: translate3d(3.2%, 0, 0); }
			}
			@keyframes aria7-page-reveal-back {
				from { opacity: 0; transform: translate3d(-2.6%, 0, 0); }
				to { opacity: 1; transform: translate3d(0, 0, 0); }
			}
			/*
			 * 根元素退出视图转场分组：整页不再被快照冻结，换页瞬间即是活层。
			 * 「纸面显影」的到达编排（曝光退去 + about 显影级联）因此在标题飞行
			 * 期间实时演出，而不是被冻在幕后等飞行结束才被硬掀开；遮住换帧的
			 * 职责交给 SharedTitleTransition 自己的曝光幕。不支持该值的浏览器
			 * 会回退到旧行为（根快照盖场），曝光幕的行内覆盖态仍能兜住换帧。
			 */
			html {
				view-transition-name: none;
			}
			/*
			 * 文章导航把软退软入交给 root：浏览器只采集视口大小的根快照，
			 * 不再随一万像素以上的正文高度扩张。封面、标题和细线拥有独立命名，
			 * 会从根快照中自动提升为自己的共享元素组并继续完成形变交接。
			 */
			html[data-article-nav] {
				view-transition-name: root;
			}

			/*
			 * 命名转场只为首页↔关于这对镜像旅程服务：其余导航不给标题命名，
			 * 否则浏览器会对单侧存在的命名元素播放孤儿渐显/渐隐——从其它页
			 * 返回首页时标题的闪烁即由此而来。旅程开始时 SharedTitleTransition
			 * 先给当前根节点挂 data-title-flight，再在 astro:before-swap 阶段给
			 * newDocument 的根节点同步该标记；属性交换后飞行的两个快照才能同名。
			 */
			html [data-aria7-title-transition] { view-transition-name: none; }
			html[data-title-flight='active'] [data-aria7-title-transition] { view-transition-name: aria7-title; }
			html [data-page-main] { view-transition-name: aria7-page-main; }
			html[data-title-flight='active'] [data-page-main] { view-transition-name: none; }
			/*
			 * 文章导航已有封面、标题与双细线承担空间连续性，不再把整篇正文加入
			 * aria7-page-main。长文可超过一万像素；给整个 main 命名会迫使 Chromium
			 * 在交换关键帧为离屏正文完成布局、栅格化和大纹理快照，即使最终动画
			 * 只使用 transform/opacity 也无法省掉这笔前置成本。
			 */
			html[data-article-nav] [data-page-main] { view-transition-name: none; }

			@media (prefers-reduced-motion: reduce) {
				::view-transition-group(aria7-title) { animation-duration: 1ms; }
				/* 命名共享元素（文章标题/封面）连同其余分组一律瞬时完成。 */
				::view-transition-group(*),
				::view-transition-old(*),
				::view-transition-new(*) {
					animation-duration: 1ms !important;
					animation-delay: 0ms !important;
				}
				html:not([data-title-flight='active'])::view-transition-group(aria7-page-main),
				html:not([data-title-flight='active'])::view-transition-old(aria7-page-main),
				html:not([data-title-flight='active'])::view-transition-new(aria7-page-main) {
					animation-duration: 1ms !important;
					animation-delay: 0ms !important;
				}
				html[data-astro-transition-fallback] [data-page-main] {
					animation-duration: 1ms !important;
				}
			}
		</style>
		<script is:inline>
			(() => {
				const modes = new Set(['clear', 'rain', 'night']);
				let saved = null;
				try {
					saved = localStorage.getItem('aria7-weather-mode');
				} catch {
					// 禁用本地存储时仍按系统主题完成无闪烁首屏，不让读取异常中断页面初始化。
				}
				const initial = modes.has(saved)
					? saved
					: 'rain';
				document.documentElement.dataset.weatherMode = initial;
				document.documentElement.dataset.theme = initial === 'night' ? 'night' : 'light';
				document.documentElement.style.colorScheme = initial === 'night' ? 'dark' : 'light';

			})();
		</script>
	</head>
	<body class={className}>
		<a class="skip-link" href="#main-content">跳到正文</a>
		<SiteFrame />
		<RainField />
		<WeatherTransition />
		<ArrivalRipples />
		<HudTypewriter />
		<SharedTitleTransition />
		<InteractionSurface />
		<TooltipLayer />
		<SiteHeader pathname={Astro.url.pathname}>
			<WeatherModeControl slot="weather-control" />
		</SiteHeader>
		<!--
			Astro 只有在模板中声明 transition:animate 后，才会把该元素登记为
			ClientRouter 的可交换层。实际运动由上方的命名 View Transition 规则
			接管；data-page-main 保留给首页与关于页的专用标题旅程进行排除控制。
		-->
		<main id="main-content" data-page-main transition:name="aria7-page-main" transition:animate="none">
			<slot />
		</main>
		<SiteFooter />
		<SearchDialog />
		<Lightbox />
		<script>
			type RouterEvent = Event & { newDocument?: Document };

			/*
			 * 文章导航标注（状态机）：before-preparation 给当前文档挂
			 * leaving（离场页细线保持原样随整页软退，视口守卫在此刻测量），
			 * before-swap 给新文档挂 active，并在离线文档里筛选落点；抵达后
			 * astro:page-load 切 settled（细线逐行起笔），画完释放。Astro 会
			 * 以新文档的根属性覆盖当前根节点，因此两端标记都要显式维护。
			 * head 内联样式里的换页规则只认 active——它们在交换后的文档上求值。
			 */
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			let settledTimer = 0;

			const armArticleNav = (event: Event) => {
				const source = (event as Event & { sourceElement?: Element }).sourceElement;
				const link = source instanceof Element
					? source.closest('a[data-article-transition-link]')
					: null;
				window.clearTimeout(settledTimer);
				// 上一次转场的航轨若还没走到释放点（快速连续导航），先拆干净，
				// 避免与本次指派撞出重名导致整个视图转场被跳过。
				document.querySelectorAll<HTMLElement>('[data-rule-flight]').forEach(releaseRuleFlight);
				if (link && !reduceMotion.matches) {
					document.documentElement.dataset.articleNav = 'leaving';
				} else {
					delete document.documentElement.dataset.articleNav;
				}
			};

			/*
			 * 共享元素的视口守卫：命名元素只有在旧页快照与新页落点都真实可见
			 * 时，「从哪儿来、到哪儿去」才成立。滚动后离屏的封面/标题一旦参与
			 * 配对，就会从屏幕外一路飞进落点、返回时再飞出屏幕。因此离场页按
			 * 已完成布局的真实视口摘名；到达页则在 before-swap 的离线文档中按
			 * 结构只保留文章 Hero 或返程目标行，避免 after-swap 首次读取 rect 时
			 * 强制同步排完整篇长文。被摘名的一侧退回整页软退软入，不再单独飞行。
			 */
			const NAMED_ELEMENT_SELECTOR = '[data-astro-transition-scope]';
			// 元素至少 1/4 露在视口带内才参与配对；贴边露一线的仍按离屏处理。
			const isMostlyInsideBand = (top: number, height: number, bandTop: number, bandBottom: number) => {
				if (height <= 0) return false;
				const visible = Math.min(top + height, bandBottom) - Math.max(top, bandTop);
				return visible / height >= 0.25;
			};

			// 到达页摘名记录在案：转场结束后归还，之后用户滚到该元素再点走时
			// 守卫能重新判定，而不是被上一次的行内摘名锁死。
			let arrivalStripped: HTMLElement[] = [];

			/*
			 * 细线航轨的动态指派：行细线在静态页面上是无名的，只有文章导航的
			 * 瞬间才被授予 aria7-rule-top/bottom——去程指给被点击行的上下两条
			 * 线（下线取下一行的上线，几何上正是该行的下缘），返程指给到达列表
			 * 里出发文章所在行的两条线。航轨与标题区细线（静态持有同名）对插
			 * 值，细线便跟着标题往返飞行。data-rule-flight 标记让航轨豁免藏线
			 * 与起笔，飞行落位后保持原貌。
			 */
			const FLIGHT_TOP = 'aria7-rule-top';
			const FLIGHT_BOTTOM = 'aria7-rule-bottom';

			const nameRuleFlight = (element: Element | null, name: string) => {
				if (!(element instanceof HTMLElement)) return;
				element.style.viewTransitionName = name;
				element.dataset.ruleFlight = 'true';
			};

			const rowFlightRules = (row: Element) => {
				const next = row.nextElementSibling;
				const bottomSource = next instanceof Element && next.matches('.article-row') ? next : null;
				return {
					top: row.querySelector<HTMLElement>('.article-row__rule--top'),
					bottom: bottomSource?.querySelector<HTMLElement>('.article-row__rule--top') ?? null,
				};
			};

			const releaseRuleFlight = (element: HTMLElement) => {
				element.style.removeProperty('view-transition-name');
				delete element.dataset.ruleFlight;
			};

			const prepareArrivalNames = (newDocument: Document, matchedRow: Element | null) => {
				const elements = Array.from(
					newDocument.querySelectorAll<HTMLElement>(`${NAMED_ELEMENT_SELECTOR}, [data-rule-flight]`),
				);
				/*
				 * newDocument 尚未挂进当前渲染树，此处只能做结构判断和行内写入，绝不
				 * 读取 rect/computed style。进入文章时只保留 Hero 的封面、标题与细线；
				 * 返回列表时只保留匹配文章行及动态指派的航轨。其余同名标题先摘名，
				 * 防止底部上一篇/下一篇或其它列表行从屏幕外参与共享元素配对。
				 */
				elements.forEach((element) => {
					if (element.matches('[data-page-main]')) return;
					if (element.closest('.article-hero')) return;
					if (element.dataset.ruleFlight === 'true') return;
					if (matchedRow?.contains(element)) return;
					element.style.viewTransitionName = 'none';
					arrivalStripped.push(element);
				});
			};
			document.addEventListener('astro:page-load', () => {
				arrivalStripped.forEach((element) => element.style.removeProperty('view-transition-name'));
				arrivalStripped = [];
				// 转场结束：细线开始起笔，画完（含最长错拍）释放标记回到静态；
				// 航轨用毕即拆，下次导航由指派逻辑重新授予。
				if (document.documentElement.dataset.articleNav === 'active') {
					document.documentElement.dataset.articleNav = 'settled';
					settledTimer = window.setTimeout(() => {
						delete document.documentElement.dataset.articleNav;
						document.querySelectorAll<HTMLElement>('[data-rule-flight]').forEach(releaseRuleFlight);
					}, 1900);
				}
			});

			let departedRestore: HTMLElement[] = [];
			let departedTimer = 0;

			document.addEventListener('astro:before-preparation', (event) => {
				armArticleNav(event);
				window.clearTimeout(departedTimer);
				if (document.documentElement.dataset.articleNav !== 'leaving') {
					departedRestore = [];
					return;
				}
				departedRestore = [];
				const elements = Array.from(
					document.querySelectorAll<HTMLElement>(NAMED_ELEMENT_SELECTOR),
				).filter((element) => !element.matches('[data-page-main]'));
				// View Transition 启动前严格分成 read/write 两段；这里只读，不改 DOM。
				const measured = elements.map((element) => {
					const rect = element.getBoundingClientRect();
					return {
						element,
						top: rect.top,
						height: rect.height,
						name: getComputedStyle(element).viewTransitionName,
					};
				});
				// 统一写阶段：后续不再读取布局，因此摘除多个命名也只产生一次失效。
				measured.forEach(({ element, top, height, name }) => {
					if (isMostlyInsideBand(top, height, 0, window.innerHeight)) return;
					if (!name || name === 'none') return;
					element.style.viewTransitionName = 'none';
					departedRestore.push(element);
				});
				// 去程航轨：被点击行的上线与下缘线跟随标题飞往文章页。标题在视口
				// 内（用户刚点过），其上下细线必然同样可见，无需再过视口守卫。
				const sourceLink = (event as Event & { sourceElement?: Element }).sourceElement
					?.closest('a[data-article-transition-link]');
				const sourceRow = sourceLink?.closest('.article-row');
				if (sourceRow instanceof Element) {
					const rules = rowFlightRules(sourceRow);
					nameRuleFlight(rules.top, FLIGHT_TOP);
					nameRuleFlight(rules.bottom, FLIGHT_BOTTOM);
					if (rules.top instanceof HTMLElement) departedRestore.push(rules.top);
					if (rules.bottom instanceof HTMLElement) departedRestore.push(rules.bottom);
				}
				// 导航失败时旧文档仍是活页，稍后把名字还给元素；成功换页后这些
				// 节点已被丢弃，恢复是无害的空操作，也不会波及新页的落点摘名。
				departedTimer = window.setTimeout(() => {
					departedRestore.forEach((element) => {
						element.style.removeProperty('view-transition-name');
						delete element.dataset.ruleFlight;
					});
					departedRestore = [];
				}, 3000);
			});
			document.addEventListener('astro:before-swap', (event) => {
				// 此刻当前文档持有 leaving；把 active 交给新文档，飞行与藏线两端才同持。
				if (document.documentElement.dataset.articleNav !== 'leaving') return;
				const newDocument = (event as RouterEvent).newDocument;
				newDocument?.documentElement.setAttribute('data-article-nav', 'active');
				// 返程航轨：在到达列表里找到出发文章所在的行，把它的上下两条线
				// 指派为航轨，标题区的细线便跟着标题飞回行位。找不到（目标列表
				// 没有这篇文章）就保持无名，航轨优雅退化为随整页淡入。
				if (!newDocument) return;
				const selector = `.article-row a[href="${window.location.pathname.replace(/["\\]/g, '\\$&')}"]`;
				const candidateRow = newDocument.querySelector(selector)?.closest('.article-row');
				const matchedRow = candidateRow instanceof Element ? candidateRow : null;
				if (matchedRow) {
					const rules = rowFlightRules(matchedRow);
					nameRuleFlight(rules.top, FLIGHT_TOP);
					nameRuleFlight(rules.bottom, FLIGHT_BOTTOM);
				}
				prepareArrivalNames(newDocument, matchedRow);
			});
		</script>
		<script>
			/*
			 * 正文媒体增强：把 shiki 代码块包进带「语言标签 + 复制」头栏的面板，
			 * 把宽表格包进横向滚动容器。全部渐进增强——无 JS 时正文退回裸
			 * pre/table，样式与阅读不受影响。脚本随文档持久存活；包装在每次
			 * astro:page-load 后对新页重跑，已包装元素按父级类名跳过。
			 */
			function enhanceProseMedia() {
				document.querySelectorAll<HTMLElement>('.reading-prose pre.astro-code').forEach((pre) => {
					if (pre.parentElement?.classList.contains('prose-code')) return;
					const wrap = document.createElement('div');
					wrap.className = 'prose-code';
					const head = document.createElement('div');
					head.className = 'prose-code__head';
					const lang = document.createElement('span');
					lang.className = 'prose-code__lang';
					lang.textContent = pre.dataset.language || 'text';
					const copy = document.createElement('button');
					copy.className = 'prose-code__copy';
					copy.type = 'button';
					copy.textContent = '复制';
					head.append(lang, copy);
					pre.replaceWith(wrap);
					wrap.append(head, pre);
				});
				document.querySelectorAll<HTMLElement>('.reading-prose table').forEach((table) => {
					if (table.parentElement?.classList.contains('prose-table')) return;
					const wrap = document.createElement('div');
					wrap.className = 'prose-table';
					table.replaceWith(wrap);
					wrap.append(table);
				});
				// 章节锚链：带 id 的 h2/h3 追加 "#" 锚点，悬停显形，供从目录外
				// （如读者自己的笔记）精确回链到某一节。触屏没有 hover，样式里
				// 用低透明度常显兜底。
				document.querySelectorAll<HTMLElement>('.reading-prose h2[id], .reading-prose h3[id]').forEach((heading) => {
					if (heading.querySelector('.prose-anchor')) return;
					const title = (heading.textContent ?? '').trim();
					const anchor = document.createElement('a');
					anchor.className = 'prose-anchor';
					anchor.href = `#${heading.id}`;
					anchor.textContent = '#';
					if (title) anchor.setAttribute('aria-label', `链接到「${title}」`);
					heading.append(anchor);
				});
			}

			let proseMediaBound = false;
			if (!proseMediaBound) {
				proseMediaBound = true;
				document.addEventListener('click', async (event) => {
					const button = event.target instanceof Element
						? event.target.closest<HTMLButtonElement>('.prose-code__copy')
						: null;
					if (!button) return;
					const pre = button.closest('.prose-code')?.querySelector('pre');
					if (!pre) return;
					const source = pre.textContent ?? '';
					let copied = false;
					try {
						await navigator.clipboard.writeText(source);
						copied = true;
					} catch {
						// 非安全上下文的兜底：临时选区 + execCommand。
						const helper = document.createElement('textarea');
						helper.value = source;
						document.body.append(helper);
						helper.select();
						try {
							copied = document.execCommand('copy');
						} catch {
							copied = false;
						}
						helper.remove();
					}
					button.classList.add(copied ? 'is-copied' : 'is-failed');
					button.textContent = copied ? '已复制' : '复制失败';
					window.setTimeout(() => {
						button.classList.remove('is-copied', 'is-failed');
						button.textContent = '复制';
					}, 1600);
				});
			}
			enhanceProseMedia();
			document.addEventListener('astro:page-load', enhanceProseMedia);
		</script>
	</body>
</html>

---
import { Focus, GitBranch, MoveLeft, BookmarkCheck, ListTree } from '@lucide/astro';
import type { MarkdownHeading } from 'astro';
import type { PostEntry } from '@/lib/content';
import { getPostPath } from '@/lib/content';
import BaseLayout from './BaseLayout.astro';
import KindLabel from '@/components/content/KindLabel.astro';
import NightEcho from '@/components/content/NightEcho.astro';
import PostMeta from '@/components/content/PostMeta.astro';
import { MemoryVault, ReadingSession, SceneGuide } from '@/components/interactive';
import CommentPanel from '@/components/interactive/CommentPanel.astro';
import ContentCoverScene from '@/components/visual/ContentCoverScene.astro';
import '@/styles/interactive.css';

interface Props {
	post: PostEntry;
	headings: MarkdownHeading[];
	related: PostEntry[];
	minutes: number;
}

const { post, headings, related, minutes } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const defaultDayCover = '/assets/covers/default-day.webp';
const defaultNightCover = '/assets/covers/default-night.webp';
const cover = post.data.cover ?? (post.data.kind === 'code' ? defaultNightCover : defaultDayCover);
const relatedLinks = related.map((entry) => ({
	href: getPostPath(entry),
	title: entry.data.title,
	kind: entry.data.kind.toUpperCase(),
}));
---

<BaseLayout title={post.data.title} description={post.data.summary} image={cover} type="article" className="article-page">
	<div class="article-topline" aria-hidden="true"><span data-article-topline></span></div>
	<div class="article-shell">
		<header class="article-hero">
			<div class="article-hero__cover" data-default-cover={!post.data.cover ? '' : undefined}>
				{post.data.cover ? (
					<img src={post.data.cover} alt="" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
				) : (
					<ContentCoverScene kind={post.data.kind} class="article-hero__cover-scene" />
				)}
				<div class="article-hero__scene">SCENE / 001</div>
			</div>
			<div class="article-hero__heading">
				<a class="article-hero__back" href="/posts/">
					<MoveLeft size={17} stroke-width={1.5} aria-hidden="true" />
					全部文章
				</a>
				<KindLabel kind={post.data.kind} />
				<h1>{post.data.title}</h1>
				<p>{post.data.summary}</p>
				<div class="article-hero__tags">
					{post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
				</div>
				{post.data.github && (
					<a class="article-hero__github" href={post.data.github} rel="noreferrer">
						<GitBranch size={17} stroke-width={1.5} aria-hidden="true" />
						查看 GitHub 项目
					</a>
				)}
			</div>
			<PostMeta date={post.data.publishedAt} minutes={minutes} weather={post.data.readingWeather} />
		</header>

		<!--
			继续阅读：读取 ReadingSession 持久化的进度，只在确实读到中途时出现。
			按钮出现与否不依赖 JS 以外的任何状态；无记录时保持隐藏，不占版面。
		-->
		<div class="article-resume-bar">
			<button class="article-resume" type="button" data-article-resume hidden>
				<BookmarkCheck size={16} stroke-width={1.5} aria-hidden="true" />
				<span>上次读到 <strong data-article-resume-value>0%</strong>，从这里继续</span>
			</button>
		</div>

		<div class="article-layout">
			<!--
				≤1240px 时侧栏整体退场，这份零 JS 折叠目录与顶部进度线一起接管
				章节导航；更宽的视口中侧栏目录已经完整，这里保持隐藏避免重复。
			-->
			{tocHeadings.length > 0 && (
				<details class="article-toc-compact">
					<summary>
						<ListTree size={16} stroke-width={1.5} aria-hidden="true" />
						<span>本文目录</span>
					</summary>
					<ol>
						{tocHeadings.map((heading) => (
							<li class={heading.depth === 2 ? 'is-chapter' : 'is-section'}>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ol>
				</details>
			)}
			<div class="article-layout__guide">
				<SceneGuide contentSelector=".prose" headingSelector="h2, h3" totalMinutes={minutes} />
				<div class="article-layout__tools">
					<!--
						阅读记录仅保存在当前浏览器；退出入口固定在阅读轨内，长文滚动到
						任何位置时都不必回到首屏寻找“全部文章”。
					-->
					<ReadingSession contentSelector=".reading-prose" postTitle={post.data.title} />
				<!--
					摘录工具与目录共享阅读轨，而不是悬浮在页面角落。scopeSelector 只允许
					选中正文，避免把导航、标签或评论区的文字误收入本机摘录。
				-->
				<MemoryVault
					variant="article"
					placement="article-tools"
					title="摘录本"
					triggerLabel="摘录"
					scopeSelector=".reading-prose"
				/>
				</div>
			</div>
			<article class="prose reading-prose" data-article-title={post.data.title} data-article-path={Astro.url.pathname}>
				<slot />
			</article>

			<!--
				沉浸阅读开关挂在右侧空白轨上，与左侧导览轨同一 sticky 几何。开启后
				天气背景整组降透明度并压上纸幕（themes.css 的 data-reading-focus
				覆盖 + RainField 的 calm 层），偏好记在本机、跨文章生效。
			-->
			<div class="article-layout__focus">
				<span class="article-focus__telemetry">READING / FOCUS</span>
				<button class="article-focus" type="button" aria-pressed="false" aria-label="切换沉浸阅读" data-tooltip="沉浸阅读：弱化背景干扰" data-article-focus>
					<Focus size={18} stroke-width={1.5} aria-hidden="true" />
				</button>
				<span class="article-focus__state" data-article-focus-state>OFF</span>
				<div class="article-focus__scale" aria-hidden="true"></div>
			</div>
		</div>

			<NightEcho minutes={minutes} scenes={Math.max(1, headings.filter((heading) => heading.depth === 2).length)} related={relatedLinks} />
			<!--
				评论区固定在文末档案区之后；Giscus 未配置时组件自身会渲染安静的占位说明，
				不会注入任何第三方脚本。
			-->
			<CommentPanel class="article-comments" title="留言" />
		</div>
	</BaseLayout>

	<script>
		interface ReadingRecord {
			progress: number;
			title: string;
			updatedAt: string;
		}

		function initArticleReaderHelpers() {
			const resume = document.querySelector<HTMLButtonElement>('[data-article-resume]');
			const resumeValue = document.querySelector<HTMLElement>('[data-article-resume-value]');
			const topline = document.querySelector<HTMLElement>('[data-article-topline]');

			if (resume && resumeValue) {
				const pageKey = window.location.pathname + window.location.search;
				let stored: ReadingRecord | undefined;
				try {
					const records = JSON.parse(localStorage.getItem('aria7-reading-progress') || '{}') as Record<string, ReadingRecord>;
					stored = records[pageKey];
				} catch {
					// 存储不可用时继续阅读不出现，阅读本身不受影响。
				}

				if (stored && typeof stored.progress === 'number' && stored.progress >= 0.04 && stored.progress <= 0.96) {
					const percent = Math.round(stored.progress * 100);
					resumeValue.textContent = `${percent}%`;
					resume.hidden = false;
					resume.addEventListener('click', () => {
						const content = document.querySelector<HTMLElement>('.reading-prose');
						if (!content) return;
						const rect = content.getBoundingClientRect();
						const contentTop = rect.top + window.scrollY;
						const scrollableDistance = Math.max(1, content.offsetHeight - window.innerHeight);
						const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
						window.scrollTo({
							top: contentTop + stored!.progress * scrollableDistance,
							behavior: reduceMotion ? 'auto' : 'smooth',
						});
					}, { once: true });
				}
			}

			const focusButton = document.querySelector<HTMLButtonElement>('[data-article-focus]');
		if (focusButton && focusButton.dataset.focusReady !== 'true') {
			focusButton.dataset.focusReady = 'true';
			const focusState = document.querySelector<HTMLElement>('[data-article-focus-state]');
			const persistFocus = (on: boolean) => {
				try {
					localStorage.setItem('aria7-reading-focus', on ? 'on' : 'off');
				} catch {
					// 存储不可用时偏好不持久化，本次页面内仍可正常切换。
				}
			};
			let immersive = false;
			try {
				immersive = localStorage.getItem('aria7-reading-focus') === 'on';
			} catch {
				// 读取失败按普通模式启动。
			}
			const applyFocus = (on: boolean) => {
				immersive = on;
				document.documentElement.dataset.readingFocus = on ? 'on' : 'off';
				focusButton.setAttribute('aria-pressed', String(on));
				if (focusState) focusState.textContent = on ? 'ON' : 'OFF';
			};
			applyFocus(immersive);
			focusButton.addEventListener('click', () => {
				applyFocus(!immersive);
				persistFocus(immersive);
			});
			// Esc 直接退出沉浸，不必把视线移回右侧开关。
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && immersive) {
					applyFocus(false);
					persistFocus(false);
				}
			});
		}

		if (topline) {
				// SceneGuide 滚动时已经算好正文比例并广播；这里只把结果接到进度线上，
				// 不再启动第二套滚动监听。侧栏在窄视口隐藏不影响事件继续派发。
				document.addEventListener('aria7-reading-progress', (event) => {
					const detail = (event as CustomEvent).detail as { ratio?: number } | null;
					if (detail && typeof detail.ratio === 'number') {
						topline.style.setProperty('--article-progress', String(detail.ratio));
					}
				});
			}
		}

		initArticleReaderHelpers();
		document.addEventListener('astro:page-load', initArticleReaderHelpers);
	</script>

<style>
	.article-shell {
		max-width: calc(var(--content-wide) + var(--page-gutter) + var(--page-gutter));
		margin-inline: auto;
		padding-inline: var(--page-gutter);
	}

	.article-hero {
		display: grid;
		grid-template-columns: minmax(460px, 1.15fr) minmax(420px, 0.85fr);
		gap: 0;
		padding-top: 42px;
	}

	.article-hero__cover {
		position: relative;
		min-height: 520px;
		overflow: hidden;
		background: var(--accent-soft);
		isolation: isolate;
	}

	.article-hero__cover::before,
	.article-hero__cover::after {
		position: absolute;
		inset: 0;
		z-index: 1;
		content: '';
		pointer-events: none;
	}

	.article-hero__cover::before {
		/*
		 * 阅读页需要比首页更安静：纸纤维和档案网格仅作为近景层，叠在自定义
		 * 封面之上时也不会遮蔽图片主体；天气远景则交给 ::after 单独慢速移动。
		 */
		background-image:
			url('/assets/patterns/archive-fiber.svg'),
			linear-gradient(var(--line) 1px, transparent 1px),
			linear-gradient(90deg, var(--line) 1px, transparent 1px),
			radial-gradient(ellipse at 76% 16%, color-mix(in srgb, var(--weather-glow) 42%, transparent), transparent 38%);
		background-position: center, center, center, center;
		background-size: 380px 380px, 92px 92px, 92px 92px, cover;
		opacity: 0.28;
		mix-blend-mode: multiply;
	}

	.article-hero__cover::after {
		/* 三种天气只替换静态材质，循环只改变合成层 transform，避免滤镜导致阅读页卡顿。 */
		z-index: 2;
		background-image: url('/assets/patterns/atmosphere-rain.svg');
		background-position: 62% center;
		background-size: cover;
		opacity: 0.24;
		mix-blend-mode: multiply;
		transform: scale(1.04);
		animation: article-cover-material-drift 18s var(--ease-drift) infinite alternate;
		transition:
			opacity 760ms var(--ease-rain),
			filter 760ms var(--ease-rain),
			background-image 1ms linear;
		will-change: transform;
	}

	.article-hero__cover img {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.article-hero__cover > :global(.article-hero__cover-scene) {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	:global(html[data-weather-mode='night']) .article-hero__cover::before {
		mix-blend-mode: screen;
		opacity: 0.24;
	}

	:global(html[data-weather-mode='night']) .article-hero__cover::after {
		background-image: url('/assets/patterns/atmosphere-night.svg');
		mix-blend-mode: screen;
		opacity: 0.34;
		filter: saturate(1.08) contrast(1.08);
	}

	:global(html[data-weather-mode='clear']) .article-hero__cover::after {
		background-image: url('/assets/patterns/atmosphere-clear.svg');
		opacity: 0.18;
	}

	.article-hero__scene {
		position: absolute;
		top: 18px;
		left: 20px;
		z-index: 3;
		font-family: var(--font-ui);
		font-size: 10px;
		color: var(--ink-muted);
	}

	.article-hero__heading {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
		padding: 54px;
		border-block: 1px solid var(--line);
		border-right: 1px solid var(--line);
	}

	.article-hero__back,
	.article-hero__github {
		display: inline-flex;
		width: fit-content;
		min-height: 44px;
		align-items: center;
		gap: 8px;
		font-family: var(--font-ui);
		font-size: 11px;
		color: var(--ink-muted);
		text-decoration: none;
	}

	.article-hero__back {
		margin-bottom: auto;
	}

	.article-hero h1 {
		margin: 18px 0 20px;
		font-family: var(--font-display);
		font-size: 68px;
		font-weight: 500;
		line-height: 1.18;
		overflow-wrap: anywhere;
	}

	.article-hero__heading > p {
		margin: 0 0 24px;
		font-size: 15px;
		line-height: 1.85;
		color: var(--ink-muted);
	}

	.article-hero__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 16px;
	}

	.article-hero__tags a {
		max-width: 100%;
		font-family: var(--font-ui);
		font-size: 10px;
		color: var(--accent-strong);
		overflow-wrap: anywhere;
		text-decoration: none;
	}

	.article-hero > :global(.post-meta) {
		grid-column: 1 / -1;
	}

	.article-layout {
		display: grid;
		grid-template-columns: 296px minmax(0, 760px) 1fr;
		gap: 48px;
		padding-top: 84px;
	}

	.article-layout__guide {
		min-width: 0;
		/*
		 * 导览和摘录在同一条固定阅读轨中分配高度：目录自己滚动，摘录始终保留
		 * 在底部，长文章也不会把保存入口推到视窗之外。
		 */
		position: sticky;
		top: 32px;
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		gap: 18px;
		height: calc(100dvh - 64px);
		align-self: start;
	}

	.article-layout__tools {
		display: grid;
		gap: 9px;
	}

	.article-layout__focus {
		/*
		 * 右侧空白轨：与左侧导览轨同一 sticky 几何，放沉浸开关和一支竖向
		 * 制图标尺，给空白一个锚点而不是再堆一栏内容。
		 */
		position: sticky;
		top: 32px;
		display: grid;
		grid-template-rows: auto auto auto minmax(24px, 1fr);
		gap: 12px;
		justify-items: center;
		width: 44px;
		height: calc(100dvh - 64px);
		align-self: start;
	}

	.article-focus {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper-0) 72%, transparent);
		backdrop-filter: blur(3px);
		color: var(--ink-muted);
		cursor: pointer;
		transition:
			color var(--duration-fast) var(--ease-rain),
			border-color var(--duration-fast) var(--ease-rain),
			background-color var(--duration-fast) var(--ease-rain);
	}

	.article-focus:hover,
	.article-focus:focus-visible {
		border-color: var(--accent-strong);
		color: var(--accent-strong);
	}

	.article-focus[aria-pressed='true'] {
		border-color: var(--accent-strong);
		color: var(--accent-strong);
		background: color-mix(in srgb, var(--accent-strong) 12%, transparent);
	}

	.article-focus[aria-pressed='true'] + .article-focus__state {
		color: var(--accent-strong);
	}

	.article-focus__telemetry,
	.article-focus__state {
		font-family: var(--font-ui);
		font-size: 9px;
		letter-spacing: 0.08em;
		color: var(--ink-muted);
	}

	.article-focus__telemetry {
		writing-mode: vertical-rl;
	}

	.article-focus__scale {
		position: relative;
		width: 9px;
		background: repeating-linear-gradient(
			to bottom,
			color-mix(in srgb, var(--line) 85%, transparent) 0 1px,
			transparent 1px 64px
		);
		opacity: 0.55;
	}

	.article-focus__scale::before {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 4px;
		width: 1px;
		background: var(--line);
		content: '';
	}

	.article-comments {
		margin-top: 84px;
	}

	.article-topline {
		position: fixed;
		top: 0;
		left: 0;
		z-index: var(--z-topline);
		width: 100%;
		height: 2px;
		pointer-events: none;
	}

	.article-topline span {
		display: block;
		height: 100%;
		background: var(--accent-strong);
		transform: scaleX(var(--article-progress, 0));
		transform-origin: left center;
	}

	.article-resume-bar {
		display: flex;
		justify-content: center;
		padding-top: 18px;
	}

	.article-resume {
		display: inline-flex;
		min-height: 36px;
		align-items: center;
		gap: 8px;
		padding-inline: 2px;
		border: none;
		border-bottom: 1px solid transparent;
		background: none;
		font-family: var(--font-ui);
		font-size: 11px;
		color: var(--ink-muted);
		cursor: pointer;
		transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
	}

	.article-resume strong {
		color: var(--accent-strong);
		font-weight: 500;
	}

	.article-resume:hover,
	.article-resume:focus-visible {
		color: var(--ink);
		border-bottom-color: var(--accent-strong);
	}

	.article-toc-compact {
		display: none;
	}

	.prose {
		grid-column: 2;
		min-width: 0;
	}

	@keyframes article-cover-material-drift {
		from { transform: translate3d(-0.7%, -0.6%, 0) scale(1.04); }
		to { transform: translate3d(0.9%, 0.8%, 0) scale(1.075); }
	}

	@media (prefers-reduced-motion: reduce) {
		.article-hero__cover::after { animation: none; }
	}

	@media (max-width: 1240px) {
		/* 侧栏、正文和双倍间距在中等桌面宽度下放不下，提前收成单列避免全局裁切。 */
		.article-layout {
			grid-template-columns: minmax(0, 760px);
			justify-content: center;
		}

		.article-layout__guide {
			display: none;
		}

		.prose {
			grid-column: 1;
		}

		/* 空白轨在单列布局里没有位置，退到右下角的固定角落，保留沉浸开关。 */
		.article-layout__focus {
			position: fixed;
			top: auto;
			right: 18px;
			bottom: 24px;
			z-index: var(--z-sticky);
			grid-template-rows: none;
			gap: 8px;
			width: auto;
			height: auto;
		}

		.article-focus__telemetry,
		.article-focus__scale {
			display: none;
		}

		/* 侧栏退场后由折叠目录与顶部进度线接管章节导航与阅读进度。 */
		.article-toc-compact {
			display: block;
			padding-block: 14px 20px;
			border-top: 1px solid var(--line);
		}

		.article-toc-compact summary {
			display: flex;
			min-height: 44px;
			align-items: center;
			gap: 8px;
			font-family: var(--font-ui);
			font-size: 11px;
			color: var(--ink-muted);
			cursor: pointer;
			list-style: none;
			user-select: none;
		}

		.article-toc-compact summary::-webkit-details-marker {
			display: none;
		}

		.article-toc-compact summary::after {
			width: 7px;
			height: 7px;
			border-right: 1px solid var(--ink-muted);
			border-bottom: 1px solid var(--ink-muted);
			content: '';
			transform: rotate(45deg);
			transition: transform var(--duration-fast) var(--ease-drift);
		}

		.article-toc-compact[open] summary::after {
			transform: rotate(225deg);
		}


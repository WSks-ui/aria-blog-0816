---
import { GitBranch, MoveLeft } from '@lucide/astro';
import type { MarkdownHeading } from 'astro';
import type { PostEntry } from '@/lib/content';
import { getPostPath } from '@/lib/content';
import BaseLayout from './BaseLayout.astro';
import KindLabel from '@/components/content/KindLabel.astro';
import NightEcho from '@/components/content/NightEcho.astro';
import PostMeta from '@/components/content/PostMeta.astro';
import { MemoryVault, ReadingSession, SceneGuide } from '@/components/interactive';
import ContentCoverScene from '@/components/visual/ContentCoverScene.astro';

interface Props {
	post: PostEntry;
	headings: MarkdownHeading[];
	related: PostEntry[];
	minutes: number;
}

const { post, headings, related, minutes } = Astro.props;
const defaultDayCover = '/assets/covers/default-day.webp';
const defaultNightCover = '/assets/covers/default-night.webp';
const cover = post.data.cover ?? (post.data.kind === 'code' ? defaultNightCover : defaultDayCover);
const relatedLinks = related.map((entry) => ({
	href: getPostPath(entry),
	title: entry.data.title,
	kind: entry.data.kind.toUpperCase(),
}));
---

<BaseLayout title={post.data.title} description={post.data.summary} image={cover} type="article" className="article-page">
	<div class="article-shell">
		<header class="article-hero">
			<div class="article-hero__cover" data-default-cover={!post.data.cover ? '' : undefined}>
				{post.data.cover ? (
					<img src={post.data.cover} alt="" width="1600" height="900" />
				) : (
					<ContentCoverScene kind={post.data.kind} class="article-hero__cover-scene" />
				)}
				<div class="article-hero__scene">SCENE / 001</div>
			</div>
			<div class="article-hero__heading">
				<a class="article-hero__back" href="/posts/">
					<MoveLeft size={17} stroke-width={1.5} aria-hidden="true" />
					全部文章
				</a>
				<KindLabel kind={post.data.kind} />
				<h1>{post.data.title}</h1>
				<p>{post.data.summary}</p>
				<div class="article-hero__tags">
					{post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
				</div>
				{post.data.github && (
					<a class="article-hero__github" href={post.data.github} rel="noreferrer">
						<GitBranch size={17} stroke-width={1.5} aria-hidden="true" />
						查看 GitHub 项目
					</a>
				)}
			</div>
			<PostMeta date={post.data.publishedAt} minutes={minutes} weather={post.data.readingWeather} />
		</header>

		<div class="article-layout">
			<div class="article-layout__guide">
				<SceneGuide contentSelector=".prose" headingSelector="h2, h3" />
				<div class="article-layout__tools">
					<!--
						阅读记录仅保存在当前浏览器；退出入口固定在阅读轨内，长文滚动到
						任何位置时都不必回到首屏寻找“全部文章”。
					-->
					<ReadingSession contentSelector=".reading-prose" postTitle={post.data.title} />
				<!--
					摘录工具与目录共享阅读轨，而不是悬浮在页面角落。scopeSelector 只允许
					选中正文，避免把导航、标签或评论区的文字误收入本机摘录。
				-->
				<MemoryVault
					variant="article"
					placement="article-tools"
					title="摘录本"
					triggerLabel="摘录"
					scopeSelector=".reading-prose"
				/>
				</div>
			</div>
			<article class="prose reading-prose" data-article-title={post.data.title} data-article-path={Astro.url.pathname}>
				<slot />
			</article>
		</div>

		<NightEcho minutes={minutes} scenes={Math.max(1, headings.filter((heading) => heading.depth === 2).length)} related={relatedLinks} />
	</div>
</BaseLayout>

<style>
	.article-shell {
		max-width: calc(var(--content-wide) + var(--page-gutter) + var(--page-gutter));
		margin-inline: auto;
		padding-inline: var(--page-gutter);
	}

	.article-hero {
		display: grid;
		grid-template-columns: minmax(460px, 1.15fr) minmax(420px, 0.85fr);
		gap: 0;
		padding-top: 42px;
	}

	.article-hero__cover {
		position: relative;
		min-height: 520px;
		overflow: hidden;
		background: var(--accent-soft);
		isolation: isolate;
	}

	.article-hero__cover::before,
	.article-hero__cover::after {
		position: absolute;
		inset: 0;
		z-index: 1;
		content: '';
		pointer-events: none;
	}

	.article-hero__cover::before {
		/*
		 * 阅读页需要比首页更安静：纸纤维和档案网格仅作为近景层，叠在自定义
		 * 封面之上时也不会遮蔽图片主体；天气远景则交给 ::after 单独慢速移动。
		 */
		background-image:
			url('/assets/patterns/archive-fiber.svg'),
			linear-gradient(var(--line) 1px, transparent 1px),
			linear-gradient(90deg, var(--line) 1px, transparent 1px),
			radial-gradient(ellipse at 76% 16%, color-mix(in srgb, var(--weather-glow) 42%, transparent), transparent 38%);
		background-position: center, center, center, center;
		background-size: 380px 380px, 92px 92px, 92px 92px, cover;
		opacity: 0.28;
		mix-blend-mode: multiply;
	}

	.article-hero__cover::after {
		/* 三种天气只替换静态材质，循环只改变合成层 transform，避免滤镜导致阅读页卡顿。 */
		z-index: 2;
		background-image: url('/assets/patterns/atmosphere-rain.svg');
		background-position: 62% center;
		background-size: cover;
		opacity: 0.24;
		mix-blend-mode: multiply;
		transform: scale(1.04);
		animation: article-cover-material-drift 18s var(--ease-drift) infinite alternate;
		transition:
			opacity 760ms var(--ease-rain),
			filter 760ms var(--ease-rain),
			background-image 1ms linear;
		will-change: transform;
	}

	.article-hero__cover img {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.article-hero__cover > :global(.article-hero__cover-scene) {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	:global(html[data-weather-mode='night']) .article-hero__cover::before {
		mix-blend-mode: screen;
		opacity: 0.24;
	}

	:global(html[data-weather-mode='night']) .article-hero__cover::after {
		background-image: url('/assets/patterns/atmosphere-night.svg');
		mix-blend-mode: screen;
		opacity: 0.34;
		filter: saturate(1.08) contrast(1.08);
	}

	:global(html[data-weather-mode='clear']) .article-hero__cover::after {
		background-image: url('/assets/patterns/atmosphere-clear.svg');
		opacity: 0.18;
	}

	.article-hero__scene {
		position: absolute;
		top: 18px;
		left: 20px;
		z-index: 3;
		font-family: var(--font-ui);
		font-size: 10px;
		color: var(--ink-muted);
	}

	.article-hero__heading {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
		padding: 54px;
		border-block: 1px solid var(--line);
		border-right: 1px solid var(--line);
	}

	.article-hero__back,
	.article-hero__github {
		display: inline-flex;
		width: fit-content;
		min-height: 44px;
		align-items: center;
		gap: 8px;
		font-family: var(--font-ui);
		font-size: 11px;
		color: var(--ink-muted);
		text-decoration: none;
	}

	.article-hero__back {
		margin-bottom: auto;
	}

	.article-hero h1 {
		margin: 18px 0 20px;
		font-family: var(--font-display);
		font-size: 68px;
		font-weight: 500;
		line-height: 1.18;
		overflow-wrap: anywhere;
	}

	.article-hero__heading > p {
		margin: 0 0 24px;
		font-size: 15px;
		line-height: 1.85;
		color: var(--ink-muted);
	}

	.article-hero__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 16px;
	}

	.article-hero__tags a {
		max-width: 100%;
		font-family: var(--font-ui);
		font-size: 10px;
		color: var(--accent-strong);
		overflow-wrap: anywhere;
		text-decoration: none;
	}

	.article-hero > :global(.post-meta) {
		grid-column: 1 / -1;
	}

	.article-layout {
		display: grid;
		grid-template-columns: 296px minmax(0, 760px) 1fr;
		gap: 48px;
		padding-top: 84px;
	}

	.article-layout__guide {
		min-width: 0;
		/*
		 * 导览和摘录在同一条固定阅读轨中分配高度：目录自己滚动，摘录始终保留
		 * 在底部，长文章也不会把保存入口推到视窗之外。
		 */
		position: sticky;
		top: 32px;
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		gap: 18px;
		height: calc(100dvh - 64px);
		align-self: start;
	}

	.article-layout__tools {
		display: grid;
		gap: 9px;
	}

	.prose {
		grid-column: 2;
		min-width: 0;
	}

	@keyframes article-cover-material-drift {
		from { transform: translate3d(-0.7%, -0.6%, 0) scale(1.04); }
		to { transform: translate3d(0.9%, 0.8%, 0) scale(1.075); }
	}

	@media (prefers-reduced-motion: reduce) {
		.article-hero__cover::after { animation: none; }
	}

	@media (max-width: 1240px) {
		/* 侧栏、正文和双倍间距在中等桌面宽度下放不下，提前收成单栏避免全局裁切。 */
		.article-layout {
			grid-template-columns: minmax(0, 760px);
			justify-content: center;
		}

		.article-layout__guide {
			display: none;
		}

		.prose {
			grid-column: 1;
		}
	}

	@media (max-width: 1100px) {
		/* 断点字号替代视口连续缩放，保证同一布局阶段的字阶稳定。 */
		.article-hero h1 {
			font-size: 52px;
		}

		.article-hero {
			grid-template-columns: 1fr;
		}

		.article-hero__cover {
			min-height: 420px;
		}

		.article-hero__heading {
			border-left: 1px solid var(--line);
		}

	}

	@media (max-width: 760px) {
		.article-shell {
			padding-inline: 20px;
		}

		.article-hero__cover {
			min-height: 280px;
		}

		.article-hero__heading {
			padding: 36px 24px;
		}

		.article-hero h1 {
			font-size: 40px;
		}

		.article-layout {
			padding-top: 52px;
		}
	}
</style>

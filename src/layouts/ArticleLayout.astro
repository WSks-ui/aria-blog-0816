---
import { GitBranch, MoveLeft } from '@lucide/astro';
import type { MarkdownHeading } from 'astro';
import type { PostEntry } from '@/lib/content';
import { getPostPath } from '@/lib/content';
import BaseLayout from './BaseLayout.astro';
import KindLabel from '@/components/content/KindLabel.astro';
import NightEcho from '@/components/content/NightEcho.astro';
import PostMeta from '@/components/content/PostMeta.astro';
import { CommentPanel, SceneGuide } from '@/components/interactive';

interface Props {
	post: PostEntry;
	headings: MarkdownHeading[];
	related: PostEntry[];
	minutes: number;
}

const { post, headings, related, minutes } = Astro.props;
const cover = post.data.cover ?? (post.data.kind === 'code' ? '/assets/covers/default-night.webp' : '/assets/covers/default-day.webp');
const relatedLinks = related.map((entry) => ({
	href: getPostPath(entry),
	title: entry.data.title,
	kind: entry.data.kind.toUpperCase(),
}));
---

<BaseLayout title={post.data.title} description={post.data.summary} image={cover} type="article" className="article-page">
	<div class="article-shell">
		<header class="article-hero">
			<div class="article-hero__cover">
				<img src={cover} alt="" width="1600" height="900" />
				<div class="article-hero__scene">SCENE / 001</div>
			</div>
			<div class="article-hero__heading">
				<a class="article-hero__back" href="/posts/">
					<MoveLeft size={17} stroke-width={1.5} aria-hidden="true" />
					全部文章
				</a>
				<KindLabel kind={post.data.kind} />
				<h1>{post.data.title}</h1>
				<p>{post.data.summary}</p>
				<div class="article-hero__tags">
					{post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
				</div>
				{post.data.github && (
					<a class="article-hero__github" href={post.data.github} rel="noreferrer">
						<GitBranch size={17} stroke-width={1.5} aria-hidden="true" />
						查看 GitHub 项目
					</a>
				)}
			</div>
			<PostMeta date={post.data.publishedAt} minutes={minutes} weather={post.data.readingWeather} />
		</header>

		<div class="article-layout">
			<div class="article-layout__guide">
				<SceneGuide contentSelector=".prose" headingSelector="h2, h3" />
			</div>
			<article class="prose reading-prose" data-article-title={post.data.title} data-article-path={Astro.url.pathname}>
				<slot />
			</article>
		</div>

		<section class="article-comments" aria-label="评论">
			<CommentPanel />
		</section>

		<NightEcho minutes={minutes} scenes={Math.max(1, headings.filter((heading) => heading.depth === 2).length)} related={relatedLinks} />
	</div>
</BaseLayout>

<style>
	.article-shell {
		max-width: var(--content-max);
		margin-inline: auto;
		padding-inline: var(--page-gutter);
	}

	.article-hero {
		display: grid;
		grid-template-columns: minmax(460px, 1.15fr) minmax(420px, 0.85fr);
		gap: 0;
		padding-top: 42px;
	}

	.article-hero__cover {
		position: relative;
		min-height: 520px;
		overflow: hidden;
		background: var(--accent-soft);
	}

	.article-hero__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.article-hero__scene {
		position: absolute;
		top: 18px;
		left: 20px;
		font-family: var(--font-ui);
		font-size: 10px;
		color: var(--ink-muted);
	}

	.article-hero__heading {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
		padding: 54px;
		border-block: 1px solid var(--line);
		border-right: 1px solid var(--line);
	}

	.article-hero__back,
	.article-hero__github {
		display: inline-flex;
		width: fit-content;
		min-height: 44px;
		align-items: center;
		gap: 8px;
		font-family: var(--font-ui);
		font-size: 11px;
		color: var(--ink-muted);
		text-decoration: none;
	}

	.article-hero__back {
		margin-bottom: auto;
	}

	.article-hero h1 {
		margin: 18px 0 20px;
		font-family: var(--font-display);
		font-size: 68px;
		font-weight: 500;
		line-height: 1.18;
		overflow-wrap: anywhere;
	}

	.article-hero__heading > p {
		margin: 0 0 24px;
		font-size: 15px;
		line-height: 1.85;
		color: var(--ink-muted);
	}

	.article-hero__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 16px;
	}

	.article-hero__tags a {
		max-width: 100%;
		font-family: var(--font-ui);
		font-size: 10px;
		color: var(--accent-strong);
		overflow-wrap: anywhere;
		text-decoration: none;
	}

	.article-hero > :global(.post-meta) {
		grid-column: 1 / -1;
	}

	.article-layout {
		display: grid;
		grid-template-columns: 240px minmax(0, 760px) 1fr;
		gap: 64px;
		padding-top: 84px;
	}

	.article-layout__guide {
		min-width: 0;
	}

	.prose {
		grid-column: 2;
		min-width: 0;
	}

	.article-comments {
		max-width: 760px;
		margin: 72px auto 0;
		padding-top: 32px;
		border-top: 1px solid var(--line);
	}

	@media (max-width: 1100px) {
		/* 断点字号替代视口连续缩放，保证同一布局阶段的字阶稳定。 */
		.article-hero h1 {
			font-size: 52px;
		}

		.article-hero {
			grid-template-columns: 1fr;
		}

		.article-hero__cover {
			min-height: 420px;
		}

		.article-hero__heading {
			border-left: 1px solid var(--line);
		}

		.article-layout {
			grid-template-columns: minmax(0, 760px);
			justify-content: center;
		}

		.article-layout__guide {
			display: none;
		}

		.prose {
			grid-column: 1;
		}
	}

	@media (max-width: 760px) {
		.article-shell {
			padding-inline: 20px;
		}

		.article-hero__cover {
			min-height: 280px;
		}

		.article-hero__heading {
			padding: 36px 24px;
		}

		.article-hero h1 {
			font-size: 40px;
		}

		.article-layout {
			padding-top: 52px;
		}
	}
</style>

<style is:global>
	/*
	 * 快捷导航的入场级联：换页转场期间（active）随整页藏起，落定（settled）
	 * 后按 --rail-order 依次自右浮入，与细线起笔同属一场编排；直接访问
	 * （无标记）时保持静态完整可见。
	 */
	html[data-article-nav='active'] .article-tabs__item {
		opacity: 0;
		transform: translateX(10px);
	}

	html[data-article-nav='settled'] .article-tabs__item {
		animation: aria7-rail-rise 460ms var(--ease-rain, ease) backwards;
		animation-delay: calc(240ms + var(--rail-order, 0) * 30ms);
	}

	@keyframes aria7-rail-rise {
		from { opacity: 0; transform: translateX(10px); }
		to { opacity: 1; transform: translateX(0); }
	}

	@media (prefers-reduced-motion: reduce) {
		html[data-article-nav] .article-tabs__item {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>

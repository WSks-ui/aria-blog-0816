---
import { ArrowRight, Focus, GitBranch, MoveLeft, BookmarkCheck, ListTree } from '@lucide/astro';
import type { MarkdownHeading } from 'astro';
import type { PostEntry } from '@/lib/content';
import { getPostPath, getPostTransitionName } from '@/lib/content';
import { SECTION_NAV_ITEMS } from '@/data/site';
import BaseLayout from './BaseLayout.astro';
import KindLabel from '@/components/content/KindLabel.astro';
import NightEcho from '@/components/content/NightEcho.astro';
import PostMeta from '@/components/content/PostMeta.astro';
import { MemoryVault, ReadingSession, SceneGuide } from '@/components/interactive';
import CommentPanel from '@/components/interactive/CommentPanel.astro';
import ContentCoverScene from '@/components/visual/ContentCoverScene.astro';
import CoverVeil from '@/components/visual/CoverVeil.astro';
import '@/styles/interactive.css';

interface Props {
	post: PostEntry;
	headings: MarkdownHeading[];
	related: PostEntry[];
	minutes: number;
	previous?: PostEntry;
	next?: PostEntry;
}

const { post, headings, related, minutes, previous, next } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const currentKindPath = `/types/${post.data.kind}/`;
/*
 * 右侧轨的全站快捷导航：主导航不吸顶，深读时这里就是最近的跳转入口。
 * 与 SiteHeader 共用 SECTION_NAV_ITEMS（单一出处）；当前文章所属栏目点亮。
 * 上一级按内容层级回所属栏目页（笔记文章的上级是「笔记」，不是文章池）。
 */
const railNav = SECTION_NAV_ITEMS;
const defaultDayCover = '/assets/covers/default-day.webp';
const defaultNightCover = '/assets/covers/default-night.webp';
const cover = post.data.cover ?? (post.data.kind === 'code' ? defaultNightCover : defaultDayCover);
const relatedLinks = related.map((entry) => ({
	href: getPostPath(entry),
	title: entry.data.title,
	kind: entry.data.kind.toUpperCase(),
}));
/*
 * 随笔走独立的文学排版：没有目录轨、阅读仪表和摘录工具，正文收窄居中、
 * 段落首行缩进，进度只保留顶部细线（脚本里由兜底广播驱动）。
 */
const isEssay = post.data.kind === 'essay';
---

<BaseLayout title={post.data.title} description={post.data.summary} image={cover} preloadImage={post.data.cover ?? undefined} type="article" className="article-page">
	<div class="article-topline" aria-hidden="true"><span data-article-topline></span></div>
	<div class="article-shell">
		<header class="article-hero">
			<!--
				封面持有全站唯一的 aria7-article-cover 共享名：从首页精选进入时与
				精选封面板对插值展开，文章间互跳时前后两篇封面直接形变交接。
			-->
			<div
				class="article-hero__cover"
				transition:name="aria7-article-cover"
				data-default-cover={!post.data.cover ? '' : undefined}
			>
				{post.data.cover ? (
					<img src={post.data.cover} alt={`《${post.data.title}》封面`} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
				) : (
					<ContentCoverScene kind={post.data.kind} class="article-hero__cover-scene" />
				)}
				<div class="article-hero__scene" data-hud-type>SCENE / 001</div>
				<!-- 天气封面纱：雨痕/尘埃/星子按当前天气覆在玻璃上。 -->
				<CoverVeil />
			</div>
			<div class="article-hero__heading">
				<!--
					标题区上下细线是全站唯一的航轨（aria7-rule-top/bottom）：列表里
					被点击行的上下两条细线跟随标题飞行，落位后成为这两条轨；返回时
					再飞回行位。伪元素挂不了共享转场名，因此用真实元素承载。
				-->
				<span class="article-hero__rule article-hero__rule--top" aria-hidden="true" transition:name="aria7-rule-top"></span>
				<span class="article-hero__rule article-hero__rule--bottom" aria-hidden="true" transition:name="aria7-rule-bottom"></span>
				<a class="article-hero__back" href="/posts/" data-article-transition-link>
					<MoveLeft size={17} stroke-width={1.5} aria-hidden="true" />
					全部文章
				</a>
				<KindLabel kind={post.data.kind} />
				<!-- 与列表行标题共享同名转场：换页时浏览器对两页快照插值，标题从原行位置飞入。 -->
				<h1 transition:name={getPostTransitionName(post)}>{post.data.title}</h1>
				<p>{post.data.summary}</p>
				<div class="article-hero__tags">
					{post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
				</div>
				{post.data.github && (
					<a class="article-hero__github" href={post.data.github} rel="noreferrer">
						<GitBranch size={17} stroke-width={1.5} aria-hidden="true" />
						查看 GitHub 项目
					</a>
				)}
			</div>
			<PostMeta date={post.data.publishedAt} minutes={minutes} weather={post.data.readingWeather} />
		</header>

		<!--
			继续阅读：读取 ReadingSession 持久化的进度，只在确实读到中途时出现。
			按钮出现与否不依赖 JS 以外的任何状态；无记录时保持隐藏，不占版面。
		-->
		<div class="article-resume-bar">
			<button class="article-resume" type="button" data-article-resume hidden>
				<BookmarkCheck size={16} stroke-width={1.5} aria-hidden="true" />
				<span>上次读到 <strong data-article-resume-value>0%</strong>，从这里继续</span>
			</button>
		</div>

		<div class:list={['article-layout', { 'article-layout--essay': isEssay }]}>
			<!--
				≤1240px 时侧栏整体退场，这份零 JS 折叠目录与顶部进度线一起接管
				章节导航；更宽的视口中侧栏目录已经完整，这里保持隐藏避免重复。
				随笔不设目录：文学阅读从头读到尾，章节跳转反而打断叙述。
			-->
			{!isEssay && tocHeadings.length > 0 && (
				<details class="article-toc-compact">
					<summary>
						<ListTree size={16} stroke-width={1.5} aria-hidden="true" />
						<span>本文目录</span>
					</summary>
					<ol>
						{tocHeadings.map((heading) => (
							<li class={heading.depth === 2 ? 'is-chapter' : 'is-section'}>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ol>
				</details>
			)}
			{!isEssay && (
			<div class="article-layout__guide">
				<SceneGuide contentSelector=".prose" headingSelector="h2, h3" totalMinutes={minutes} />
				<div class="article-layout__tools">
					<!--
						阅读记录仅保存在当前浏览器；退出入口固定在阅读轨内，长文滚动到
						任何位置时都不必回到首屏寻找“全部文章”。
					-->
					<ReadingSession contentSelector=".reading-prose" postTitle={post.data.title} />
				<!--
					摘录工具与目录共享阅读轨，而不是悬浮在页面角落。scopeSelector 只允许
					选中正文，避免把导航、标签或评论区的文字误收入本机摘录。
				-->
				<MemoryVault
					variant="article"
					placement="article-tools"
					title="摘录本"
					triggerLabel="摘录"
						scopeSelector=".reading-prose"
					/>
				</div>
			</div>
			)}
			<article class="prose reading-prose" data-article-title={post.data.title} data-article-path={Astro.url.pathname}>
				<slot />
			</article>

			<!--
				沉浸阅读开关挂在右侧空白轨上，与左侧导览轨同一 sticky 几何。开启后
				天气背景整组降透明度并压上纸幕（themes.css 的 data-reading-focus
				覆盖 + RainField 的 calm 层），偏好记在本机、跨文章生效。
			-->
			<div class="article-layout__focus">
				<span class="article-focus__telemetry" data-hud-type>READING / FOCUS</span>
				<button class="article-focus" type="button" aria-pressed="false" aria-label="切换沉浸阅读" data-tooltip="沉浸阅读：弱化背景干扰" data-article-focus>
					<Focus size={18} stroke-width={1.5} aria-hidden="true" />
				</button>
				<span class="article-focus__state" data-article-focus-state>OFF</span>
				<!--
					全站快捷导航：主导航不吸顶，深读时这里是最近的入口。首页与天气
					切换置顶，其下与 SiteHeader 主导航同一套栏目（当前文章所属栏目
					点亮）。右侧滑动指示旗由脚本驱动：悬停追到指向项，离开滑回当前
					栏目。
				-->
				<nav class="article-tabs" aria-label="快捷导航">
					<span class="article-tabs__label" aria-hidden="true" data-hud-type>NAV / QUICK</span>
					<span class="article-tabs__flag" aria-hidden="true"></span>
					<a class="article-tabs__item" href="/" style="--rail-order: 0">
						<span class="article-tabs__index" aria-hidden="true">01</span>
						<span class="article-tabs__title">首页</span>
					</a>
					<!--
						天气观测窗：CSS 手绘的三档天气图形（晴=旋芒圆日 / 雨=落雨斜纹 /
						夜=新月星点），点击循环并走 weather-mode-request 握手——
						WeatherTransition 在场时播转场，不在场立即提交。偏好写入同一
						存储键，与页头控件保持同步。
					-->
					<button
						class="article-tabs__item article-weather"
						type="button"
						data-rail-weather
						data-rail-weather-mode="rain"
						data-tooltip="切换颜色模式"
					>
						<span class="article-weather__glyph" aria-hidden="true"></span>
						<span class="article-weather__mode" data-rail-weather-label>RAIN</span>
					</button>
					{railNav.map((item, index) => (
						<a
							class:list={['article-tabs__item', { 'is-current': item.href === currentKindPath }]}
							href={item.href}
							style={`--rail-order: ${index + 2}`}
							aria-current={item.href === currentKindPath ? 'true' : undefined}
						>
							<span class="article-tabs__index" aria-hidden="true">{String(index + 3).padStart(2, '0')}</span>
							<span class="article-tabs__title">{item.label}</span>
						</a>
					))}
				</nav>
				<div class="article-focus__scale" aria-hidden="true"></div>
			</div>
		</div>

			<!--
				文末续读：同栏目内按发布时间取上一篇（更早）与下一篇（更新）。
				两枚标题与目标文章的 H1 持同名转场——在页尾点走时标题直接飞入
				新页页头；抵达时它们位于首屏折叠线以下，由到达守卫摘名，不会
				从屏幕外飞进来。
			-->
			{(previous || next) && (
				<nav class="article-neighbors" aria-label="上一篇与下一篇">
					{previous ? (
						<a class="article-neighbors__item" href={getPostPath(previous)} data-article-transition-link>
							<MoveLeft size={17} stroke-width={1.5} aria-hidden="true" />
							<span class="article-neighbors__body">
								<small>PREVIOUS / 上一篇</small>
								<strong transition:name={getPostTransitionName(previous)}>{previous.data.title}</strong>
							</span>
						</a>
					) : <span class="article-neighbors__placeholder" aria-hidden="true"></span>}
					{next ? (
						<a class="article-neighbors__item is-next" href={getPostPath(next)} data-article-transition-link>
							<span class="article-neighbors__body">
								<small>NEXT / 下一篇</small>
								<strong transition:name={getPostTransitionName(next)}>{next.data.title}</strong>
							</span>
							<ArrowRight size={17} stroke-width={1.5} aria-hidden="true" />
						</a>
					) : <span class="article-neighbors__placeholder" aria-hidden="true"></span>}
				</nav>
			)}

			<NightEcho minutes={minutes} scenes={Math.max(1, headings.filter((heading) => heading.depth === 2).length)} related={relatedLinks} />
			<!--
				评论区固定在文末档案区之后；Giscus 未配置时组件自身会渲染安静的占位说明，
				不会注入任何第三方脚本。
			-->
			<CommentPanel class="article-comments" title="留言" />
		</div>
	</BaseLayout>

	<script>
		// 客户端脚本单独引入：frontmatter 的导入只存在于服务端作用域。
		import {
			commitWeatherMode,
			isWeatherMode,
			WEATHER_MODES,
			WEATHER_MODE_STORAGE_KEY,
			type WeatherMode,
		} from '@/lib/weather-mode';

		interface ReadingRecord {
			progress: number;
			title: string;
			updatedAt: string;
		}

		// 每次初始化前先拆掉上一实例挂在世界（document/window）上的监听，
		// 并作废待写入的持久化定时器——否则换页后旧闭包会拿着脱离 DOM 的
		// 旧正文以 ratio=1 污染 aria7-reading-progress，让“继续阅读”对
		// 读过的文章永久失效。
		let readerHelpersTeardown: (() => void) | null = null;

		function initArticleReaderHelpers() {
			readerHelpersTeardown?.();
			const controller = new AbortController();
			const { signal } = controller;
			const cleanupFns: Array<() => void> = [];
			readerHelpersTeardown = () => {
				controller.abort();
				cleanupFns.forEach((fn) => fn());
				cleanupFns.length = 0;
				readerHelpersTeardown = null;
			};

			const resume = document.querySelector<HTMLButtonElement>('[data-article-resume]');
			const resumeValue = document.querySelector<HTMLElement>('[data-article-resume-value]');
			const topline = document.querySelector<HTMLElement>('[data-article-topline]');

			if (resume && resumeValue) {
				const pageKey = window.location.pathname + window.location.search;
				let stored: ReadingRecord | undefined;
				try {
					const records = JSON.parse(localStorage.getItem('aria7-reading-progress') || '{}') as Record<string, ReadingRecord>;
					stored = records[pageKey];
				} catch {
					// 存储不可用时继续阅读不出现，阅读本身不受影响。
				}

				if (stored && typeof stored.progress === 'number' && stored.progress >= 0.04 && stored.progress <= 0.96) {
					const percent = Math.round(stored.progress * 100);
					resumeValue.textContent = `${percent}%`;
					resume.hidden = false;
					resume.addEventListener('click', () => {
						const content = document.querySelector<HTMLElement>('.reading-prose');
						if (!content) return;
						const rect = content.getBoundingClientRect();
						const contentTop = rect.top + window.scrollY;
						const scrollableDistance = Math.max(1, content.offsetHeight - window.innerHeight);
						const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
						window.scrollTo({
							top: contentTop + stored!.progress * scrollableDistance,
							behavior: reduceMotion ? 'auto' : 'smooth',
						});
					}, { once: true });
				}
			}

			const proseContent = document.querySelector<HTMLElement>('.reading-prose');
		if (proseContent && proseContent.dataset.progressReady !== 'true' && !document.querySelector('[data-scene-guide]')) {
			// 随笔版没有导览轨，滚动比例在这里计算并广播同一名事件，顶部进度线
			// 与“继续阅读”不必感知两种版式的差异；同时接手 ReadingSession 的
			// 持久化职责，沿用同一存储格式，让续读跨版式可用。
			proseContent.dataset.progressReady = 'true';
			const pageKey = window.location.pathname + window.location.search;
			let latestRatio = 0;
			let lastSaved = -1;
			let persistTimer = 0;
			const persistProgress = (force = false) => {
				if (!force && Math.abs(latestRatio - lastSaved) < 0.01) return;
				try {
					const records = JSON.parse(localStorage.getItem('aria7-reading-progress') || '{}') as Record<string, unknown>;
					records[pageKey] = {
						progress: Number(latestRatio.toFixed(4)),
						title: proseContent.dataset.articleTitle || document.title,
						updatedAt: new Date().toISOString(),
					};
					localStorage.setItem('aria7-reading-progress', JSON.stringify(records));
					lastSaved = latestRatio;
				} catch {
					// 存储不可用时只丢续读记录，不影响阅读本身。
				}
			};
			let ticking = false;
			cleanupFns.push(() => window.clearTimeout(persistTimer));
			const emitRatio = () => {
				ticking = false;
				// 换页后 prose 脱离 DOM，几何信息归零、比例恒为 1，直接跳过。
				if (!proseContent.isConnected) return;
				const rect = proseContent.getBoundingClientRect();
				const contentTop = rect.top + window.scrollY;
				const scrollable = Math.max(1, proseContent.offsetHeight - window.innerHeight);
				latestRatio = Math.min(1, Math.max(0, (window.scrollY - contentTop) / scrollable));
				document.dispatchEvent(new CustomEvent('aria7-reading-progress', {
					detail: { content: proseContent, ratio: latestRatio },
				}));
				window.clearTimeout(persistTimer);
				persistTimer = window.setTimeout(() => persistProgress(), 900);
			};
			window.addEventListener('scroll', () => {
				if (ticking) return;
				ticking = true;
				window.requestAnimationFrame(emitRatio);
			}, { passive: true, signal });
			window.addEventListener('pagehide', () => persistProgress(true), { signal });
			emitRatio();
		}

		const focusButton = document.querySelector<HTMLButtonElement>('[data-article-focus]');
		if (focusButton && focusButton.dataset.focusReady !== 'true') {
			focusButton.dataset.focusReady = 'true';
			const focusState = document.querySelector<HTMLElement>('[data-article-focus-state]');
			const persistFocus = (on: boolean) => {
				try {
					localStorage.setItem('aria7-reading-focus', on ? 'on' : 'off');
				} catch {
					// 存储不可用时偏好不持久化，本次页面内仍可正常切换。
				}
			};
			let immersive = false;
			try {
				immersive = localStorage.getItem('aria7-reading-focus') === 'on';
			} catch {
				// 读取失败按普通模式启动。
			}
			const applyFocus = (on: boolean) => {
				immersive = on;
				document.documentElement.dataset.readingFocus = on ? 'on' : 'off';
				focusButton.setAttribute('aria-pressed', String(on));
				if (focusState) focusState.textContent = on ? 'ON' : 'OFF';
			};
			applyFocus(immersive);
			focusButton.addEventListener('click', () => {
				applyFocus(!immersive);
				persistFocus(immersive);
			});
			// Esc 直接退出沉浸，不必把视线移回右侧开关。
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && immersive) {
					applyFocus(false);
					persistFocus(false);
				}
			}, { signal });
		}

		if (topline) {
				// SceneGuide 滚动时已经算好正文比例并广播；这里只把结果接到进度线上，
				// 不再启动第二套滚动监听。侧栏在窄视口隐藏不影响事件继续派发。
				// 比照 ReadingSession 校验内容归属：旧页面闭包广播的 detached 正文
				// 或别的文章的正文，不得驱动本页进度线。
				document.addEventListener('aria7-reading-progress', (event) => {
					const detail = (event as CustomEvent).detail as { content?: unknown; ratio?: unknown } | null;
					if (!detail || typeof detail.ratio !== 'number') return;
					if (!(detail.content instanceof HTMLElement) || !detail.content.isConnected) return;
					const sameContent = !proseContent
						|| detail.content === proseContent
						|| detail.content.contains(proseContent)
						|| proseContent.contains(detail.content);
					if (sameContent) {
						topline.style.setProperty('--article-progress', String(detail.ratio));
					}
				}, { signal });
			}
		}

		/*
		 * 快捷导航的滑动指示旗：悬停追到指向项，移出后滑回当前所属栏目；
		 * 没有当前栏目（异常路径）就整枚藏起。旗只做位移，不参与入场动画。
		 */
		function initRailNavFlag() {
			const nav = document.querySelector<HTMLElement>('.article-tabs');
			const flag = nav?.querySelector<HTMLElement>('.article-tabs__flag');
			if (!nav || !flag) return;
			if (nav.dataset.flagReady === 'true') return;
			nav.dataset.flagReady = 'true';
			const items = Array.from(nav.querySelectorAll<HTMLElement>('.article-tabs__item'));
			const anchor = () => nav.querySelector<HTMLElement>('.article-tabs__item.is-current') ?? null;
			const moveTo = (item: HTMLElement | null) => {
				if (!item) {
					flag.classList.remove('is-on');
					return;
				}
				const y = item.offsetTop + (item.offsetHeight - flag.offsetHeight) / 2;
				flag.style.transform = `translateY(${Math.max(0, y)}px)`;
				flag.classList.add('is-on');
			};
			moveTo(anchor());
			items.forEach((item) => item.addEventListener('mouseenter', () => moveTo(item)));
			nav.addEventListener('mouseleave', () => moveTo(anchor()));
		}

		/*
		 * 快捷导航里的天气切换：读取当前模式 → 循环到下一档 → 走
		 * weather-mode-request 握手。commit 与 WeatherModeControl 共用
		 * lib/weather-mode 的同一提交实现（根属性、地址栏色、存储、全局
		 * 事件、页头单选同步）；转场动画由 WeatherTransition 接管，缺席时
		 * 立即提交。
		 */
		function initRailWeather() {
			const button = document.querySelector<HTMLButtonElement>('[data-rail-weather]');
			const label = document.querySelector<HTMLElement>('[data-rail-weather-label]');
			if (!button || !label || button.dataset.railWeatherReady === 'true') return;
			button.dataset.railWeatherReady = 'true';
			const modes = WEATHER_MODES;
			type Mode = WeatherMode;
			const isMode = isWeatherMode;

			const syncLabel = (mode: Mode) => {
				label.textContent = mode.toUpperCase();
				button.dataset.railWeatherMode = mode;
			};
			// 提交动作与页头控件共用 lib/weather-mode 的同一实现。
			const commit = (mode: Mode) => {
				commitWeatherMode(mode, { storageKey: WEATHER_MODE_STORAGE_KEY, source: 'control' });
				syncLabel(mode);
			};
			syncLabel(isMode(document.documentElement.dataset.weatherMode ?? null)
				? (document.documentElement.dataset.weatherMode as Mode)
				: 'rain');
			button.addEventListener('click', () => {
				const current = isMode(document.documentElement.dataset.weatherMode ?? null)
					? (document.documentElement.dataset.weatherMode as Mode)
					: 'rain';
				const next = modes[(modes.indexOf(current) + 1) % modes.length];
				if (next === current) return;
				const request = new CustomEvent('weather-mode-request', {
					cancelable: true,
					detail: {
						mode: next,
						previousMode: current,
						commit: () => commit(next),
					},
				});
				// 没有转场组件接管时事件不被取消，立即提交。
				if (document.dispatchEvent(request)) commit(next);
			});
		}

		initArticleReaderHelpers();
		initRailNavFlag();
		initRailWeather();
		document.addEventListener('astro:page-load', () => {
			initArticleReaderHelpers();
			initRailNavFlag();
			initRailWeather();
		});
		// 换页与 page-load 之间的窗口期也要断供：旧页面的持久化定时器若在这时
		// 到期，会把错误的进度写进存储，before-swap 提前拆干净。
		document.addEventListener('astro:before-swap', () => {
			readerHelpersTeardown?.();
		});
	</script>

